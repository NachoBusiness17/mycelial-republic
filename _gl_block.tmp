// ---- THE WIPEOUT MATH AS THE ENVIRONMENT (stolen whole from wipeout_sunset, our own shader) ----
// raymarched triangle terrain + slit sun + starfield; the game feeds it steer/speed/crash.
const FS_SRC=`
precision highp float;
float round(float x){return floor(x+.5);}
vec3 round(vec3 x){return floor(x+.5);}
uniform vec2 iResolution;
uniform float iTime;
uniform float iTimeDelta;
uniform sampler2D iChannel0;
uniform float uSteer;
uniform float uSpeed;
uniform float uCrashFlash;
#define speed 10.
#define wave_thing
#define audio_vibration_amplitude .125
float jTime;
float amp(vec2 p){return smoothstep(1.,8.,abs(p.x));}
float pow512(float a){a*=a;a*=a;a*=a;a*=a;a*=a;a*=a;a*=a;a*=a;return a*a;}
float pow1d5(float a){return a*sqrt(a);}
float hash21(vec2 co){return fract(sin(dot(co.xy,vec2(1.9898,7.233)))*45758.5433);}
float hash(vec2 uv){
 float a=amp(uv);
 float w=a>0.?(1.-.4*pow512(.51+.49*sin((.02*(uv.y+.5*uv.x)-jTime)*2.))):0.;
 return (a>0.?a*pow1d5(hash21(uv))*w:0.);
}
float edgeMin(float dx,vec2 da,vec2 db,vec2 uv){
 uv.x+=5.;
 vec3 c=fract((round(vec3(uv,uv.x+uv.y)))*(vec3(0,1,2)+0.61803398875));
 float a1=1.,a2=1.,a3=1.;
 return min(min((1.-dx)*db.y*a3,da.x*a2),da.y*a1);
}
vec2 trinoise(vec2 uv){
 const float sq=sqrt(3./2.);
 uv.x*=sq;uv.y-=.5*uv.x;
 vec2 d=fract(uv);uv-=d;
 bool c=dot(d,vec2(1.))>1.;
 vec2 dd=1.-d;
 vec2 da=c?dd:d,db=c?d:dd;
 float nn=hash(uv+float(c));
 float n2=hash(uv+vec2(1.,0.));
 float n3=hash(uv+vec2(0.,1.));
 float nmid=mix(n2,n3,d.y);
 float ns=mix(nn,c?n2:n3,da.y);
 float dx=da.x/db.y;
 return vec2(mix(ns,nmid,dx),edgeMin(dx,da,db,uv+d));
}
vec2 map(vec3 p){vec2 n=trinoise(p.xz);return vec2(p.y-2.*n.x,n.y);}
vec3 grad(vec3 p){
 const vec2 e=vec2(.005,0.);
 float a=map(p).x;
 return vec3(map(p+e.xyy).x-a,map(p+e.yxy).x-a,map(p+e.yyx).x-a)/e.x;
}
vec2 intersect(vec3 ro,vec3 rd){
 float d=0.,h=0.;
 for(int i=0;i<300;i++){
  vec3 p=ro+d*rd;
  vec2 s=map(p);
  h=s.x;d+=h*.5;
  if(abs(h)<.003*d)return vec2(d,s.y);
  if(d>150.||p.y>2.)break;
 }
 return vec2(-1.);
}
void addsun(vec3 rd,vec3 ld,inout vec3 col){
 float sun=smoothstep(.21,.2,distance(rd,ld));
 if(sun>0.){
  float yd=(rd.y-ld.y);
  float a=sin(3.1*exp(-yd*14.));
  sun*=smoothstep(-.8,0.,a);
  col=mix(col,vec3(1.,.8,.4)*.75,sun);
 }
}
float starnoise(vec3 rd){
 float c=0.;
 vec3 p=normalize(rd)*300.;
 for(float i=0.;i<4.;i++){
  vec3 q=fract(p)-.5;
  vec3 id=floor(p);
  float c2=smoothstep(.5,0.,length(q));
  c2*=step(hash21(id.xz/id.y),.06-i*i*.005);
  c+=c2;
  p=p*.6+.5*p*mat3(3./5.,0.,4./5.,0.,1.,0.,-4./5.,0.,3./5.);
 }
 c*=c;
 float g=dot(sin(rd*10.512),cos(rd.yzx*10.512));
 c*=smoothstep(-3.14,-.9,g)*.5+.5*smoothstep(-.3,1.,g);
 return c*c;
}
vec3 gsky(vec3 rd,vec3 ld,bool mask){
 float haze=exp2(-5.*(abs(rd.y)-.2*dot(rd,ld)));
 float st=mask?(starnoise(rd))*(1.-min(haze,1.)):0.;
 vec3 back=vec3(.4,.1,.7);
 vec3 col=clamp(mix(back,vec3(.7,.1,.4),haze)+st,0.,1.);
 if(mask)addsun(rd,ld,col);
 return col;
}
void mainImage(out vec4 fragColor,in vec2 fragCoord){
 fragColor=vec4(0.);
 vec2 uv=(2.*fragCoord-iResolution.xy)/iResolution.y;
 const float shutter_speed=.25;
 float dt=fract(hash21(fragCoord)+iTime)*shutter_speed;
 jTime=mod(iTime-dt*iTimeDelta,4000.);
 vec3 ro=vec3(uSteer*4.,1.,(-20000.+jTime*speed));
 vec3 rd=normalize(vec3(uv,4./3.));
 vec2 i=intersect(ro,rd);
 float d=i.x;
 vec3 ld=normalize(vec3(0.,.125+.05*sin(.1*jTime),1.));
 vec3 fog=d>0.?exp2(-d*vec3(.14,.1,.28)):vec3(0.);
 vec3 sky=gsky(rd,ld,d<0.);
 vec3 p=ro+d*rd;
 vec3 n=normalize(grad(p));
 float diff=dot(n,ld)+.1*n.y;
 vec3 col=vec3(.1,.11,.18)*diff;
 vec3 rfd=reflect(rd,n);
 vec3 rfcol=gsky(rfd,ld,true);
 col=mix(col,rfcol,.05+.95*pow(max(1.+dot(rd,n),0.),5.));
 col=mix(col,vec3(.8,.1,.92),smoothstep(.05,.0,i.y));
 col=mix(sky,col,fog);
 if(d<0.)d=1e6;
 d=min(d,10.);
 fragColor+=vec4(clamp(col,0.,1.),d<0.?0.:.1+exp2(-d));
 fragColor.a=1.;
 if(uCrashFlash>0.)fragColor.rgb=mix(fragColor.rgb,vec3(1.,.2,.3),uCrashFlash*.6);
}
void main(){
 vec4 fc=vec4(0.);
 mainImage(fc,gl_FragCoord.xy);
 gl_FragColor=fc;
}`;
let GLOK=false,gl=null,glU={};
function glInit(){
 try{
  const glc=document.getElementById('gl');glc.width=W;glc.height=H;
  const gc=glc.getContext('webgl',{antialias:false});
  if(!gc)throw new Error('no webgl');
  const vs=gc.createShader(gc.VERTEX_SHADER);
  gc.shaderSource(vs,'attribute vec2 aP;void main(){gl_Position=vec4(aP,0.,1.);}');gc.compileShader(vs);
  const fs=gc.createShader(gc.FRAGMENT_SHADER);
  gc.shaderSource(fs,FS_SRC);gc.compileShader(fs);
  if(!gc.getShaderParameter(fs,gc.COMPILE_STATUS))throw new Error('fs: '+gc.getShaderInfoLog(fs));
  const pr=gc.createProgram();gc.attachShader(pr,vs);gc.attachShader(pr,fs);gc.linkProgram(pr);gc.useProgram(pr);
  const buf=gc.createBuffer();gc.bindBuffer(gc.ARRAY_BUFFER,buf);
  gc.bufferData(gc.ARRAY_BUFFER,new Float32Array([-1,-1,3,-1,-1,3]),gc.STATIC_DRAW);
  const loc=gc.getAttribLocation(pr,'aP');gc.enableVertexAttribArray(loc);gc.vertexAttribPointer(loc,2,gc.FLOAT,false,0,0);
  const tex=gc.createTexture();gc.bindTexture(gc.TEXTURE_2D,tex);
  gc.texImage2D(gc.TEXTURE_2D,0,gc.RGBA,1,1,0,gc.RGBA,gc.UNSIGNED_BYTE,new Uint8Array([0,0,0,255]));
  glU={res:gc.getUniformLocation(pr,'iResolution'),time:gc.getUniformLocation(pr,'iTime'),dt:gc.getUniformLocation(pr,'iTimeDelta'),steer:gc.getUniformLocation(pr,'uSteer'),speed:gc.getUniformLocation(pr,'uSpeed'),crash:gc.getUniformLocation(pr,'uCrashFlash')};
  gl=gc;GLOK=true;
 }catch(e){GLOK=false;}
}
glInit();
function glDraw(){
 if(!GLOK)return;
 gl.viewport(0,0,W,H);
 gl.uniform2f(glU.res,W,H);
 gl.uniform1f(glU.time,T);
 gl.uniform1f(glU.dt,0.016);
 gl.uniform1f(glU.steer,player?(player.x/WW-0.5)*1.6:0);
 gl.uniform1f(glU.speed,3+diffLevel*0.8+(player?Math.abs(player.vx)/70:0));
 gl.uniform1f(glU.crash,player&&player.flash>0?player.flash*3:0);
 gl.drawArrays(gl.TRIANGLES,0,3);
}

// ---- Geometry Wars warp grid (spring field: explosions bend it, anchors recall it) ----
const GRID_SP=60, GRID_C=Math.ceil(2400/GRID_SP)+1, GRID_R=Math.ceil(540/GRID_SP)+1;
let grid=[];
function gridInit(){
 grid=[];
 for(let r=0;r<GRID_R;r++)for(let c=0;c<GRID_C;c++)
  grid.push({ox:c*GRID_SP,oy:r*GRID_SP,x:c*GRID_SP,y:r*GRID_SP,vx:0,vy:0});
}
function gridForce(px,py,rad,pow){
 for(const p of grid){
  let dx=p.x-px,dy=p.y-py,d2=dx*dx+dy*dy;
  if(d2<rad*rad&&d2>1){let d=Math.sqrt(d2),f=pow*(1-d/rad)/d;p.vx+=dx*f;p.vy+=dy*f;}
 }
}
function gridUpdate(dt){
 for(const p of grid){
  p.vx+=(p.ox-p.x)*14*dt;p.vy+=(p.oy-p.y)*14*dt;
  p.vx*=Math.pow(0.12,dt);p.vy*=Math.pow(0.12,dt);
  p.x+=p.vx*dt;p.y+=p.vy*dt;
 }
}
function gridDraw(){
 if(!grid.length)return;
 ctx.strokeStyle='#1e3a5f';ctx.lineWidth=1;ctx.beginPath();
 for(let r=0;r<GRID_R;r++)for(let c=0;c<GRID_C;c++){
  let p=grid[r*GRID_C+c];
  if(p.x<camX-GRID_SP||p.x>camX+W+GRID_SP)continue;
  if(c<GRID_C-1){let q=grid[r*GRID_C+c+1];let d=Math.abs(p.x-p.ox)+Math.abs(p.y-p.oy);
   ctx.strokeStyle=d>3?'rgba(80,180,255,'+Math.min(0.9,0.25+d/40)+')':'rgba(30,58,95,'+(0.7+beatPulse*0.5)+')';
   ctx.moveTo(p.x,p.y);ctx.lineTo(q.x,q.y);}
  if(r<GRID_R-1){let q=grid[(r+1)*GRID_C+c];let d=Math.abs(p.x-p.ox)+Math.abs(p.y-p.oy);
   ctx.strokeStyle=d>3?'rgba(80,180,255,'+Math.min(0.9,0.25+d/40)+')':'rgba(30,58,95,'+(0.7+beatPulse*0.5)+')';
   ctx.moveTo(p.x,p.y);ctx.lineTo(q.x,q.y);}
 }
 ctx.stroke();
}

function startGame(){
 state='play';T=0;kills=0;diffLevel=0;nextDiff=30;spawnT=0.4;
 disco();if(!bgm)startBgm();
 upg={dmg:(1+0.1*(meta.tiers.dmg||0))*(upg.dmgMul||1),rate:1,pierce:0,spread:1,speed:(1+0.06*(meta.tiers.spd||0))*(upg.spdMul||1),maxhp:100+(meta.tiers.hp||0)*20,magnet:(60+(meta.tiers.mag||0)*15),orbit:0,orbitAng:0};
 enemies=[];gems=[];projs=[];parts=[];dmgNums=[];shake=0;toast=null;toastT=0;
 player={x:200,y:GY-30,w:20,h:30,vx:0,vy:0,hp:upg.maxhp,onGround:false,coyote:0,atkT:0,flash:0,face:1};
 platforms=[{x:400,y:340,w:160,h:14},{x:900,y:280,w:180,h:14},{x:1500,y:350,w:200,h:14},{x:2000,y:300,w:160,h:14}];
 if(!grid.length)gridInit();
 // onboarding: contact inside five seconds, announced
 spawnEnemy(player.x+190);spawnEnemy(player.x-230);
 toast='they come from both sides — your knives never stop';toastT=3.5;
}

function spawnEnemy(forcedX){
 if(enemies.length>=120)return;
 let side=Math.random()<0.5?-1:1;
 let ex=forcedX!==undefined?forcedX:(side<0?camX-40:camX+W+40);
 let r=Math.random();
 let type=r<0.45?'walker':r<0.8?'runner':'flyer';
 let hpMul=1+T/40;
 let e={x:ex,y:GY-30,w:22,h:28,vy:0,type,flash:0,hitT:0};
 if(type==='walker'){e.hp=8*hpMul;e.spd=40;e.dmg=12;e.w=26;e.h=32;}
 if(type==='runner'){e.hp=4*hpMul;e.spd=110;e.dmg=8;e.w=18;e.h=24;}
 if(type==='flyer'){e.hp=5*hpMul;e.spd=70;e.dmg=10;e.w=22;e.h=18;e.baseY=200+Math.random()*180;e.y=e.baseY;e.ph=Math.random()*6.28;}
 enemies.push(e);
}

function damageEnemy(e,dmg,px,py){
 e.hp-=dmg;e.flash=0.12;
 gridForce(px===undefined?e.x:px,py===undefined?e.y:py,50,140);
 dmgNums.push({x:e.x,y:e.y-10,t:0.7,v:Math.ceil(dmg)});
 for(let i=0;i<4;i++)parts.push({x:e.x+w2(e),y:e.y,vx:(Math.random()-0.5)*100,vy:-Math.random()*100,t:0.4,col:'#f66'});
 if(e.hp<=0){
  e.dead=true;kills++;
  gridForce(e.x,e.y,110,320);
  for(let i=0;i<8;i++)parts.push({x:e.x,y:e.y,vx:(Math.random()-0.5)*260,vy:-Math.random()*260,t:0.6,col:'#f44'});
  let nG=e.isBoss?16:1;
  for(let k=0;k<nG;k++)if(gems.length<200)gems.push({x:e.x+rnd(-30,30),y:e.y+rnd(-20,10),vx:0,vy:0,t:0});
  if(e.isBoss){toast='THE HERALD FALLS — take its light';toastT=4;gridForce(e.x,e.y,260,700);}
 }
}
function w2(e){return e.w/2;}

function pickUp(i){
 if(i<0||i>=levelCards.length)return;
 levelCards[i].f();
 state='play';levelCards=[];
}
function levelUp(){
 state='levelup';
 let pool=upgPool.slice();
 gridForce(player.x,player.y,180,420);
 levelCards=[];
 for(let i=0;i<3&&pool.length;i++){
  let j=Math.floor(Math.random()*pool.length);
  levelCards.push(pool[j]);pool.splice(j,1);
 }
 shake=8;
}

function update(dt){
 if(state!=='play')return;
 T+=dt;
 if(T>=nextDiff){nextDiff+=30;diffLevel++;toast='the night deepens';toastT=2.5;}
 if(toastT>0)toastT-=dt;

 // player
 let spd=200*upg.speed;
 if(keys['a']||keys['arrowleft'])player.vx=-spd;
 else if(keys['d']||keys['arrowright'])player.vx=spd;
 else player.vx*=0.7;
 if(keys['w']||keys[' ']||keys['arrowup']){
  if(player.onGround||player.coyote>0){player.vy=-400;player.onGround=false;player.coyote=0;}
 }
 if(player.onGround)player.coyote=0.1;else player.coyote-=dt;
 player.vy+=900*dt;
 player.x+=player.vx*dt;player.y+=player.vy*dt;
 player.x=Math.max(20,Math.min(WW-20,player.x));
 // ground
 if(player.y+player.h/2>=GY){player.y=GY-player.h/2;player.vy=0;player.onGround=true;}
 else player.onGround=false;
 // platforms
 player.onGround=false;
 if(player.y+player.h/2>=GY){player.y=GY-player.h/2;player.vy=0;player.onGround=true;}
 for(let p of platforms){
  if(player.x+player.w/2>p.x&&player.x-player.w/2<p.x+p.w&&player.vy>=0&&player.y+player.h/2>p.y&&player.y+player.h/2<p.y+30){
   player.y=p.y-player.h/2;player.vy=0;player.onGround=true;
  }
 }

 // auto attack
 player.atkT-=dt;
 if(player.atkT<=0){
  let best=null,bd=1e9;
  for(let e of enemies){if(e.dead)continue;let d=Math.abs(e.x-player.x)+Math.abs(e.y-player.y);if(d<bd){bd=d;best=e;}}
  if(best&&bd<500){
   player.atkT=0.5/upg.rate;
   let baseAng=Math.atan2(best.y-player.y,best.x-player.x);
   for(let i=0;i<upg.spread;i++){
    let a=baseAng+(i-(upg.spread-1)/2)*0.18;
    if(projs.length<80)projs.push({x:player.x,y:player.y,vx:Math.cos(a)*420,vy:Math.sin(a)*420,dmg:6*upg.dmg,pierce:upg.pierce,hit:[],t:1.5});
   }
  }
 }

 // orbit blades
 if(upg.orbit>0){
  upg.orbitAng+=dt*4;
  for(let i=0;i<upg.orbit;i++){
   let a=upg.orbitAng+i*(6.28/upg.orbit);
   let bx=player.x+Math.cos(a)*55,by=player.y+Math.sin(a)*55;
   for(let e of enemies){
    if(e.dead)continue;
    if(Math.abs(bx-e.x)<20+e.w/2&&Math.abs(by-e.y)<20+e.h/2){
     e.hitT-=dt;
     if(e.hitT<=0){e.hitT=0.3;damageEnemy(e,4*upg.dmg,bx,by);}
    }
   }
   parts.push({x:bx,y:by,vx:0,vy:0,t:0.1,col:'#8ff'});
  }
 }

 // enemies
 for(let e of enemies){
  if(e.dead)continue;
  e.flash=Math.max(0,e.flash-dt);
  let dx=player.x-e.x;
  if(e.type==='flyer'){
   e.x+=Math.sign(dx)*e.spd*dt;
   e.y=e.baseY+Math.sin(T*3+e.ph)*40;
  } else {
   e.x+=Math.sign(dx)*e.spd*dt;
   e.vy+=900*dt;e.y+=e.vy*dt;
   if(e.y+e.h/2>=GY){e.y=GY-e.h/2;e.vy=0;}
   for(let p of platforms){
    if(e.x+e.w/2>p.x&&e.x-e.w/2<p.x+p.w&&e.vy>=0&&e.y+e.h/2>p.y&&e.y+e.h/2<p.y+30){
     e.y=p.y-e.h/2;e.vy=0;
    }
   }
  }
  // contact damage
  if(Math.abs(e.x-player.x)<(e.w/2+player.w/2)&&Math.abs(e.y-player.y)<(e.h/2+player.h/2)){
   gridForce(player.x,player.y,70,90);
   player.hp-=e.dmg*dt*2;player.flash=0.15;
   if(player.hp<=0&&state==='play'){
    state='dead';
    meta.bank+=player.souls;metaSave();
    if(T>best){best=T;localStorage.setItem('swarmbest',best);}
   }
  }
 }

 // projectiles
 for(let p of projs){
  p.x+=p.vx*dt;p.y+=p.vy*dt;p.t-=dt;
  if(p.t<=0)p.dead=true;
  for(let e of enemies){
   if(e.dead||p.hit.includes(e))continue;
   if(Math.abs(p.x-e.x)<e.w/2+6&&Math.abs(p.y-e.y)<e.h/2+6){
    damageEnemy(e,p.dmg,p.x,p.y);
    p.hit.push(e);
    if(p.hit.length>p.pierce){p.dead=true;break;}
   }
  }
 }

 // gems
 for(let g of gems){
  let dx=player.x-g.x,dy=player.y-g.y,d=Math.hypot(dx,dy);
  if(d<upg.magnet){g.vx+=dx/d*400*dt;g.vy+=dy/d*400*dt;}
  g.vx*=0.95;g.vy*=0.95;
  g.x+=g.vx*dt;g.y+=g.vy*dt;
  g.vy+=200*dt;
  if(g.y>GY-5){g.y=GY-5;g.vy=0;}
  if(d<20){g.dead=true;player.hp=Math.min(upg.maxhp,player.hp+0);
   // xp
   player.xp=(player.xp||0)+1;
   if(player.xp>=10){player.xp=0;levelUp();}
  }
 }

 // particles
 for(let p of parts){p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=300*dt;p.t-=dt;if(p.t<=0)p.dead=true;}
 for(let d of dmgNums){d.t-=dt;d.y-=30*dt;if(d.t<=0)d.dead=true;}

 // the HERALD — the run's story: at five minutes, something with a name comes
 if(T>=300&&!spawnBoss.__done){
  spawnBoss.__done=true;
  let hb={x:player.x+(player.x<WW/2?420:-420),y:GY-60,w:56,h:70,vy:0,type:'herald',flash:0,hitT:0,
   hp:400*(1+T/120),maxHp:400*(1+T/120),spd:55,dmg:25,color:'#ff4a6a',isBoss:true,baseY:GY-60,ph:0};
  enemies.push(hb);
  toast='THE HERALD COMES';toastT=4;shake=14;
  beep(90,0.6,'sawtooth',0.07);
 }
 // spawn
 spawnT-=dt;
 if(spawnT<=0){
  spawnT=Math.max(0.15,0.9-diffLevel*0.1);
  let n=1+Math.floor(diffLevel/2);
  for(let i=0;i<n;i++)spawnEnemy();
 }
 // the Horse comes thundering past, now and then
 horseT-=dt;
 if(horseT<=0&&!horse){horse={x:camX-180,spd:240+Math.random()*140,t:Math.random()*6};horseT=34+Math.random()*22;}

 // camera
 let targetX=player.x-W/2;
 camX+=(targetX-camX)*Math.min(1,dt*5);
 camX=Math.max(0,Math.min(WW-W,camX));
 shake*=0.9;
 gridUpdate(dt);

 // cleanup
 enemies=enemies.filter(e=>!e.dead);
 gems=gems.filter(g=>!g.dead);
 projs=projs.filter(p=>!p.dead);
 parts=parts.filter(p=>!p.dead);
 dmgNums=dmgNums.filter(d=>!d.dead);
}

function draw(){
 glDraw();
 if(GLOK){ctx.clearRect(0,0,W,H);}
 else{ctx.fillStyle='#0b0d10';ctx.fillRect(0,0,W,H);}
 let sx=(Math.random()-0.5)*shake,sy=(Math.random()-0.5)*shake;
 ctx.save();ctx.translate(-camX+sx,sy);

 // sky: 2D fallback only when WebGL is unavailable (the shader owns the sky otherwise)
 if(!GLOK){
  let sky=ctx.createLinearGradient(0,0,0,H);
  sky.addColorStop(0,'#0a0618');sky.addColorStop(0.45,'#2a0f3a');sky.addColorStop(0.75,'#6a1f4a');sky.addColorStop(1,'#c4502a');
  ctx.fillStyle=sky;ctx.fillRect(0,0,W,H);
  let sunX=W*0.5,sunY=GY-40-((camX*0.04)%8),sunR=108+beatPulse*14;
  ctx.save();ctx.beginPath();ctx.rect(0,0,W,GY-6);ctx.clip();
  let sg=ctx.createLinearGradient(0,sunY-sunR,0,sunY+sunR);
  sg.addColorStop(0,'#ffe89a');sg.addColorStop(0.5,'#ff9a4a');sg.addColorStop(1,'#ff4a6a');
  ctx.fillStyle=sg;ctx.beginPath();ctx.arc(sunX,sunY,sunR,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#2a0f3a';
  for(let i=0;i<7;i++){let by=sunY+8+i*13;ctx.fillRect(sunX-sunR,by,sunR*2,3+i*0.7);}
  ctx.restore();
  for(let l=0;l<2;l++){
   let par=l===0?0.25:0.5,col=l===0?'#241035':'#180a26';
   ctx.fillStyle=col;ctx.beginPath();ctx.moveTo(0,H);
   let off=camX*par;
   for(let x=0;x<=W;x+=24){
    let wx=x+off;
    let hgt=(l===0?70:110)+beatPulse*10+Math.sin(wx*0.008+l*2)*38+Math.sin(wx*0.021+l)*22+Math.sin(wx*0.0043)*30;
    ctx.lineTo(x,GY-6-hgt);
   }
   ctx.lineTo(W,H);ctx.closePath();ctx.fill();
  }
  // the Horse (viz_horse_run DNA: rotary gallop, luminous lines) — comes thundering past
  if(horse){
   horse.t+=0.016;horse.x+=horse.spd*0.016;
   if(horse.x>camX+W+160)horse=null;
   else{
    let p=(horse.t*9)%(Math.PI*2),bob=Math.sin(2*p)*2.5,hy=GY-26+bob;
    ctx.strokeStyle='rgba(140,200,255,0.75)';ctx.lineWidth=2;ctx.lineCap='round';
    ctx.beginPath();ctx.moveTo(horse.x-26,hy);ctx.lineTo(horse.x+24,hy-3);ctx.stroke();
    ctx.beginPath();ctx.moveTo(horse.x+24,hy-3);ctx.lineTo(horse.x+34,hy-16);ctx.lineTo(horse.x+44,hy-13);ctx.stroke();
    ctx.beginPath();ctx.moveTo(horse.x-26,hy);ctx.lineTo(horse.x-34,hy-10+Math.sin(p)*2);ctx.stroke();
    let legOff=[0,Math.PI,Math.PI*0.5,Math.PI*1.5];
    for(let li=0;li<4;li++){
     let lx=horse.x-20+li*14,a=Math.sin(p+legOff[li])*0.7;
     let kx=lx+Math.sin(a)*10,ky=hy+12,kx2=kx+Math.sin(a*0.5)*10,ky2=ky+12;
     ctx.beginPath();ctx.moveTo(lx,hy);ctx.lineTo(kx,ky);ctx.lineTo(kx2,ky2);ctx.stroke();
    }
   }
  }
 } else {
  // the Horse rides in the shader world too
  if(horse){
   horse.t+=0.016;horse.x+=horse.spd*0.016;
   if(horse.x>camX+W+160)horse=null;
   else{
    let p=(horse.t*9)%(Math.PI*2),bob=Math.sin(2*p)*2.5,hy=GY-26+bob;
    ctx.strokeStyle='rgba(140,200,255,0.75)';ctx.lineWidth=2;ctx.lineCap='round';
    ctx.beginPath();ctx.moveTo(horse.x-26,hy);ctx.lineTo(horse.x+24,hy-3);ctx.stroke();
    ctx.beginPath();ctx.moveTo(horse.x+24,hy-3);ctx.lineTo(horse.x+34,hy-16);ctx.lineTo(horse.x+44,hy-13);ctx.stroke();
    let legOff=[0,Math.PI,Math.PI*0.5,Math.PI*1.5];
    for(let li=0;li<4;li++){
     let lx=horse.x-20+li*14,a=Math.sin(p+legOff[li])*0.7;
     ctx.beginPath();ctx.moveTo(lx,hy);ctx.lineTo(lx+Math.sin(a)*10,hy+24);ctx.stroke();
    }
   }
  }
 }
 // ground
 ctx.fillStyle='#101a14';ctx.fillRect(0,GY,WW,H-GY);
 ctx.strokeStyle='#2f6a3f';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(0,GY);ctx.lineTo(WW,GY);ctx.stroke();
 // platforms
 ctx.strokeStyle='#3a5a7a';ctx.lineWidth=2;
 for(let p of platforms){ctx.strokeRect(p.x,p.y,p.w,p.h);}
 // the warp grid (Geometry Wars DNA: the field remembers every explosion)
 gridDraw();

 // ---- neon pass (additive glow: everything burns brighter on the grid) ----
 ctx.globalCompositeOperation='lighter';

 // gems
 for(let g of gems){
  ctx.save();ctx.translate(g.x,g.y);ctx.rotate(0.785);
  ctx.fillStyle='rgba(80,255,120,0.25)';ctx.fillRect(-7,-7,14,14);
  ctx.fillStyle='#4f4';ctx.fillRect(-4,-4,8,8);
  ctx.restore();
 }

 // enemies as geometric shapes (GW DNA: each species owns a polygon)
 for(let e of enemies){
  let col=e.flash>0?'#ffffff':(e.isBoss?'#ff4a6a':e.type==='walker'?'#ff5566':e.type==='runner'?'#ff8866':'#cc66ff');
  ctx.strokeStyle=col;ctx.lineWidth=e.isBoss?3:2;
  ctx.save();ctx.translate(e.x,e.y);
  if(e.isBoss){
   ctx.rotate(Math.sin(T*2)*0.15);
   ctx.strokeRect(-e.w/2,-e.h/2,e.w,e.h);
   ctx.rotate(Math.PI/4);ctx.strokeRect(-e.w/2-4,-e.h/2-4,e.w+8,e.h+8);
  }
  else if(e.type==='walker'){ctx.rotate(Math.PI/4);ctx.strokeRect(-e.w/2,-e.w/2,e.w,e.w);}
  else if(e.type==='runner'){
   ctx.beginPath();ctx.moveTo(-Math.sign(player.x-e.x)*e.w/2,-e.h/2);
   ctx.lineTo(-Math.sign(player.x-e.x)*e.w/2,e.h/2);ctx.lineTo(Math.sign(player.x-e.x)*e.w/2,0);
   ctx.closePath();ctx.stroke();
  } else {
   ctx.rotate(T*2+e.ph);ctx.strokeRect(-e.w/2,-e.h/2,e.w,e.h);
   ctx.rotate(Math.PI/4);ctx.strokeRect(-e.w/2,-e.h/2,e.w,e.h);
  }
  ctx.restore();
 }

 // orbit blades
 if(upg.orbit>0){
  ctx.strokeStyle='#88ffff';ctx.lineWidth=2;
  for(let i=0;i<upg.orbit;i++){
   let a=upg.orbitAng+i*(6.28/upg.orbit);
   let bx=player.x+Math.cos(a)*55,by=player.y+Math.sin(a)*55;
   ctx.save();ctx.translate(bx,by);ctx.rotate(a*3);
   ctx.beginPath();ctx.moveTo(-9,0);ctx.lineTo(9,0);ctx.stroke();
   ctx.beginPath();ctx.moveTo(0,-4);ctx.lineTo(0,4);ctx.stroke();
   ctx.restore();
  }
 }

 // projectiles
 ctx.strokeStyle='#ffee88';ctx.lineWidth=2;
 for(let p of projs){
  ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(p.x-p.vx*0.03,p.y-p.vy*0.03);ctx.stroke();
 }

 // little skateboarding person (the deck remembers everything)
 let pcol=player.flash>0?'#ffffff':'#66ccff';
 ctx.strokeStyle=pcol;ctx.lineWidth=2;ctx.lineCap='round';
 const fy=player.y+15;
 ctx.beginPath();
 ctx.moveTo(player.x-13,fy-1);ctx.lineTo(player.x-9,fy-4);ctx.lineTo(player.x+9,fy-4);ctx.lineTo(player.x+13,fy-1);
 ctx.stroke();
 ctx.beginPath();ctx.arc(player.x-8,fy+2,2.6,0,6.28);ctx.stroke();
 ctx.beginPath();ctx.arc(player.x+8,fy+2,2.6,0,6.28);ctx.stroke();
 const air=player.onGround===false;
 const lean=player.face*4,hipY=fy-13-(air?3:0),shY=fy-23-(air?6:0);
 ctx.beginPath();
 ctx.moveTo(player.x-6,fy-4);ctx.lineTo(player.x-2,hipY);ctx.lineTo(player.x+3,fy-4);
 ctx.stroke();
 ctx.beginPath();ctx.moveTo(player.x-2,hipY);ctx.lineTo(player.x+lean,shY);ctx.stroke();
 ctx.beginPath();
 ctx.moveTo(player.x+lean,shY);ctx.lineTo(player.x-10,shY+3);
 ctx.moveTo(player.x+lean,shY);ctx.lineTo(player.x+10*player.face,shY-3);
 ctx.stroke();
 ctx.beginPath();ctx.arc(player.x+lean+2,shY-6,4,0,6.28);ctx.stroke();
 ctx.strokeStyle='rgba(102,204,255,0.25)';ctx.lineWidth=6;
 ctx.beginPath();ctx.moveTo(player.x-13,fy-2);ctx.lineTo(player.x+13,fy-2);ctx.stroke();
 ctx.lineWidth=2;

 // particles as line sparks
 ctx.lineWidth=1.5;
 for(let p of parts){ctx.globalAlpha=Math.max(0,p.t*2);ctx.strokeStyle=p.col;
  ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(p.x-p.vx*0.035,p.y-p.vy*0.035);ctx.stroke();}
 ctx.globalAlpha=1;
 ctx.globalCompositeOperation='source-over';

 // damage numbers
 ctx.font='bold 12px monospace';ctx.textAlign='center';
 for(let d of dmgNums){ctx.globalAlpha=Math.max(0,d.t);ctx.fillStyle='#ff8';ctx.fillText(d.v,d.x,d.y);}
 ctx.globalAlpha=1;

 ctx.restore();

 // HUD
 ctx.fillStyle='rgba(0,0,0,0.5)';ctx.fillRect(0,0,W,40);
 ctx.font='bold 28px monospace';ctx.textAlign='center';ctx.fillStyle='#fff';
 ctx.fillText(T.toFixed(1),W/2,30);
 ctx.font='12px monospace';ctx.textAlign='left';ctx.fillStyle='#aaa';
 ctx.fillText('KILLS: '+kills,10,20);
 ctx.fillText('LVL: '+diffLevel,10,34);
 // hp bar
 ctx.fillStyle='#333';ctx.fillRect(10,46,200,14);
 ctx.fillStyle='#4a4';ctx.fillRect(10,46,200*Math.max(0,player.hp/upg.maxhp),14);
 ctx.fillStyle='#fff';ctx.font='10px monospace';ctx.fillText(Math.ceil(player.hp)+'/'+upg.maxhp,12,57);
 // xp bar
 ctx.fillStyle='#333';ctx.fillRect(W-210,46,200,14);
 ctx.fillStyle='#4af';ctx.fillRect(W-210,46,200*((player.xp||0)/10),14);

 // toast
 if(toastT>0){
  ctx.globalAlpha=Math.min(1,toastT);
  ctx.fillStyle='#ff8';ctx.font='bold 18px monospace';ctx.textAlign='center';
  ctx.fillText(toast,W/2,80);ctx.globalAlpha=1;
 }

 if(state==='title'){
  ctx.fillStyle='rgba(0,0,0,0.7)';ctx.fillRect(0,0,W,H);
  ctx.fillStyle='#f44';ctx.font='bold 60px monospace';ctx.textAlign='center';
  ctx.fillText('PRIVLIDGE',W/2,H/2-60);
  ctx.fillStyle='#fff';ctx.font='16px monospace';
  ctx.fillText('a disco science skate — move with A/D, everything else is automatic',W/2,H/2);
  ctx.fillText('press any key',W/2,H/2+40);
  if(best>0)ctx.fillText('best: '+best.toFixed(1)+'s',W/2,H/2+80);
 }
 if(state==='dead'){
  ctx.fillStyle='rgba(0,0,0,0.8)';ctx.fillRect(0,0,W,H);
  ctx.fillStyle='#f44';ctx.font='bold 40px monospace';ctx.textAlign='center';
  ctx.fillText('YOU DIED',W/2,H/2-80);
  ctx.fillStyle='#fff';ctx.font='20px monospace';
  ctx.fillText('survived: '+T.toFixed(1)+'s',W/2,H/2-20);
  ctx.fillText('kills: '+kills,W/2,H/2+20);
  ctx.fillStyle='#fc8';ctx.font='16px monospace';
  ctx.fillText(meta.bank+' souls at the bonfire — spend: press 1-4',W/2,H/2+60);
  ctx.font='13px monospace';
  for(let i=0;i<METASHOP.length;i++){
   const shop=METASHOP[i],tier=meta.tiers[shop.k]||0,c=shop.cost(tier);
   const can=meta.bank>=c;
   ctx.fillStyle=can?'#8fc79a':'#555';
   ctx.fillText((i+1)+'. '+shop.n+' lv'+tier+' — '+c+' souls · '+shop.d,W/2,H/2+85+i*18);
  }
  ctx.font='16px monospace';ctx.fillStyle='#aaa';
  ctx.fillText('press any key to ride again',W/2,H/2+115);
 }
 if(state==='levelup'){
  ctx.fillStyle='rgba(0,0,0,0.75)';ctx.fillRect(0,0,W,H);
  ctx.fillStyle='#ff8';ctx.font='bold 30px monospace';ctx.textAlign='center';
  ctx.fillText('LEVEL UP!',W/2,80);
  for(let i=0;i<levelCards.length;i++){
   let cx=W/6+i*W/3,cy=H/2-40;
   ctx.fillStyle='#1a2a3a';ctx.fillRect(cx-120,cy-80,240,180);
   ctx.strokeStyle='#4af';ctx.lineWidth=2;ctx.strokeRect(cx-120,cy-80,240,180);
   ctx.fillStyle='#fff';ctx.font='bold 18px monospace';
   ctx.fillText(levelCards[i].n,cx,cy-30);
   ctx.font='13px monospace';ctx.fillStyle='#aaa';
   ctx.fillText(levelCards[i].d,cx,cy+10);
   ctx.fillStyle='#4af';ctx.font='bold 24px monospace';
   ctx.fillText((i+1),cx,cy+70);
  }
 }
}

function loop(ts){
 let dt=Math.min(0.05,(ts-last)/1000||0);last=ts;
 update(dt);beatRead();draw();
 requestAnimationFrame(loop);
}
player={x:200,y:GY-30,w:20,h:30,vx:0,vy:0,hp:100,onGround:false,coyote:0,atkT:0,flash:0,face:1,xp:0}