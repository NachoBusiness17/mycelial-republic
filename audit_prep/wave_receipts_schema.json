{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mag.wave_receipt.v1",
  "type": "object",
  "required": ["schema","ts","wave_width","lane_id","goal","resolved_stack","timeout_s","max_tokens","temperature","lane_hash","verifier_pass"],
  "properties": {
    "schema": {"type":"string","const":"mag.wave_receipt.v1"},
    "ts": {"type":"string","format":"date-time"},
    "wave_id": {"type":"string"},
    "wave_width": {"type":"integer","minimum":1},
    "lane_id": {"type":"string"},
    "goal": {"type":"string"},
    "resolved_stack": {"type":"string"},
    "timeout_s": {"type":"number","minimum":0},
    "max_tokens": {"type":"integer","minimum":0},
    "temperature": {"type":"number"},
    "lane_hash": {"type":"string"},
    "signature": {"type":"string"},
    "verifier_pass": {"type":"boolean"},
    "notes": {"type":"string"}
  },
  "additionalProperties": false
}
