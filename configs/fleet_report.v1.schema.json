{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mag://schema/fleet_report.v1",
  "title": "fleet_report.v1",
  "description": "SALUTE-style fleet report filed through estate_bridge.shared_receipt_append (watch/receipts/). Doctrine: watch/LIBRARY/FLEET_COORDINATION_DOCTRINE_20261017.md P8. The stdlib validator in mag/fleet_report.py enforces this schema; tests/test_fleet_coordination.py keeps the two in step. String fields reject secret-shaped values (names only, never values).",
  "type": "object",
  "required": ["schema", "kind", "dtg", "seat"],
  "properties": {
    "schema": {"const": "fleet_report.v1"},
    "kind": {"enum": ["SPOTREP", "SITREP", "NOTICE", "RELIEF", "ACK"]},
    "dtg": {"type": "string", "format": "date-time", "description": "report time, ISO 8601 UTC"},
    "seat": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,31}$"},
    "model": {"type": "string", "maxLength": 128},
    "lane": {"type": "string", "maxLength": 64},
    "cop_sha": {"type": "string", "maxLength": 64},
    "leases": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 200}},
    "narrative": {"type": "string", "maxLength": 4000},
    "size": {"type": "string", "maxLength": 400},
    "activity": {"type": "string", "maxLength": 400},
    "location": {"type": "string", "maxLength": 400},
    "unit": {"type": "string", "maxLength": 400},
    "time": {"type": "string", "maxLength": 64},
    "equipment": {"type": "string", "maxLength": 400},
    "assessment": {"type": "string", "maxLength": 1000},
    "action": {"type": "string", "maxLength": 1000},
    "status": {"type": "string", "maxLength": 400},
    "readiness": {"type": "string", "maxLength": 400},
    "problems": {"type": "string", "maxLength": 1000},
    "recommendations": {"type": "string", "maxLength": 1000},
    "notice_id": {"type": "string", "pattern": "^N-[0-9]{8}-[a-z0-9][a-z0-9-]{1,60}$"},
    "category": {"enum": ["breach", "key_rotation", "key_inventory", "lane_down", "hazard_file", "law_change", "other"]},
    "subject": {"type": "string", "maxLength": 200},
    "affects": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "maxLength": 200}},
    "action_required": {"type": "string", "maxLength": 1000},
    "in_force_until": {"type": "string", "maxLength": 64, "description": "ISO 8601 UTC or the literal until_cancelled"},
    "cancels": {"type": "string", "pattern": "^N-[0-9]{8}-[a-z0-9][a-z0-9-]{1,60}$"},
    "names": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 100}, "description": "key/env/account NAMES only"},
    "outstanding": {"type": "string", "maxLength": 2000},
    "unusual": {"type": "string", "maxLength": 1000},
    "upcoming": {"type": "string", "maxLength": 1000},
    "hazards": {"type": "string", "maxLength": 1000},
    "stand_relieved": {"const": true},
    "ack_of": {"type": "string", "maxLength": 200},
    "note": {"type": "string", "maxLength": 400}
  },
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"kind": {"const": "SPOTREP"}}},
     "then": {"required": ["size", "activity", "location", "unit", "time", "equipment"]}},
    {"if": {"properties": {"kind": {"const": "SITREP"}}},
     "then": {"required": ["status", "readiness"]}},
    {"if": {"properties": {"kind": {"const": "NOTICE"}}},
     "then": {"required": ["notice_id", "category", "subject", "affects", "action_required", "in_force_until"]}},
    {"if": {"properties": {"kind": {"const": "RELIEF"}}},
     "then": {"required": ["status", "outstanding", "leases", "stand_relieved"]}},
    {"if": {"properties": {"kind": {"const": "ACK"}}},
     "then": {"required": ["ack_of"]}}
  ]
}
