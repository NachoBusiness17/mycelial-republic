{
  "name": "mag-dashboard",
  "displayName": "Sovereign Swarm Dashboard",
  "description": "Activity-bar dashboard: individual icon views per test surface (flock, world, percolator, emergence), live in-canvas rendering fed cheaply by our swarm.",
  "version": "0.1.0",
  "publisher": "mag",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "magSovereign", "title": "Sovereign", "icon": "media/sovereign.svg" }
      ]
    },
    "views": {
      "magSovereign": [
        { "id": "magFlock",  "name": "Flock",  "icon": "media/flock.svg" },
        { "id": "magWorld",  "name": "World",  "icon": "media/world.svg" },
        { "id": "magEmerge", "name": "Emerge", "icon": "media/emerge.svg" },
        { "id": "magVerkle", "name": "Verkle", "icon": "media/world.svg" }
      ]
    }
  }
}
