local StaminaSystem = require(script.Parent:WaitForChild("StaminaSystem"))

local CombatSystem = {}

-- ============ CONFIG ============
local CONFIG = {
	LightAttack = {
		StaminaCost = 1,
		Damage = 10,
		Range = 8,
		Cooldown = 0.3,
		Windup = 0.05,
		ConeAngle = 45, -- narrow cone (degrees, half-angle)
		Knockback = 5,
	},
	HeavyAttack = {
		StaminaCost = 3,
		Damage = 35,
		Range = 12,
		Cooldown = 0.8,
		Windup = 0.4,
		ConeAngle = 80, -- wider cone
		Knockback = 15,
	},
	Dodge = {
		StaminaCost = 1,
		IFrames = 0.5,
		Distance = 15,
		Duration = 0.35,
		Cooldown = 0.4,
	},
}

-- ============ STATE ============
type CombatState = {
	Character: Model,
	Humanoid: Humanoid,
	RootPart: BasePart,
	Player: Player?,
	LastLightAttack: number,
	LastHeavyAttack: number,
	LastDodge: number,
	IsAttacking: boolean,
	IsDodging: boolean,
	IFrameUntil: number,
	ActiveHitboxes: { [string]: boolean },
	Connections: { RBXScriptConnection },
}

local states: { [Model]: CombatState } = {}

-- ============ HELPERS ============

local function getOverlapParams(character: Model): OverlapParams
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.MaxParts = 50
	return params
end

local function getRaycastParams(character: Model): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.IgnoreWater = true
	return params
end

local function getFacingDirection(state: CombatState): Vector3
	local root = state.RootPart
	local look = root.CFrame.LookVector
	look = Vector3.new(look.X, 0, look.Z)
	if look.Magnitude < 0.01 then
		return Vector3.new(0, 0, -1)
	end
	return look.Unit
end

local function isInCone(origin: Vector3, facing: Vector3, targetPos: Vector3, range: number, halfAngleDeg: number): boolean
	local toTarget = targetPos - origin
	local dist = toTarget.Magnitude
	if dist > range or dist < 0.01 then
		return false
	end
	local dir = toTarget.Unit
	local dot = facing:Dot(dir)
	local angle = math.deg(math.acos(math.clamp(dot, -1, 1)))
	return angle <= halfAngleDeg
end

local function findTargetsInCone(state: CombatState, range: number, halfAngleDeg: number): { Model }
	local origin = state.RootPart.Position
	local facing = getFacingDirection(state)
	local params = getOverlapParams(state.Character)

	local results: { Model } = {}
	local seen: { [Model]: boolean } = {}

	-- Spatial query: sphere around player, then filter by cone
	local parts = workspace:GetPartBoundsInRadius(origin, range, params)
	for _, part in ipairs(parts) do
		local model = part:FindFirstAncestorOfClass("Model")
		if model and not seen[model] then
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local targetRoot = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
			if humanoid and humanoid.Health > 0 and targetRoot and targetRoot ~= state.RootPart then
				if isInCone(origin, facing, targetRoot.Position, range, halfAngleDeg) then
					seen[model] = true
					table.insert(results, model)
				end
			end
		end
	end
	return results
end

local function spawnDamageNumber(targetRoot: BasePart, amount: number, isHeavy: boolean)
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(80, 40)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = 100

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = isHeavy and Color3.fromRGB(255, 120, 60) or Color3.fromRGB(255, 240, 200)
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.Text = tostring(math.floor(amount))
	label.Parent = billboard

	billboard.Parent = targetRoot

	-- Float up + fade
	local startOffset = billboard.StudsOffset
	local tweenService = game:GetService("TweenService")
	local tween = tweenService:Create(billboard, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		StudsOffset = startOffset + Vector3.new(0, 4, 0),
	})
	tween:Play()

	tweenService:Create(label, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()

	Debris:AddItem(billboard, 1)
end

local function applyDamage(targetModel: Model, amount: number, sourceRoot: BasePart, knockback: number, isHeavy: boolean)
	local humanoid = targetModel:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end

	local targetRoot = targetModel:FindFirstChild("HumanoidRootPart") or targetModel.PrimaryPart
	if not targetRoot then
		return
	end

	humanoid:TakeDamage(amount)
	spawnDamageNumber(targetRoot, amount, isHeavy)

	-- Knockback
	if knockback > 0 then
		local dir = (targetRoot.Position - sourceRoot.Position)
		dir = Vector3.new(dir.X, 0, dir.Z)
		if dir.Magnitude > 0.01 then
			dir = dir.Unit
			local impulse = dir * knockback
			targetRoot:ApplyImpulse(impulse * targetRoot.AssemblyMass)
		end
	end
end

-- ============ ATTACKS ============

local function performAttack(state: CombatState, attackType: "Light" | "Heavy")
	if state.IsAttacking or state.IsDodging then
		return false
	end

	local cfg = attackType == "Light" and CONFIG.LightAttack or CONFIG.HeavyAttack
	local now = os.clock()
	local lastTime = attackType == "Light" and state.LastLightAttack or state.LastHeavyAttack

	if now - lastTime < cfg.Cooldown then
		return false
	end

	if not StaminaSystem.HasStamina(state.Character, cfg.StaminaCost) then
		return false
	end

	if not StaminaSystem.SpendStamina(state.Character, cfg.StaminaCost) then
		return false
	end

	if attackType == "Light" then
		state.LastLightAttack = now
	else
		state.LastHeavyAttack = now
	end

	state.IsAttacking = true

	task.spawn(function()
		-- Windup
		if cfg.Windup > 0 then
			task.wait(cfg.Windup)
		end

		if not state.Character.Parent or not state.RootPart.Parent then
			state.IsAttacking = false
			return
		end

		-- Hit detection
		local targets = findTargetsInCone(state, cfg.Range, cfg.ConeAngle)
		for _, target in ipairs(targets) do
			applyDamage(target, cfg.Damage, state.RootPart, cfg.Knockback, attackType == "Heavy")
		end

		state.IsAttacking = false
	end)

	return true
end

function CombatSystem.LightAttack(character: Model): boolean
	local state = states[character]
	if not state then
		return false
	end
	return performAttack(state, "Light")
end

function CombatSystem.HeavyAttack(character: Model): boolean
	local state = states[character]
	if not state then
		return false
	end
	return performAttack(state, "Heavy")
end

-- ============ DODGE ============

function CombatSystem.Dodge(character: Model, moveDirection: Vector3?): boolean
	local state = states[character]
	if not state then
		return false
	end

	if state.IsDodging or state.IsAttacking then
		return false
	end

	local cfg = CONFIG.Dodge
	local now = os.clock()
	if now - state.LastDodge < cfg.Cooldown then
		return false
	end

	if not StaminaSystem.HasStamina(character, cfg.StaminaCost) then
		return false
	end

	if not StaminaSystem.SpendStamina(character, cfg.StaminaCost) then
		return false
	end

	state.LastDodge = now
	state.IsDodging = true
	state.IFrameUntil = now + cfg.IFrames

	local dir = moveDirection
	if not dir or dir.Magnitude < 0.01 then
		dir = getFacingDirection(state)
	else
		dir = Vector3.new(dir.X, 0, dir.Z)
		if dir.Magnitude > 0.01 then
			dir = dir.Unit
		else
			dir = getFacingDirection(state)
		end
	end

	local root = state.RootPart
	local humanoid = state.Humanoid

	-- Disable movement control during dodge
	local originalWalkSpeed = humanoid.WalkSpeed
	humanoid.WalkSpeed = 0

	local startPos = root.Position
	local endPos = startPos + dir * cfg.Distance
	local startTime = os.clock()

	local connection
	connection = RunService.Heartbeat:Connect(function()
		local elapsed = os.clock() - startTime
		local alpha = math.clamp(elapsed / cfg.Duration, 0, 1)
		-- Ease out
		local eased = 1 - (1 - alpha) * (1 - alpha)
		local newPos = startPos:Lerp(endPos, eased)

		if root.Parent then
			root.CFrame = CFrame.new(newPos, newPos + dir)
		end

		if alpha >= 1 then
			connection:Disconnect()
			state.IsDodging = false
			if humanoid.Parent then
				humanoid.WalkSpeed = originalWalkSpeed
			end
		end
	end)

	table.insert(state.Connections, connection)

	return true
end

function CombatSystem.IsInvulnerable(character: Model): boolean
	local state = states[character]
	if not state then
		return false
	end
	return os.clock() < state.IFrameUntil
end

-- ============ INIT / CLEANUP ============

function CombatSystem.Init(character: Model)
	if states[character] then
		CombatSystem.Cleanup(character)
	end

	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	local rootPart = character:WaitForChild("HumanoidRootPart") :: BasePart

	local player = Players:GetPlayerFromCharacter(character)

	local state: CombatState = {
		Character = character,
		Humanoid = humanoid,
		RootPart = rootPart,
		Player = player,
		LastLightAttack = 0,
		LastHeavyAttack = 0,
		LastDodge = 0,
		IsAttacking = false,
		IsDodging = false,
		IFrameUntil = 0,
		ActiveHitboxes = {},
		Connections = {},
	}

	states[character] = state

	-- Cleanup on death
	table.insert(state.Connections, humanoid.Died:Connect(function()
		CombatSystem.Cleanup(character)
	end))

	-- Cleanup on removal
	table.insert(state.Connections, character.AncestryChanged:Connect(function(_, parent)
		if not parent then
			CombatSystem.Cleanup(character)
		end
	end))

	return state
end

