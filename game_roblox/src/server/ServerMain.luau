--!strict
-- ServerMain.lua
-- Soul Frontier - Main server orchestrator

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

-- ============================================================
-- Module requires
-- ============================================================
local StaminaSystem = require(ServerScriptService:WaitForChild("StaminaSystem"))
local CombatSystem = require(ServerScriptService:WaitForChild("CombatSystem"))
local WaveSpawner = require(ServerScriptService:WaitForChild("WaveSpawner"))
local Telegraph = require(ServerScriptService:WaitForChild("Telegraph"))

-- ============================================================
-- Constants
-- ============================================================
local ARENA_RADIUS = 60
local ARENA_WALL_HEIGHT = 20
local ARENA_WALL_THICKNESS = 4
local SPAWN_DELAY = 5
local BREATHER_TIME = 3
local GUARDIAN_INTERVAL = 5
local CRAWLER_COUNT_BASE = 3

local ARENA_CENTER = Vector3.new(0, 0, 0)

-- ============================================================
-- State
-- ============================================================
local GameState = {
	running = false,
	currentWave = 0,
	enemiesAlive = 0,
	enemiesKilled = 0,
	playerStats = {}, -- [player] = {kills, damageDealt, damageTaken, startTime}
}

local activeEnemies = {} -- [model] = true
local arenaFolder = nil

-- ============================================================
-- Remote events
-- ============================================================
local Remotes = Instance.new("Folder")
Remotes.Name = "SoulFrontierRemotes"
Remotes.Parent = ReplicatedStorage

local function makeRemote(name: string, class: string)
	local r = Instance.new(class)
	r.Name = name
	r.Parent = Remotes
	return r
end

local WaveStartedRemote = makeRemote("WaveStarted", "RemoteEvent")
local WaveClearedRemote = makeRemote("WaveCleared", "RemoteEvent")
local GameOverRemote = makeRemote("GameOver", "RemoteEvent")
local GameStateRemote = makeRemote("GameState", "RemoteEvent")

-- ============================================================
-- Arena construction
-- ============================================================
local function buildArena()
	if arenaFolder then arenaFolder:Destroy() end
	arenaFolder = Instance.new("Folder")
	arenaFolder.Name = "Arena"
	arenaFolder.Parent = workspace

	-- Floor
	local floor = Instance.new("Part")
	floor.Name = "Floor"
	floor.Shape = Enum.PartType.Cylinder
	floor.Size = Vector3.new(2, ARENA_RADIUS * 2, ARENA_RADIUS * 2)
	floor.CFrame = CFrame.new(ARENA_CENTER) * CFrame.Angles(0, 0, math.rad(90))
	floor.Anchored = true
	floor.CanCollide = true
	floor.Material = Enum.Material.Slate
	floor.Color = Color3.fromRGB(28, 28, 34)
	floor.TopSurface = Enum.SurfaceType.Smooth
	floor.BottomSurface = Enum.SurfaceType.Smooth
	floor.Parent = arenaFolder

	-- Walls (ring of segments)
	local segments = 48
	for i = 1, segments do
		local angle = (i / segments) * math.pi * 2
		local x = math.cos(angle) * ARENA_RADIUS
		local z = math.sin(angle) * ARENA_RADIUS
		local wall = Instance.new("Part")
		wall.Name = "Wall"
		wall.Size = Vector3.new(
			(2 * math.pi * ARENA_RADIUS) / segments + 1,
			ARENA_WALL_HEIGHT,
			ARENA_WALL_THICKNESS
		)
		wall.CFrame = CFrame.new(Vector3.new(x, ARENA_WALL_HEIGHT / 2, z))
			* CFrame.Angles(0, -angle + math.pi / 2, 0)
		wall.Anchored = true
		wall.CanCollide = true
		wall.Material = Enum.Material.Metal
		wall.Color = Color3.fromRGB(18, 18, 22)
		wall.TopSurface = Enum.SurfaceType.Smooth
		wall.BottomSurface = Enum.SurfaceType.Smooth
		wall.Parent = arenaFolder
	end

	-- Spawn location
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "ArenaSpawn"
	spawn.Size = Vector3.new(8, 1, 8)
	spawn.CFrame = CFrame.new(ARENA_CENTER + Vector3.new(0, 0.5, 0))
	spawn.Anchored = true
	spawn.CanCollide = false
	spawn.Transparency = 1
	spawn.Neutral = true
	spawn.Parent = arenaFolder

	return arenaFolder
end

-- ============================================================
-- Lighting / atmosphere
-- ============================================================
local function setupLighting()
	Lighting.Ambient = Color3.fromRGB(20, 20, 28)
	Lighting.OutdoorAmbient = Color3.fromRGB(15, 15, 22)
	Lighting.Brightness = 0.6
	Lighting.ClockTime = 0
	Lighting.GeographicLatitude = 0
	Lighting.EnvironmentDiffuseScale = 0.2
	Lighting.EnvironmentSpecularScale = 0.2
	Lighting.GlobalShadows = true
	Lighting.FogColor = Color3.fromRGB(10, 10, 16)
	Lighting.FogStart = 40
	Lighting.FogEnd = 180

	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("Atmosphere") or child:IsA("BloomEffect")
			or child:IsA("ColorCorrectionEffect") or child:IsA("SunRaysEffect") then
			child:Destroy()
		end
	end

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.4
	atmosphere.Offset = 0.1
	atmosphere.Color = Color3.fromRGB(40, 40, 55)
	atmosphere.Decay = Color3.fromRGB(20, 20, 30)
	atmosphere.Glare = 0
	atmosphere.Haze = 1.5
	atmosphere.Parent = Lighting

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Brightness = -0.05
	cc.Contrast = 0.15
	cc.Saturation = -0.2
	cc.TintColor = Color3.fromRGB(200, 200, 220)
	cc.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.4
	bloom.Size = 24
	bloom.Threshold = 1.2
	bloom.Parent = Lighting
end

-- ============================================================
-- Player stats
-- ============================================================
local function initPlayerStats(player: Player)
	GameState.playerStats[player] = {
		kills = 0,
		damageDealt = 0,
		damageTaken = 0,
		startTime = os.clock(),
	}
end

local function getPlayerStats(player: Player)
	return GameState.playerStats[player]
end

-- ============================================================
-- Enemy tracking
-- ============================================================
local function registerEnemy(model: Model)
	activeEnemies[model] = true
	GameState.enemiesAlive += 1

	model.AncestryChanged:Connect(function(_, parent)
		if not parent and activeEnemies[model] then
			activeEnemies[model] = nil
			GameState.enemiesAlive = math.max(0, GameState.enemiesAlive - 1)
			GameState.enemiesKilled += 1
		end
	end)
end

local function clearAllEnemies()
	for model in pairs(activeEnemies) do
		if model and model.Parent then
			model:Destroy()
		end
	end
	activeEnemies = {}
	GameState.enemiesAlive = 0
end

-- ============================================================
-- Wave logic
-- ============================================================
local function getCrawlerCount(wave: number): number
	return CRAWLER_COUNT_BASE + math.floor((wave - 1) * 1.5)
end

local function isGuardianWave(wave: number): boolean
	return wave % GUARDIAN_INTERVAL == 0
end

local function spawnWave(wave: number)
	GameState.currentWave = wave
	WaveStartedRemote:FireAllClients(wave, isGuardianWave(wave))

	local crawlerCount = getCrawlerCount(wave)
	local spawnPositions = {}

	for i = 1, crawlerCount do
		local angle = math.random() * math.pi * 2
		local dist = ARENA_RADIUS * 0.6 + math.random() * (ARENA_RADIUS * 0.3)
		table.insert(spawnPositions, Vector3.new(
			math.cos(angle) * dist,
			3,
			math.sin(angle) * dist
		))
	end

	local spawned = WaveSpawner.SpawnWave({
		wave = wave,
		crawlerCount = crawlerCount,
		spawnPositions = spawnPositions,
		spawnGuardian = isGuardianWave(wave),
		arenaCenter = ARENA_CENTER,
		arenaRadius = ARENA_RADIUS,
	})

	for _, enemy in ipairs(spawned) do
		registerEnemy(enemy)
		Telegraph.Attach(enemy, {
			arenaCenter = ARENA_CENTER,
			arenaRadius = ARENA_RADIUS,
		})
	end
end

local function waitForWaveClear()
	while GameState.enemiesAlive > 0 and GameState.running do
		task.wait(0.25)
	end
end

-- ============================================================
-- Game over
-- ============================================================
local function endGame(reason: string)
	if not GameState.running then return end
	GameState.running = false

	clearAllEnemies()

	for player, stats in pairs(GameState.playerStats) do
		if player.Parent then
			local elapsed = os.clock() - stats.startTime
			GameOverRemote:FireClient(player, {
				reason = reason,
				wave = GameState.currentWave,
				kills = stats.kills,
				damageDealt = stats.damageDealt,
				damageTaken = stats.damageTaken,
				timeSurvived = elapsed,
			})
		end
	end
end

-- ============================================================
-- Player lifecycle
-- ============================================================
local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid

	StaminaSystem.InitCharacter(player, character)
	CombatSystem.InitCharacter(player, character)

	humanoid.Died:Connect(function()
		endGame("death")
	end)
end

local function onPlayerAdded(player: Player)
	initPlayerStats(player)

	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)

	if player.Character then
		onCharacterAdded(player, player.Character)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	GameState.playerStats[player] = nil
end)

-- ============================================================
-- Main game loop
-- ============================================================
local function runGame()
	GameState.running = true
	GameState.currentWave = 0
	GameState.enemiesKilled = 0

	-- Wait for at least one player
	while #Players:GetPlayers() == 0 do
		task.wait(0.5)
	end

	-- Initial spawn delay
	task.wait(SPAWN_DELAY)

	while GameState.running do
		local nextWave = GameState.currentWave + 1
		spawnWave(nextWave)

		waitForWaveClear()

		if not GameState.running then break end

		WaveClearedRemote:FireAllClients(nextWave)

		-- Breather
		task.wait(BREATHER_TIME)
	end
end

-- ============================================================
-- Bootstrap
-- ============================================================
local function bootstrap()
	setupLighting()
	buildArena()

	StaminaSystem.Init()
	CombatSystem.Init({
		arenaCenter = ARENA_CENTER,
		arenaRadius = ARENA_RADIUS,
		onDamageDealt = function(player, amount)
			local stats = getPlayerStats(player)
			if stats then stats.damageDealt += amount end
		end,
		onDamageTaken = function(player, amount)
			local stats = getPlayerStats(player)
			if stats then stats.damageTaken += amount end
		end,
		onKill = function(player)
			local stats = getPlayerStats(player)
			if stats then stats.kills += 1 end
		end,
	})
	WaveSpawner.Init({
		arenaCenter = ARENA_CENTER,
		arenaRadius = ARENA_RADIUS,
	})
	Telegraph.Init({
		arenaCenter = ARENA_CENTER,
		arenaRadius = ARENA_RADIUS,
	})

	GameStateRemote:FireAllClients({ state = "ready" })

	task.spawn(runGame)
end

bootstrap()