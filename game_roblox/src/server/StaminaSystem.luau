--[[
    StaminaSystem — the core loop
    One bar. Every action draws from it.
    Generated by deepseek-chat via the task wall.
]]

--!strict
-- StaminaSystem.lua
-- Shared stamina resource for Soul Frontier.
-- One bar (0-100) shared by all actions.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local StaminaSystem = {}

-- ============================================================
-- Constants
-- ============================================================

local MAX_STAMINA: number = 100
local MIN_STAMINA: number = 0

local COST_LIGHT_ATTACK: number = 15
local COST_HEAVY_ATTACK: number = 45
local COST_DODGE: number = 20
local DODGE_IFRAME_DURATION: number = 0.5

local SPRINT_DRAIN_PER_SEC: number = 10
local REGEN_IDLE_PER_SEC: number = 15
local REGEN_MOVING_PER_SEC: number = 5

local EXHAUSTION_WINDOW: number = 1.0

-- ============================================================
-- Types
-- ============================================================

export type ActionType = "LightAttack" | "HeavyAttack" | "Dodge" | "Sprint"

type StaminaState = {
	current: number,
	lastActionTime: number,
	isSprinting: boolean,
	isMoving: boolean,
	player: Player?,
	character: Model?,
	uiBar: Frame?,
	uiFill: Frame?,
	uiLabel: TextLabel?,
	connections: { RBXScriptConnection },
	gaspSound: Sound?,
}

-- ============================================================
-- State
-- ============================================================

local state: StaminaState = {
	current = MAX_STAMINA,
	lastActionTime = 0,
	isSprinting = false,
	isMoving = false,
	player = nil,
	character = nil,
	uiBar = nil,
	uiFill = nil,
	uiLabel = nil,
	connections = {},
	gaspSound = nil,
}

-- ============================================================
-- Internal helpers
-- ============================================================

local function now(): number
	return os.clock()
end

local function playGasp()
	if state.gaspSound then
		state.gaspSound:Play()
	end
end

local function updateUI()
	if not state.uiFill or not state.uiLabel then
		return
	end
	local ratio = math.clamp(state.current / MAX_STAMINA, 0, 1)
	state.uiFill.Size = UDim2.new(ratio, 0, 1, 0)
	state.uiLabel.Text = string.format("%d / %d", math.floor(state.current + 0.5), MAX_STAMINA)

	-- Color shift: green -> yellow -> red
	local color: Color3
	if ratio > 0.5 then
		color = Color3.fromRGB(80, 220, 100)
	elseif ratio > 0.25 then
		color = Color3.fromRGB(240, 200, 60)
	else
		color = Color3.fromRGB(230, 70, 70)
	end
	state.uiFill.BackgroundColor3 = color
end

local function markAction()
	state.lastActionTime = now()
end

local function inExhaustionWindow(): boolean
	return (now() - state.lastActionTime) < EXHAUSTION_WINDOW
end

-- ============================================================
-- Public API
-- ============================================================

function StaminaSystem.GetMax(): number
	return MAX_STAMINA
end

function StaminaSystem.GetCurrent(): number
	return state.current
end

function StaminaSystem.CanAfford(cost: number): boolean
	if cost <= 0 then
		return true
	end
	return state.current >= cost
end

-- Attempts to spend stamina. Returns true on success, false on failure.
-- On failure, plays the "gasped" sound cue.
function StaminaSystem.Spend(cost: number): boolean
	if cost <= 0 then
		return true
	end
	if not StaminaSystem.CanAfford(cost) then
		playGasp()
		return false
	end
	state.current = math.max(MIN_STAMINA, state.current - cost)
	markAction()
	updateUI()
	return true
end

-- Regenerate stamina based on deltaTime. Respects exhaustion window.
function StaminaSystem.Regenerate(deltaTime: number)
	if deltaTime <= 0 then
		return
	end
	if inExhaustionWindow() then
		return
	end
	if state.current >= MAX_STAMINA then
		return
	end

	local rate: number
	if state.isSprinting then
		-- Sprinting drains, does not regen.
		state.current = math.max(MIN_STAMINA, state.current - SPRINT_DRAIN_PER_SEC * deltaTime)
		updateUI()
		return
	elseif state.isMoving then
		rate = REGEN_MOVING_PER_SEC
	else
		rate = REGEN_IDLE_PER_SEC
	end

	state.current = math.min(MAX_STAMINA, state.current + rate * deltaTime)
	updateUI()
end

-- ============================================================
-- Action helpers (convenience wrappers)
-- ============================================================

function StaminaSystem.TryLightAttack(): boolean
	return StaminaSystem.Spend(COST_LIGHT_ATTACK)
end

function StaminaSystem.TryHeavyAttack(): boolean
	return StaminaSystem.Spend(COST_HEAVY_ATTACK)
end

-- Returns true if dodge succeeded. Grants i-frames via attribute on character.
function StaminaSystem.TryDodge(): boolean
	if not StaminaSystem.Spend(COST_DODGE) then
		return false
	end
	local char = state.character
	if char then
		char:SetAttribute("IFramesUntil", now() + DODGE_IFRAME_DURATION)
	end
	return true
end

function StaminaSystem.SetSprinting(sprinting: boolean)
	state.isSprinting = sprinting
	if sprinting then
		markAction()
	end
end

function StaminaSystem.SetMoving(moving: boolean)
	state.isMoving = moving
end

function StaminaSystem.IsInvulnerable(): boolean
	local char = state.character
	if not char then
		return false
	end
	local until_ = char:GetAttribute("IFramesUntil")
	if typeof(until_) ~= "number" then
		return false
	end
	return now() < until_
end

-- ============================================================
-- UI
-- ============================================================

local function buildUI(character: Model)
	local head = character:WaitForChild("Head", 5)
	if not head or not head:IsA("BasePart") then
		return
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "StaminaBar"
	billboard.Size = UDim2.new(4, 0, 0.5, 0)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = 120
	billboard.Adornee = head
	billboard.Parent = head

	local bg = Instance.new("Frame")
	bg.Name = "Background"
	bg.Size = UDim2.new(1, 0, 1, 0)
	bg.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
	bg.BackgroundTransparency = 0.25
	bg.BorderSizePixel = 0
	bg.Parent = billboard

	local bgCorner = Instance.new("UICorner")
	bgCorner.CornerRadius = UDim.new(0.5, 0)
	bgCorner.Parent = bg

	local bgStroke = Instance.new("UIStroke")
	bgStroke.Color = Color3.fromRGB(0, 0, 0)
	bgStroke.Thickness = 1.5
	bgStroke.Transparency = 0.3
	bgStroke.Parent = bg

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.new(1, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(80, 220, 100)
	fill.BorderSizePixel = 0
	fill.Parent = bg

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0.5, 0)
	fillCorner.Parent = fill

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.4
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.Text = string.format("%d / %d", MAX_STAMINA, MAX_STAMINA)
	label.Parent = bg

	local labelSize = Instance.new("UITextSizeConstraint")
	labelSize.MaxTextSize = 18
	labelSize.MinTextSize = 8
	labelSize.Parent = label

	state.uiBar = bg
	state.uiFill = fill
	state.uiLabel = label
	updateUI()
end

local function clearConnections()
	for _, c in ipairs(state.connections) do
		c:Disconnect()
	end
	table.clear(state.connections)
end

-- ============================================================
-- Init
-- ============================================================

function StaminaSystem.Init(player: Player)
	clearConnections()

	state.player = player
	state.current = MAX_STAMINA
	state.lastActionTime = 0
	state.isSprinting = false
	state.isMoving = false
	state.uiBar = nil
	state.uiFill = nil
	state.uiLabel = nil

	-- Gasped sound cue (created once, parented to SoundService)
	if not state.gaspSound then
		local s = Instance.new("Sound")
		s.Name = "StaminaGasp"
		s.SoundId = "rbxassetid://9125402735" -- placeholder gasp cue
		s.Volume = 0.6
		s.PlaybackSpeed = 1.1
		s.Parent = SoundService
		state.gaspSound = s
	end

	local function onCharacter(char: Model)
		state.character = char
		buildUI(char)

		local humanoid = char:WaitForChild("Humanoid", 5)
		if humanoid and humanoid:IsA("Humanoid") then
			local moveConn = humanoid:GetPropertyChangedSignal("MoveDirection"):Connect(function()
				local md = humanoid.MoveDirection
				state.isMoving = md.Magnitude > 0.05
			end)
			table.insert(state.connections, moveConn)
		end
	end

	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	table.insert(state.connections, player.CharacterAdded:Connect(onCharacter))

	-- Regen loop
	local regenConn = RunService.Heartbeat:Connect(function(dt)
		StaminaSystem.Regenerate(dt)
	end)
	table.insert(state.connections, regenConn)
end

return StaminaSystem