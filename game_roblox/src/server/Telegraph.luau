-- Telegraph.lua
-- Soul Frontier - Enemy AI + Telegraph system

local Telegraph = {}

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")

-- ============================================================
-- CONFIG
-- ============================================================

local ENEMY_CONFIG = {
	Crawler = {
		HP = 20,
		Speed = 6,
		ContactDamage = 5,
		ContactCooldown = 0.8,
		Size = Vector3.new(2, 2, 2),
		Color = Color3.fromRGB(120, 60, 160),
		WindUpColor = Color3.fromRGB(255, 80, 80),
		Behavior = "Chase",
		SoulDrop = 1,
	},
	Lunger = {
		HP = 35,
		Speed = 10,
		WindUpTime = 0.5,
		LungeDistance = 20,
		LungeSpeed = 60,
		LungeDamage = 15,
		LungeHitRadius = 3,
		CooldownTime = 1.2,
		Size = Vector3.new(2.2, 2.2, 2.2),
		Color = Color3.fromRGB(200, 120, 40),
		WindUpColor = Color3.fromRGB(255, 40, 40),
		Behavior = "Lunge",
		SoulDrop = 2,
	},
	Guardian = {
		HP = 200,
		Speed = 3,
		WindUpTime = 0.8,
		SlamRadius = 12,
		SlamDamage = 40,
		CooldownTime = 2.0,
		Size = Vector3.new(5, 5, 5),
		Color = Color3.fromRGB(80, 80, 100),
		WindUpColor = Color3.fromRGB(255, 30, 30),
		Behavior = "Slam",
		SoulDrop = 8,
	},
}

-- ============================================================
-- HELPERS
-- ============================================================

local function makePart(name, size, color, parent)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function makeBillboard(parent, text)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, 60, 0, 12)
	bb.StudsOffset = Vector3.new(0, 3, 0)
	bb.AlwaysOnTop = true
	bb.Parent = parent

	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, 0, 1, 0)
	bar.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	bar.BorderSizePixel = 0
	bar.Parent = bb

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.new(1, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
	fill.BorderSizePixel = 0
	fill.Parent = bar

	return bb, fill
end

local function spawnSoulOrbs(position, count)
	for i = 1, count do
		local orb = Instance.new("Part")
		orb.Shape = Enum.PartType.Ball
		orb.Size = Vector3.new(0.8, 0.8, 0.8)
		orb.Color = Color3.fromRGB(120, 220, 255)
		orb.Material = Enum.Material.Neon
		orb.Anchored = false
		orb.CanCollide = false
		orb.Position = position + Vector3.new(
			(math.random() - 0.5) * 3,
			2,
			(math.random() - 0.5) * 3
		)
		orb.Parent = workspace

		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(120, 220, 255)
		light.Range = 6
		light.Brightness = 2
		light.Parent = orb

		Debris:AddItem(orb, 30)
	end
end

-- ============================================================
-- ENEMY CREATION
-- ============================================================

function Telegraph.CreateEnemy(enemyType, position)
	local config = ENEMY_CONFIG[enemyType]
	assert(config, "Unknown enemy type: " .. tostring(enemyType))

	local model = Instance.new("Model")
	model.Name = enemyType

	local body = makePart("Body", config.Size, config.Color, model)
	body.CFrame = CFrame.new(position + Vector3.new(0, config.Size.Y / 2, 0))

	local hitbox = makePart("Hitbox", config.Size + Vector3.new(0.5, 0.5, 0.5), config.Color, model)
	hitbox.Transparency = 1
	hitbox.CFrame = body.CFrame

	local _, hpFill = makeBillboard(body, enemyType)

	-- AoE indicator (Guardian only)
	local aoeIndicator = nil
	if enemyType == "Guardian" then
		aoeIndicator = Instance.new("Part")
		aoeIndicator.Name = "AoEIndicator"
		aoeIndicator.Shape = Enum.PartType.Cylinder
		aoeIndicator.Size = Vector3.new(0.2, config.SlamRadius * 2, config.SlamRadius * 2)
		aoeIndicator.Color = Color3.fromRGB(255, 40, 40)
		aoeIndicator.Material = Enum.Material.Neon
		aoeIndicator.Transparency = 1
		aoeIndicator.Anchored = true
		aoeIndicator.CanCollide = false
		aoeIndicator.Orientation = Vector3.new(0, 0, 90)
		aoeIndicator.Parent = model
	end

	-- State data
	local data = {
		Type = enemyType,
		Config = config,
		Model = model,
		Body = body,
		Hitbox = hitbox,
		HPFill = hpFill,
		HP = config.HP,
		MaxHP = config.HP,
		State = "IDLE",
		StateTimer = 0,
		ContactTimer = 0,
		LungeDirection = Vector3.zero,
		LungeTraveled = 0,
		LungeHit = false,
		Dead = false,
		AoEIndicator = aoeIndicator,
		BaseColor = config.Color,
	}

	model:SetAttribute("EnemyType", enemyType)
	model.PrimaryPart = body

	model.Parent = workspace
	return model, data
end

-- ============================================================
-- DAMAGE / DEATH
-- ============================================================

function Telegraph.Damage(enemyData, amount)
	if enemyData.Dead then return end
	enemyData.HP -= amount
	if enemyData.HPFill then
		enemyData.HPFill.Size = UDim2.new(math.clamp(enemyData.HP / enemyData.MaxHP, 0, 1), 0, 1, 0)
	end
	if enemyData.HP <= 0 then
		Telegraph.Kill(enemyData)
	end
end

function Telegraph.Kill(enemyData)
	if enemyData.Dead then return end
	enemyData.Dead = true

	local pos = enemyData.Body.Position
	spawnSoulOrbs(pos, enemyData.Config.SoulDrop)

	-- Dissolve effect
	local model = enemyData.Model
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
			task.spawn(function()
				for i = 1, 10 do
					part.Transparency = math.min(1, part.Transparency + 0.1)
					task.wait(0.03)
				end
			end)
		end
	end
	Debris:AddItem(model, 0.5)
end

-- ============================================================
-- BEHAVIOR: CHASE (Crawler)
-- ============================================================

local function updateChase(data, dt, playerPos)
	local body = data.Body
	local toPlayer = (playerPos - body.Position)
	toPlayer = Vector3.new(toPlayer.X, 0, toPlayer.Z)
	local dist = toPlayer.Magnitude

	if dist > 0.1 then
		local dir = toPlayer.Unit
		body.CFrame = CFrame.new(body.Position + dir * data.Config.Speed * dt, body.Position + dir)
	end

	-- Contact damage
	data.ContactTimer -= dt
	if dist < (data.Config.Size.X / 2 + 2.5) and data.ContactTimer <= 0 then
		data.ContactTimer = data.Config.ContactCooldown
		local player = Players:GetPlayerFromCharacter(Players.LocalPlayer.Character)
		-- Fire damage via attribute (game loop reads it)
		body:SetAttribute("DealDamage", data.Config.ContactDamage)
		body:SetAttribute("DealDamageTick", tick())
	end
end

-- ============================================================
-- BEHAVIOR: LUNGE (Lunger)
-- ============================================================

local function updateLunge(data, dt, playerPos)
	local body = data.Body
	local cfg = data.Config

	if data.State == "IDLE" then
		local toPlayer = (playerPos - body.Position)
		toPlayer = Vector3.new(toPlayer.X, 0, toPlayer.Z)
		local dist = toPlayer.Magnitude

		if dist > 0.1 then
			local dir = toPlayer.Unit
			body.CFrame = CFrame.new(body.Position + dir * cfg.Speed * dt, body.Position + dir)
		end

		if dist < 25 then
			data.State = "WIND_UP"
			data.StateTimer = cfg.WindUpTime
			data.LungeDirection = toPlayer.Unit
			data.LungeTraveled = 0
			data.LungeHit = false
		end

	elseif data.State == "WIND_UP" then
		data.StateTimer -= dt
		-- Flash red
		local t = (math.sin(tick() * 30) + 1) * 0.5
		body.Color = data.BaseColor:Lerp(cfg.WindUpColor, t)
		body.Material = Enum.Material.Neon

		if data.StateTimer <= 0 then
			data.State = "STRIKE"
			data.StateTimer = cfg.LungeDistance / cfg.LungeSpeed
			body.Color = cfg.WindUpColor
		end

	elseif data.State == "STRIKE" then
		data.StateTimer -= dt
		local step = cfg.LungeSpeed * dt
		data.LungeTraveled += step
		body.CFrame = CFrame.new(body.Position + data.LungeDirection * step, body.Position + data.LungeDirection)

		-- Hit check
		if not data.LungeHit then
			local dist = (Vector3.new(playerPos.X, body.Position.Y, playerPos.Z) - body.Position).Magnitude
			if dist < cfg.LungeHitRadius then
				data.LungeHit = true
				body:SetAttribute("DealDamage", cfg.LungeDamage)
				body:SetAttribute("DealDamageTick", tick())
			end
		end

		if data.StateTimer <= 0 or data.LungeTraveled >= cfg.LungeDistance then
			data.State = "COOLDOWN"
			data.StateTimer = cfg.CooldownTime
			body.Color = data.BaseColor
			body.Material = Enum.Material.SmoothPlastic
		end

	elseif data.State == "COOLDOWN" then
		data.StateTimer -= dt
		if data.StateTimer <= 0 then
			data.State = "IDLE"
		end
	end
end

-- ============================================================
-- BEHAVIOR: SLAM (Guardian)
-- ============================================================

local function updateSlam(data, dt, playerPos)
	local body = data.Body
	local cfg = data.Config

	if data.State == "IDLE" then
		local toPlayer = (playerPos - body.Position)
		toPlayer = Vector3.new(toPlayer.X, 0, toPlayer.Z)
		local dist = toPlayer.Magnitude

		if dist > 0.1 then
			local dir = toPlayer.Unit
			body.CFrame = CFrame.new(body.Position + dir * cfg.Speed * dt, body.Position + dir)
		end

		if dist < cfg.SlamRadius * 0.9 then
			data.State = "WIND_UP"
			data.StateTimer = cfg.WindUpTime
			if data.AoEIndicator then
				data.AoEIndicator.CFrame = CFrame.new(body.Position - Vector3.new(0, body.Position.Y - 0.1, 0))
				data.AoEIndicator.Transparency = 0.6
			end
		end

	elseif data.State == "WIND_UP" then
		data.StateTimer -= dt
		local t = (math.sin(tick() * 25) + 1) * 0.5
		body.Color = data.BaseColor:Lerp(cfg.WindUpColor, t)
		body.Material = Enum.Material.Neon

		if data.AoEIndicator then
			data.AoEIndicator.CFrame = CFrame.new(body.Position - Vector3.new(0, body.Position.Y - 0.1, 0))
			data.AoEIndicator.Transparency = 0.4 + 0.3 * t
		end

		if data.StateTimer <= 0 then
			data.State = "STRIKE"
			data.StateTimer = 0.15
			body.Color = cfg.WindUpColor

			-- Apply AoE damage
			local dist = (Vector3.new(playerPos.X, body.Position.Y, playerPos.Z) - body.Position).Magnitude
			if dist <= cfg.SlamRadius then
				body:SetAttribute("DealDamage", cfg.SlamDamage)
				body:SetAttribute("DealDamageTick", tick())
			end

			if data.AoEIndicator then
				data.AoEIndicator.Transparency = 0.1
			end
		end

	elseif data.State == "STRIKE" then
		data.StateTimer -= dt
		if data.StateTimer <= 0 then
			data.State = "COOLDOWN"
			data.StateTimer = cfg.CooldownTime
			body.Color = data.BaseColor
			body.Material = Enum.Material.SmoothPlastic
			if data.AoEIndicator then
				data.AoEIndicator.Transparency = 1
			end
		end

	elseif data.State == "COOLDOWN" then
		data.StateTimer -= dt
		if data.StateTimer <= 0 then
			data.State = "IDLE"
		end
	end
end

-- ============================================================
-- MAIN UPDATE
-- ============================================================

function Telegraph.Update(enemies, deltaTime, playerPosition)
	for _, data in ipairs(enemies) do
		if data.Dead then continue end

		local behavior = data.Config.Behavior
		if behavior == "Chase" then
			updateChase(data, deltaTime, playerPosition)
		elseif behavior == "Lunge" then
			updateLunge(data, deltaTime, playerPosition)
		elseif behavior == "Slam" then
			updateSlam(data, deltaTime, playerPosition)
		end

		-- Sync hitbox
		data.Hitbox.CFrame = data.Body.CFrame
	end
end

return Telegraph