--!strict
-- WaveSpawner ModuleScript
-- Soul Frontier - Wave system, enemy spawning, AI, telegraphs, game over

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local WaveSpawner = {}

-- ============ CONFIG ============
local ARENA_RADIUS = 60
local BREATHER_TIME = 3
local WAVE_COMPLETE_PAUSE = 2.5

local ENEMY_STATS = {
	Crawler = {
		HP = 20,
		Speed = 8,
		Damage = 8,
		Color = Color3.fromRGB(120, 40, 40),
		Size = Vector3.new(2, 2, 2),
		TouchCooldown = 0.8,
	},
	Lunger = {
		HP = 35,
		Speed = 14,
		Damage = 18,
		Color = Color3.fromRGB(180, 60, 60),
		Size = Vector3.new(2.2, 2.2, 2.2),
		TelegraphTime = 0.5,
		LungeSpeed = 55,
		LungeDuration = 0.35,
		LungeCooldown = 1.6,
		LungeRange = 18,
		TouchCooldown = 0.6,
	},
	Guardian = {
		HP = 200,
		Speed = 5,
		Damage = 35,
		Color = Color3.fromRGB(80, 20, 90),
		Size = Vector3.new(5, 5, 5),
		SlamRange = 12,
		SlamTelegraph = 1.0,
		SlamRadius = 10,
		SlamCooldown = 2.5,
		TouchCooldown = 1.0,
	},
}

-- ============ STATE ============
local state = {
	active = false,
	player = nil,
	character = nil,
	humanoid = nil,
	rootPart = nil,
	waveNumber = 0,
	kills = 0,
	startTime = 0,
	enemies = {}, -- [model] = {type=, hp=, ...}
	connections = {},
	threads = {},
	arenaCenter = Vector3.new(0, 0, 0),
	enemiesFolder = nil,
	gameOver = false,
}

-- ============ HELPERS ============
local function track(conn)
	table.insert(state.connections, conn)
	return conn
end

local function trackThread(thread)
	table.insert(state.threads, thread)
	return thread
end

local function isAlive()
	if not state.character or not state.character.Parent then return false end
	local hum = state.character:FindFirstChildOfClass("Humanoid")
	return hum and hum.Health > 0
end

local function getPlayerRoot()
	if not state.character or not state.character.Parent then return nil end
	return state.character:FindFirstChild("HumanoidRootPart")
end

local function randomSpawnPosition()
	local angle = math.random() * math.pi * 2
	local r = ARENA_RADIUS - math.random() * 4
	return state.arenaCenter + Vector3.new(math.cos(angle) * r, 3, math.sin(angle) * r)
end

local function makeEnemyModel(enemyType)
	local stats = ENEMY_STATS[enemyType]
	local model = Instance.new("Model")
	model.Name = enemyType

	local part = Instance.new("Part")
	part.Name = "Body"
	part.Shape = Enum.PartType.Ball
	part.Size = stats.Size
	part.Color = stats.Color
	part.Material = Enum.Material.Neon
	part.Anchored = false
	part.CanCollide = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = model

	local hum = Instance.new("Humanoid")
	hum.MaxHealth = stats.HP
	hum.Health = stats.HP
	hum.WalkSpeed = stats.Speed
	hum.Parent = model

	model.PrimaryPart = part

	-- Billboard HP bar
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.new(0, 60, 0, 8)
	billboard.StudsOffset = Vector3.new(0, stats.Size.Y * 0.9 + 1, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = part

	local bg = Instance.new("Frame")
	bg.Size = UDim2.new(1, 0, 1, 0)
	bg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	bg.BorderSizePixel = 0
	bg.Parent = billboard

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.new(1, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
	fill.BorderSizePixel = 0
	fill.Parent = bg

	return model, part, hum, fill
end

local function damagePlayer(amount)
	if not isAlive() then return end
	local hum = state.character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:TakeDamage(amount)
	end
end

local function showGameOver()
	if state.gameOver then return end
	state.gameOver = true

	local player = state.player
	if not player then return end
	local playerGui = player:FindFirstChildOfClass("PlayerGui")
	if not playerGui then return end

	local elapsed = os.clock() - state.startTime
	local minutes = math.floor(elapsed / 60)
	local seconds = math.floor(elapsed % 60)

	local gui = Instance.new("ScreenGui")
	gui.Name = "SoulFrontierGameOver"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.Parent = playerGui

	local bg = Instance.new("Frame")
	bg.Size = UDim2.new(1, 0, 1, 0)
	bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	bg.BackgroundTransparency = 0.35
	bg.BorderSizePixel = 0
	bg.Parent = gui

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 80)
	title.Position = UDim2.new(0, 0, 0.25, 0)
	title.BackgroundTransparency = 1
	title.Text = "GAME OVER"
	title.TextColor3 = Color3.fromRGB(220, 40, 40)
	title.TextScaled = true
	title.Font = Enum.Font.GothamBlack
	title.Parent = bg

	local stats = Instance.new("TextLabel")
	stats.Size = UDim2.new(1, 0, 0, 200)
	stats.Position = UDim2.new(0, 0, 0.4, 0)
	stats.BackgroundTransparency = 1
	stats.Text = string.format(
		"Waves Survived: %d\nKills: %d\nTime: %02d:%02d",
		math.max(0, state.waveNumber - 1),
		state.kills,
		minutes,
		seconds
	)
	stats.TextColor3 = Color3.fromRGB(240, 240, 240)
	stats.TextScaled = true
	stats.Font = Enum.Font.GothamBold
	stats.Parent = bg
end

-- ============ ENEMY AI ============
local function updateHPBar(model, hum, fill)
	local stats = ENEMY_STATS[model.Name]
	if not stats then return end
	local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
	fill.Size = UDim2.new(ratio, 0, 1, 0)
end

local function killEnemy(model)
	if not state.enemies[model] then return end
	state.enemies[model] = nil
	state.kills += 1
	if model.Parent then
		model:Destroy()
	end
end

local function damageEnemy(model, amount)
	local data = state.enemies[model]
	if not data then return end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	hum:TakeDamage(amount)
end

local function runCrawlerAI(model, part, hum)
	local lastTouch = 0
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		if not state.enemies[model] or not model.Parent then
			conn:Disconnect()
			return
		end
		if not isAlive() then return end
		local target = getPlayerRoot()
		if not target then return end

		local myPos = part.Position
		local targetPos = target.Position
		local dir = (targetPos - myPos)
		dir = Vector3.new(dir.X, 0, dir.Z)
		if dir.Magnitude > 0.1 then
			dir = dir.Unit
			part.CFrame = CFrame.new(myPos, myPos + dir)
			hum:Move(dir, false)
		end

		-- Contact damage
		local dist = (targetPos - myPos).Magnitude
		if dist < 3.5 then
			local now = os.clock()
			if now - lastTouch > ENEMY_STATS.Crawler.TouchCooldown then
				lastTouch = now
				damagePlayer(ENEMY_STATS.Crawler.Damage)
			end
		end
	end)
	track(conn)
end

local function runLungerAI(model, part, hum)
	local stats = ENEMY_STATS.Lunger
	local state_ai = {
		mode = "chase", -- chase | telegraph | lunge | recover
		timer = 0,
		lungeDir = Vector3.new(),
		lastTouch = 0,
	}
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		if not state.enemies[model] or not model.Parent then
			conn:Disconnect()
			return
		end
		if not isAlive() then return end
		local target = getPlayerRoot()
		if not target then return end

		local myPos = part.Position
		local targetPos = target.Position
		local toTarget = targetPos - myPos
		local flat = Vector3.new(toTarget.X, 0, toTarget.Z)
		local dist = flat.Magnitude

		if state_ai.mode == "chase" then
			if dist > 0.1 then
				local dir = flat.Unit
				part.CFrame = CFrame.new(myPos, myPos + dir)
				hum:Move(dir, false)
			end
			if dist <= stats.LungeRange then
				state_ai.mode = "telegraph"
				state_ai.timer = stats.TelegraphTime
				hum:Move(Vector3.new(), false)
				-- Telegraph: turn red + flash
				part.Color = Color3.fromRGB(255, 40, 40)
				local flashTween = TweenService:Create(part, TweenInfo.new(0.12, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
					Transparency = 0.3,
				})
				flashTween:Play()
				task.delay(stats.TelegraphTime, function()
					if flashTween then flashTween:Cancel() end
					if part and part.Parent then part.Transparency = 0 end
				end)
			end
		elseif state_ai.mode == "telegraph" then
			state_ai.timer -= dt
			hum:Move(Vector3.new(), false)
			if state_ai.timer <= 0 then
				state_ai.mode = "lunge"
				state_ai.timer = stats.LungeDuration
				state_ai.lungeDir = (dist > 0.1) and flat.Unit or Vector3.new(0, 0, 1)
				part.Color = Color3.fromRGB(255, 200, 200)
			end
		elseif state_ai.mode == "lunge" then
			state_ai.timer -= dt
			local move = state_ai.lungeDir * stats.LungeSpeed * dt
			part.CFrame = part.CFrame + move
			-- Contact damage during lunge
			local now = os.clock()
			if dist < 3.5 and now - state_ai.lastTouch > stats.TouchCooldown then
				state_ai.lastTouch = now
				damagePlayer(stats.Damage)
			end
			if state_ai.timer <= 0 then
				state_ai.mode = "recover"
				state_ai.timer = stats.LungeCooldown
				part.Color = stats.Color
			end
		elseif state_ai.mode == "recover" then
			state_ai.timer -= dt
			hum:Move(Vector3.new(), false)
			if state_ai.timer <= 0 then
				state_ai.mode = "chase"
			end
		end
	end)
	track(conn)
end

local function runGuardianAI(model, part, hum)
	local stats = ENEMY_STATS.Guardian
	local ai = {
		mode = "chase", -- chase | slamTelegraph | slamRecover
		timer = 0,
		lastTouch = 0,
	}
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		if not state.enemies[model] or not model.Parent then
			conn:Disconnect()
			return
		end
		if not isAlive() then return end
		local target = getPlayerRoot()
		if not target then return end

		local myPos = part.Position
		local targetPos = target.Position
		local toTarget = targetPos - myPos
		local flat = Vector3.new(toTarget.X, 0, toTarget.Z)
		local dist = flat.Magnitude

		if ai.mode == "chase" then
			if dist > 0.1 then
				local dir = flat.Unit
				part.CFrame = CFrame.new(myPos, myPos + dir)
				hum:Move(dir, false)
			end
			-- Contact damage
			local now = os.clock()
			if dist < 4.5 and now - ai.lastTouch > stats.TouchCooldown then
				ai.lastTouch = now
				damagePlayer(stats.Damage * 0.5)
			end
			if dist <= stats.SlamRange then
				ai.mode = "slamTelegraph"
				ai.timer = stats.SlamTelegraph
				hum:Move(Vector3.new(), false)
				part.Color = Color3.fromRGB(255, 60, 60)
				-- Telegraph ring
				local ring = Instance.new("Part")
				ring.Shape = Enum.PartType.Cylinder
				ring.Size = Vector3.new(0.2, stats.SlamRadius * 2, stats.SlamRadius * 2)
				ring.CFrame = CFrame.new(myPos) * CFrame.Angles(0, 0, math.rad(90))
				ring.Anchored = true
				ring.CanCollide = false
				ring.Material = Enum.Material.Neon
				ring.Color = Color3.fromRGB(255, 40, 40)
				ring.Transparency = 0.6
				ring.Parent = workspace
				Debris:AddItem(ring, stats.SlamTelegraph + 0.2)
