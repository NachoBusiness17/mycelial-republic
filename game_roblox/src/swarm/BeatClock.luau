--[[
    BeatClock === — PRIVLIDGE swarm flagship
    The 122bpm beat IS the ruleset.
    Generated by deepseek-chat.
]]

--!strict
-- BeatClock.luau
-- Manages the 122 BPM disco beat clock. The soundtrack IS the game clock.
-- All hazards, tricks, and scoring quantize to the 8th-note grid.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BeatClock = {}
BeatClock.__index = BeatClock

-- === CONSTANTS ===
-- Mutable so SetBPM can retune the grid live.
local BPM = 122
local BEATS_PER_SECOND = BPM / 60
local SECONDS_PER_BEAT = 60 / BPM
local SECONDS_PER_STEP = SECONDS_PER_BEAT / 2 -- one 8th note
local STEPS_PER_BEAT = 2
local STEPS_PER_BAR = 8 -- 4/4 time, 8 eighth notes per bar

-- === STATE ===
local running = false
local currentStep = 0
local stepAccumulator = 0
local heartbeatConn = nil

-- Audio sync: when a music Sound is bound, the step clock advances by the
-- sound's own TimePosition delta each frame (interpolated with dt on seek/
-- loop) instead of raw wall time. This is the RoBeats-style master clock.
local musicSound: Sound? = nil
local lastSoundTP: number? = nil

-- Continuous song position (seconds since clock start), advanced by the
-- same per-frame delta that drives the step grid. BeatDistance reads this.
local songPos = 0

-- === REMOTES ===
local remotesFolder = ReplicatedStorage:FindFirstChild("PRIVLIDGE_Remotes")
if not remotesFolder then
	remotesFolder = Instance.new("Folder")
	remotesFolder.Name = "PRIVLIDGE_Remotes"
	remotesFolder.Parent = ReplicatedStorage
end

local beatPulse = remotesFolder:FindFirstChild("BeatPulse")
if not beatPulse then
	beatPulse = Instance.new("RemoteEvent")
	beatPulse.Name = "BeatPulse"
	beatPulse.Parent = remotesFolder
end

local riserEvent = remotesFolder:FindFirstChild("Riser")
if not riserEvent then
	riserEvent = Instance.new("RemoteEvent")
	riserEvent.Name = "Riser"
	riserEvent.Parent = remotesFolder
end

-- === HAZARD PATTERNS ===
-- Each pattern is a function(step) -> boolean, called every step.
-- Patterns are quantized to the 8th-note grid by construction.
BeatClock.Patterns = {
	-- Drifters every 4 beats; DOUBLE density inside dense sections
	Drifter = function(step: number): boolean
		local period = isDenseSection(step) and (STEPS_PER_BEAT * 2) or (STEPS_PER_BEAT * 4)
		return step % period == 0
	end,

	-- Sweeper arms fire on beats 2 and 4 (steps 2 and 6 within a bar)
	Sweeper = function(step: number): boolean
		local barStep = step % STEPS_PER_BAR
		return barStep == 2 or barStep == 6
	end,

	-- Walls close mid-bar (step 4 of 8) — the Drifter owns the downbeat;
	-- sharing phase made them co-spawn and co-arrive every bar.
	Wall = function(step: number): boolean
		return step % STEPS_PER_BAR == 4
	end,

	-- Weavers every 2 bars, off-phase from everything else, dense-only bait
	Weaver = function(step: number): boolean
		return isDenseSection(step) and step % (STEPS_PER_BAR * 2) == 12
	end,
}

-- === RISER / DENSE SECTIONS ===
-- Every OTHER 8-bar block is DENSE: 8 bars chill → riser → 8 bars dense.
-- The riser's warning has a payoff: Drifters double in dense sections and
-- Weavers only appear there.
local RISER_LEAD_STEPS = STEPS_PER_BAR -- 1 bar of warning
local DENSE_PERIOD_STEPS = STEPS_PER_BAR * 8 -- one 8-bar block

local function blockOf(step: number): number
	return math.floor(step / DENSE_PERIOD_STEPS)
end

local function isDenseSection(step: number): boolean
	return blockOf(step) % 2 == 1
end

local function shouldFireRiser(step: number): boolean
	local atLead = step + RISER_LEAD_STEPS
	return atLead % DENSE_PERIOD_STEPS == 0 and blockOf(atLead) % 2 == 1
end

-- === INTERNAL ===
local function fireStep(step: number)
	-- Broadcast the pulse. Clients use this to sync visuals/audio.
	beatPulse:FireAllClients(step, step % STEPS_PER_BAR, step % STEPS_PER_BEAT)

	-- Riser telegraph
	if shouldFireRiser(step) then
		riserEvent:FireAllClients(RISER_LEAD_STEPS)
	end

	-- Hazard pattern dispatch (server-side listeners can hook these)
	-- We expose them via a bindable so gameplay code can subscribe.
	local hazardBus = remotesFolder:FindFirstChild("HazardBus")
	if hazardBus then
		for name, pattern in pairs(BeatClock.Patterns) do
			if pattern(step) then
				hazardBus:Fire(name, step)
			end
		end
	end
end

local function onHeartbeat(dt: number)
	if not running then return end

	-- Advance the grid. Prefer the bound music's own clock: TimePosition is
	-- only updated once per frame, so we take its per-frame delta and fall
	-- back to wall dt on seek/loop stalls. Never accumulate raw dt when
	-- music is playing, or the two clocks drift apart.
	local advance = dt
	local snd = musicSound
	if snd and snd.IsPlaying then
		local tp = snd.TimePosition
		local last = lastSoundTP
		if last and tp >= last and (tp - last) < 1 then
			advance = tp - last
		end
		lastSoundTP = tp
	else
		lastSoundTP = nil
	end

	stepAccumulator += advance
	songPos += advance

	-- Catch up if we fell behind (e.g. a long frame). We still fire each step
	-- in order so downstream listeners see a continuous grid.
	while stepAccumulator >= SECONDS_PER_STEP do
		stepAccumulator -= SECONDS_PER_STEP
		currentStep += 1
		fireStep(currentStep)
	end
end

-- === PUBLIC API ===

-- Bind the soundtrack. While it plays, the grid locks to its TimePosition.
function BeatClock.BindSound(sound: Sound)
	musicSound = sound
	lastSoundTP = nil
end

function BeatClock.UnbindSound()
	musicSound = nil
	lastSoundTP = nil
end

-- Retune the grid live (e.g. for a track at a different BPM).
function BeatClock.SetBPM(newBPM: number)
	BPM = newBPM
	BEATS_PER_SECOND = BPM / 60
	SECONDS_PER_BEAT = 60 / BPM
	SECONDS_PER_STEP = SECONDS_PER_BEAT / 2
end

function BeatClock.Start()
	if running then return end
	running = true
	currentStep = 0
	stepAccumulator = 0
	heartbeatConn = RunService.Heartbeat:Connect(onHeartbeat)
	-- Fire step 0 immediately so listeners get an initial pulse.
	fireStep(0)
end

function BeatClock.Stop()
	running = false
	if heartbeatConn then
		heartbeatConn:Disconnect()
		heartbeatConn = nil
	end
end

function BeatClock.IsRunning(): boolean
	return running
end

function BeatClock.GetCurrentStep(): number
	return currentStep
end

-- Returns phase within the current step, 0..1
function BeatClock.GetBeatPhase(): number
	if not running then return 0 end
	return math.clamp(stepAccumulator / SECONDS_PER_STEP, 0, 1)
end

-- Continuous position on the song timeline (seconds). Rhythm judgments
-- derive from this, never from wall clocks.
function BeatClock.GetSongPos(): number
	return songPos
end

-- Distance in seconds to the nearest BEAT boundary (0 .. half-beat).
-- At 122 BPM the half-beat is ~0.246s, so a tolerance of 0.12s here is a
-- real timing gate (~quarter of a beat), not the ~99%-always-true sliver
-- an 8th-note grid gives.
function BeatClock.BeatDistance(): number
	local within = songPos % SECONDS_PER_BEAT
	return math.min(within, SECONDS_PER_BEAT - within)
end

-- Returns true if the current moment is within `tolerance` seconds of a
-- BEAT boundary (not the 8th-note grid — see BeatDistance).
function BeatClock.IsOnBeat(tolerance: number?): boolean
	tolerance = tolerance or 0.08
	if not running then return false end
	return BeatClock.BeatDistance() <= tolerance
end

-- Utility accessors
function BeatClock.GetBPM(): number return BPM end
function BeatClock.GetSecondsPerStep(): number return SECONDS_PER_STEP end
function BeatClock.GetStepsPerBar(): number return STEPS_PER_BAR end
function BeatClock.IsDenseSection(step: number): boolean return isDenseSection(step) end

-- Expose the pulse remote for other server modules
BeatClock.BeatPulse = beatPulse
BeatClock.Riser = riserEvent

return BeatClock