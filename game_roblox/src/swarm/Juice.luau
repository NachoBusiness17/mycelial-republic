-- === STATE ===
local shakeState = {
	active = false,
	amplitude = 0,
	frequency = 0,
	startTime = 0,
	duration = 0,
	seed = 0,
}

-- The game has no Humanoid rig (custom anchored skater), so shake is
-- exposed as an offset the camera rig reads and applies itself.
local currentOffset = Vector3.zero

local hitStopUntil = 0
local flashGui = nil
local flashFrame = nil

-- === INTERNAL: SCREEN SHAKE ===
-- Uses a perlin-ish noise via sin with irrational multipliers for variety.
local function noise(t: number, seed: number): number
	return math.sin(t * 12.9898 + seed) * 43758.5453 % 1
end

local function updateShake(dt: number)
	if not shakeState.active then
		currentOffset = Vector3.zero
		return
	end
	local now = os.clock()
	local elapsed = now - shakeState.startTime
	if elapsed >= shakeState.duration then
		shakeState.active = false
		currentOffset = Vector3.zero
		return
	end

	-- Envelope: linear falloff
	local envelope = 1 - (elapsed / shakeState.duration)
	local amp = shakeState.amplitude * envelope
	local t = elapsed * shakeState.frequency

	currentOffset = Vector3.new(
		(noise(t, shakeState.seed) * 2 - 1) * amp,
		(noise(t, shakeState.seed + 1.7) * 2 - 1) * amp,
		(noise(t, shakeState.seed + 3.3) * 2 - 1) * amp * 0.5
	)
end

-- === INTERNAL: HIT-STOP ===
-- Freezes the frame by setting a target time; the main loop skips updates
-- until the freeze expires. We implement it by throttling a RenderStepped
-- connection that other systems can query.
local function applyHitStop(frames: number)
	if frames <= 0 then return end
	-- 1 frame ~= 1/60s. We scale to a short freeze.
	local duration = frames / 60
	hitStopUntil = math.max(hitStopUntil, os.clock() + duration)
end

function Juice.IsFrozen(): boolean
	return os.clock() < hitStopUntil
end

-- Camera rig reads this every frame and applies it to its own CFrame.
function Juice.GetShakeOffset(): Vector3
	return currentOffset
end

-- === INTERNAL: FLASH ===
local function ensureFlashGui()
	if flashGui and flashGui.Parent then return end
	local pg = player:WaitForChild("PlayerGui")
	flashGui = Instance.new("ScreenGui")
	flashGui.Name = "PRIVLIDGE_Flash"
	flashGui.IgnoreGuiInset = true
	flashGui.ResetOnSpawn = false
	flashGui.DisplayOrder = 999
	flashGui.Parent = pg

	flashFrame = Instance.new("Frame")
	flashFrame.Size = UDim2.fromScale(1, 1)
	flashFrame.BackgroundColor3 = Color3.new(1, 1, 1)
	flashFrame.BackgroundTransparency = 1
	flashFrame.BorderSizePixel = 0
	flashFrame.ZIndex = 999
	flashFrame.Parent = flashGui
end

local function fireFlash()
	ensureFlashGui()
	if not flashFrame then return end
	flashFrame.BackgroundTransparency = 0
	local tween = TweenService:Create(
		flashFrame,
		TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ BackgroundTransparency = 1 }
	)
	tween:Play()
end

-- === INTERNAL: PARTICLES ===
local function spawnParticles(position: Vector3, color: Color3, count: number, speed: number, lifetime: number)
	local emitter = Instance.new("Part")
	emitter.Anchored = true
	emitter.CanCollide = false
	emitter.Transparency = 1
	emitter.Size = Vector3.new(0.1, 0.1, 0.1)
	emitter.CFrame = CFrame.new(position)
	emitter.Parent = workspace

	local attachment = Instance.new("Attachment")
	attachment.Parent = emitter

	local particle = Instance.new("ParticleEmitter")
	particle.Color = ColorSequence.new(color)
	particle.LightEmission = 0.8
	particle.LightInfluence = 0
	particle.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(1, 0),
	})
	particle.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	particle.Lifetime = NumberRange.new(lifetime * 0.7, lifetime)
	particle.Rate = 0
	particle.Speed = NumberRange.new(speed * 0.6, speed)
	particle.SpreadAngle = Vector2.new(180, 180)
	particle.Rotation = NumberRange.new(0, 360)
	particle.EmissionDirection = Enum.NormalId.Top
	particle.Parent = attachment

	particle:Emit(count)

	Debris:AddItem(emitter, lifetime + 0.5)
end

-- === PUBLIC API ===

-- Fire an effect. eventType must be a key in EVENT_CONFIG.
-- position is optional (defaults to camera focus). intensity scales the effect.
function Juice.Fire(eventType: string, position: Vector3?, intensity: number?)
	local cfg = EVENT_CONFIG[eventType]
	if not cfg then
		warn(("[Juice] Unknown event type: %s"):format(eventType))
		return
	end
	intensity = intensity or 1

	-- Screen shake
	shakeState.active = true
	shakeState.amplitude = cfg.shakeAmplitude * intensity
	shakeState.frequency = cfg.shakeFrequency
	shakeState.startTime = os.clock()
	shakeState.duration = cfg.shakeDuration
	shakeState.seed = math.random() * 1000

	-- Hit-stop
	applyHitStop(math.floor(cfg.hitStopFrames * intensity + 0.5))

	-- Flash
	if cfg.flash then
		fireFlash()
	end

	-- Particles
	local pos = position
	if not pos then
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum and hum.RootPart then
			pos = hum.RootPart.Position
		else
			-- Never cache the camera: Roblox recreates it
			local cam = workspace.CurrentCamera
			pos = cam and cam.CFrame.Position + cam.CFrame.LookVector * 5 or Vector3.zero
		end
	end
	spawnParticles(
		pos,
		cfg.particleColor,
		math.floor(cfg.particleCount * intensity + 0.5),
		cfg.particleSpeed,
		cfg.particleLifetime
	)
end

-- === LIFECYCLE ===
local heartbeatConn = nil

function Juice.Start()
	if heartbeatConn then return end
	heartbeatConn = RunService.Heartbeat:Connect(function(dt)
		-- Hit-stop zeroes the shake too: a frozen frame holds no offset.
		if Juice.IsFrozen() then
			currentOffset = Vector3.zero
			return
		end
		updateShake(dt)
	end)
end

function Juice.Stop()
	if heartbeatConn then
		heartbeatConn:Disconnect()
		heartbeatConn = nil
	end
end

-- Auto-start on require (client-side module).
Juice.Start()

return Juice