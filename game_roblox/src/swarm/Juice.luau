--!strict
-- Juice.luau
-- Client-side game feel: screen shake, hit-stop, flashes, particles.
-- All effects route through Juicer:Fire(eventType, position, intensity).

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
