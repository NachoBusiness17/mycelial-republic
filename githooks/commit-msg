#!/usr/bin/env bash
# Deletion lint (2026-10-03, watch/inbox/OPERATOR_WORKFLOW_DIVE_20261003.md change 3c):
# when the staged change deletes files, append a "Deleted: <paths>" trailer to the
# commit message so a deletion can never ride an unrelated title again (add33ba72
# dropped memory/tls/lan.key under a D&D message). Never blocks: always exits 0.
#
# Wired HERE because core.hooksPath=githooks (see githooks/pre-commit header).
# Test: a throwaway temp repo only (receipt in watch/inbox/LAWLOG_20261003.md).
MSG_FILE="${1:-}"
[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0
MAX=40
paths=()
while IFS= read -r -d '' p; do
  paths+=("$p")
done < <(git diff --cached --name-only --diff-filter=D -z 2>/dev/null)
[ "${#paths[@]}" -eq 0 ] && exit 0
list="${paths[0]}"
i=1
while [ "$i" -lt "${#paths[@]}" ] && [ "$i" -lt "$MAX" ]; do
  list="$list, ${paths[$i]}"
  i=$((i + 1))
done
[ "${#paths[@]}" -gt "$MAX" ] && list="$list (+$(( ${#paths[@]} - MAX )) more)"
git interpret-trailers --in-place --if-exists addIfDifferent \
  --trailer "Deleted: $list" "$MSG_FILE" 2>/dev/null || true
exit 0
