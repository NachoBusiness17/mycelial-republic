{"ver": "0.1", "info": {"id": "3dcyWn", "date": "1600708474", "viewed": 59, "name": "Sin Wave test ", "username": "trinketMage", "description": "Sine wave test for eneko", "likes": 1, "published": 1, "flags": 0, "usePreview": 0, "tags": ["sinewave"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    vec2 uv = fragCoord / iResolution.x;\n\tfloat time = iTime * 0.0005;\n    \n    vec3 params1 = vec3(\n        20.0,\n        100.0 + 12.5 * uv.y,\n        (0.0)\n    );\n        \n    vec3 params2 = vec3(\n        0.03125 - 0.03125 * uv.y,\n        0.125 - 0.0625 * -time + 0.0625 * uv.y,\n        0.0 \n    );\n        \n    vec3 params3 = vec3(\n        0.025 - 0.025 * uv.y * 4.,\n        0.125 - 0.0125 * -time + 0.25 * uv.y,\n        0.01\n    );\n    \n    uv.y += params1.x * sin(uv.x / params1.y + time) + params1.z + params2.x * cos(uv.x / params2.y);\n\n    uv.y += params3.x * sin(uv.x / params3.y + time) + params3.z;\n\n    float ny = sin(mod(uv.y * 18., 1.0));\n    \n    float up = 1.0 - smoothstep(0.25, 1.0, ny);\n    float down = smoothstep(0.0, 0.2, ny);\n    \n    vec4 color = vec4(up * down);\n    fragColor = color * 0.1 + 0.9;\n}", "name": "Image", "description": "", "type": "image"}]}