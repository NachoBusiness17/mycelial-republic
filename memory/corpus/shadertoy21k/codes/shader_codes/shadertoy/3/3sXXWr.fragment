{"ver": "0.1", "info": {"id": "3sXXWr", "date": "1550999798", "viewed": 52, "name": "simpleCircle ", "username": "patrickhartono", "description": "tryOut", "likes": 1, "published": 1, "flags": 0, "usePreview": 0, "tags": ["try"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    // Normalized pixel coordinates (from 0 to 1)\n    vec2 uv = fragCoord/iResolution.xy;\n    \n    uv -= 0.5;\n    \n    uv.x *= iResolution.x/iResolution.y;\n    \n    float d = length(uv);\n    \n    float r = .8; //circle radius\n    \n    float c = smoothstep(r, r * 0.5 * sin(iTime), d);\n        \n\n    //if (d < .3) c = 1.; else c = 0.;\n    \n    fragColor = vec4(vec3(c), 1.0); \n    \n\n}", "name": "Image", "description": "", "type": "image"}]}