{"ver": "0.1", "info": {"id": "3sXyDM", "date": "1584862602", "viewed": 43, "name": "Julia2D", "username": "NY", "description": "a", "likes": 1, "published": 1, "flags": 0, "usePreview": 0, "tags": ["2d"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "// HSV \u30ab\u30e9\u30fc\u751f\u6210\u95a2\u6570\nvec3 hsv(float h, float s, float v){\n    vec4 t = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);\n    vec3 p = abs(fract(vec3(h) + t.xyz) * 6.0 - vec3(t.w));\n    return v * mix(vec3(t.x), clamp(p - vec3(t.x), 0.0, 1.0), s);\n}\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    // Normalized pixel coordinates (from 0 to 1)\n      vec2 p  = (2. * fragCoord - iResolution.xy) / iResolution.y;\n\n    \n    int j = 0;\n    vec2 x = vec2(-0.345, 0.654);\n    vec2 y = vec2(iTime * 0.005, 0.0);\n    vec2 z = p;\n    for(int i = 0; i < 360; i++){\n        j++;\n        if(length(z) > 2.0){break;}\n        z = vec2(z.x * z.x - z.y * z.y, 2.0 * z.x * z.y) + x + y;\n    }\n\n    // \u6642\u9593\u306e\u7d4c\u904e\u3067\u8272\u3092 HSV \u51fa\u529b\u3059\u308b\n    float h = mod(iTime * 20.0, 360.0) / 360.0;\n    vec3 rgb = hsv(h, 1.0, 1.0);\n    \n    // \u6f38\u5316\u5f0f\u3067\u7e70\u308a\u8fd4\u3057\u305f\u56de\u6570\u3092\u3082\u3068\u306b\u8f1d\u5ea6\u3092\u6c7a\u3081\u308b\n    float t = float(j) / 360.0;\n    \n    // \u6700\u7d42\u7684\u306a\u8272\u306e\u51fa\u529b\n    fragColor = vec4(rgb * t, 1.0);\n}", "name": "Image", "description": "", "type": "image"}]}