{"ver": "0.1", "info": {"id": "3scyWf", "date": "1601827317", "viewed": 44, "name": "JustHemp", "username": "Michel3324", "description": "\nJust Hemp Learn about hemp, CBD, and cannabinoids on our Blog focuses on providing accurate and up-to-date information about the hemp industry.\nhttps://www.justhemp.org/\n\n", "likes": 0, "published": 1, "flags": 0, "usePreview": 0, "tags": ["httpswwwjusthemporg"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    // Normalized pixel coordinates (from 0 to 1)\n    vec2 uv = fragCoord/iResolution.xy;\n\n    // Time varying pixel color\n    vec3 col = 0.5 + 0.5*cos(iTime+uv.xyx+vec3(0,2,4));\n\n    // Output to screen\n    fragColor = vec4(col,1.0);\n}", "name": "Image", "description": "", "type": "image"}]}