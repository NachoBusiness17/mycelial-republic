{"ver": "0.1", "info": {"id": "3sfBRn", "date": "1587567251", "viewed": 190, "name": "Function001", "username": "PoetLuchnik", "description": "Sum of sin", "likes": 2, "published": 3, "flags": 0, "usePreview": 0, "tags": ["function"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "float f(float x)\n{\n    float y = 0.0;\n    float size = 0.25;\n    float speed = 3.14;\n    \n    while(size > 0.001)\n    {\n        y += sin(x * speed + iTime) * size;\n        speed *= 2.0;\n        size *= 0.5;\n    }\n    \n    return y + 0.5;\n}\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    vec2 uv = fragCoord / iResolution.xy;\n\n    fragColor = vec4( abs( f(uv.x) - uv.y ) < 0.005 );\n}", "name": "Image", "description": "", "type": "image"}]}