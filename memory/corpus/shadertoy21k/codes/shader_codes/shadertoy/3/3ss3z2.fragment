{"ver": "0.1", "info": {"id": "3ss3z2", "date": "1546897547", "viewed": 46, "name": "Sekundnik", "username": "tomaszborsukowski", "description": "Shader tworzy sekundnik, zielona kulka jest \u015brodkiem tarczy sekundnika. Niebieska kulka jest wskaz\u00f3wk\u0105 sekundnika porusza si\u0119 w linii prostej od \u015brodka tarczy (zielona kulka) do kra\u0144ca tarczy (p\u00f3\u0142ksi\u0119\u017cyc). Na podstawie Tutorialu GSLS 2D", "likes": 2, "published": 1, "flags": 0, "usePreview": 0, "tags": ["sekundnik"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "//Shader sekundnik\n//Ustalanie globalnych warto\u015bci\nfloat PI = 3.141592; //liczba PI\nfloat dist = 100.0; //dystans do dyspozycji dla pi\u0142eczki\nfloat r2 = 130.0; //promie\u0144 ko\u0142a odejmuj\u0105cego kolor od ksi\u0119\u017cyca\nfloat width = 10.0; //u\u015bredniona grubo\u015b\u0107 ksi\u0119\u017cyca\nfloat gap;\nfloat ballwidth = 5.0; //promie\u0144 pi\u0142eczki\nvec2 ballpos = vec2(0.0, 0.0);\nfloat ballmaxdist;\nfloat balldiff;\nfloat r;\nvec2 bouncermiddle;\nvec2 clearmiddle;\nvec2 zero;\n\n//funkcja przemieszczaj\u0105ca \u015brodek ko\u0142a z kt\u00f3rego wycinany jest ksi\u0119\u017cyc i obracaj\u0105ca dooko\u0142a tego \u015brodka drugie ko\u0142o\nvoid setmiddle(float time){\n    bouncermiddle = zero+vec2(sin(2.0*PI*time)*dist, cos(2.0*PI*time)*dist);\n    clearmiddle = bouncermiddle+vec2(sin(2.0*PI*(time*60.0+time))*(gap-ballwidth),cos(2.0*PI*(time*60.0+time))*(gap-ballwidth));\n}\n\n//funkcja ustalaj\u0105ca ruch pi\u0142eczki\nvoid setball(float time){\n    float halfsec = floor(time*120.0);\n    float sec = floor(time*60.0);\n    float partsec = mod(time*60.0, 1.0);\n    float halfasec = mod(time*60.0, 0.5);\n    ballpos.x = (zero.x + sin(2.0*PI*sec/60.0)*(ballwidth+balldiff-balldiff*abs(partsec-0.5)*2.0));\n    ballpos.y = (zero.y + cos(2.0*PI*sec/60.0)*(ballwidth+balldiff-balldiff*abs(partsec-0.5)*2.0));\n}\n\n//funkcja okre\u015blaj\u0105ca, czy dany piksel jest cz\u0119\u015bci\u0105 odbijaj\u0105cego ksi\u0119\u017cyca\nbool isBouncer (vec2 pos, float minmod) {\n    setmiddle(minmod);\n    if (length(pos - bouncermiddle) < r && length(pos - clearmiddle) > r2) { return true; } else { return false; }    \n}\n\n//funkcja okre\u015blaj\u0105ca, czy dany piksel jest cz\u0119\u015bci\u0105 pi\u0142eczki\nbool Ball(vec2 pos, float time){\n    setball(time);\n    if (length(pos - ballpos) < ballwidth) return true; else  return false;\n}\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    zero = vec2(iResolution.x/2.0, iResolution.y/2.0); //okre\u015blenie \u015brodka ekranu (punkt zero)\n    gap = (r2-dist)+width; //wyznacznie odleg\u0142o\u015bi mi\u0119dzy \u015brodkami okr\u0119g\u00f3w\n    r = dist+width; //wyznaczenie \u015brednicy okr\u0119gu wysuj\u0105cego ksi\u0119\u017cyc\n    ballmaxdist = dist - ballwidth; //maksymalna odleg\u0142o\u015b\u0107 pi\u0142eczki od punktu zero\n    balldiff = ballmaxdist*2.0 - ballwidth;\n    //utworzenie kolor\u00f3w\n    vec3 bgCol = vec3(1.0, 0.0, 0.0);\n    vec3 pixel = bgCol;\n    vec3 col1 = vec3(0.5, 1.0, 0.75);\n    vec3 col2 = vec3(0.0, 0.2, 0.9);\n    vec3 col3 = vec3(0.19, 0.44, 0.27);\n    if (length(zero - fragCoord) < ballwidth) pixel = col3; //miejscowienie zielonej kulki na \u015brodku\n    float t = iTime; //pobranie czasu \n    t = mod(t, 60.0)/60.0; //przypisanie zmniennej t cz\u0105stki up\u0142yni\u0119tej minuty\n    if (isBouncer(fragCoord, t)) {pixel = col1;} //miejscowienie odbijaj\u0105cego ksi\u0119\u017cyca\n    if (Ball(fragCoord, t)) {pixel = col2;} //miejscowienie pi\u0142ki\n    fragColor = vec4(pixel,1.0); //rysowanie\n}", "name": "Image", "description": "", "type": "image"}]}