{"ver": "0.1", "info": {"id": "3ttGRl", "date": "1577240069", "viewed": 219, "name": "fire fire", "username": "changjiu", "description": "fire\n/*\n*\u7b97\u6cd5\u6765\u81ea\uff1ahttps://blog.csdn.net/tjw02241035621611/article/details/80045381\n*algorithm from https://blog.csdn.net/tjw02241035621611/article/details/80045381\n*/", "likes": 1, "published": 3, "flags": 0, "usePreview": 0, "tags": ["fire"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "/*\n*\u7b97\u6cd5\u6765\u81ea\uff1ahttps://blog.csdn.net/tjw02241035621611/article/details/80045381\n*algorithm from https://blog.csdn.net/tjw02241035621611/article/details/80045381\n*/\n\n#define HASHSCALE1 .1031\n#define PI 3.14159265\n\nvec3 _Color = vec3(1.0,0.3,0.0);\nfloat _GridSize = 30.;\nfloat _RotSpd = 0.5;\nfloat _YSpd = 0.7;\n\nfloat Hash12(vec2 p)\n{\n\tvec3 p3  = fract(vec3(p.xyx) * HASHSCALE1);\n    p3 += dot(p3, p3.yzx + 19.19);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    // Normalized pixel coordinates (from 0 to 1)\n    vec2 uv = fragCoord/iResolution.xy;\n\n    vec3 acc = vec3(0.0,0.0,0.0);\n\n    float rotDeg = 3.*_RotSpd * iTime;\n    float yOffset = 4.*_YSpd* iTime;\n\n    vec2 coord = uv*_GridSize - vec2(0.,yOffset);//\u6574\u4f53\u6cbfy\u8f74\u4e0a\u5347\n    if (abs(mod(coord.y,2.0))<1.0){\n        coord.x += 0.5;\n    }\n    vec2 gridIndex = vec2(floor(coord));\n    float rnd = Hash12(gridIndex);//\u6839\u636eID \u83b7\u53d6hash\u503c\n    // \u5f25\u8865y\u8f74\u4e0a\u5347\u7684\u9006\u5dee \u83b7\u53d6\u539f\u6765\u7684y\u503c \n    // \u540c\u65f6\u56e0\u4e3agridIndex = floor(coord) \u7684\u539f\u56e0  \u4f1a\u8ba9tempY\u503c\u5728\u9501\u5b9a\u56fa\u5b9a\u7684grid\u7684\u540c\u65f6\u8d8a\u6765\u8d8a\u5927;\n    float tempY = gridIndex.y + yOffset ;\n    float life = min(10.0*(1.0-min((tempY)/(24.0-20.0*rnd),1.0)),1.0);\n    if (life>0.0 ) {\n        float size = 0.08*rnd;//\u8ba9\u5927\u5c0f\u968f\u673a\u5316\n        float deg = 999.0*rnd*2.0*PI + rotDeg*(0.5+0.5*rnd);//\u6dfb\u52a0\u65cb\u8f6c\u968f\u673a\u5316\n        vec2 rotate = vec2(sin(deg),cos(deg));//\u5355\u4f4d\u5706\u65cb\u8f6c\u504f\u79fb\n        float radius =  0.5-size*0.2;\n        vec2 cirOffset = radius*rotate;//\n        vec2 part = fract(coord-cirOffset) - 0.5 ;//\u8ba9\u683c\u5b50\u81ea\u5df1\u65cb\u8f6c\u8d77\u6765 \u4f4d\u7f6e\u53d8 \u65b9\u5411\u4e0d\u53d8\n        float len = length(part);\n        float sparksGray = max(0.0,1.0 -len/size);//\u753b\u5706\n        float sinval = sin(PI*1.*(0.3+0.7*rnd)*iTime+rnd*10.);//\u52a0\u70b9\u4eae\u5ea6\u7684\u53d8\u5316\u5b9e\u73b0\u95ea\u70c1 \n        float period = clamp(pow(pow(sinval,5.),5.),0.,1.);\n        float blink =(0.8+0.8*abs(period));\n        acc = life*sparksGray*_Color*blink;\n    }\n\n    // Output to screen\n    fragColor = vec4(acc,1.0);\n}", "name": "Image", "description": "", "type": "image"}]}