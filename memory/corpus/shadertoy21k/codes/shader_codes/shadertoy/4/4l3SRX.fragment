{"ver": "0.1", "info": {"id": "4l3SRX", "date": "1480967269", "viewed": 172, "name": "Pixelating A Shader", "username": "TrueBoolean", "description": "Pixelating a scene. This should work with any shader that uses UV.", "likes": 4, "published": 1, "flags": 0, "usePreview": 0, "tags": ["procedural"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 c, vec2 p )\n{\n\tp = (p/iResolution.xy)*2.-1.;\n    \n    #define PIX 16\n    p = floor(p*float(PIX))/float(PIX);\n    \n    float shade=p.y;\n    p/=p.y-1.;\n    p= p*(sin(iTime)+2.) - iTime;\n\tc = vec4( vec3((mod( floor(p.x) + p.y, 2.) < 1.) ? 0. : 1.)-1.*shade, 1.);\n}", "name": "Image", "description": "", "type": "image"}]}