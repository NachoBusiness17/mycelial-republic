{"ver": "0.1", "info": {"id": "4lXBzj", "date": "1512423351", "viewed": 261, "name": "nlights", "username": "Del", "description": "northern lights test, based on water caustic shader", "likes": 5, "published": 1, "flags": 0, "usePreview": 0, "tags": ["lines"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "// water closeup / sky lines... something... who knows\n\nvoid mainImage(out vec4 k, vec2 p)\n{\n    const vec4 col1 = vec4(0.62,.44,.81,1.0);\n    const vec4 col2 = vec4(0.08,.08,.0,1.0);\n    const mat3 _m = mat3(-2.0,-1.0,2.0, 3.0,-2.0,1.0, 1.0,2.0,2.0);\n    vec2 uv = p.xy / iResolution.xy;\n    \n    vec4 d = vec4(iTime*.04);\n    \n    \n    d.xy = uv;\n    d.y *=0.015;\n    d.x *= 0.725;\n\n    d.xyw *=_m*.5;\n    float v1 = length(.5-fract(d.xyw));\n    d.xyw *=_m*.4;\n    float v2 = length(.5-fract(d.xyw));\n    d.xyw *=_m*.3;\n    float v3 = length(.5-fract(d.xyw));\n    \n    \n    float v = pow(min(min(v1,v2),v3),4.)*13.37+uv.y*1.55;\n    k = mix(col2,col1,v);\n}\n", "name": "Image", "description": "", "type": "image"}]}