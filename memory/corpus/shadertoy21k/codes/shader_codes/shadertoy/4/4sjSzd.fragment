{"ver": "0.1", "info": {"id": "4sjSzd", "date": "1415054784", "viewed": 310, "name": "aliceffekt stripes", "username": "mmalex", "description": "quick 20 min doodle inspired by https://twitter.com/aliceffekt/status/529387010759602177\n", "likes": 4, "published": 1, "flags": 0, "usePreview": 0, "tags": ["2d", "stripes"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [], "code": "// quick doodle inspired by https://twitter.com/aliceffekt/status/529387010759602177\n// I should have stayed truer to the original\n// but I'm tired and I guess it didn't go quite to plan :(\n// oh well...\nfloat t=iTime+80.;\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n\tvec2 uv = fragCoord.xy / iResolution.yy;\n    uv.y*=2.;\n    uv*=mat2(.4,.3,-.3,.4)*0.3;\n    float z=exp(-uv.y*uv.y*(2000.+1000.*cos(t*0.074+0.36)))*((2.+sin(t*0.035))*0.2)+0.8*cos(uv.y*11.0);\n   uv.x+=0.7*sin(z+t*0.01)*0.3;\n    float d=sin(uv.x*1200.)+0.3;\n    float aa=fwidth(d);\n    float c=smoothstep(-aa,aa,d);\n\tfragColor = vec4(c,c,c,1.0);\n}", "name": "", "description": "", "type": "image"}]}