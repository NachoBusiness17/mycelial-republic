{"ver": "0.1", "info": {"id": "4tScDy", "date": "1509933296", "viewed": 104, "name": "demo_04", "username": "jzllove9", "description": "\u4f9d\u65e7\u662f\u4ecethreejs\u6252\u8fc7\u6765\u7684shader\uff0c\u4f46\u662f\u505a\u4e86\u90e8\u5206\u66f4\u6539", "likes": 0, "published": 1, "flags": 0, "usePreview": 0, "tags": ["demo"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "/*\n* learn from :\n*\n* threejs example - webgl_shader2\n*\n* https://www.shadertoy.com/user/candycat\n*\n* sorry for my poor Artistic attainments o(\u2565\ufe4f\u2565)o\n*\n*/\n\n//#define NOT_MIX_EDG\n\nconst float smoothLevel = 0.03;\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    //uv = -1.0 + 2.0 * uv; //\u4f1a\u53d8\u5f62\n\tvec2 uv = ( 2. * fragCoord.xy - iResolution.xy) / min(iResolution.y, iResolution.x);    \n    \n    vec3 bgColor =  vec3( 1.0 ) * ( 1.0 - 0.3 * length(uv) );\n    \n    float a = atan( uv.y, uv.x ); //\u5f53\u524d\u50cf\u7d20\u6240\u5728\u5f27\u5ea6\n    float r = sqrt( dot( uv, uv ) ); //\u6a21\u957f\n    \n    //\u628a\u4ed6\u4eec\u626d\u6210\u4e00\u4e2a\u6839\u636e\u65f6\u95f4\u53d8\u5316\u7684\u5706\u5f62\u533a\u57df\n    uv.x = cos( a ) / clamp(r, .5, 1.);\n    uv.y = sin( a ) / clamp(r, .5, 1.);\n    uv += iTime * 0.05;\n    \n    //\u5077\u6765\u7684\u989c\u8272\u53d8\u5316\u51fd\u6570 ^_^\n    float color = 1.0;\n    color += sin(uv.x * cos(iTime/15.) * 80.) + cos(uv.y * cos(iTime/15.) * 10.);\n    color += sin( uv.y * sin( iTime / 10.0 ) * 40.0 ) + cos( uv.x * sin( iTime / 25.0 ) * 40.0 );\n    color += sin( uv.x * sin( iTime / 5.0 ) * 10.0 ) + sin( uv.y * sin( iTime / 35.0 ) * 80.0 );\n    color *= sin( iTime / 10.0 ) * 0.5;\n      \n    //\u8f93\u51fa\n    #ifdef NOT_MIX_EDG\n    \n\t//\u8fd9\u79cd\u65b9\u5f0f\u8f93\u51fa\u8fb9\u754c\u4f1a\u6709\u952f\u9f7f\n    fragColor = vec4(bgColor, 1.0);\n\tif( r <= 1.0 ){\n   \t \tfragColor = vec4(vec3(color, color * 0.5, sin(color + iTime/3.) * .75), 1.);\n    }\n    \n\t#else\n    \n    //\u901a\u8fc7mix + smoothstep\u6df7\u5408\u8fb9\u754c\n    vec3 _color = mix( bgColor, vec3(color, color * .5, sin(color + iTime/3.) ), smoothstep(-smoothLevel, smoothLevel, 1.0 - r ) );\n    fragColor = vec4(_color, 1.0);\n    \n    #endif    \n}", "name": "Image", "description": "", "type": "image"}]}