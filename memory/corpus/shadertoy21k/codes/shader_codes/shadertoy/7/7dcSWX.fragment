{"ver": "0.1", "info": {"id": "7dcSWX", "date": "1634047442", "viewed": 113, "name": "\u5165\u95e8\u4e4b\u8def-2", "username": "jialouluo", "description": "\u5728\u5165\u95e8\u4e00\u7684\u57fa\u7840\u4e0a\u6269\u5c55\u4e86\u4e00\u90e8\u5206\u3002", "likes": 2, "published": 3, "flags": 0, "usePreview": 0, "tags": [], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "vec3 getcolor(float ang) {\n    //\u4f20\u5165\u8fdb\u6765\u7684\u662f\u4e00\u4e2a\u89d2\u5ea6\u503c \u6211\u4eec\u9700\u8981\u5c06\u4ed6\u8fdb\u884c\u4e00\u5b9a\u7684\u8fd0\u7b97\u6765\u4f7f\u5f97\u4ed6\u6210\u4e3a\u6211\u4eec\u9700\u8981\u7684\u7ed3\u679c\uff0c\u8fd9\u91cc\u53ef\u4ee5\u6839\u636e\u81ea\u5df1\u559c\u597d\n        //return 0.6 + 0.4 * cos(ang + vec3(0.5,.7,.2));\n        //return 0.6 + 0.4 * cos(ang + vec3(0.5,.7,.2)  + iTime );//\u6709 iTime\n        //return .5 + .5 * cos(6.28 * (ang + vec3(0., .33, .67)));\n        return .5 + .5 * cos(6.28 * (ang/6.28 + vec3(0., .33, .67)));//6.28 \u7ea6\u7b49\u4e8e2\u03a0\n    }\nvec2 getCir(float k,float ant,float dis){//\u6ce8\u91ca\u6389\u989c\u8272\u4ee3\u7801 \u8bb0\u5f97\u5c06\u8fd4\u56de\u503c\u6539\u4e3afloat\n/**\n\u672c\u4eba\u4e5f\u624d\u521a\u5f00\u59cb\u5b66 \uff0c\u6709\u4e0d\u5bf9\u7684\u4e00\u4e9b\u5730\u65b9\u6216\u8005\u7406\u89e3\u9519\u8bef\u7684\u5730\u65b9\uff0c\u4e5f\u5e0c\u671b\u8def\u8fc7\u7684\u5927\u4f6c\u4e0d\u541d\u8d50\u6559QAQ\n*/\n    float ir = 2.0*fract((iTime*0.2 + k));//\u5185\u73af\u534a\u5f84\uff0c\u5c06\u534a\u5f84\u533a\u95f4\u6539\u53d8\u4e3a0-2.0\n    float or = 2.2*fract((iTime*0.2 + k));//\u5916\u73af\u534a\u5f84\uff0c\u5c06\u534a\u5f84\u533a\u95f4\u6539\u53d8\u4e3a0-2.2\n    //\u89e3\u91ca\u4e00\u4e0b\u91cc\u9762\u7684\u4e00\u4e9b\u6570\u5b57\u7684\u542b\u4e49 2.0 ,2.2\u5df2\u7ecf\u89e3\u91ca\u4e86\n    //0.2\u4ee3\u8868\u5706\u73af\u7684\u6269\u5c55\u901f\u5ea6 \u53ef\u4ee5\u6539\u53d8\u5927\u5c0f\u89c2\u5bdf\u5706\u73af\u7684\u6269\u5c55\u901f\u5ea6\n    float c =0.0;\n    \n    if(max(dis,or)==or){\n        c = smoothstep(ant,-ant,dis-or);\n    }\n    if(max(dis,ir)==ir){\n        c = smoothstep(ant,-ant,abs(dis-ir) );\n    }\n     //return c;\n    //\u4e0b\u9762\u7684\u4ee3\u7801\u662f\u8d4b\u8272\u4ee3\u7801\uff0c\u4e0e\u751f\u6210\u73af\u7eb9\u65e0\u5173\n    float a =1.0;\n    if(max(dis,or)==or){//\u53ef\u4ee5\u4e0e\u4e0a\u9762\u7684if\u5757\u5408\u5e76 \u8fd9\u91cc\u5206\u51fa\u6765\u662f\u4e3a\u4e86\u533a\u5206\n        a = (dis-ir)/(or-ir);//\u8fd9\u91cc\u5206\u6bcd\u662f\u5706\u73af\u6709\u8272\u7684\u8303\u56f4\u503c\uff0c\u5206\u5b50\u4f9d\u9760\u7740dis\u4e0e\u5185\u5708\u534a\u5f84\u7684\u5dee \u5dee\u8d8a\u5927\u8868\u793a\u8d8a\u4e0d\u5e94\u8be5\u88ab\u9690\u85cf\uff0c\u4ee5\u6b64\u6765\u5b9e\u73b0\u5411\u5185\u5708\u865a\u5316\n        //\u5982\u679c\u4f60\u6709\u5174\u8da3 \u4e0d\u59a8\u5c06ir\u6539\u6210or\uff0c\u8fd9\u65f6\u4f1a\u5411\u5916\u5708\u865a\u5316\n    }\n    else{\n        a =1.0;\n    }\n    \n    return vec2(c,a*c);//\u8fd4\u56de\u503c\u8fd9\u6b21\u8bbe\u7f6e\u4e3a\u4e00\u4e2avec2\u56e0\u4e3a\u6211\u4eec\u9700\u8981a\u7684\u503c\uff0c\u5f53\u7136\u8bb0\u5f97\u7ed9a\u4e58\u4e0ac(c\u9664\u5f00\u5e73\u6ed1\u90e8\u5206\u503c \u53ea\u67090\uff0c1\u8fd9\u53ef\u4ee5\u4ee3\u8868\u7740\u90a3\u4e9b\u5730\u65b9\u9700\u8981a\u7684\u989c\u8272)\n}\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    //vec2 uv = fragCoord/iResolution.xy;\n    //uv-=0.5;\n    //uv.x*=(iResolution.x/iResolution.y);//\u521d\u59cb\u65f6x\u8f74\u4e3a0\u52302y\u8f74\u4e3a0\u52301,\u51cf\u53bb0.5\u8ba1\u7b97\u4e4b\u540e\u4e3ax\u8f74-1\u52301 y\u8f74\u4e3a-0.5\u52300.5\n    //\u5728\u67e5\u770b\u5176\u4ed6\u5927\u4f6c\u5206\u4eab\u7684\u6848\u4f8b\u4e2d \u6709\u53e6\u5916\u4e00\u79cd\u4e5f\u53ef\u4ee5\u4f7f\u5f97\u957f\u5bbd\u6bd4\u4f8b\u4e3a1\n    vec2 uv = (2. * fragCoord - iResolution.xy) / iResolution.y;//\u6211\u4eec\u8fd9\u6b21\u9009\u7528\u8fd9\u79cd\u8ba1\u7b97\u65b9\u5f0f\u6765\u4f7f\u5f97uv.x\u5904\u4e8e-1-->1 uv.y\u4e5f\u5904\u4e8e-1-->1\n    float dis = length(uv);\n    //\u4eca\u5929\u6211\u4eec\u6765\u5b9e\u73b0\u4e00\u79cd\u52a8\u6001\u7684\u5706\u73af\u6ce2\uff0c\u7c7b\u4f3c\u4e8e\u5f80\u6c34\u4e2d\u4ecd\u4e00\u5757\u77f3\u5934\u4e4b\u540e\u6c34\u9762\u51fa\u73b0\u7684\u90a3\u79cd\u6ce2\u7eb9(\u5f53\u7136\u76ee\u524d\u662f\u4e8c\u7ef4\u7684 TAT~);\n    //\u9996\u5148\u8ba9\u6211\u4eec\u5148\u5199\u51fa\u751f\u6210\u5706\u73af\u7684\u4ee3\u7801\uff08\u5177\u4f53\u53ef\u4ee5\u53c2\u8003\u6211\u7684\u5165\u95e8\u4e00\uff09\n    //float ir =0.2;//\u5185\u73af\u534a\u5f84\n    //float or =0.4;//\u5916\u73af\u534a\u5f84\n    //\u8fd9\u6b21\u6211\u4eec\u5c06\u4e0a\u6b21\u63d0\u5230\u7684\u6297\u952f\u9f7f\u4ee3\u7801\u52a0\u5165\u8fdb\u6765\n    //float antialias = fwidth(dis);//\u8fd9\u91cc\u5185\u5d4c\u4e86\u4e00\u4e2aabs\u6240\u4ee5antialias\u662f\u6b63\u6570\uff0c\u504f\u5bfc\u5bbd\u7684\u5177\u4f53\u5b9a\u4e49\u53ef\u4ee5\u5148\u53bb\u641c\u641c\uff0c\u6bd5\u7adf\u5b9a\u4e49\u8fd8\u662f\u5f97\u5b98\u65b9\u8bf4\u5f97\u66f4\u6e05\u695a\u8be6\u7ec6\n    //float c =0.0;\n    //if(max(dis,or)==or){\n    //    c = smoothstep(antialias,-antialias,dis-or);\n    //}\n    //if(max(dis,ir)==ir){\n    //    c = smoothstep(antialias,-antialias,abs(dis-ir));\n    //}\n    //\u8fd9\u6b21\u6211\u6539\u4e86\u4e00\u4e0b\uff0c\u53ef\u4ee5\u6b63\u786e\u7684\u8c03\u6574\u5185\u73af\u548c\u5916\u73af\u7684\u534a\u5f84\u4e86\n    //\u4e0b\u9762\u6211\u4eec\u6765\u5c1d\u8bd5\u53bb\u5b9e\u73b0\u73af\u6ce2\n    //\u521d\u6b65\u6211\u4eec\u53ef\u4ee5\u770b\u4f5c\u5185\u73af\u548c\u5916\u73af\u90fd\u540c\u65f6\u88ab\u653e\u5927\uff0c\u7136\u540e\u65b0\u7684\u5706\u73af\u88ab\u751f\u6210\u7136\u540e\u65b0\u5706\u73af\u7684\u5185\u5916\u73af\u53c8\u88ab\u653e\u5927\uff0c\u5982\u6b64\u5faa\u73af\u4e0b\u53bb\n    //\u4e0b\u9762\u6211\u4eec\u6765\u5c1d\u8bd5\u4e00\u4e0b(\u9700\u8981\u4f7f\u7528\u5230iTime)\n    //\u8ba9\u6211\u4eec\u6765\u91cd\u519911-21\u884c\u4ee3\u7801,\u4e3a\u4e86\u540e\u9762\u7684\u6548\u679c\uff0c\u8fd9\u91cc\u6211\u4eec\u4e0d\u59a8\u5c06\u4ed6\u5c01\u88c5\u4e3a\u4e00\u4e2a\u51fd\u6570\uff1b\n    //float antialias = fwidth(dis);//\u504f\u5bfc\u5bbd\u4f5c\u4e3a\u53c2\u6570\u4f20\u5165\uff0c\u4e0e\u4e4b\u4e00\u8d77\u4f20\u5165\u7684\u8fd8\u6709\u8ddd\u79bb\n    //float c = getCir(0.0,antialias,dis);//\u7b2c\u4e00\u4e2a\u53c2\u6570\u7c7b\u4f3c\u4e8e\u504f\u79fb\u91cf(\u4f5c\u7528\u662f\u8ba9\u5706\u73af\u5728\u751f\u6210\u65f6\u5904\u5728\u4e0d\u540c\u7684\u4f4d\u7f6e)\n    //c+= getCir(0.4,antialias,dis);//\u8fd9\u91cc\u4e3a\u4ec0\u4e48 c\u8981\u52a0\u540e\u9762\u7684\u6bcf\u4e00\u4e2a\u5462\uff0c\u56e0\u4e3a\u6211\u4eecfragColor\u91cc\u9762\u4f9d\u9760c\u6765\u8d4b\u8272\n    //c+= getCir(0.8,antialias,dis);//\u540c\u65f6\uff0c\u5982\u679c\u5f53\u533a\u57df1(\u7406\u89e3\u4e3a\u5706\u73af\u4e00)\u7684\u8fd4\u56de\u503c\u4e3a1\u7684\u8bdd\u5e76\u4e14\u533a\u57df2\u7684\u8fd4\u56de\u503c1\uff0c\u5982\u679c\u4e0d\u76f8\u52a0\uff0c\u4ec5\u53d6\u533a\u57df1\u7684\u8fd4\u56de\u503c\n    //c+= getCir(1.2,antialias,dis);//\u5c31\u4f1a\u5bfc\u81f4c\u7684\u503c\u4ec5\u53d6\u51b3\u4e8e\u533a\u57df1\u7684\u503c \u5728\u533a\u57df1\u91cc\u7684\u5904\u5728\u533a\u57df2\u8fd4\u56de\u503c\u4e3a1\u7684\u533a\u57df\u4f1a\u88ab\u8d4b\u503c\u4e3a0\u7ed9c\n    //c+= getCir(1.6,antialias,dis);//\u6240\u4ee5\u6211\u4eec\u9700\u8981\u5c06\u4e24\u4e2a\u533a\u57df\u7684\u503c\u8fdb\u884c\u76f8\u52a0 \u53ef\u4ee5\u7406\u89e3\u4e3a\u6c42\u4ea4\u96c6 \u8fd9\u6837\u5c31\u4f1a\u8ba9\u6211\u4eec\u6bcf\u4e2a\u533a\u57df\u7684\u503c\u88ab\u6b63\u786e\u5f97\u8d4b\u503c\u7ed9c\n    //\u5230\u8fd9\u91cc\u6211\u4eec\u5df2\u7ecf\u751f\u6210\u4e86\u5177\u6709\u9ed1\u767d\u989c\u8272\u7684\u73af\u7eb9\u4e86\uff0c\u63a5\u4e0b\u6765\u6211\u4eec\u9700\u8981\u7ed9\u4ed6\u8d4b\u8272;\n    //\u8ba9\u6211\u4eec\u8bd5\u8bd5\u6628\u5929\u7684\u989c\u8272\u4ee3\u7801\uff0c\u770b\u770b\u4ed6\u4f1a\u6709\u4ec0\u4e48\u6548\u679c\uff0c\u5f53\u7136\u8fd9\u4e9b\u4ee3\u7801\u5e94\u8be5\u88ab\u5199\u5728\u51fd\u6570\u91cc\uff0c\u6216\u8005\u6839\u636e\u4e2a\u4eba\u9700\u6c42\u4f5c\u4e3a\u4e00\u4e2a\u53c2\u6570\u4f20\u5165;\n    //\u4f7f\u7528 atan(uv.y,uv.x)\u662f\u5e38\u7528\u7684\u6c42uv\u89d2\u5ea6\u7684\u65b9\u6cd5\n    //float angle  =atan(uv.y,uv.x);\n    //vec3 Color = getcolor(angle);\n    //Color = Color *c;\n    //\u89c2\u5bdf\u6548\u679c \u611f\u89c9\u4f3c\u4e4e\u8fd8\u4e0d\u9519(\u5bf9\u4e8e\u6211\u8fd9\u4e2a\u840c\u65b0\u6765\u8bf4~);\n    //\u63a5\u4e0b\u6765 \u6211\u4eec\u4e3a\u4ec0\u4e48\u4e0d\u7ed9\u4ed6\u65cb\u8f6c\u8d77\u6765\u5462;\n    //Color = Color * fract(angle/6.28 - iTime);\n    //\u770b\u8d77\u6765 \u4f3c\u4e4e\u65cb\u8f6c\u8fc7\u4e00\u7edf\u4e00\u4e86\uff0c\u8ba9\u6211\u4eec\u518d\u7ed9\u4ed6\u52a0\u70b9\u504f\u79fb\u91cf\uff0c\u91cd\u519967\u884c\u4ee3\u7801\n    //Color = Color * fract(angle/6.28 - iTime *0.1 + cos(dis)  );//\u8fd9\u91cc\u76840.1\u63a7\u5236\u989c\u8272\u65cb\u8f6c\u7684\u901f\u5ea6\n    //\u5c31\u5148\u8fd9\u6837\u5427\uff0c\u6211\u4eec\u6765\u5b9e\u73b0\u53e6\u5916\u4e00\u79cd\u6548\u679c\uff0c\u4ee3\u7801\u572822\u884c\u4e4b\u540e,\u5e76\u4e14\u91cd\u519963\u884c\u4e4b\u540e\u7684\u4ee3\u7801\n    float antialias = fwidth(dis);//\u504f\u5bfc\u5bbd\u4f5c\u4e3a\u53c2\u6570\u4f20\u5165\uff0c\u4e0e\u4e4b\u4e00\u8d77\u4f20\u5165\u7684\u8fd8\u6709\u8ddd\u79bb\n    vec2 c = getCir(0.0,antialias,dis);//\u7b2c\u4e00\u4e2a\u53c2\u6570\u7c7b\u4f3c\u4e8e\u504f\u79fb\u91cf(\u4f5c\u7528\u662f\u8ba9\u5706\u73af\u5728\u751f\u6210\u65f6\u5904\u5728\u4e0d\u540c\u7684\u4f4d\u7f6e)\n    c+= getCir(0.4,antialias,dis);//\u8fd9\u91cc\u4e3a\u4ec0\u4e48 c\u8981\u52a0\u540e\u9762\u7684\u6bcf\u4e00\u4e2a\u5462\uff0c\u56e0\u4e3a\u6211\u4eecfragColor\u91cc\u9762\u4f9d\u9760c\u6765\u8d4b\u8272\n    c+= getCir(0.8,antialias,dis);//\u540c\u65f6\uff0c\u5982\u679c\u5f53\u533a\u57df1(\u7406\u89e3\u4e3a\u5706\u73af\u4e00)\u7684\u8fd4\u56de\u503c\u4e3a1\u7684\u8bdd\u5e76\u4e14\u533a\u57df2\u7684\u8fd4\u56de\u503c1\uff0c\u5982\u679c\u4e0d\u76f8\u52a0\uff0c\u4ec5\u53d6\u533a\u57df1\u7684\u8fd4\u56de\u503c\n    c+= getCir(1.2,antialias,dis);//\u5c31\u4f1a\u5bfc\u81f4c\u7684\u503c\u4ec5\u53d6\u51b3\u4e8e\u533a\u57df1\u7684\u503c \u5728\u533a\u57df1\u91cc\u7684\u5904\u5728\u533a\u57df2\u8fd4\u56de\u503c\u4e3a1\u7684\u533a\u57df\u4f1a\u88ab\u8d4b\u503c\u4e3a0\u7ed9c\n    c+= getCir(1.6,antialias,dis);//\u6240\u4ee5\u6211\u4eec\n    vec3 Color = vec3(c[1]* 0.3,c[1]* 0.5,c[1] * 0.6)*c[1];\n    fragColor = vec4(Color,1.0);\n}\n", "name": "Image", "description": "", "type": "image"}]}