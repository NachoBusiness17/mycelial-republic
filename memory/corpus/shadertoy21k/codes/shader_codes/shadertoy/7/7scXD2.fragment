{"ver": "0.1", "info": {"id": "7scXD2", "date": "1633968031", "viewed": 139, "name": "Thewaytoentry-1", "username": "jialouluo", "description": "\u4ece\u5982\u4f55\u521b\u5efa\u4e00\u4e2a\u5706 \u5230\u521b\u5efa\u4e00\u4e2a\u5706\u73af\uff0c\u5230\u4e3a\u5706\u73af\u589e\u6dfb\u989c\u8272\uff0c\u5230\u8272\u5f69\u52a8\u6548\uff1b", "likes": 3, "published": 3, "flags": 0, "usePreview": 0, "tags": [], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "vec3 getcolor(float ang) {\n    //\u4f20\u5165\u8fdb\u6765\u7684\u662f\u4e00\u4e2a\u89d2\u5ea6\u503c \u6211\u4eec\u9700\u8981\u5c06\u4ed6\u8fdb\u884c\u4e00\u5b9a\u7684\u8fd0\u7b97\u6765\u4f7f\u5f97\u4ed6\u6210\u4e3a\u6211\u4eec\u9700\u8981\u7684\u7ed3\u679c\uff0c\u8fd9\u91cc\u53ef\u4ee5\u6839\u636e\u81ea\u5df1\u559c\u597d\n        //return 0.6 + 0.4 * cos(ang + vec3(0.5,.7,.2));\n        //return 0.6 + 0.4 * cos(ang + vec3(0.5,.7,.2)  + iTime );//\u6709 iTime\n        //return .5 + .5 * cos(6.28 * (ang + vec3(0., .33, .67)));\n        return .5 + .5 * cos(6.28 * (ang/6.28 + vec3(0., .33, .67)));//6.28 \u7ea6\u7b49\u4e8e2\u03a0\n    }\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    //\u4ece\u5982\u4f55\u521b\u5efa\u4e00\u4e2a\u5706 \u5230\u521b\u5efa\u4e00\u4e2a\u5706\u73af\uff0c\u5230\u4e3a\u5706\u73af\u589e\u6dfb\u989c\u8272\uff0c\u5230\u8272\u5f69\u52a8\u6548\uff1b\n    //\u672c\u4eba\u4e5f\u624d\u521a\u5f00\u59cb\u5b66 \uff0c\u6709\u4e0d\u5bf9\u7684\u4e00\u4e9b\u5730\u65b9\u6216\u8005\u7406\u89e3\u9519\u8bef\u7684\u5730\u65b9\uff0c\u4e5f\u5e0c\u671b\u8def\u8fc7\u7684\u5927\u4f6c\u4e0d\u541d\u8d50\u6559QAQ\n    vec2 uv = fragCoord/iResolution.xy;//\u5c06uv\u5750\u6807\u8f6c\u6362\u52300-1\n    uv-=.5;//\u5c06uv\u79fb\u5230\u4e2d\u5fc3(0,0)\n    uv.x *= (iResolution.x/iResolution.y);//\u522b\u6025\u7740\u89e3\u5f00\u6ce8\u91ca\uff0cuv.x\u66f4\u65b0\n    //\u4e0b\u9762\u521b\u5efa\u4e00\u4e2a\u5706\n    float dis = length(uv);//\u5f97\u5230\u6bcf\u4e2a\u50cf\u7d20\u5230\u539f\u70b9(0\uff0c0)\u7684\u957f\u5ea6\n    \n    //smoothstep(a,b,x); \u5f53a>b\u65f6 ,x>a \u90a3\u4e48y\u503c(\u8fd4\u56de\u503c)\u4e3a0;x <b\u5c0f\u8fd4\u56de\u503c\u4e3a1; b>a\u7684\u60c5\u51b5\u8fd9\u91cc\u7528\u4e0d\u5230,\u5177\u4f53\u53ef\u4ee5\u770bApi\u7684\u89e3\u91ca\n    //\u82e5x\u5927\u4e8eb\u5c0f\u4e8ea\u4e3a\u5e73\u6ed1\u8fc7\u6e21\u7684\u503c(0-1)\n    //\u57fa\u4e8e\u8fd9\u4e00\u70b9 \u6211\u4eec\u53ef\u4ee5\u5b9e\u73b0\u4e00\u4e2a\u5706\n    //\u6211\u4eec\u5c4f\u5e55\u7684\u5750\u6807\u8303\u56f4\u4e3a -0.5=>0.5(\u6ce8\u91ca\u6389uv.x\u66f4\u65b0\u7684\u90a3\u884c\u4ee3\u7801\u7684\u8303\u56f4)\n    //float r = 0.6;//\u8fd9\u662f\u534a\u5f84,\u4e0d\u53d7\u8303\u56f4\u5927\u5c0f\u5f71\u54cd\n    //float c  = smoothstep(r,r-0.1,dis);//\u53ea\u8981dis(\u50cf\u7d20\u7684\u5750\u6807\u8ddd\u79bb\u539f\u70b9\u7684\u8ddd\u79bb)\u5927\u4e8er \u90a3\u4e48 \u8fd4\u56de\u503c\u5c31\u4e3a0\uff0c\n    //\u5c0f\u4e8er-0.1\u5c31\u4e3a1\uff0c\u67090.1\u7684\u5e73\u6ed1\u8ddd\u79bb\n    //\u6211\u4eec\u5c06\u76ee\u524d\u7684c\u503c\u8d4b\u503c\u7ed9fragColor\u8bd5\u8bd5\u6548\u679c\n    //vec3 cir = vec3(c);\n    //fragColor = vec4(cir,1.0);\n    //\u4f1a\u53d1\u73b0\u662f\u4e00\u4e2a\u692d\u5706\n    //\u53ef\u4ee5\u53d1\u73b0 \u662f\u7531\u4e8e\u957f\u5bbd\u6bd4\u4f8b\u7684\u95ee\u9898 \u6240\u4ee5\u5c06 \u6240\u6709\u7684uv\u7684x\u503c\u90fd\u4e58\u4ee5\u4e00\u4e2ax/y\u7684\u503c\n    //\u9700\u8981\u5728\u8ba1\u7b97\u8ddd\u79bb\u4e4b\u524d\u6dfb\u52a0\u8fd9\u53e5\u4ee3\u7801uv.x *= (iResolution.x/iResolution.y);\n    //\u8fd9\u4e0b\u6211\u4eec\u89e3\u5f00\u4e0a\u9762\u7684\u6ce8\u91ca\u518d\u8bd5\u8bd5\n    //\u8fd0\u884c\u4e4b\u540e\u6211\u4eec\u53d1\u73b0 \u6210\u529f\u7684\u7ed8\u5236\u7684\u4e00\u4e2a\u5706\n    //\u5229\u7528smoothstep \u6211\u4eec\u60f3\u60f3 \u53ef\u4e0d\u53ef\u4ee5\u5728\u5706\u7684\u57fa\u7840\u4e0a\u5236\u4f5c\u4e00\u4e2a\u7a7a\u5fc3\u7684\u5706(\u5706\u73af)\n    //\u6211\u4eec\u77e5\u9053 \u5982\u679c\u5728a>b\u7684\u57fa\u7840\u4e0a \u82e5x\u5927\u4e8ea\u8fd4\u56de\u503c\u4e3a0 \u6211\u4eec\u53ef\u4ee5\u57fa\u4e8e\u8fd9\u4e00\u70b9\u6765\u5b9e\u73b0\n    //\u4e5f\u5c31\u662f \u5728\u8ddd\u79bb\u539f\u70b9\u4f4d\u7f6e\u8d8a\u8fd1 \u67d0\u4e2a\u503c\u8d8a\u5927 \u6700\u540e\u8fbe\u5230\u4e34\u754c\u503c\u4f1a\u5927\u4e8ea \u4ee5\u6b64\u6765\u5b9e\u73b0\u8fd4\u56de0 \n    //\u8fd9\u4e2a\u503c \u6211\u4eec\u53ef\u4ee5\u7528 value \u540c\u65f6\u6211\u4eec\u4e5f\u53ef\u4ee5\u8bbe\u7f6e\u4e00\u4e2a\u5185\u5706\u7684\u534a\u5f84 ir\n    //\u63a5\u4e0b\u6765\u8ba9\u6211\u4eec\u91cd\u5199\u7b2c8 - 32\u884c\u7684\u4ee3\u7801;\n    float ir = 0.09;\n    float or = 0.4;\n    float value = abs(dis - or);//dis\u8d8a\u8fd1 value\u7684\u503c\u8d8a\u5927\n    float c = smoothstep(ir,ir-0.01,value);//\u8fd9\u91cc\u53ef\u4ee5\u4e0d\u75280.01\u4f5c\u4e3a\u533a\u95f4 \uff0c\u53ef\u4ee5\u7528\u504f\u5bfc\u5bbd\u6765\u4f5c\u4e3a\u5e73\u6ed1\u533a\u95f4,(\u504f\u5bfc\u5bbd + smoothstep \u7ecf\u5e38\u4f5c\u4e3a\u53bb\u952f\u9f7f\u7684\u4e00\u79cd\u5e38\u7528\u65b9\u6cd5)\n    //vec3 cir = vec3(c);\n    //fragColor = vec4(cir,1.0);\n    //\u6548\u679c\u4f3c\u4e4e\u8fd8\u884c\uff0c\u4f46\u662f\u6539\u53d8\u53c2\u6570\u53d1\u73b0 \u4f3c\u4e4e\u6548\u679c\u4e0d\u5982\u6211\u4eec\u60f3\u5f97\u90a3\u6837\u7f8e\u597d\uff0c\n    //\u539f\u56e0\u662f\u5f53\u6211\u4eec\u6539\u53d8\u5185\u5706\u534a\u5f84\u65f6 a\uff0cb\u7684\u503c\u4e5f\u53d1\u751f\u4e86\u6539\u53d8,\u4f7f\u5f97\u9664\u5f00\u5185\u5706\u8303\u56f4\u5224\u65ad\u7684\u5176\u4ed6\u5224\u65ad\u4e5f\u53d1\u751f\u4e86\u6539\u53d8\uff0c\n    //\u4f46\u662f\u5df2\u7ecf\u4e0d\u5f71\u54cd\u6211\u4eec\u4e0b\u9762\u7684\u4f7f\u7528\u4e86\n    //\u4e0b\u9762\u6211\u4eec\u6765\u5bf9\u8fd9\u4e2a\u5706\u73af\u8fdb\u884c\u7740\u8272\n    //\u6211\u4eec\u9700\u8981\u77e5\u9053\u6bcf\u4e2auv\u5750\u6807\u5bf9\u5e94\u4e8e\u4e2d\u5fc3\u70b9\u7684\u89d2\u5ea6\uff0c\u4ee5\u6b64\u6765\u8fdb\u884c\u4e0d\u540cuv\u4f4d\u7f6e\u7684\u4e0d\u540c\u989c\u8272\u8d4b\u503c\n    //\u4f7f\u7528 atan(uv.y,uv.x)\u662f\u5e38\u7528\u7684\u6c42uv\u89d2\u5ea6\u7684\u65b9\u6cd5\n    float angle  =atan(uv.y,uv.x);\n    //\u6211\u4eec\u8fd9\u65f6\u6765\u8fdb\u884c\u8d4b\u503c\u64cd\u4f5c,\u91cd\u519937 - 44\u884c\u7684\u4ee3\u7801\n    //vec3 cir = vec3(angle * c);\n    //fragColor = vec4(cir,1.0);\n    //\u4f1a\u53d1\u73b0\u6e10\u53d8\u7684\u6548\u679c\u4f3c\u4e4e\u51fa\u6765\u4e86\uff0c\u5f53\u7136\u56e0\u4e3argb\u7684\u53c2\u6570\u662f\u4e00\u6837\u7684\u6240\u4ee5\u5448\u9ed1\u767d\n    //\u6211\u4eec\u9700\u8981\u5bf9\u4ed6\u8fdb\u884c\u4f18\u5316\uff0c\u6211\u4eec\u9700\u8981\u4e00\u4e2a\u65b9\u6cd5\u6765\u4f7f\u5f97\u6211\u4eec\u7684\u89d2\u5ea6\u503c\u8f6c\u53d8\u4e3a\u4e00\u4e2a\u5177\u6709\u4e0d\u540crgb\u7684\u4e00\u4e2avec3\u5bf9\u8c61\n    //\u8ba9\u6211\u4eec\u4e3a\u4ed6\u521b\u5efa\u4e00\u4e2a\u51fd\u6570\n    //\u8ba9\u6211\u4eec\u6765\u91cd\u519947-50\u884c\u4ee3\u7801\n    vec3 f_color = getcolor(angle) * c * fract(angle/6.28 - iTime);\n    //vec3 f_color = getcolor(angle) * c * fract(angle - iTime);//\u4e0d\u96642\u03a0\n    fragColor =vec4(f_color,1.0);\n    //\u5230\u8fd9\u5df2\u7ecf\u521b\u5efa\u4e00\u4e2a\u5177\u6709\u81ea\u5df1\u7279\u8272\u989c\u8272\u7684\u5706\u73af\u4e86\uff0c\u63a5\u4e0b\u6765\u6211\u4eec\u9700\u8981\u4e3a\u4ed6\u6dfb\u52a0\u4e00\u4e9b\u52a8\u6548\n    //\u6211\u4eec\u9700\u8981\u7528\u5230 iTime \u8fd9\u4e2ashadertoy\u5185\u7f6e\u53d8\u91cf \u4ed6\u4ee3\u7f16\u8fd0\u884c\u65f6\u95f4 \uff0c\u4e0e\u4ed6\u5bf9\u5e94\u7684\u8fd8\u6709\u4e00\u4e2a ItimeDelta \u4ed6\u8868\u793a\u6bcf\u5e27\u65f6\u957f;\n    //\u5c06 iTime \u5199\u5165\u5230\u8ba1\u7b97\u4e2d\uff0c\u8fd9\u91cc\u8df3\u8f6c\u5230\u51fd\u6570\u54ea\u53bb\n    //\u6211\u4eec\u53ef\u4ee5\u4e3a\u4ed6\u6dfb\u52a0\u4e00\u4e9b\u5f69\u8679\u5934\u4eae\u5c3e\u6697\u7684\u6548\u679c\n    //\u81f3\u4e8e\u96642\u03a0\u7684\u4f5c\u7528\u73b0\u76ee\u524d\u65e0\u6cd5\u7528\u8bed\u8a00\u6765\u5f62\u5bb9 \u770b\u770b\u6548\u679c\u5e94\u8be5\u80fd\u5927\u81f4\u6e05\u695a\u4e86\n    \n    //\u5c31\u5148\u5199\u5230\u8fd9\u91cc\u5427 \u6211\u4e5f\u662f\u521a\u5b66\u7684\u65b0\u4eba\uff0c\u501f\u9274\u4e86\u65e0\u6570\u5927\u4f6c\u7684\u7406\u89e3\u548c\u4ee3\u7801 \u624d\u52c9\u5f3a\u505a\u5230\u8fd9\u91cc\uff0c\u4ee5\u540e\u4e00\u8d77\u52a0\u6cb9\u5427\n}\n", "name": "Image", "description": "", "type": "image"}]}