{"ver": "0.1", "info": {"id": "MlB3RW", "date": "1427178558", "viewed": 105, "name": "2015-03-23-11-25", "username": "yastero", "description": "random", "likes": 2, "published": 1, "flags": 0, "usePreview": 0, "tags": ["random"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [{"id": "4sXGRr", "filepath": "/media/a/48e2d9ef22ca6673330b8c38a260c87694d2bbc94c19fec9dfa4a1222c364a99.mp3", "previewfilepath": "/media/ap/48e2d9ef22ca6673330b8c38a260c87694d2bbc94c19fec9dfa4a1222c364a99.mp3", "type": "music", "channel": 0, "sampler": {"filter": "linear", "wrap": "clamp", "vflip": "false", "srgb": "false", "internal": "byte"}, "published": 1}], "outputs": [], "code": "void mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n  float t = iTime;\n\n  vec2 uv = fragCoord.xy / iResolution.xy;\n\n  float vol = texture(iChannel0, vec2(abs(sin(t) * 100.0), 1.0)).x;\n\n  float w = 0.0;\n\n  w = sin(\n    sin(iTime * 13.5 + (3.0 * vol)) *\n    10.0 *\n    pow(\n      pow(uv.x, 1.0 + (2.0 * sin(iTime * 0.3))) + sin(uv.y *  + (19.0 * vol)) / 10.0,\n      (4.7 * sin(iTime * 0.2)) + (1.5 * sin(iTime * 0.2))\n    )\n  );\n\n  fragColor = vec4(w, w, w, 1.0);\n\n}\n", "name": "", "description": "", "type": "image"}]}