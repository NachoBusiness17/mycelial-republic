{"ver": "0.1", "info": {"id": "MldSz2", "date": "1480712205", "viewed": 94, "name": "Sine Art", "username": "TrueBoolean", "description": "Patterns made from adding sine patterns.", "likes": 1, "published": 1, "flags": 0, "usePreview": 0, "tags": ["plasma", "sine"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 OUT, vec2 uv )\n{\n    const float PI = atan(0.,-1.);\n\tuv=(uv/iResolution.y)*PI;\n    uv/=uv.x-PI;\n    float x=uv.x+sin(iTime), y=uv.y+iTime;\n    float func=sin(x * 2.)+sin(y * 8.)+sin((x+y) *4.);\n\tOUT = vec4( vec3(func + uv.y/20.), 1.);\n}", "name": "Image", "description": "", "type": "image"}]}