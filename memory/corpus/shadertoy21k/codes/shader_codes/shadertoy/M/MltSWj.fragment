{"ver": "0.1", "info": {"id": "MltSWj", "date": "1481706734", "viewed": 75, "name": "\u3059\u3070\u3089\u3057\u3044\uff01\uff01\uff01", "username": "Ilygos", "description": "\u3053\u308c\u306f\u7d20\u6674\u3089\u3057\u3044\u3060\u3088\uff01", "likes": 0, "published": 1, "flags": 0, "usePreview": 0, "tags": [], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    float radius = 100.0 + cos(iTime) * 50.0;\n    float centerX = iResolution.x/2.0 + cos(iTime)*250.0;\n    float centerY = iResolution.y/2.0 + sin(iTime)*100.0;\n    float distance = sqrt( pow(centerX - fragCoord.x, 2.0) + pow(centerY - fragCoord.y, 2.0));\n    vec2 uv = fragCoord.xy / iResolution.xy;\n    vec2 vu = 8.0 / iResolution.xy;\n    if ( distance < radius){\n\t\tfragColor = vec4(uv,0.5+0.5*sin(iTime),1.0);\n    }else fragColor = vec4(vu, 0.2+0.8*sin(iTime), 0.5);\n}", "name": "Image", "description": "", "type": "image"}]}