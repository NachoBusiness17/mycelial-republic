{"ver": "0.1", "info": {"id": "MtKfWz", "date": "1542273564", "viewed": 271, "name": "Mikki ", "username": "MikkiRich", "description": "Mikki  Rich \u00a0", "likes": 0, "published": 3, "flags": 0, "usePreview": 0, "tags": ["rich"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    // Normalized pixel coordinates (from 0 to 1)\n    vec2 uv = fragCoord/iResolution.xy;\n\n    // Time varying pixel color\n    vec3 col = 0.5 + 0.5*cos(iTime+uv.xyx+vec3(0,2,4));\n\n    // Output to screen\n    fragColor = vec4(col,1.0);\n     fragColor = vec4(col,1.0);\n}", "name": "Image", "description": "", "type": "image"}]}