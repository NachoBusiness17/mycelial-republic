{"ver": "0.1", "info": {"id": "MttXz2", "date": "1480714658", "viewed": 90, "name": "Plasma Color", "username": "TrueBoolean", "description": "Plasma effect using sine patterns.", "likes": 0, "published": 1, "flags": 0, "usePreview": 0, "tags": ["plasma"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 OUT, vec2 uv )\n{\n    const float PI = atan(0.,-1.);\n\tuv=(uv/iResolution.y)*PI;\n    float x=uv.x, y=uv.y;\n    float func=sin(x * 2.)+sin( y * 8. )+sin((x+y)*8.) + sin(length( uv )* 20.);\n    vec3 pal= vec3( 2. , 4. , 8.);\n    pal = .5+ sin( PI * (func+iTime) / pal );\n\tOUT = vec4( pal, 1.);\n}", "name": "Image", "description": "", "type": "image"}]}