{"ver": "0.1", "info": {"id": "NdBXRh", "date": "1619607587", "viewed": 234, "name": "Captivating", "username": "Bellatrix", "description": "Just a siimple concentric circle pattern", "likes": 1, "published": 1, "flags": 0, "usePreview": 0, "tags": ["hypnosis"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "float pattern(in vec2 coords)\n{\n    float dist = length(coords);\n    dist = abs(dist-0.3);\n    float bandwidth = fract(dist*2.-iTime)*0.8 + 0.1;\n    return floor(fract(dist*20.+iTime*2.) + 1.-bandwidth);\n}\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    // Normalized pixel coordinates (from 0 to 1)\n    vec2 coords = (fragCoord-iResolution.xy/2.)/min(iResolution.x, iResolution.y);\n\n    vec3 col = vec3(pattern(coords));\n\n    // Output to screen\n    fragColor = vec4(col,1.0);\n}", "name": "Image", "description": "", "type": "image"}]}