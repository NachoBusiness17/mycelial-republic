{"ver": "0.1", "info": {"id": "Ndt3D8", "date": "1629704529", "viewed": 77, "name": "ripple wave ", "username": "hahnzhu", "description": "ripple wave", "likes": 1, "published": 1, "flags": 0, "usePreview": 0, "tags": ["wave"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    vec3 col = vec3(0.);\n    vec2 uv = (2.0 * fragCoord.xy - iResolution.xy) / min(iResolution.y, iResolution.x);\n    float angle = atan(uv.y, uv.x);\n\n    float from = .1;  // origin size\n    float width = .2;  // ripple width\n    \n    for (float t = 0.0; t <= 1.0; t++) {\n        from = fract((iTime+0.9*t)*0.5)*2.;\n        float len = smoothstep(from, from-width, length(uv)) - smoothstep(from-width, from-width*2., length(uv));\n        float opacity = 1. - smoothstep(1.5, 2., from);\n        col += len * opacity;\n    }\n    \n    fragColor = vec4(col,1.0);\n}", "name": "Image", "description": "", "type": "image"}]}