{"ver": "0.1", "info": {"id": "NlG3Rh", "date": "1637107750", "viewed": 479, "name": "terrain 3", "username": "yonatan", "description": "added some clouds/fog", "likes": 15, "published": 3, "flags": 0, "usePreview": 0, "tags": ["terrain", "clouds", "fog", "short"], "hasliked": 0, "parentid": "ftd3DX", "parentname": "terrain 2?"}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "#define R(a)mat2(cos(a),sin(a),-sin(a),cos(a))\n#define r iResolution.xy\n#define t iTime\n\nvoid mainImage( out vec4 o, in vec2 FC )\n{\n    o=vec4(0);\n    for(float i,e,f,g,s;i++<50.;g+=min(e*.7,f*f*.1)){\n        vec3 c=vec3(4.7,5,5.6),n,q,p=q=vec3((FC.xy-.5*r)/r.y*g,g);\n        p.zy*=R(.4+sin(t/3.)*.2);\n        s=1.4;\n        p.z+=t;\n        q=p;\n        f=abs(p.y*p.y-2.8)+.4;\n        e=++p.y;\n        mat2 m=R(1.);\n        for(;s<1e3;s*=1.7)\n            p.xz*=m,\n            n.xz*=m,\n            q.xz*=m,\n            q.yz*=m,\n            n+=cos(p*s),\n            f-=abs(cos(q.x*s)*cos(q.z*s)-.6)/s,\n            q.xz+=t/s*.2,\n            e+=sin(p.x*s)/s/2.;\n        n.y=.2;\n        n/=length(n);\n        e-=n.y;\n        c.x+=n.y*3.;\n        o.rgb+=mix(\n            mix(exp(n.z-c),c/3e2,min(g/9.+e,1.4)),\n            p-p+exp(-f*f)/50.,\n            exp(-f));\n    }\n}", "name": "Image", "description": "", "type": "image"}]}