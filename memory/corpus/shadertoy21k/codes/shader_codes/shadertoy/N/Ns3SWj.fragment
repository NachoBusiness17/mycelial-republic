{"ver": "0.1", "info": {"id": "Ns3SWj", "date": "1633911541", "viewed": 104, "name": "demo webgl vs canvas", "username": "ninofiliu", "description": "Same in canvas:\nhttps://jsfiddle.net/pr5gkc12/", "likes": 0, "published": 3, "flags": 0, "usePreview": 0, "tags": ["demo"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage(out vec4 fragColor, in vec2 fragCoord) {\n    float s = sin(fragCoord.x/iResolution.x+iTime);\n    s += s < 0.0 ? 1.0 : 0.0;\n    fragColor = vec4(vec3(s), 1.0);\n}", "name": "Image", "description": "", "type": "image"}]}