{"ver": "0.1", "info": {"id": "NsdSRX", "date": "1633627058", "viewed": 156, "name": "Filtre", "username": "rasterdog", "description": "lol", "likes": 3, "published": 1, "flags": 2, "usePreview": 0, "tags": ["filtre"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [{"id": "4sf3zn", "filepath": "/presets/webcam.png", "previewfilepath": "/presets/webcam.png", "type": "webcam", "channel": 0, "sampler": {"filter": "linear", "wrap": "clamp", "vflip": "true", "srgb": "false", "internal": "byte"}, "published": 1}], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    // Normalized pixel coordinates (from 0 to 1)\n    vec2 uv = fragCoord / iResolution.xy;\n    \n    vec4 cam = texture(iChannel0, uv);\n    \n    float noise = sin(fragCoord.x * cos(fragCoord.y * iTime)) / 5.0;\n    \n    float color = max(clamp(sin(cam.x + cam.y + cam.z / cos(1.4)), 0.0, 0.8) * 1.25, sin(cam.y * fragCoord.y / 5.0 + iTime * 10.0));\n\n    // Output to screen\n    fragColor = vec4(color / fragCoord.x * 400.0 + noise, color / 2.0 + noise, color * color, 1.0);\n}\n", "name": "Image", "description": "", "type": "image"}]}