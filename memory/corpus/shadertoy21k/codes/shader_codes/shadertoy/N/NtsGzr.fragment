{"ver": "0.1", "info": {"id": "NtsGzr", "date": "1621441544", "viewed": 139, "name": "Simplex Noise (well kinda)", "username": "wildniklin", "description": "Getting there...", "likes": 1, "published": 3, "flags": 0, "usePreview": 0, "tags": ["simplex"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "float rand1(vec2 p)\n{\n    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453123);\n}\n\nvec2 skew(vec2 st)\n{\n    vec2 r = vec2(0.0);\n    r.x = 1.1547 * st.x;\n    r.y = st.y + (0.5 * r.x);\n    return r;\n}\n\nvec3 simplexGrid(vec2 st)\n{\n    vec3 m = vec3(0.0);\n\n    vec2 p = fract(skew(st));\n    if (p.x > p.y)\n    {\n        m.xy = 1.0 - vec2(p.x, p.y - p.x);\n        m.z = p.y;\n    }\n    else\n    {\n        m.yz = 1.0 - vec2(p.x - p.y, p.y);\n        m.x = p.x;\n    }\n\n    return fract(m);\n}\n\nfloat simplexNoise(vec2 uv)\n{\n    vec3 m;\n    vec3 r;\n\n    vec2 k = skew(uv);\n    vec2 i = floor(k);\n    vec2 f = k - i;\n    \n    if (f.x > f.y)\n    {\n        m = vec3(1.0 - f.x, 1.0 - (f.y - f.x), f.y);\n        r = vec3(rand1(i), rand1(vec2(i.x + 1.0, i.y)), rand1(i + 1.0));\n    }\n    else\n    {\n        m = vec3(f.x, 1.0 - (f.x - f.y), 1.0 - f.y);\n        r = vec3(rand1(i + 1.0), rand1(vec2(i.x, i.y + 1.0)), rand1(i));\n    }\n    \n\n    m = fract(m);\n    m = smoothstep(0.0, 1.0, m);\n    float a = 0.0;\n    a = mix(mix(r.x, r.z, m.z), mix(r.y, r.z, m.z), m.y);\n    return a;\n}\n\nvoid mainImage(out vec4 o, in vec2 i)\n{\n    vec2 uv = (i - (0.5 * iResolution.xy)) / min(iResolution.x, iResolution.y);\n    vec3 col = vec3(0.0);\n\n    uv *= 10.0;\n    uv += iTime;\n\n    col += simplexNoise(uv);\n    \n    o = vec4(col, 1.0);\n}\n", "name": "Image", "description": "", "type": "image"}]}