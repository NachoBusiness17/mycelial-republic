{"ver": "0.1", "info": {"id": "WdKSDR", "date": "1573774394", "viewed": 255, "name": " \u03b5\u03be\u03ac\u03b3\u03c9\u03bd\u03bf", "username": "blauwmaan", "description": "hexagonal fun built up on art of code", "likes": 3, "published": 3, "flags": 0, "usePreview": 0, "tags": ["hexagon"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "float Circle(vec2 uv, vec2 p, float r, float blur) {\n    float d = length(uv-p);\n    float c = smoothstep(r, r-blur, d);\n    \n    return c;\n}\n\nfloat MaxDistance (vec2 p) {\n\tp = abs(p);\n    \n       \n    float c = dot(p, normalize(vec2(1, 1.73)));\n    c = max(c, p.x); \n    \n    return c;\n\n}\n\nvec4 hexaCoords (vec2 uv) {\n\n   vec2 r = vec2(1., 1.73);\n    vec2 h= r*.5;\n    vec2 a = mod(uv, r)-h;\n    \n    vec2 b = mod(uv-h, r)-h;\n    \n    vec2 gv;\n        \n    if(length(a)<length(b))\n    \tgv = a;\n    else \n    \tgv = b;\n    \n    \n    float x = atan(gv.x, gv.y);\n    float y = .5-MaxDistance(gv);\n    \n    vec2 id = uv-gv;\n    return vec4(x, y, id.x, id.y);\n}\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    \n    float t = iTime;\n    \n    vec2 uv = (fragCoord-.5*iResolution.xy)/iResolution.y;\n \n    \n    vec3 col = vec3 (cos(t), sin(t)*1., 0);\n    \n \tuv *= 5.;\n    \n \n    \n   vec4 coords = hexaCoords(uv);\n   \n   float grid = smoothstep(.05, sin(t), coords.y*sin(coords.z*coords.w+t)); \n    col += grid; \n// col.rg = hexaCoords(uv*sin(t)).xy;\n \n//    float c = sin(MaxDistance(uv)*10.+t);\n   \n // col += sin(t)*smoothstep(c*sin(5.*t), .2, 0.1*tan(.5*t));\n      \n  \n       \n   \n    col += Circle(uv, coords.zw, sin(t)*0.1, 0.01);\n    \n    \n    fragColor = vec4(col,1.0);\n}", "name": "Image", "description": "", "type": "image"}]}