{"ver": "0.1", "info": {"id": "WdXBR4", "date": "1587728488", "viewed": 210, "name": "Function002", "username": "PoetLuchnik", "description": "Function001, but around", "likes": 3, "published": 3, "flags": 0, "usePreview": 0, "tags": ["lovemath"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "//Function002\nfloat f(float x)\n{\n    float y = 0.0;\n    float size = 0.125;\n    float speed = 3.14;\n    while(size > 0.0001)\n    {\n        //y += sin(x * speed + iTime) * size;\n        y += abs(sin(x * speed + iTime) * size);\n        speed *= 2.5;\n        size *= 0.6;\n    }\n    return y + 0.19;\n}\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    vec2 point = fragCoord / iResolution.yy;\n    //Relative to center:\n    point -= vec2(iResolution.x * 0.5 / iResolution.y, 0.5);\n    //x, y -> angle, length:\n    float len = length(point);\n    point = vec2(acos(point.x / len), len);\n    //Set color:\n    vec3 col = 0.5 + 0.5 * cos(iTime + point.xyx + vec3(0,2,4));\n    if(abs( f(point.x / 3.14) - point.y ) < 0.01)\n    \tfragColor = vec4(col, 1);\n    else\n        fragColor = vec4(0, 0, 0, 1);\n        \n}", "name": "Image", "description": "", "type": "image"}]}