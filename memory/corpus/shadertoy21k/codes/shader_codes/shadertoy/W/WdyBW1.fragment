{"ver": "0.1", "info": {"id": "WdyBW1", "date": "1606974034", "viewed": 78, "name": "Trippy Folds", "username": "ChutneyPot", "description": "Just playing around with colors and uvs.", "likes": 3, "published": 1, "flags": 0, "usePreview": 0, "tags": ["trippy"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    vec2 uv = (2.0 * fragCoord - iResolution.xy) / iResolution.y;\n    \n    vec3 col = vec3(0.0);\n    \n    uv *= sin(iTime / 2.0) + 1.5;\n    uv = abs(uv);\n    \n    float ang = (cos(iTime) + 1.0) * 2.0;\n    uv *= mat2(cos(ang), sin(ang), -sin(ang), cos(ang));\n    \n    float aud = texture(iChannel0, uv).x;\t    \n \n    uv = fract(uv);\n    col += fract(uv.x + iTime) + fract(uv.y + iTime);\n    \n    vec3 rgb = 0.5 + 0.5 * cos(iTime + uv.xyx + vec3(0,2,4));\n    col *= rgb;\n    \n    fragColor = vec4(col,1.0);\n}", "name": "Image", "description": "", "type": "image"}]}