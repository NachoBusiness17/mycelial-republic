{"ver": "0.1", "info": {"id": "WdycRw", "date": "1602404835", "viewed": 5361, "name": "cinetunnel", "username": "tomviolin", "description": "for cineshader\n\n", "likes": 5, "published": 3, "flags": 0, "usePreview": 0, "tags": ["cineshader"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    vec2 center = iResolution.xy/2.;\n    center.x = center.x + sin(iTime*6.)*iResolution.x*.03;\n    center.y = center.y + cos(iTime*5.4)*iResolution.x*.033;\n    float d = length(vec2(fragCoord.x,fragCoord.y) - center)/iResolution.x;\n    float a = -atan(fragCoord.y-center.y,fragCoord.x-center.x)*6.;\n    float r = (sin(a+3.14159*4./3.+4./d*1.+iTime*6.)*.5+.5)*d*2.;\n    float g  = (sin(a+3.14159*2./3.+4./d*1.+iTime*6.)*.5+.5)*d*2.;\n    float b = (sin(a+4./d*1.+iTime*6.)*.5+.5)*d*2.;\n    float w = (sin(a*4.+3.14159*2./3.+3./d*1.+iTime*6.)*.5+.5)*1.*sin(a*7.);\n    w=w>.6?3.:0.;\n    w=w*d;\n    fragColor = vec4(\n        clamp(w+r,0.,1.),\n        clamp(w+g,0.,1.),\n        clamp(w+b,0.,1.),\n        atan(5.-1./d)/3.14159*2.+4.);\n}\n", "name": "Image", "description": "", "type": "image"}]}