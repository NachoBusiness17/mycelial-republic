{"ver": "0.1", "info": {"id": "WlGSzy", "date": "1582947473", "viewed": 107, "name": "movingcross", "username": "NY", "description": "aa", "likes": 1, "published": 1, "flags": 0, "usePreview": 0, "tags": ["2d"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "vec2 brickTile(vec2 st, float zoom)\n{\n    // \u62e1\u5927\n    st *= zoom;\n    // \u5ea7\u6a19\u3068\u539f\u70b9\u306e\u30e9\u30b8\u30a2\u30f3\n    float radian = atan(st.y,st.x);\n    //\u7e26\u6a2a\u3069\u3061\u3089\u3092\u52d5\u304b\u3059\u304b\u3000\n    float isMoveLine = step(0.499999,(fract(iTime)));\n    // mod\u3068floor\u3092\u5947\u6570\u884c\u3068\u5076\u6570\u884c\u30920\u30681\u306b\n    // isMoveLine\u3067\u505c\u6b62\u3059\u308b\u6642\u9593\u3092\u4f5c\u308b\n    vec2 f = (floor(mod(st,2.))* 2. -1. ) * iTime;\n    st.x +=  f.y * isMoveLine * 2.;\n    st.y +=  f.x * (mod(isMoveLine + 1.,2.)) * 2.;\n    return fract(st);\n} \n\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    // Normalized pixel coordinates (from 0 to 1)\n    vec2 uv = fragCoord/iResolution.y;\n    \n    uv = brickTile(uv,5.);\n\n   vec3 col = vec3(smoothstep(0.29,0.3, length(uv - 0.5)));\n\n    // Output to screen\n    fragColor = vec4(col,1.0);\n}", "name": "Image", "description": "", "type": "image"}]}