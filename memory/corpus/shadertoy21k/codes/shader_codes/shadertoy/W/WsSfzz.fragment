{"ver": "0.1", "info": {"id": "WsSfzz", "date": "1589337020", "viewed": 203, "name": " Various Spider Silk Shapes", "username": "kass", "description": "hey", "likes": 4, "published": 1, "flags": 0, "usePreview": 0, "tags": ["glsl"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "float uvrand(vec2 uv)\n{\n    return fract(sin(dot(uv, vec2(12.9898, 78.233))) * 43758.5453);\n}\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    vec2 coord = gl_FragCoord.xy;\n\n    const float pi = 3.1415926;\n    float t = floor(iTime * 1.1) * 7.3962;\n\n    vec2 sc = (coord.xy - iResolution.xy / 2.0) / iResolution.y;\n    float phi = atan(sc.y, sc.x + 1e-6);\n    vec2 pc = vec2(fract(phi / (pi * 2.f)), length(sc));  //\u6975\u5ea7\u6a19\n    \n    // \u653e\u5c04\n    float h_divnum = 5. + 10.*abs(sin(float(int(iTime))));\n    float s_divnum = 5. + 10.*abs(sin(float(int(iTime))));\n    \n    float ddth = fract(pc.x * h_divnum);\n    \n    // \u653e\u5c04\u533a\u5206\u3051\u3054\u3068\u306e\u30e9\u30f3\u30c0\u30e0\u5024\n    float h_id = (pc.x * h_divnum) - fract(pc.x * h_divnum); \n    float h_rand = uvrand(vec2(h_id,int(iTime)));\n    \n    // \u540c\u5fc3\u5186\u533a\u5206\u3051\u3054\u3068\u306e\u30e9\u30f3\u30c0\u30e0\u5024\n    float s_id  = (pc.y * s_divnum) - fract(pc.y * s_divnum); \n    int   is_id = int(s_id);   \n    \n    float s_rand = uvrand(vec2(float(s_id),int(iTime)));\n    \n\n    \n    // \u6a2a\u7dda\u3086\u304c\u307e\u305b\n    float l = pc.y+ ddth * (h_rand - 0.5) + ddth*(s_rand - 0.5)*0.2 ;\n    \n    // \u653e\u5c04\u30fb\u540c\u5fc3\u5186\n    \n    float thickness = 0.5- pc.y + (s_rand*0.1 + h_rand*0.1) + (0.02*sin((h_rand)*iTime*10.f)); // \u5fae\u5999\n    \n    float a = step(abs(sin( ( pc.x*pi*2.f  )  * s_divnum )),thickness * 0.5);\n    float b = step(abs(sin( ( pc.y*pi*2.f + h_rand + l)  * h_divnum )),thickness*0.5 );\n    \n    fragColor = vec4(a+b,a+b,a+b,1.0);\n}", "name": "Image", "description": "", "type": "image"}]}