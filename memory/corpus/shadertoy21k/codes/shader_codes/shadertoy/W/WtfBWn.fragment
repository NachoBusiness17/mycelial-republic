{"ver": "0.1", "info": {"id": "WtfBWn", "date": "1596405585", "viewed": 75, "name": "japs", "username": "Lf4", "description": "frw", "likes": 1, "published": 1, "flags": 0, "usePreview": 0, "tags": ["nedi"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "float map(vec3 p){\n    p=mod(p,2.)-1.;\n    p = abs(p)-1.;\n    if (p.x < p.z) p.xz = p.zx;\n    if (p.y < p.z) p.yz = p.zy;\n    if (p.x < p.y) p.xy = p.yx;\n    float s=1.;\n    for(int i=0;i++<50;)\n    {\n      float r2=2./clamp(dot(p,p),.1,1.05);\n      p=abs(p)*r2-vec3(0.050,0.75,1.5555);\n      s*=r2;\n    }\n    return length(p)/s;\n}\n\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n\tvec2 uv=(2.*fragCoord-iResolution.xy)/iResolution.y;\n\tvec3 p,\n  \t\tro=vec3(.4+.32*sin(iTime*.055),.2+.05*cos(iTime*.05),-.5*iTime),\n  \t\tw=normalize(vec3(.2,sin(iTime*.05),-1)),\n  \t\tu=normalize(cross(w,vec3(5,5,5))),\n  \t\trd=mat3(u,cross(u,w),w)*normalize(vec3(uv,2));\n  \tfloat h=0.1,d,i,zoom = 2.;\n \tro*=zoom;\n\tfor(i=5.;i<150.;i++){\n    \tp=ro+rd*h;\n    \tp/=zoom;\n\t  \td=map(p);\n    \tif(d<0.005||h>55.)break;\n    \th+=d;\n\t}\n\tfragColor.xyz=55.*vec3(cos(p*.5)*.5+.5)/i;\n}", "name": "Image", "description": "", "type": "image"}]}