{"ver": "0.1", "info": {"id": "wdBXzz", "date": "1552676618", "viewed": 52, "name": "Kurakin_Mashgraph_312", "username": "sheogarat1488", "description": "t-1000", "likes": 1, "published": 1, "flags": 0, "usePreview": 0, "tags": ["raymarching"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "#define max_steps 100\n#define max_dist 100.\n#define surface_dist .01\n//\u0432\u0441\u0435 \u0444\u0438\u0433\u0443\u0440\u044b \u0432\u0437\u044f\u0442\u044b \u0441 distfunctions.htm\n//5 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u0442\u0438\u043f\u0430 \u043f\u0440\u0438\u043c\u0438\u0442\u0432\u043e\u0432 - \u0442\u043e\u0440, \u043a\u0430\u043f\u0441\u0443\u043b\u0430, \u0441\u0444\u0435\u0440\u0430, \u0433\u0435\u043a\u0441\u0430\u0433\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u0440\u0438\u0437\u043c\u0430 \u0438 \u043a\u043e\u0440\u043e\u0431\u043a\u0430\n//5 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432 - \u043e\u0434\u0438\u043d \u0430\u043d\u0438\u043c\u0438\u0440\u043e\u0432\u0430\u043d\n//2 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430 \u0441\u0432\u0435\u0442\u0430\n\nfloat sdBox(vec3 p, vec3 b)//\u043f\u0435\u0440\u0432\u044b\u0439 \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442 \u0441\u0434\u0432\u0438\u0433, \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0440\u0430\u0437\u043c\u0435\u0440\u044b\n{\n  return length(max(abs(p) - b, 0.));\n}\n\nfloat sdSphere( vec3 p, float s )\n{\n  return length(p)-s;\n}\n\nfloat sdHexPrism( vec3 p, vec2 h )\n{\n    vec3 q = abs(p);\n    return max(q.z - h.y, max((q.x*0.866025 + q.y*0.5), q.y) - h.x);\n}\n\nfloat sdCapsule( vec3 p, vec3 a, vec3 b, float r)\n{\n    vec3 pa = p - a;\n    vec3 ba = b - a;\n    float t = clamp(dot(pa,ba) / dot(ba,ba), 0., 1.); //\u043d\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u0443\u0442\u0435\u043c / \u043f\u043e\u0442\u043e\u043c \u0441\u0443\u0436\u0435\u043d\u0438\u0435 t \n    return length(pa - ba*t) - r; //t - \u0441\u0443\u0442\u044c \u0448\u0430\u0433\u0438\n}\n\nfloat sdTorus(vec3 p, vec2 t)\n{\n  vec2 q = vec2(length(p.xz) - t.x, p.y);\n  return length(q) - t.y;\n}\n\nfloat opS(float d1, float d2)//\u0432\u044b\u0447\u0438\u0442\u0430\u043d\u0438\u0435 \u0444\u0438\u0433\u0443\u0440\n{\n    return max(-d1, d2);\n}\n\n\n\n\nfloat GetDist (vec3 p) \n{\n    float dP = p.y; //planedistance - \u043f\u043e\u043a\u0430 \u043f\u043b\u043e\u0441\u043a\u0430\u044f \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c\n    float hd = sdHexPrism(p - vec3(2, 1.5, 6), vec2 (0.3, 0.2));\n    float cd = sdCapsule(p, vec3(0, 1, 6), vec3 (1, 2, 6), .2);\n    float bd = sdBox(p - vec3(-3, .75, 6), vec3(.75));\n    float sd = sdSphere(p - vec3(-3, .75, 6), 1.); \n    float td = sdTorus(p - vec3(0, 0.5,6), vec2(1.5, .2)); //\u043a\u043e\u0433\u0434\u0430 \u0432\u044b\u0447\u0438\u0442\u0430\u0435\u043c - \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0433\u0430\u0435\u043c \u0442\u043e\u0440\n  \t\n    float bd1 = sdBox(p - vec3(4, .75, 6), vec3(.75));\n    float sd1 = sdSphere(p - vec3(4, .75, 6), 1.); \n    float e = mix(sd1, bd1, sin(iTime) * .9); //\u0430\u043d\u0438\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043e\u0431\u044a\u0435\u043a\u0442\n    \n    float c = opS(sd, bd);//\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u0441\u043f\u043b\u043e\u0448\u043d\u043e\u0439 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438\n    float d = min(cd, dP);\n    d = min(d, td);\n    d = min(d, hd);\n    d = min(d, c);\n    d = min(d, e);\n    return d;\n}\n\nfloat RayMarch (vec3 ro, vec3 rd) \n{\n\tfloat dO = 0.; //dO - \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043e\u0442 \u0433\u043b\u0430\u0437\u0430\n\tfor (int i = 0; i < max_steps; i++) //\u043d\u0435 \u0445\u043e\u0442\u0438\u043c \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0431\u043b\u0438\u0437\u043a\u043e \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0430\u0442\u044c\u0441\u044f\n    {\n        vec3 p = ro + dO * rd; //p - \u0442\u0435\u043a\u0443\u0449\u0435\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043c\u0430\u0440\u0448\u0430\n        float dS = GetDist(p);\n        dO = dO + dS;\n        if (dS < surface_dist || dO > max_dist) //\u043d\u0430 \u0441\u043b\u0443\u0447\u0430\u0439 \u0435\u0441\u043b\u0438 \u043c\u044b \u0432\u043e\u043e\u0431\u0449\u0435 \u043d\u0435 \u0432\u0438\u0434\u0438\u043c \u043e\u0431\u044a\u0435\u043a\u0442 \u0438\u043b\u0438 \u0434\u043e\u0441\u0442\u0438\u0433\u043b\u0438 \u0436\u0435\u043b\u0430\u0435\u043c\u043e\u0439 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438\n        \tbreak;\n    }\n    return dO;\n}\n\nvec3 GetNormal (vec3 p)\n{\n    float d = GetDist(p);\n    vec2 e = vec2(.01, .0);\n    vec3 n = vec3(\n        d - GetDist(p - e.xyy),\n        d - GetDist(p - e.yxy),\n        d - GetDist(p - e.yyx)); //e.xyy =def= vec3(.01, 0, 0)\n    return normalize(n);\n}\n\nfloat GetLight (vec3 p) //\u043d\u0430 \u0432\u0445\u043e\u0434 \u0442\u043e\u0447\u043a\u0430, \u043b\u044f \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0445\u043e\u0442\u0438\u043c \u043d\u0430\u0439\u0442\u0438 \u0442\u0435\u043d\u044c\n{\n    vec3 lightPos = vec3(0, 5, 6); //\u043f\u043e\u0437\u0438\u0446\u0438\u044f \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430\n    lightPos.xz = lightPos.xz + vec2(sin(iTime), cos(iTime)) * 6.;//\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u043b\u0430\u043c\u043f\u043e\u0447\u043a\u0438 \n    vec3 l = normalize(lightPos - p); //\u0432\u0435\u043a\u0442\u043e\u0440 \u0441\u0432\u0435\u0442\u0430\n    vec3 n = GetNormal(p);\n    float dif = clamp(dot(n, l), 0., 1.); //clamp \u0441\u0436\u0438\u043c\u0430\u0435\u0442 \u043f\u0435\u0440\u0432\u043e\u0435 \u043c\u0435\u0436\u0434\u0443 2 \u0438 3 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0430\u043c\u0438\n    float d = RayMarch(p + n * surface_dist * 2., l); //\u0447\u0443\u0442\u044c \u043e\u0442\u043e\u0434\u0432\u0438\u0433\u0430\u0435\u043c \u043e\u0442 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 - \u0438\u043d\u0430\u0447\u0435 \u043d\u0443\u0443\u0443 \u0432\u0441\u0435 \u0442\u0435\u043c\u043d\u043e\u0435\n    if (d < length(lightPos - p)) //\u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u043c \u0432 \u0442\u0435\u043d\u0438 \u043b\u0438 \u043c\u044b\n    \tdif = dif * .1;\n    return dif;\n}\n\nfloat GetLight1 (vec3 p) \n{\n    vec3 lightPos = vec3(3, 5, -6); \n    vec3 l = normalize(lightPos - p); //\u0432\u0435\u043a\u0442\u043e\u0440 \u0441\u0432\u0435\u0442\u0430\n    vec3 n = GetNormal(p);\n    float dif = clamp(dot(n, l), 0., 1.);  \n    float d = RayMarch(p + n * surface_dist * 2., l); \n    if (d < length(lightPos - p)) \n    \tdif = dif * .1;\n    return dif;\n}\n\nvec3 R(vec2 uv, vec3 p, vec3 l, float z) //\u0432\u0437\u044f\u0442\u043e \u0438\u0437 \u0440\u043e\u043b\u0438\u043a\u0430 \u043d\u0430 \u044e\u0442\u0443\u0431\u0435, \u044f \u0441\u0434\u0435\u043b\u0430\u043b \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0432\u043e\u0440\u043e\u0442\n{\n    vec3 f = normalize(l-p),\n        r = normalize(cross(vec3(0,1,0), f)),\n        u = cross(f,r),\n        c = p+f*z,\n        i = c + uv.x*r + uv.y*u,\n        d = normalize(i-p);\n    return d;\n}\n\nmat2 Rot(float a) \n{\n    float s = sin(a);\n    float c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\n\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    vec2 uv = (fragCoord-.5*iResolution.xy)/iResolution.y;\n\tvec2 m = iMouse.xy/iResolution.xy; //\u0434\u0430\u0435\u043c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043c\u044b\u0448\u043a\u043e\u0439\n\n    vec3 col = vec3(0);\n    \n    vec3 ro = vec3(5, 4, 3); //\u0417\u0430\u0434\u0430\u0435\u043c \u043a\u0430\u043c\u0435\u0440\u0443, \u044d\u0442\u043e \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u044b \u0433\u043b\u0430\u0437\u0430\n    ro.yz *= Rot(-m.y);\n    ro.xz *= Rot(-m.x * 5.); //\u0443\u0441\u043a\u043e\u0440\u044f\u0435\u043c \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043a\u0430\u043c\u0435\u0440\u0430 \u0437\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u0435\u0442\u0441\u044f\n\tvec3 rd = R(uv, ro, vec3(0,0,0), .7); //\u044d\u0442\u043e ray direction = \u043a\u0443\u0434\u0430 \u043c\u044b \u0441\u043c\u043e\u0442\u0440\u0438\u043c, \u0432\u0435\u043a\u0442\u043e\u0440 \u043d\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d \u0432 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 R\n    \n  \n    float d = RayMarch(ro, rd); //from ray origin to ray dir\n    vec3 p = ro + rd * d;\n    \n    float dif = GetLight(p) + GetLight1(p);//diffused lightning\n    col = vec3(dif);\n\n    fragColor = vec4(col,1.0);     \n}", "name": "Image", "description": "", "type": "image"}]}