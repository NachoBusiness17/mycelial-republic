{"ver": "0.1", "info": {"id": "wdVfWz", "date": "1606945652", "viewed": 50, "name": "rtt", "username": "hpstrc", "description": "rtt", "likes": 3, "published": 1, "flags": 0, "usePreview": 0, "tags": ["rtt"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "float channel(vec2 uv, float t) {\n    vec2 pos = vec2(cos(t*1.02) * .5, sin(t*2.345) * .25);\n    \n    return .1/length(uv - pos);\n}\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    vec2 uv = (fragCoord-.5*iResolution.xy)/iResolution.y;\n\n    float t = iTime * .5;\n    \n    vec3 m = vec3(1. - uv.y -.6);\n    m *= .2;\n    \n    m = min(m, vec3(.001, .04, .1));\n    \n    float red = (channel(uv*.98, t + .015));\n    float green = (channel(uv, t));\n    float blue = (channel(uv*1.02, t - .015));\n\n    m += vec3(red, green, blue);\n    \n    fragColor = vec4(m, 1.0);\n}", "name": "Image", "description": "", "type": "image"}]}