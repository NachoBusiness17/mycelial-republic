{"ver": "0.1", "info": {"id": "wdlBDj", "date": "1589124962", "viewed": 229, "name": "FireFunction", "username": "PoetLuchnik", "description": "burn?", "likes": 1, "published": 3, "flags": 0, "usePreview": 0, "tags": ["fire"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "float f(float x)\n{\n    float y = 0.0;\n    float size = 0.6;\n    float speed = 13.0;\n    float i = 0.0;\n    \n    while(size > 0.001)\n    {\n        y += sin(x * speed + iTime * 16.0 + i) * size;\n        speed *= 2.0;\n        size *= 0.7;\n        i += 13.0;\n    }\n    \n    return y + 0.5;\n}\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    // Normalized pixel coordinates (from 0 to 1)\n    vec2 uv = fragCoord / iResolution.xy;\n\n    // Time varying pixel color\n    float p = 3.0 - uv.y * 3.8 + f(uv.x) * 0.3;\n    vec3 col = vec3(0);\n\n    col.r = p;\n    p -= 1.0;\n   \tcol.g = p;\n   \tp -= 1.0;\n    col.b = p;\n\n    // Output to screen\n    fragColor = vec4(col, 1.0);\n}", "name": "Image", "description": "", "type": "image"}]}