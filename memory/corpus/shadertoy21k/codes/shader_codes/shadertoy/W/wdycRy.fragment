{"ver": "0.1", "info": {"id": "wdycRy", "date": "1603116978", "viewed": 64, "name": "Scrolling Truchet Tiles", "username": "oneshade", "description": "I watched The Art of Code's video explaining truchet tiling and this is what I learned from it.", "likes": 2, "published": 1, "flags": 0, "usePreview": 0, "tags": ["procedural", "truchet", "tiling", "quad"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "float Hash21(in vec2 id) {\n    vec2 n = id * fract(dot(id, vec2(534.75, 65.54)));\n    return fract(dot(id + n, n));\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n    vec2 uv = ((fragCoord - 0.5 * iResolution.xy) / iResolution.y) * 10.0 + iTime;\n    vec2 cellLocation = floor(uv);\n    vec2 cellLocalUV = fract(uv) - 0.5;\n    cellLocalUV.x *= Hash21(cellLocation) < 0.5 ? -1.0 : 1.0;\n\n    vec2 circleUV = cellLocalUV - (cellLocalUV.x + cellLocalUV.y < 0.0 ? -1.0 : 1.0) * 0.5;\n    float circleDist = length(circleUV) - 0.5;\n    vec3 color = vec3(smoothstep(0.3, 0.0, abs(circleDist)));\n\n    fragColor = vec4(color, 1.0);\n}", "name": "Image", "description": "", "type": "image"}]}