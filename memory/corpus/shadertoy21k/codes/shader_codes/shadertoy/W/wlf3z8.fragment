{"ver": "0.1", "info": {"id": "wlf3z8", "date": "1555601917", "viewed": 72, "name": "simple metaball test", "username": "mxr233", "description": "a simple metaball test.", "likes": 1, "published": 1, "flags": 0, "usePreview": 0, "tags": ["metaball"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "float circle(vec2 uv,float r)\n{\n    return r/length(uv);\n}\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    // Normalized pixel coordinates (from 0 to 1)\n    vec2 uv = (2.*fragCoord-iResolution.xy)/iResolution.y;\n\tvec2 mouseUV=(2.*iMouse.xy-iResolution.xy)/iResolution.y;\n    // Time varying pixel color\n    vec2 s[3];\n    s[0]=mouseUV;\n\ts[1]=vec2(-1,0)*sin(iTime*0.5);\n    s[2]=vec2(1,0)*sin(iTime*0.5);\n    float t=smoothstep(0.2,0.7,circle(uv-s[1],0.1));\n    t+=smoothstep(0.2,0.7,circle(uv-s[0],0.1));\n    t+=smoothstep(0.2,0.7,circle(uv-s[2],0.1));\n    // Output to screen\n    fragColor = vec4(t*sin(iTime*2.),t,t*cos(iTime),1.0);\n}", "name": "Image", "description": "", "type": "image"}]}