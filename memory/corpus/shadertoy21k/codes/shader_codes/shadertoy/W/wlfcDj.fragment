{"ver": "0.1", "info": {"id": "wlfcDj", "date": "1593072629", "viewed": 52, "name": "moir\u00e9_1", "username": "TAKUSAKU", "description": "moir\u00e9", "likes": 5, "published": 1, "flags": 0, "usePreview": 0, "tags": ["moir"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 o, in vec2 FC )\n{\n    vec3 u=normalize(vec3(2.*FC-iResolution.xy,(1e3-6.)*8.))*5e4;\n    for(int i=0;i<9;i++)\n        u.x+=fract(u.y+iTime)*.2,\n        u.xy+=sin(u.y+iTime*6.)*.1,\n        o=cos(float(u)+vec4(.3,.1,0,0));\n}", "name": "Image", "description": "", "type": "image"}]}