{"ver": "0.1", "info": {"id": "wlyGDm", "date": "1579065431", "viewed": 48, "name": "single circle", "username": "hocchang", "description": "single circle", "likes": 0, "published": 1, "flags": 0, "usePreview": 0, "tags": ["singlecircle"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    // Normalized pixel coordinates (from 0 to 1)\n    vec2 uv = fragCoord/iResolution.xy;\n    float r =  iResolution.y / 2.0;\n    if(distance(fragCoord, iResolution.xy / 2.0) < r)\n    {\n        // Time varying pixel color\n        vec3 col = 0.5 + 0.5*cos(iTime+uv.xyx+vec3(0,2,4));\n        // Output to screen\n        fragColor = vec4(col,1.0);\n    }\n    else\n    {\n        // Output to screen\n    \tfragColor = vec4(1.0);\n    }\n\n\n\n\n}", "name": "Image", "description": "", "type": "image"}]}