{"ver": "0.1", "info": {"id": "wsXSzM", "date": "1551107573", "viewed": 409, "name": "Glare circle", "username": "noriben", "description": "Glare circle.", "likes": 2, "published": 3, "flags": 0, "usePreview": 0, "tags": ["glare"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    \n    //mouse\n    vec2 mouse = (iMouse.xy *2.0 - iResolution.xy) / min(iResolution.x, iResolution.y);\n    // Normalized pixel coordinates (from 0 to 1)\n    vec2 uv = (fragCoord.xy * 2.0 - iResolution.xy) / min(iResolution.x, iResolution.y);\n\n    \n \n    // \u52d5\u3044\u3066\u308b\u30ea\u30f3\u30b0 Ring\n    float circleHigh1 = 0.02 / abs(tan(2.0 * iTime) - distance(uv.xy, mouse));\n    // \u8272\u4ed8\u3051 Coloring    \n    vec3 highCol1 = vec3(circleHigh1) * vec3(0.3, 0.3, 0.7);\n    \n    \n    // \u5186 Circle\n    float circle1 = 0.1 / distance(uv.xy, mouse.xy); //\u8d64\u306e\u5186\u306f\u30de\u30a6\u30b9\u3067\u52d5\u304f\n    float circle2 = 0.1 / distance(uv.xy, vec2(0.1, 0.0));\n    \n    // \u7dd1\u3068\u8d64\u306b\u8272\u4ed8\u3051 Coloring\n    vec3 col1 = vec3(circle1) * vec3(0.7, 0.3, 0.3);\n    vec3 col2 = vec3(circle2) * vec3(0.3, 0.7, 0.3);\n    \n    //\u5408\u6210\n    vec3 color = col1 + col2 + highCol1;\n    \n\n    // Output to screen\n    fragColor = vec4(color, 1.0);\n}", "name": "Image", "description": "", "type": "image"}]}