{"ver": "0.1", "info": {"id": "wtGSWG", "date": "1583786314", "viewed": 239, "name": "\u00f6laksdfgjalk\u00f6djf", "username": "lennyjpg", "description": "sadasdfa", "likes": 4, "published": 3, "flags": 0, "usePreview": 0, "tags": ["asdfasdfasdf"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    vec2 uv = fragCoord/iResolution.xy;  \n    vec2 u = uv;\n    u *= 1.;\n    float t = iTime * 3.3;\n    float e = u.y - 0.3 ;\n    e += sin(u.x * 7.0 - t ) * .1;\n    float f = pow(u.x - 0.5,2.0)*3.0;\n    e += sin(f*1.0+t*0.5)*0.1;\n    e -= cos(u.x*17.241-t*1.22)*0.02;\n    e*=2.5;\n    float k = smoothstep(e,f,f*1.05); \n    float m = step(f,e);\n    vec3 a = vec3(33.,33.9,1.1);\n    vec3 b = vec3(1.0,0.2,0.3);\n    vec3 c = mix(a,b,m / k);\n    c.r *= uv.x / uv.y;\n    fragColor = vec4(c,1.0);\n}", "name": "Image", "description": "", "type": "image"}]}