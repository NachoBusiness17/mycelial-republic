{"ver": "0.1", "info": {"id": "Xls3Rl", "date": "1425484670", "viewed": 229, "name": "Wave it", "username": "TomoAlien", "description": "Uh.\n\nI don't know what to say about this :P", "likes": 4, "published": 1, "flags": 0, "usePreview": 0, "tags": ["2d", "wave", "blue", "purple"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n\tvec2 uv = fragCoord.xy / iResolution.xy;\n    float x = uv.x*2.0;\n    float y = uv.y;\n    float n = iTime*4.0;\n    float bom = (x*32.0+atan(y*8.0-4.+sin(n/4.0+sin(x*2.0+sin(y*2.0)))*4.)*32.0+n);\n    float abe = cos((bom)/4.);\n    float clo = clamp(abe,0.,1.);\n    float cla = clamp(-abe,0.,1.);\n\tfragColor = vec4(-clo*0.75+abs(sin(x-n/3.))*cla*0.7,sin(x+n/4.)*cla,abs(abe),1.0);\n}", "name": "", "description": "", "type": "image"}]}