{"ver": "0.1", "info": {"id": "XslSRj", "date": "1404120627", "viewed": 380, "name": "Circular", "username": "r1", "description": "Simple black and white. Increased the amplitude of the sine wave to provide some pseudo antialiasing. ", "likes": 9, "published": 1, "flags": 0, "usePreview": 0, "tags": ["2d"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n\t\n\tfloat d = distance(fragCoord.xy, iResolution.xy * vec2(0.5,0.5).xy);\n\t\n\tfloat x = sin(5.0+0.1*d + iTime*-4.0) * 5.0;\n\t\n\t// some drivers don't appear to cope with over ranged values. \n\tx = clamp( x, 0.0, 1.0 );\n\t\n\tfragColor = vec4( x, x, x, 1 );\n}", "name": "", "description": "", "type": "image"}]}