{"ver": "0.1", "info": {"id": "XsscD8", "date": "1487997848", "viewed": 91, "name": "Heart 2D", "username": "TrueBoolean", "description": "Based on IQ's awesome youtube video: https://www.youtube.com/watch?v=aNR4n0i2ZlM&t=1s\n\nReally helped me see how to make shapes and animation more organic-looking in shaders.", "likes": 1, "published": 1, "flags": 0, "usePreview": 0, "tags": ["heart"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 o, in vec2 p ){\n    const float TAU = atan(0., -1.) *2.;\n    float aa = 6.0 / iResolution.y;\n\tp = ((p.xy/iResolution.y)-(iResolution.xy/iResolution.y)/2.)*4.;\n    o = vec4(1.);\n    //Shape\n    float r = 1. + 0.2*pow(0.5 + 0.5*sin(iTime * TAU + p.y/2.), 4.);\n    p.x = abs(p.x);\n    p.y = p.y - p.x*sqrt((1.7-p.x));\n    p.y/=0.7;\n    o.gb*= smoothstep( r, r+aa, length(p) );\n}", "name": "Image", "description": "", "type": "image"}]}