{"ver": "0.1", "info": {"id": "Xts3WH", "date": "1421709612", "viewed": 2709, "name": "[2TC 15] Lava Lamp", "username": "Trisomie21", "description": "[2TC 15] Lava Lamp", "likes": 13, "published": 1, "flags": 0, "usePreview": 0, "tags": ["noise"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [], "code": "void mainImage( out vec4 c, in vec2 w )\n{\n\tvec2 p = w/iResolution.xy, a = p*5.; a.y -= iTime;\n\tvec2 f = fract(a); a -= f; f = f*f*(3.-2.*f);\n    vec4 r = fract(sin(vec4(a.x + a.y*1e3) + vec4(0, 1, 1e3, 1001)) * 1e5)*30./p.y;\n\tc.rgb = p.y + vec3(1,.5,.2) * clamp(mix(mix(r.x, r.y, f.x), mix(r.z, r.w, f.x), f.y)-30., -.2, 1.);\n}", "name": "", "description": "", "type": "image"}]}