{"ver": "0.1", "info": {"id": "fdB3RK", "date": "1617625726", "viewed": 60, "name": "3p Shader", "username": "atteherttala", "description": "Wavy", "likes": 0, "published": 1, "flags": 0, "usePreview": 0, "tags": ["waves"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    // Normalisoidut pikselin koordinaatit (0:sta 1)\n    vec2 uv = fragCoord/iResolution.xy;\n\n    //Pikselin v\u00e4ri (R,G,B)\n    vec3 col = vec3(0,0,0);\n    \n\n    //Jos pikselin (x,y) y-koordinaatti on pienempi kuin sin(x) (sek\u00e4 kertoimia jotta saadaan mahtumaan koko n\u00e4yt\u00f6lle)\n    if(uv.y < 0.5*sin(iTime + uv.x*10.0)+0.5)col = \n\n    //Alhaalta yl\u00f6sp\u00e4in tulevat aaltojen kertoimet, joilla kerrotaan sinist\u00e4 v\u00e4ri\u00e4.\n    0.7/(0.5*sin(iTime + uv.x * 10.0) -uv.y - 0.5) *\n\n    //Itse v\u00e4ri, jossa sinist\u00e4 v\u00e4ri\u00e4 lis\u00e4t\u00e4\u00e4n cos(aika) mukaan\n    0.4 * vec3(0,1,cos(iTime * 8.0));\n    \n\n    //Jos pikselin (x,y) y-koordinaatti on suurempi kuin sin(x)\n    if(uv.y > 0.5*sin(iTime + uv.x*10.0)+0.5)col = \n\n    //Tummuuskerroin kohtiin jotka ovat l\u00e4hell\u00e4 sinin \"reunaa\"\n    (uv.y - 0.5*sin(iTime + uv.x*10.0)+0.5) * 0.2\n    \n    //Itse v\u00e4ri jossa vihre\u00e4\u00e4 v\u00e4ri\u00e4 lis\u00e4t\u00e4\u00e4n sin(aika) mukaan\n    + 0.1* vec3(1,sin(iTime*10.0),0);\n\n\n\n    // Asetetaan v\u00e4ri ruudulle\n    fragColor = vec4(col,1.0);\n}", "name": "Image", "description": "", "type": "image"}]}