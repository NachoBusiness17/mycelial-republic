{"ver": "0.1", "info": {"id": "fdcXRM", "date": "1632975186", "viewed": 96, "name": "hyz\u9713\u8679\u5b66\u4e60", "username": "huangyz", "description": "\u5b66\u4e60\u7528", "likes": 8, "published": 1, "flags": 0, "usePreview": 0, "tags": ["2d"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "\nfloat rand(vec2 p){\n    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);\n}\n\nfloat drawLayer(float cellNum,vec2 uv){\n    //\u7eb9\u7406\u5750\u6807\u653e\u5927cellNum\u500d\uff0c\u76ee\u7684\u662f\u4e3a\u4e86\u5c06\u5c4f\u5e55\u5206\u5272\u6210cellNum * (cellNum*ratio)\u5757\uff0c\u7136\u540e\u8ba1\u7b97\u51facoord\u548cpt\n    vec2 uv0 = uv*cellNum;\n    //\u907f\u514d\u6392\u5217\u592a\u6574\u9f50\uff0c\u6839\u636ey\u5750\u6807\u968f\u673a\u5de6\u53f3\u5e73\u79fb\n    uv0.x+=rand(vec2(floor(uv0.y)));\n    \n    //\u5f53\u524d\u662f\u54ea\u4e00\u4e2a\u683c\u5b50\n    vec2 coord = floor(uv0);\n    //\u5f53\u524d\u8fd9\u4e2a\u70b9\uff0c\u5728\u8fd9\u4e2a\u683c\u5b50\u5185\u7684\u5750\u6807\uff0cxy\u7684\u503c\u8303\u56f4\u30100,1\u3011\n    vec2 pt = fract(uv0);\n    \n    //\u968f\u673a\u51fa\u4e00\u4e2a\u534a\u5f84\u5927\u5c0f\uff0c\u6b64\u65f6\u4e3a\u30100,1\u3011\n    float radius = rand(coord);\n    //\u4e00\u4e2a\u8ddf\u534a\u5f84\u76f8\u5173\u7684\u4eae\u5ea6\n    float strength = radius;\n    \n    //\u771f\u5b9e\u5f84\u8303\u56f4\u30100.2,0.45\u3011*1.0/cellNum;\n    radius = radius*0.25+0.2;\n    \n    //\u53bb\u63892/3\u7684\u70b9\n    if(mod(radius*10.0,3.0)<2.0){\n        return 0.0;\n    }\n    \n    //\u5f53\u524d\u70b9\u8ddd\u79bb\u5706\u5fc3\u7684\u8303\u56f4\n    float dis = distance(pt,vec2(0.5,0.5));\n    \n    //\u5f3a\u5ea6\u6700\u540e\u518d\u6574\u4f53\u6839\u636ecellNum\u533a\u5206\u4e00\u4e0b\uff0c\u52a0\u5f3a\u5c42\u6b21\u611f\n    strength*=1.0/cellNum*12.0;\n    //strength*=1.0-dis*2.0;\n\n    //\u753b\u5706\n    float a = smoothstep(radius-0.03,radius,dis);\n    a = 1.0-a;\n    \n    a*=strength;\n    return a;\n}\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    //\u7eb9\u7406\u5750\u6807\u5f52\u4e00\u5316\uff0cy\u8f740-1\n    vec2 uv = fragCoord/iResolution.y;\n    vec3 col = vec3(0.0,0.0,0.0);\n    \n    //\u4e09\u5c42\u989c\u8272\n    vec3 arr[3];\n    arr[0] = vec3(0.64,0.18,0.80);    \n    arr[1] = vec3(0.67,0.71,0.31);\n    arr[2] = vec3(0.9,0.0,0.2);\n    \n    //\u80cc\u666f\u8272\n    vec3 color_left = vec3(0.79,0.28,0.29);\n    vec3 color_right = vec3(0.4,0.4,0.2);\n    \n    float z = 0.0;//\u8bb0\u5f55\u8fd9\u4e2a\u70b9\u662f\u5426\u5df2\u7ecf\u7ed8\u5236\u8fc7\n    //\u5206\u4e09\u5c42\u7ed8\u5236\uff0c\u989c\u8272\u76f8\u52a0\n    for(int i=0;i<=2;i++){\n        vec3 color = arr[i];\n        //cellNum \u6bcf\u4e00\u5c42\u5c06\u5c4f\u5e55\u5206\u6210\u591a\u5c11\u4e2a\u683c\u5b50\n        float cellNum = float(i)*2.5+5.0;\n        //\u968f\u673a\u51fa\u4e00\u4e2a\u65b9\u5411\uff0c\u6839\u636e\u65f6\u95f4\u505a\u504f\u79fb\n        vec2 uvoff = vec2( rand( vec2(cellNum*2.0) ), 0.5+0.5*rand( vec2( cellNum * 12.0 ) ) );\n        uvoff = uvoff * iTime * 0.1;\n        vec2 pt = uv+uvoff;\n        \n        //\u5f53\u524d\u5750\u6807\u7684\u900f\u660e\u5ea6\n        float a=drawLayer(cellNum,pt);\n        \n        //\u5df2\u7ecf\u6709\u989c\u8272\u7684\uff0c\u907f\u514d\u8986\u76d6\uff0c\u4ee5\u514d\u5206\u5c42\u7a7f\u5e2e\n        if(z<0.01){\n            col += color*a;\n        }\n        z += a;\n    }\n    \n    col+=mix(color_left,color_right,uv.x);\n    \n    // Output to screen\n    fragColor = vec4(col,1.0);\n\n}", "name": "Image", "description": "", "type": "image"}]}