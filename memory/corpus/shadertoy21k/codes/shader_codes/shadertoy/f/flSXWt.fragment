{"ver": "0.1", "info": {"id": "flSXWt", "date": "1628814787", "viewed": 62, "name": "\u5f69\u8679\u5708", "username": "tangyuan", "description": "\u5f69\u8679\u5706\u73af", "likes": 3, "published": 1, "flags": 0, "usePreview": 0, "tags": ["2d"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "#define PI 3.14159256\n\n//\u5f69\u8679\u63d2\u8272\u51fd\u6570\nvec3 rainbowColor(float t) {\n    return .5 + .5 * cos(6.283 * (t + vec3(0., .33, .67)));\n}\n\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    // \u5750\u6807\u8f6c\u6362\u81f3\u5c4f\u5e55\u4e2d\u5fc3\u53d8\u4e3a-1\u81f31\n    vec2 uv = (2. * fragCoord - iResolution.xy) / iResolution.y;\n    //0 - 0.5\n    float len = length(uv);\n    //\u76f8\u5bf9\u4e2d\u5fc3\u7684\u89d2\u5ea6\n    float angle = atan(uv.y, uv.x);\n    //n 2PI\n    float f = angle / PI / 2. - iTime;\n    f = fract(f);\n    // \u989c\u8272\n    vec3 circleColor = rainbowColor(f);\n    \n    //\u753b\u5706\uff0c\u5e76\u4e14\u5f69\u8679\u8272\u6839\u636ef\u518d\u548c\u9ed1\u8272\u6df7\u8272\n    circleColor = len < 0.4 || len > 0.5 ? vec3(0.): mix(circleColor, vec3(0.), 1. - f);\n\n    // Output to screen\n    fragColor = vec4(circleColor,1.0);\n}", "name": "Image", "description": "", "type": "image"}]}