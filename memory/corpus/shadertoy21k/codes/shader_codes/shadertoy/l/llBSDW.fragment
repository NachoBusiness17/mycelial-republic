{"ver": "0.1", "info": {"id": "llBSDW", "date": "1443615992", "viewed": 102, "name": "Phong Lumi\u00c3\u00a8re mouvante", "username": "Lihouf", "description": "Phong Lumi\u00c3\u00a8re mouvante", "likes": 1, "published": 1, "flags": 0, "usePreview": 0, "tags": ["phong"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n\tvec2 uv = gl_FragCoord.xy / iResolution.xy;\n    uv.x=uv.x*(16.0/9.0);\n    /////////////////////////////////////\n    //DECLARATION\n    /////////////////////////////////////\n    //position de la pam\u00c3\u00a9ra\n\tvec3 camera = vec3(0.0, 0.0, -2.0);\n    \n\tvec3 direction = normalize(vec3(uv, 1.0));\n    \n    //Point actuel \n    vec3 point=camera;\n    \n    //Position de la lumi\u00c3\u00a8re\n    vec3 lumiere=vec3(5.0*sin(iTime),1.0,-2.0);\n    \n    //Intensit\u00c3\u00a9 et couleur de la lumi\u00c3\u00a8re ambiante Compris entre 0 et 1\n    vec3 ambiant=vec3(0.01,0.01,0.2);\n    \n    //Position de la sph\u00c3\u00a8re\n    vec3 centreSphere=vec3(1.0,1.0,1.0);\n    \n    //Couleur de fond\n    fragColor = vec4(1.0,1.0,1.0,1.0);\n    \n    //Raymarching\n    for(int i=1;i<512;i++)\n    {\n        //D\u00c3\u00a9calage raymarching\n        point=point+direction*0.01;\n        \n        //Si l'on se situe\n        if(distance(point,centreSphere)<=1.0){\n            //Normal de la surface N\n          \tvec3 normalSurface = normalize(point-vec3(1.0,1.0,1.0));\n            //Normal de la lumi\u00c3\u00a8re L\n            vec3 normLumiere = normalize(lumiere-point);\n            //Normal de la cam\u00c3\u00a9ra V\n            vec3 normVue = normalize(camera-point);\n            \n            //R\u00c3\u00a9flection R\n         \tvec3 R = 2.0*max(dot(normalSurface,normLumiere),0.0)*normalSurface-normLumiere;\n\t\t\t\n            //Intensit\u00c3\u00a9 de la lumi\u00c3\u00a8re diffuse\n            float diffuse=max(dot(normalSurface,normLumiere),0.0);\n            \n            //Intensit\u00c3\u00a9 de la lumi\u00c3\u00a8re sp\u00c3\u00a9culaire\n            float speculaire=pow(max(dot(R,normVue),0.0),64.0);\n\t\t\t\n            \n            float res=diffuse+iMouse.x*(speculaire/iResolution.x);\n            \n            //Couleur de la shp\u00c3\u00a8re\n            \n            fragColor = vec4(ambiant.x+res,ambiant.y+res,ambiant.z+res,1.0);\n            break;\n        }\n    }\n}", "name": "", "description": "", "type": "image"}]}