{"ver": "0.1", "info": {"id": "lllBWl", "date": "1514020322", "viewed": 57, "name": "Circle & Pillar", "username": "FEI", "description": "\u5706\u5f62\u5185\u90e8\u7684\u67f1\u5b50\u79fb\u52a8\u6548\u679c", "likes": 0, "published": 1, "flags": 0, "usePreview": 0, "tags": ["circle", "pillar"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n\tvec2 uv = fragCoord.xy / iResolution.xy;\n    float r = iResolution.y / 2.5;\n    vec2 center = iResolution.xy / 2.0;\n    float dis = distance(fragCoord.xy , center);\n    float t = clamp(r - dis, 0.0, 1.0);\n    \n    \n    float c = fragCoord.x / 8.0;\n    \n    c = cos(c - iTime) * 0.5 + 0.5;\n    // c = step(0.5, c);\n    \n    vec4 background = vec4( 0.1, 0.2, 0.3, 1.0);\n    vec4 color = vec4(c, c, c, min(t, c)); // min(t, c)\n    \n\tfragColor = mix(background, color, color.a);\n}", "name": "Image", "description": "", "type": "image"}]}