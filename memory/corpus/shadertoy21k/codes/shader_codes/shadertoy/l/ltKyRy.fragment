{"ver": "0.1", "info": {"id": "ltKyRy", "date": "1536826265", "viewed": 75, "name": "Wave test 2", "username": "budsan", "description": "Second version of the ps3 menu waving thing in the background, but my color selection.", "likes": 0, "published": 1, "flags": 0, "usePreview": 0, "tags": ["2d", "wave"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    float mn = min(iResolution.x, iResolution.y);\n    vec2 uv = fragCoord/mn;\n\n    vec3 col1 = vec3(uv.x, 0.0, uv.y);\n    vec3 col2 = vec3(0.0, 0.5 + uv.y * 0.5, uv.x);\n    float s1 = 0.1 * sin(iTime + (uv.x * 5.0)) + 0.5 - uv.y;\n    float s2 = 0.2 * cos(iTime * 0.5 + (uv.x *2.0)) + 0.5 - uv.y;\n    \n    float m = smoothstep(0.0001, -0.0001, s1 * s2);\n    vec3 col = mix(col1, col2, m);\n\n    fragColor = vec4(col,1.0);\n}", "name": "Image", "description": "", "type": "image"}]}