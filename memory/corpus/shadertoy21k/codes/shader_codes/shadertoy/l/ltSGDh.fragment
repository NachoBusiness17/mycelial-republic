{"ver": "0.1", "info": {"id": "ltsGDH", "date": "1421879298", "viewed": 201, "name": "[2TC 15] Taser", "username": "Trisomie21", "description": "[2TC 15] Shock", "likes": 5, "published": 1, "flags": 0, "usePreview": 0, "tags": ["2d", "tweet"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [], "code": "#define S(b) length(p-o-(b)*clamp(dot(p-o,b) / dot(b,b), 0., 1.))\n\n#define A(i) vec2(x.x+i, fract(sin(x+i+iTime)*1e3)*(9.-abs(x+i)))\n\nvoid mainImage( out vec4 f, in vec2 w )\n{\n    vec2 p = w*18./iResolution.x - vec2(9, 1), x = floor(p)-.5, o=A(1.);\n\tf = vec4(2,1,2,1) - min(S(A(0.)-o), S(A(2.)-o))*4.;\n}\n\t\t    \n", "name": "", "description": "", "type": "image"}]}