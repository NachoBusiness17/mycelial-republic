{"ver": "0.1", "info": {"id": "ltVSRd", "date": "1485505206", "viewed": 87, "name": "firstshomam", "username": "Shoma_M", "description": "first", "likes": 2, "published": 1, "flags": 0, "usePreview": 0, "tags": ["first"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n\tfragColor = vec4(0);\n    for (int i = 0; i < 200; i++) {\n        vec2 uv = fragCoord.xy / iResolution.xy;\n    \tuv -= 0.5; //\u539f\u70b9\u4e2d\u5fc3\u306b\n        uv.x *= iResolution.x / iResolution.y; //xy\u306e\u5e45\u7d71\u4e00\n        \n    \tfloat t = iTime + float(i) * 0.1;\n    \tuv.x += 0.2 * sin(t * 2.); \n    \tuv.y += 0.2 * sin(t * 3.); //\u539f\u70b9\u4f4d\u7f6e\u3092\u79fb\u52d5\n    \n    \tfloat c = 1.0 / ( length(uv) * length(uv) ); //\u4e2d\u5fc3\u304b\u3089\u306e\u8ddd\u96e2\u306e2\u4e57\u306e\u9006\u6570\n    \tc *= 0.0001; //\u9069\u5f53\n    \n\t\tfragColor += vec4(c, c * .2, c , 1.0); //\u8272\u5909\u66f4\n    \n    }\n}", "name": "Image", "description": "", "type": "image"}]}