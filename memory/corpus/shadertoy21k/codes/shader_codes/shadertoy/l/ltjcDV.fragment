{"ver": "0.1", "info": {"id": "ltjcDV", "date": "1510216338", "viewed": 119, "name": "PAD Tutorial 09", "username": "dpadrial", "description": "a", "likes": 1, "published": 1, "flags": 0, "usePreview": 0, "tags": ["tutorial"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    \n    // \u753b\u9762\u4e0a\u306e\u5ea7\u6a19\u3092\u6c42\u3081\u308b.\n    // iTime\u306f\u3001\u73fe\u5728\u306e\u6642\u9593\u7d4c\u904e\u306b\u95a2\u3059\u308b\u5024\u3067\u6642\u9593\u7d4c\u904e\u3067\u5909\u5316\u3059\u308b\u3088\u3046\u306a\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u8868\u73fe\u306b\u5229\u7528\u3059\u308b.\n    // \u3053\u306e\u4f8b\u3067\u306f\u3001iTime\u3092sin\u95a2\u6570\u306b\u4e0e\u3048\u308b\u3053\u3068\u3067\u5468\u671f\u7684\u306a\u8272\u306e\u5909\u5316\u3092\u884c\u306a\u3063\u3066\u3044\u308b\u3002\n\tvec2 uv = fragCoord.xy / iResolution.xy;\n    vec4 color = vec4(uv, 0.5 + 0.5 * sin(iTime), 1.0);\n    \n    // \u753b\u9762\u4e0a\u306e\u5ea7\u6a19\u5024\u3092-1.0\u304b\u3089\n    vec2 pos = uv * 2.0 - 1.0;\n    \n    color *= abs(1.0 / (sin(pos.x + cos(pos.y + iTime) * 0.5) * sin(iTime * .3) * 70.0));\n    color *= abs(1.0 / (sin(pos.y + cos(pos.x + iTime) * 0.2) * sin(iTime * .3) * 70.0));\n    \n    fragColor = color;\n}", "name": "Image", "description": "", "type": "image"}]}