{"ver": "0.1", "info": {"id": "ssGGRd", "date": "1631944287", "viewed": 36, "name": "a~\u2013@~@\u2022@\u2022@\u2013\u2022\u2013", "username": "HaleyHalcyon", "description": "a", "likes": 2, "published": 1, "flags": 0, "usePreview": 0, "tags": ["a"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "#define TAU (6.283185307)\n#define HEX(x) (vec3((x >> 16) & 255, (x >> 8) & 255, x & 255) / 255.)\n\nfloat ease(float x) {\n    x = clamp(x, 0., 1.);\n    return smoothstep(0., 1., x);\n}\n\nfloat ripple(vec2 uv, vec2 lightDir, float scale, float time) {\n    \n    return sin(\n        length(uv) * scale - time * TAU\n    ) * dot(\n        lightDir,\n        normalize(uv) *\n        ease(length(uv) * scale * 0.5)\n    );\n}\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    // Make sure this loops\n    float time = fract(iTime / 10.0);\n    // Normalized pixel coordinates\n    vec2 uv = ( 2.* fragCoord - iResolution.xy ) / length(iResolution.xy);\n    vec2 lightDir = vec2(sin(time * TAU), cos(time * TAU));\n    \n    vec2 center0 = 0.5*vec2(sin(TAU*time), cos(TAU*time));\n    vec2 center1 = 0.5*vec2(sin(TAU*(time+1./3.)), cos(TAU*(time+1./3.)));\n    vec2 center2 = 0.5*vec2(sin(TAU*(time-1./3.)), cos(TAU*(time-1./3.)));\n    \n    const float sizeScale = 30.;\n    const float timeScale = 10.;\n    \n    vec3 col = HEX(0x4080c0) + 0.15 * (\n        ripple(\n            uv - center0, lightDir,\n            sizeScale, 0.2 + time * timeScale\n        ) + ripple(\n            uv - center1, lightDir,\n            sizeScale, 0.4 + time * timeScale\n        ) + ripple(\n            uv - center2, lightDir,\n            sizeScale, 0.8 + time * timeScale\n        )\n    );\n    \n    // Output to screen\n    fragColor = vec4(\n        col, 1.0\n    );\n}", "name": "Image", "description": "", "type": "image"}]}