{"ver": "0.1", "info": {"id": "sscGWM", "date": "1629936137", "viewed": 141, "name": "liquidcolor", "username": "Caineluo", "description": "this is test demo", "likes": 3, "published": 1, "flags": 0, "usePreview": 0, "tags": ["2dliquid"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n     vec2 coord = 6.0 * fragCoord.xy / iResolution.xy;\n    for(int i = 1;i < 190;i++){\n        float n = float(i);\n        coord += vec2(0.7 / n * sin(n * coord.y + iTime  + 0.3) + 0.8, 0.4 / n * sin(n * coord.x + iTime + 0.3 ) + 0.6);\n    }\n    vec3 color = vec3(0.5 * sin(coord.x) + 0.5, 0.5 * sin(coord.y) + 0.5,sin(coord.x+coord.y));\n    fragColor = vec4(color,1.0);\n}", "name": "Image", "description": "", "type": "image"}]}