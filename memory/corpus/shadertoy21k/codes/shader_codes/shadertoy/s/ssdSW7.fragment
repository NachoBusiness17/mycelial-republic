{"ver": "0.1", "info": {"id": "ssdSW7", "date": "1633379373", "viewed": 35, "name": "sine moire patterns", "username": "izutionix", "description": "\u00ad", "likes": 0, "published": 1, "flags": 0, "usePreview": 0, "tags": ["moire"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    vec2 uv = (sin(fragCoord+iTime*.05)*(10.*iTime+1024.)-.5*iResolution.xy)/iResolution.y;\n    fragColor = vec4(smoothstep(1., 0., 64.*abs(length(uv)-.4)));\n}", "name": "Image", "description": "", "type": "image"}]}