{"ver": "0.1", "info": {"id": "stXGWX", "date": "1622963473", "viewed": 32, "name": "20210606 magnetic field", "username": "kamonumber", "description": "magnetic field", "likes": 1, "published": 1, "flags": 0, "usePreview": 0, "tags": ["sinatan"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    vec2 uv = fragCoord/iResolution.xy;\n\n    uv-=vec2(0.5);\n    float angle = atan(uv.x/uv.y);//uv0,0\u3068\u306e\u89d2\u5ea6\u3092\u5272\u308a\u51fa\u3059\n    float l = length(sqrt(pow(uv.x,2.)+pow(uv.y,2.)));//0.0\u304b\u3089\u306e\u8ddd\u96e2\n    l+=sin(iTime);\n    \n    vec3 col = vec3(angle);\n    col =(col/vec3(l));//\u56de\u8ee2\u90e8\u5206\u3068\u30680,0\u304b\u3089\u306e\u8ddd\u96e2\u3068\u306e\u5024\u540c\u58eb\u3092\u8a08\u7b97\u3059\u308b\u2605/\u304c\u30dd\u30a4\u30f3\u30c8\n    col*=vec3(3.);//\u6ce2\u306e\u6570\n    col = fract(col);//\u5024\u30920.0~1.0\u306b\u3059\u308b\n    \n\n    fragColor = vec4(col,1.0);\n}", "name": "Image", "description": "", "type": "image"}]}