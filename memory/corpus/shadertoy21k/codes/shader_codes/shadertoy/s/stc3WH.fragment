{"ver": "0.1", "info": {"id": "stc3WH", "date": "1636067999", "viewed": 94, "name": "heart.....", "username": "lllcz", "description": "....", "likes": 3, "published": 3, "flags": 0, "usePreview": 0, "tags": [], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "#define PI 3.1415926\n#define PI_HALF (.5*PI)\n#define PIx2 (2.*PI)\n \n// 2D rotation matrix\nmat2 rotmat(float a)\n{\n    return mat2(cos(a), sin(a), -sin(a), cos(a));\n}\n \n/// @brief \u8fd4\u56de\u5e26\u6709\u6297\u952f\u9f7f\u7684 2D \u5706\u7684\u8ddd\u79bb\u573a\n/// @param uv \u7eb9\u7406\u5750\u6807\n/// @param origin \u5706\u5fc3\u5750\u6807\n/// @param radius \u5706\u7684\u534a\u5f84\n/// @param alias \u6297\u952f\u9f7f\u7684\u533a\u95f4\nfloat smooth_circle(in vec2 uv, in vec2 origin, float radius, float alias)\n{\n    return /*1.0 - */smoothstep(radius - alias, radius + alias,\n                                length(uv - origin));\n}\n \n/// @brief \u8fd4\u56de\u9ed8\u8ba4\u5e26\u6297\u952f\u9f7f\u7684 2D \u5706\u7684\u8ddd\u79bb\u573a\n/// @param uv \u7eb9\u7406\u5750\u6807\n/// @param origin \u5706\u5fc3\u5750\u6807\n/// @param radius \u5706\u7684\u534a\u5f84\nfloat circle(in vec2 uv, in vec2 origin, float radius)\n{\n    return smooth_circle(uv, origin, radius, 0.005);\n}\n \n/// \u53ef\u4ee5\u5206\u522b\u63a7\u5236\u56db\u4e2a\u89d2\u7684\u5927\u5c0f [z, x\n///                         w, y]\nfloat sdRoundBox( in vec2 p, in vec2 b, in vec4 r )\n{\n    r.xy = (p.x > 0.0) ? r.xy : r.zw;\n    r.x  = (p.y > 0.0) ? r.x  : r.y;\n \n    vec2 q = abs(p) - b + r.x;\n    float d = max(q.x, q.y);\n    return min(d, 0.0) + length(max(q, 0.0)) - r.x;\n}\n \n/// @brief \u7ed8\u5236\u5fc3\u5f62\nfloat inHeart (vec2 p, vec2 center)\n{\n    //\u79fb\u52a8\u4e2d\u5fc3\n    p = p - center;\n    //\u65cb\u8f6c\n    vec2 q = rotmat(45. / 180.*PI) * p;\n    \n    float ret = sdRoundBox(q, vec2(.15), vec4(0.03));\n \n    ret = smoothstep(0.01, .012, ret);\n    ret = min(ret, circle(p, vec2(.1, .1), .161));\n    ret = min(ret, circle(p, vec2(-.1, .1), .161));\n \n    return ret;\n}\n \nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 uv = gl_FragCoord.xy / iResolution.xy;\n \n     //\u5148\u7ed8\u5236\u5fc3\u5f62\n    float dist = inHeart(uv, vec2(.5));\n \n     //\u518d\u586b\u5145\u6ce2\u6d6a\n    float color[2];\n    for (int i = 0; i < 2; i++)\n    {\n  \n        /// @note \u6b63\u5f26\u6ce2\u5f62\n        float p = (5.*uv.x + float(i)  +  1.*iTime);\n        float offset =  .025 * sin(p) + .62;\n \n        float eps = 1e-3;\n        float color_0 = step(uv.y, offset);\n        color[i] = color_0 * step(dist, .1);\n    }\n \n    vec3 temp = mix(vec3(57., 56., 78.) / 255., vec3(245., 245., 245.) / 255., dist);\n    temp = mix(temp, vec3(233., 51., 74.)/255., color[0]);\n    \n    fragColor = vec4(mix(temp,  vec3(.4, 0., 0.),clamp(color[0] - color[1], 0., 1.)), 1.);\n}", "name": "Image", "description": "", "type": "image"}]}