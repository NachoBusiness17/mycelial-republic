{"ver": "0.1", "info": {"id": "stsGDs", "date": "1623161382", "viewed": 66, "name": "20210608 eclipse", "username": "kamonumber", "description": "I drew a semicircle, like a solar eclipse.", "likes": 3, "published": 1, "flags": 0, "usePreview": 0, "tags": ["glow"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    vec2 uv = fragCoord/iResolution.xy;\n    uv.x*=iResolution.x/iResolution.y;\n    uv.x-=iResolution.x/iResolution.y/2.0;//\u753b\u9762\u306e\u4e2d\u5fc3\u30920,0\u306b\u3057\u3066\u7bc4\u56f2\u3092-1.0~1.0\u304f\u3089\u3044\u306b\u3059\u308b\n    uv.y-=0.1;//\u4e2d\u5fc3\u3092\u305a\u3089\u3059\n    uv.y*=1.05;//\u7e26\u306b\u3064\u3076\u3059\n\n   float r = 0.6;//\u5186\u306e\u534a\u5f84\n   float y=sqrt(pow(r,2.0)-pow(uv.x,2.0));//\u5186\u306e\u5f0f\n   float col =((((sin(iTime)+(sin(iTime*0.7))/2.0+2.01)/100.0)/length(y-uv.y)));//\u95a2\u6570\n\n    \n    fragColor = vec4(vec3(col),1.0);\n}", "name": "Image", "description": "", "type": "image"}]}