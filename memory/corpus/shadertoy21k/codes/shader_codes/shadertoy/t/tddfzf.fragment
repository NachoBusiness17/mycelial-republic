{"ver": "0.1", "info": {"id": "tddfzf", "date": "1605717846", "viewed": 44, "name": "Cfera", "username": "Voldemar", "description": "Cfera", "likes": 1, "published": 1, "flags": 0, "usePreview": 0, "tags": ["cfera"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "\n\nvoid mainImage( out vec4 fragColor, in vec2 FC )\n{\n    vec2 uv = (FC*2.-iResolution.xy)/iResolution.y;\n     //d -\u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043e\u0442 \u043a\u0430\u043c\u0435\u0440\u044b\n    //e - \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0435 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043e\u0442 \u043f\u0443\u0442\u0438 d \n    float e,d=0.;\n    vec3 p,rd = vec3(uv,1);\n    int i;\n    for(int i = 2;i<9;i++){\n        p=rd*d - vec3(0.,0.,2.);\n        d+=e=length(p-vec3(0.,0.,sin(iTime*3.)))-0.5;\n        if(e<.01)break;\n    }\n    vec3 col = cos(iTime+uv.xyx+vec3(0,2,4)) + 0.98*cos(iTime+uv.xyx+vec3(0,2,4))/d;\n    fragColor = vec4(vec3(col),0.);\n}", "name": "Image", "description": "", "type": "image"}]}