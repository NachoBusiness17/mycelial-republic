{"ver": "0.1", "info": {"id": "tdfXDr", "date": "1564409958", "viewed": 341, "name": "RayMarching Cube", "username": "bluedrop", "description": "RayMarching Sphere and do mod operation \n\u5b66\u4e60\u540e\uff0c\u6765\u4e2a\u4e2d\u6587\u7684\u6ce8\u91ca\u628a\uff0c\u5e0c\u671b\u80fd\u5e2e\u5230\u5c0f\u4f19\u4f34\n\u5199\u4e86\u4e2a\u4e09\u7ef4\u566a\u58f0\uff0c\u53ef\u662f\u6548\u7387\u597d\u4f4e\ud83d\ude2d", "likes": 1, "published": 3, "flags": 0, "usePreview": 0, "tags": ["3d", "raymarching"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "#define MAX_STEPS 100\n#define MAX_DIST 100.\n//\u5230\u8868\u9762\u7684\u9608\u503c\n#define SURF_DIST .01    \n\nfloat N31(vec3 p)\n{\n\tvec3 n = p * vec3(235.24, 525.67, 937.84);\n    n += dot(n, n+ 53.56);\n    return fract(sin(n.x * n.y * n.z )*iTime);\n}\n\n\nfloat noise3(vec3 p)\n{\n    float res = 0.;\n    vec3 gv = fract(p);\n    vec3 id = floor(p);\n    \n    gv = gv * gv * (3.0 - 2.0 * gv);\n    \n    //front\n    float flb = N31(id);\n    float frb = N31(id + vec3(1., 0., 0.));\n    float fb = mix(flb, frb, gv.x);\n    \n    float flt = N31(id + vec3(0., 1., 0.));\n    float frt = N31(id + vec3(1., 1., 0.));\n    float ft = mix(flt, frt, gv.x);\n    \n    float front = mix(fb, ft, gv.y);\n\n    //back\n    float blb = N31(id + vec3(0,0,1));\n    float brb = N31(id + vec3(1., 0., 1.));\n    float bb = mix(blb, brb, gv.x);\n    \n    float blt = N31(id + vec3(0., 1., 1.));\n    float brt = N31(id + vec3(1., 1., 1.));\n    float bt = mix(blt, brt, gv.x);\n    \n    float back = mix(bb, bt, gv.y);\n    \n    res = mix(front, back, gv.z);\n    return res;\n}\n\nfloat dBox(vec3 p, vec3 s){\n\treturn length(max(abs(p)-s, 0.));\n}\n\nfloat GetDist(vec3 p){\n    //p.x = mod(p.x,2.)-1.;\n    //p.z = mod(p.z,10.)-1.;\n    //p.y = mod(p.y,6.)-0.;\n    vec4 sphere = vec4(0, 1.5, 6, .8);     //\u7403\u4f53\u7684\u6570\u636e\uff0cxyz\u662f\u4f4d\u7f6e\uff0cw\u662f\u534a\u5f84\n    float sphereDist = length(p -sphere.xyz) - noise3(p) * 2.;     //\u5f53\u524d\u6b65\u8fdb\u4f4d\u7f6e\u5230\u7403\u8868\u9762\u7684\u8ddd\u79bb\n    float planeDist = p.y;                          //\u76f8\u673a\u5230\u5e73\u9762\u7684\u8ddd\u79bb\n    float d = min(sphereDist, planeDist);      //\u83b7\u53d6\u6700\u5c0f\u7684\u8ddd\u79bb\uff08\u4e5f\u5c31\u662f\u6700\u8fd1\u7684\u7269\u4f53\uff09\n    //d = min(d, dBox(p-vec3(1,1.,7.), vec3(.7)));\n    return d;\n}\n\nfloat RayMarching(vec3 ro, vec3 rd){\n    float dod = 0.;\n    for(int i=0; i <MAX_STEPS; ++i){\n        vec3 p = ro + rd*dod;         //\u5f53\u524d\u6b65\u8fdb\u7684\u4f4d\u7f6e\n        float r = GetDist(p);        //\u4e0e\u573a\u666f\u4e2d\u6700\u8fd1\u7269\u4f53\u7684\u8ddd\u79bb\n        dod += r;                    //\u8fdb\u884c\u6b65\u8fdb\n        if(dod >MAX_DIST || r < SURF_DIST)break;       \n    }\n    return dod;\n}\n\nvec3 GetNormal(vec3 p){\n    float d = GetDist(p);\n    vec2 e = vec2(.01, 0);\n    \n    vec3 n = d - vec3(\n        GetDist(p - e.xyy),\n\t\tGetDist(p - e.yxy),\n        GetDist(p - e.yyx)\n    );\n    return normalize(n);\n}\n\nfloat GetLight(vec3 p){\n    vec3 lightPos = vec3(cos(iTime)*2., 5.+sin(iTime)*2., 6);          //\u5b9a\u4e49\u5149\u6e90\u4f4d\u7f6e\n    vec3 l = normalize(lightPos - p);      //\u5149\u5230\u8868\u9762\u7684\u6807\u51c6\u5411\u91cf\n    vec3 n = GetNormal(p);                   //\u83b7\u53d6\u8868\u9762\u6cd5\u5411\u91cf\n    float dif = clamp(dot(n, l),0.,1.);       //\u6cd5\u5411\u91cf\u4e0e\u5149\u5411\u91cf\u70b9\u4e58,\u80cc\u9762\u7684\u9634\u5f71\u4f1a\u53d8\u6210\u8d1f\u6570\uff0c\u8981\u9650\u5236\n    float d = RayMarching(p+n*SURF_DIST*10.,l);\n    if(d < length(lightPos - p))dif *=.1;\n    return dif * 1.;\n}\n\n\n    \nvoid mainImage(out vec4 fragColor, in vec2 fragCoord){\n    vec2 uv = (fragCoord -.5*iResolution.xy) / iResolution.y;\n    vec3 col = vec3(0.);\n\n    //\u8bbe\u7f6e\u6444\u50cf\u673a\n    vec3 ro = vec3(0., 4., -10.);  \n    vec3 rd = normalize(vec3(uv.x, uv.y, 1.)); \n    float d = RayMarching(ro, rd);\n\n    vec3 p = ro + rd * d;\n    float dif = GetLight(p);\n    col = vec3(dif);\n    fragColor = vec4(col, 1.0);\n}", "name": "Image", "description": "", "type": "image"}]}