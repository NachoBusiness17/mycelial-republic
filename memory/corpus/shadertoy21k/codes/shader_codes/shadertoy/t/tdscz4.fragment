{"ver": "0.1", "info": {"id": "tdscz4", "date": "1584315674", "viewed": 203, "name": "animation_PM", "username": "KofeyOK", "description": "wave PM", "likes": 2, "published": 3, "flags": 0, "usePreview": 0, "tags": ["animated"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "float Circle(vec2 uv, vec2 p, float r, float blur) { //\u0444\u0443\u043d\u043a\u0446\u0456\u044f \u0434\u043b\u044f \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u043a\u043e\u043b\u0430\n float d = length(uv-p);\n float c = smoothstep(r, r-blur, d);\n\n return c;\n}\nfloat Band (float t, float start, float end, float blur) //\u0444\u0443\u043d\u043a\u0446\u0456\u044f \u0434\u043b\u044f \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u0441\u043c\u0443\u0436\u043a\u0438\n{\nfloat step1 = smoothstep(start-blur, start+blur, t);\n float step2 = smoothstep(end+blur, end-blur, t);\n\n return step1*step2;\n}\nfloat Rect (vec2 uv, float left, float right, float //\u0444\u0443\u043d\u043a\u0446\u0456\u044f \u0434\u043b\u044f \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u043f\u0440\u044f\u043c\u043e\u043a\u0443\u0442\u043d\u0438\u043a\u0430\nbottom, float top, float blur) {\nfloat band1 = Band(uv.x, left, right, blur);\nfloat band2 = Band(uv.y, bottom, top, blur);\n\nreturn band1*band2;\n}\nfloat smiley (vec2 uv, vec2 p, float size){ //\u0444\u0443\u043d\u043a\u0446\u0456\u044f \u0434\u043b\u044f \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u0441\u043c\u0430\u0439\u043b\u0430 :)\nuv -= p; //translating coordinate systems\n uv /= size; //scaling coordinate systems\n\n float mask = Circle (uv, vec2(.0), .4, .01);\n\n mask -= Circle (uv, vec2(-.13, .2), .07, .01);\n mask -= Circle (uv, vec2(.13, .2), .07, .01);\n\nfloat mouth = Circle (uv, vec2(.0, .0), .3, .02);\n mouth -= Circle (uv, vec2(.0, 0.1), .3, .02);\n\n mask -= mouth;\n\n return mask;\n }\nfloat remap01 (float a, float b, float t){ //\u043d\u043e\u0440\u043c\u0430\u043b\u0456\u0437\u0443\u0454 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f t; 0<=t<=1\n return (t-a) / (b-a);\n}\nfloat remap (float a, float b, float c, float d, float // c<=t<=d\nt){\n return remap01 (a, b, t) * (d-c) + c;\n}\nfloat PIlike(vec2 uv, vec2 p, float size){\n uv -= p; //translating coordinate systems\n uv /= size; //scaling coordinate systems\n float x1 = uv.x;\n\n float m = sin(+x1*8.) *.1; // \u0437\u043c\u0456\u043d\u044e\u0454\u0442\u044c\u0441\u044f \u0437 \u0447\u0430\u0441\u043e\u043c \u0456 \u0437\u0440\u043e\u0441\u0442\u0430\u043d\u043d\u044f\u043c \u0445\n \n m = m*m*4.;\n float y1 = uv.y-m; // -m \u043f\u0435\u0440\u0435\u0442\u0432\u043e\u0440\u044e\u0454 \u043f\u0440\u044f\u043c\u043e\u043a\u0443\u0442\u043d\u0438\u043a \u043d\u0430 \u0441\u0438\u043d\u0443\u0441\u043e\u0457\u0434\u0443, \u044f\u043a\u0430 \u0437\u043c\u0456\u043d\u044e\u0454\u0442\u044c\u0441\u044f \u0437 \u0447\u0430\u0441\u043e\u043c\n \n float y2 = uv.y;\n float m2 = sin(+y2*8.) *.1;\n float x2  = uv.x-m2;\n //float m = (x-.5)*(x+.5);  // \u0446\u0435\u0439 \u0431\u043b\u043e\u043a \u043a\u043e\u0434\u0443 \u0437\u043c\u0456\u043d\u044e\u0454 \u0432\u0438\u0433\u043b\u044f\u0434 \u0444\u0456\u0433\u0443\u0440\u0438\n \n //float y = uv.y+m; \n\n //x+= y;  // \u043d\u0430\u0445\u0438\u043b \u0444\u0456\u0433\u0443\u0440\u0438\n\n float blur = remap(-.1, .1, .01, .05, y1); // \u0437\u0431\u0456\u043b\u044c\u0448\u0443\u0454 \u0440\u043e\u0437\u043c\u0438\u0442\u0442\u044f \u0437\u0456 \u0437\u0440\u043e\u0441\u0442\u0430\u043d\u043d\u044f\u043c \u0445\n //blur *= pow(blur*4., 3.);\n float mask = Rect (vec2(x1, y1), -.5, .5, .1, .3, blur); //\u0431\u0443\u0434\u0443\u0454\u043c\u043e \u0444\u0456\u0433\u0443\u0440\u0443\n mask += Rect (vec2(x2, y2), -.5, -.3, -0.2, 0.16, .04);\n mask += Rect (vec2(x2, y2), 0., 0.2, -0.2, 0.16, .04);\n float wheel = Circle(uv, vec2(0.,-0.2), 0.16, .07);\n mask+=wheel;\n    \n return mask;\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 uv = fragCoord.xy / iResolution.xy; // 0 <> 1.\n\n    float t = iTime; // \u0447\u0430\u0441\n    uv -= .5; // -0.5 <> 0.5\n    uv.x *= iResolution.x/iResolution.y;\n\tfloat m = sin(t+uv.x*8.) *.1; // \u0437\u043c\u0456\u043d\u044e\u0454\u0442\u044c\u0441\u044f \u0437 \u0447\u0430\u0441\u043e\u043c \u0456 \u0437\u0440\u043e\u0441\u0442\u0430\u043d\u043d\u044f\u043c \u0445\n \tuv.y -=m;\n    vec3 col = vec3(0.);\n\n    float mask = 0.;\n\tmask = Rect(uv, -.7, -.55, -.3, .3, .001);\n    mask += Rect(uv, -.3, -0.15, -.3, .3, .001);\n    mask += Rect(uv, -.7, -0.15, .15, .3, .001);\n    mask += Rect(uv, .1, 0.2, -.3, .3, .001);\n    mask += Rect(uv, .55, 0.65, -.3, .3, .001);\n    mask += Rect(vec2(uv.x+uv.y*0.23,uv.y), 0.225, 0.325, -.3, .3, .003);\n    mask += Rect(vec2(uv.x-uv.y*0.23,uv.y), 0.425, 0.525, -.3, .3, .003);\n    //mask = PIlike(uv, vec2(0.),1.);\n    col = vec3(1., 1., 1.)*mask;\n\n    fragColor = vec4(col, 1.0);\n    \n}", "name": "Image", "description": "", "type": "image"}]}