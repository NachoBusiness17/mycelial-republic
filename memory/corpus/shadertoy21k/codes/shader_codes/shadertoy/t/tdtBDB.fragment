{"ver": "0.1", "info": {"id": "tdtBDB", "date": "1605931287", "viewed": 40, "name": "My Smiling Face", "username": "zhengzhehui", "description": "rotating smiling face", "likes": 3, "published": 1, "flags": 0, "usePreview": 0, "tags": ["2d"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "\nfloat Circle(vec2 uv, vec2 p, float r, float blur) { //\u53c2\u8003\u7cfb\uff0c\u5706\u5fc3\u76f8\u5bf9\u4f4d\u7f6e\uff0c\u534a\u5f84\uff0c\u8fb9\u7f18\u6a21\u7cca\u8303\u56f4\n    float circle = length(uv-p);\n    circle = smoothstep(r, r-blur, circle); //\u786e\u5b9a\u4e00\u4e2a\u5e73\u6ed1\u533a\u95f4\uff0c\u533a\u95f4\u5916\u7684\u53d6\u503c\u90fd\u4e3a0\u62161\n    return circle;\n\n}\n\nfloat Mask(vec2 uv, vec2 p, float size){  //\u753b\u7b11\u8138\uff1a\u53c2\u8003\u7cfb\uff0c\u5706\u5fc3\u76f8\u5bf9\u4f4d\u7f6e\uff0c\u5927\u5c0f\n    uv -= p;  //\u79fb\u52a8\u53c2\u8003\u7cfb\u4e2d\u5fc3\u70b9\n    uv /= size;  //\u7f29\u653e\u53c2\u8003\u7cfb\n    \n    float mask = Circle(uv, vec2(0.0,0.0), .3, 0.01);  //\u8138\n    mask -= Circle(uv, vec2(-0.12,0.12), .07, 0.01); //\u5de6\u773c\n    mask -= Circle(uv, vec2(0.12,0.12), .07, 0.01);  //\u53f3\u773c\n    float mouth = Circle(uv, vec2(-0.0,-0.08), .15, 0.01);  //\u5634\n    mouth -= Circle(uv, vec2(-0.0,-0.1), .15, 0.01);\n    mask += mouth;\n    if(mask > 1.0) mask = 1.0;\n    else if (mask < 0.0) mask = 0.0;  //\u786e\u4fddmask\u7684\u8303\u56f4\u57280\u548c1\u4e4b\u95f4\n    return mask;\n}\n\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    // Normalized pixel coordinates (from 0 to 1)\n    vec2 uv = fragCoord/iResolution.xy;\n    \n    uv -= .5;\n    uv.x *= iResolution.x/iResolution.y;\n\tfloat t = iTime;\n    float size = abs(sin(t)*0.3 + .5);  //\u5927\u5c0f\u968f\u65f6\u95f4\u53d8\u5316\n    vec2 pos = vec2(sin(t)*0.6, cos(t)*0.4); //\u505a\u692d\u5706\u8fd0\u52a8\n    \n\tfloat mask = Mask(uv, pos, size);  //\u8138\n    vec3 col = vec3(1.,.5,0.5)*mask;  //\u4e0a\u8272\n\n    // Output to screen\n    fragColor = vec4(col,1.0);\n}", "name": "Image", "description": "", "type": "image"}]}