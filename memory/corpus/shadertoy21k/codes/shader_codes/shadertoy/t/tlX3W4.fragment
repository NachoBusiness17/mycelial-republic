{"ver": "0.1", "info": {"id": "tlX3W4", "date": "1556312687", "viewed": 80, "name": "short shader study", "username": "Machia", "description": "test", "likes": 3, "published": 1, "flags": 0, "usePreview": 0, "tags": ["raymarching"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "/*\n\tcompressed shader study\n\n\treference from\n\thttp://glslsandbox.com/e#54303.0\n*/\n\n//\u30de\u30c3\u30d4\u30f3\u30b0\uff08\u7acb\u4f53\u914d\u7f6e\uff09\nfloat map(vec3 p) {\n\tfloat t = length(mod(p, 2.0) - 1.0) - 0.35;\n\treturn t;\n}\n\n//\u6cd5\u7dda\u3092\u53d6\u5f97\u3059\u308b\uff08\u3053\u3068\u3067\u7acb\u4f53\u7684\u306a\u7d75\u306b\u306a\u308b\uff09\nvec3 getN(vec3 p) {\n\tfloat t = map(p);\n\tvec2 d = vec2(0.001, 0.0);\n    \n\treturn normalize(vec3(\n\t\tt - map(p + d.xyy),\n\t\tt - map(p + d.yxy),\n\t\tt - map(p + d.yyx)));\n}\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    // Normalized pixel coordinates (from 0 to 1)\n\tvec2 uv = ( 2.0 * fragCoord.xy - iResolution.xy ) / min(iResolution.x , iResolution.y);\n    \n    //\u30ec\u30a4\u3092\u98db\u3070\u3059\u65b9\u5411\n\tvec3 dir = normalize(vec3(uv, 1.0));\n    float x_po,y_po;\n    //\u8abf\u67fb\u30dd\u30b8\u30b7\u30e7\u30f3\u306e\u5b9a\u7fa9\n    \n    if( uv.x*uv.x + uv.y*uv.y >0.45){\n        x_po = -1.;\n        y_po = -0.;\n    }else{\n        x_po = 1.0;\n        y_po = 0.0;\n    }\n    if( (uv.x*uv.x + uv.y*uv.y)>1.0){\n        x_po =0.0;\n        y_po = 1.0;\n    }\n    \n    if(uv.x*uv.x + uv.y*uv.y>2.0){\n        x_po = 2.0;\n        y_po = -2.0;\n    }\n    \n    \n    vec3 pos = vec3(y_po*cos(iTime) ,x_po*sin(iTime) , iTime);\n\n    //\u5909\u6570\u5b9a\u7fa9\n\tfloat t= 0.0;\n    \n    int mx =75;//int(floor(20.*(sin(iTime)+1.) ) );\n    \n    //\u30ec\u30a4\u3092\u98db\u3070\u3057\u3066\u8abf\u67fb\u3059\u308b\n\tfor(int i = 0 ; i < 25+mx; i++ ) {\n        //\u30de\u30c3\u30d7\u3057\u3066\u308b\u56f3\u5f62\u306b\u5bfe\u3057\u30ec\u30a4\u3092\u98db\u3070\u3057\u3001\n        //\u305d\u306e\u5206\u8ddd\u96e2\u3092\u9032\u3081\u308b\n\t\tt += map(dir * t + pos);\n\t}\n    \n    //\u8a08\u7b97\u3092\u7d42\u4e86\u3057\u305f\u6642\u70b9\u306e\u30ec\u30a4\u306e\u4f4d\u7f6e\u3092\u5b9a\u7fa9\u3059\u308b\n    vec3 ip = dir * t + pos;\n    \n    //\u6cd5\u7dda\u5b9a\u7fa9\n\tvec3 L = normalize(vec3(1,2,3));\n\tvec3 N = getN(ip);\n    \n    // Output to screen\n    \n    //dot(L,N):\u6cd5\u7dda\u3068\u30e9\u30a4\u30c8\u306e\u5ea7\u6a19\u3068\u306e\u5185\u7a4d\u3092\u6c42\u3081\u308b\n    //dir*0.1:\u8272\u3092\u6291\u3048\u3066\u308b\uff08\u3053\u306e\u307e\u307e\u3060\u3068RGB\u304c\u30ad\u30c4\u3044\uff09\n    fragColor = vec4(dot(L, N)*0.75 + x_po*3.*dir * 0.2, 1.0);\n}", "name": "Image", "description": "", "type": "image"}]}