{"ver": "0.1", "info": {"id": "tldXWS", "date": "1581640213", "viewed": 67, "name": "hsbrotate", "username": "NY", "description": "a", "likes": 1, "published": 1, "flags": 0, "usePreview": 0, "tags": ["2d"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "#define TWO_PI 6.28318530718\n\nvec3 hsb2rgb(vec3 c)\n{\n    vec3 rgb = clamp(abs(mod(c.x * 6. + vec3(0. , 4., 2.), 6.) - 3.) - 1., 0., 1. );\n    rgb = rgb * rgb * (3. - 2. * rgb);\n    return c.z * mix(vec3(1.), rgb, c.y);\n}\n\n\nmat2 zrotate(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, s, -s, c);\n}\n\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    // Normalized pixel coordinates (from 0 to 1)\n    vec2 uv = fragCoord/iResolution.xy;\n\n    // 0.0\u3092\u539f\u70b9\u306b -0.5\u301c0.5\u306b\u3059\u308b\n    vec2 toCenter = vec2(0.5) - uv;\n    // \u56de\u8ee2\n    toCenter *= zrotate(iTime);\n    \n    // \u539f\u70b9\u304b\u3089\u306e\u8ddd\u96e2 \n    float radius = length(toCenter);\n    // 0\u301c1.0\u306b\u3059\u308b\n    radius *= 2.;\n    \n     // \u539f\u70b9\u306eX\u8ef8\u3068UV\u306e\u30e9\u30b8\u30a2\u30f3\u3092\u7b97\u51fa\n    float angle = atan(toCenter.y,toCenter.x);\n    // \u30e9\u30b8\u30a2\u30f3(-\u03c0\u301c\u03c0)\u3092\u03c0 * 2\u3067\u5272\u308b\u3053\u3068\u3067-0.5\u301c0.5\u306b\u3059\u308b\n    angle /= TWO_PI;\n    // 0.0\u301c1.0\u306b\n    angle += 0.5;\n    \n    // \u6975\u5ea7\u6a19\u7cfb\u4f5c\u6210\n    vec3 hsb = vec3(angle, radius, 1.);   \n    // hsb\u304b\u3089rgb\u306b\u5909\u63db\n    vec3 color = hsb2rgb(hsb);\n\n    // Output to screen\n    fragColor = vec4(color,1.);\n}", "name": "Image", "description": "", "type": "image"}]}