{"ver": "0.1", "info": {"id": "tll3RM", "date": "1555942047", "viewed": 228, "name": "My Very First Shader", "username": "georgecruesby", "description": "This is my first shader.", "likes": 1, "published": 3, "flags": 0, "usePreview": 0, "tags": ["test"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    // Normalized pixel coordinates (from 0 to 1)\n    vec2 uv = fragCoord/iResolution.xy;\n\n    // Time varying pixel color\n    vec3 col = 0.5 + 0.5*cos(iTime+uv.xyx+vec3(0,2,4));\n\n    // Output to screen\n    fragColor = vec4(col,1.0);\n    \n    // input channel. XX = 2D/Cube\n    \n    \n}\n", "name": "Image", "description": "", "type": "image"}]}