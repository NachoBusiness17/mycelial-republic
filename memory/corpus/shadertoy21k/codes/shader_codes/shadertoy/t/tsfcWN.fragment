{"ver": "0.1", "info": {"id": "tsfcWN", "date": "1584892892", "viewed": 185, "name": "\u6cf0\u68ee\u591a\u8fb9\u5f62 Voronoi", "username": "ywqy", "description": "\u6cf0\u68ee\u591a\u8fb9\u5f62", "likes": 2, "published": 3, "flags": 0, "usePreview": 0, "tags": ["voronoi"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "//learn from https://thebookofshaders.com/12/?lan=ch\n//Then learn from http://www.iquilezles.org/www/articles/voronoilines/voronoilines.htm\n\n#define ANIMATE\n\nvec2 random2( vec2 p ) {\n    return fract(sin(\n        vec2(dot(p,vec2(127.1,311.7)),\n             dot(p,vec2(269.5,183.3)))\n    )*43758.5453);\n}\n\nvec3 voronoi(in vec2 uv) {\n    \n\t//\u6574\u6570\u5c0f\u6570\u5206\u79bb\n    //Tile the space\n    vec2 i_uv = floor(uv);\n    vec2 f_uv = fract(uv);\n    \n    //----------------------------------\n    // \u901a\u9053\u4e00\uff1a\u5e38\u89c4\u7f51\u683c\u566a\u58f0\n    // first pass: regular vornoi\n    //----------------------------------\n    \n    //\u6700\u77ed\u5411\u91cf\uff0c\u6700\u8fd1\u90bb\u5c45\n    vec2 minVector, nearNeighbor;\n    \n    //\u6700\u77ed\u8ddd\u79bb\n    float minDistance = 8.0;\n    \n    for (int y = -1; y <= 1; y++) {\n        for (int x = -1; x <= 1; x++) {\n        \t//\u5f53\u524d\u90bb\u5c45\n            //Neigbor place in the grid\n            vec2 curNeighbor = vec2(float(x), float(y));\n            \n            //\u83b7\u53d6\u90bb\u5c45\u7684\u968f\u673a\u70b9\n            //Random position from current + neighbor place in the grid\n            vec2 neighborPoint = random2(i_uv + curNeighbor);\n            \n            #ifdef ANIMATE\n            neighborPoint = 0.5 + .5*sin(iTime + 3.14159 * neighborPoint);\n            #endif\n            \n            //\u50cf\u7d20\u70b9\u5230\u90bb\u5c45\u968f\u673a\u70b9\u7684\u8ddd\u79bb\n            //Vector from the pixel to point\n            vec2 curVector = curNeighbor + neighborPoint - f_uv;\n            \n            //\u8ba1\u7b97\u957f\u5ea6\n            //calculate distance\n            float curDistance = dot(curVector, curVector);\n            \n            //\u6ee4\u51fa\u6700\u77ed\u8ddd\u79bb\uff0c\u90bb\u5c45\uff0c\u5411\u91cf\n            if(curDistance < minDistance) {\n            \tminDistance = curDistance;\n                minVector = curVector;\n                nearNeighbor = curNeighbor;\n            }\n        }\n    }\n    \n    //----------------------------------\n    // \u901a\u9053\u4e8c\uff1a\u8fb9\u754c\u8ddd\u79bb\n    // second pass: distance to borders\n    //----------------------------------\n    \n    minDistance = 8.0;\n    for (int y = -2; y <= 2; y++) {\n        for (int x = -2; x <= 2; x++) { \n        \t//\u6700\u8fd1\u90bb\u5c45\u7684\u90bb\u5c45\n            //Neighbor'Neighbor\n            vec2 curNeighbor = nearNeighbor + vec2(float(x), float(y));\n            \n            vec2 neighborPoint = random2(i_uv + curNeighbor);\n            \n            #ifdef ANIMATE\n            neighborPoint = 0.5 + .5*sin(iTime + 3.14159 * neighborPoint);\n            #endif\n            \n            vec2 curVector = curNeighbor + neighborPoint - f_uv;\n            \n            //\u6392\u9664\u81ea\u76f8\u4ea4\n            if(dot(minVector - curVector, minVector - curVector)>0.00001)\n            \t//\u50cf\u7d20\u5728\u6700\u8fd1\u70b9\u548c\u6b21\u8fd1\u70b9\u7684\u6bd4\u503c\n                minDistance = min(minDistance, \n                         dot(0.5 * (minVector + curVector),\n                             normalize(curVector - minVector)\n                            ));\n            \n        }\n    }\n    \n    return vec3(minDistance, minVector);\n}\n\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    \n    vec2 uv = fragCoord/iResolution.xx;\n    \n    vec3 c = voronoi( 8.0*uv );\n\n    //\u753b\u7b49\u503c\u7ebf\n    //Show isolines\n    vec3 addColor= vec3(0.3, .6, 0.6);\n    vec3 color = c.x * (.5 + .5*sin(32.0*c.x))*vec3(1.0);\n    \n    //\u753b\u8fb9\u754c\n    //Draw broders\n    color = mix(addColor, color, smoothstep(.04, .07, c.x));\n    \n    //\u753b\u7ec6\u80de\u4e2d\u5fc3\n    //Draw cell center\n    float dd = length(c.yz);\n\tcolor = mix(addColor, color, smoothstep(0.0, 0.12, dd) );\n    color += addColor * (1.0-smoothstep( 0.0, 0.04, dd));\n    \n    \n    fragColor = vec4(color,1.0);\n}", "name": "Image", "description": "", "type": "image"}]}