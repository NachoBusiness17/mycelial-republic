{"ver": "0.1", "info": {"id": "tssXz8", "date": "1550653673", "viewed": 482, "name": "Sine wave line", "username": "noriben", "description": "Sine wave line\nreference: https://www.shadertoy.com/view/wsf3zS", "likes": 0, "published": 3, "flags": 0, "usePreview": 0, "tags": ["wave"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    vec2 uv = fragCoord/iResolution.xy;\n\t\n    float amp = 0.1; //\u632f\u5e45\n    float freq = 6.0; //\u5468\u6ce2\u6570\n    float thickness = 0.05 / 2.0; //\u7dda\u306e\u592a\u3055\n    float smoothing = 4.0 / iResolution.x; //\u753b\u9762\u89e3\u50cf\u5ea6\u306b\u5fdc\u3058\u305f\u30a2\u30f3\u30c1\u30a8\u30a4\u30ea\u30a2\u30b9\n    \n    //\u30b5\u30a4\u30f3\u30ab\u30fc\u30d6\u3092time\u3067mix\n    //float y = mix(amp * sin(uv.x * freq + iTime), amp * cos(uv.x * freq * 2. + iTime),  sin(iTime));\n    float wave = uv.x * freq + iTime;\n    //wave01\n    float y = amp * (wave - floor(wave)) + amp * acos(cos(2.0 * wave)) + amp  - 0.3;\n    //wave02\n    float s = amp * sin(wave);\n    //mix\n    y = mix(y,s, sin(iTime));\n    \n    vec3 linecolor = vec3(uv.x * sin(iTime), uv.y * sin(iTime), 0.9);\n    vec3 coltop = vec3(smoothstep(0.0, smoothing, uv.y - y - 0.5 + thickness)) * linecolor;\n    vec3 colbottom = vec3(1. - smoothstep(0.0, smoothing, uv.y - y - 0.5 - thickness));\n    vec3 col = coltop * colbottom;\n\t\n    fragColor = vec4(col,1.0);\n}", "name": "Image", "description": "", "type": "image"}]}