{"ver": "0.1", "info": {"id": "ttsfW4", "date": "1596907734", "viewed": 156, "name": "\u5927\u9f99\u732b - Quicky#039", "username": "totetmatt", "description": "Quicky", "likes": 4, "published": 3, "flags": 0, "usePreview": 0, "tags": ["quicky"], "hasliked": 0, "parentid": "", "parentname": ""}, "renderpass": [{"inputs": [], "outputs": [{"id": "4dfGRr", "channel": 0}], "code": "mat2 r(float f){\n    float c=cos(f),s=sin(f);\n    return mat2(c,s,-s,c);\n}\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 uv = (fragCoord.xy-.5 * iResolution.xy) / iResolution.y;\n    vec2 uuv = uv;\n    uv*=r(iTime*.2+length(uv));\n    uv.x *=sign(sin(uv.y*100.));\n    uv.y *= sign(cos(uv.x*100.));\n    if(length(uuv)>.525) {\n         uv*=r(iTime*.2+length(uv));\n    uv.x *=-sign(cos(uv.y*100.));\n    uv.y *= -sign(sin(uv.x*100.));\n    }\n    float d = sin(-iTime+cos(iTime)*atan(uv.y,uv.x)+(3.*atan(uv.x,uv.y))+length(uv*10.));\n    vec3 col = smoothstep(0.1,0.01,vec3(d));\n    fragColor = vec4(col,1.0);\n}", "name": "Image", "description": "", "type": "image"}]}