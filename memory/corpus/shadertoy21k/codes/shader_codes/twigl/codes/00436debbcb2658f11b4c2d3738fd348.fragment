void rot(inout vec3 p,vec3 a,float t){
	a=normalize(a);
	vec3 u=cross(a,p),v=cross(a,u);
	p=u*sin(t)+v*cos(t)+a*dot(a,p);   
}
void rot(inout vec2 p,float t){
    p=p*cos(t)+vec2(p.y,-p.x)*sin(t);
}

#define G dot(p,vec2(1,-1)*.707)
#define V v=vec2(1,-1)*.707
void sfold(inout vec2 p)
{
  vec2 v=vec2(1,-1)*.707;
    float g=dot(p,v);
    p-=(G-sqrt(G*G+.01))*v;
}

float map(vec3 p){
  rot(p.xy,t*.5);
  rot(p.yz,t*.3);
  float k=.01;
  for(int i=0;i<8;i++)
  {
  p=abs(p)-1.;
  sfold(p.xz);
	sfold(p.yz);
	sfold(p.xy);
	rot(p,vec3(1,2,2),.6);
	p*=2.;
  }
  return length(p.xy)/exp2(8.)-.01;
}

void main(){
  vec2 uv=(2.*gl_FragCoord.xy-r)/r.y;
  vec3 ro=vec3(0,0,-8);
  vec3 rd=normalize(vec3(uv,3));
  vec3 p;
  float h=0.,d,i;
	for(i=1.;i<100.;i++){
    p=ro+rd*h*.5;    
		d=map(p);
  	if(d<.0001)break;
    h+=d;
	}
  o.xyz+=15./i;
}
