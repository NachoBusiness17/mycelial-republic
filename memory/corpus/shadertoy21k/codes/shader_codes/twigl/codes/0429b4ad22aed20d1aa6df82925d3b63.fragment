float d,e,i=0.,s;
vec3 p;
for(;i++<100.;e<.001?o+=.3*atan(1./i,pow(d,.1)):o){
  p=d*vec3((FC.xy-.5*r)/r.y, 1);
  p.z-=5.;
  p.xz*=rotate2D(t);
  s=1.;
	for(int i=0;i<5;i++){
	  e=2.3/clamp(dot(p,p),.3,1.1);
	  p=abs(p);
	  p*=e;
	  p-=vec3(1,10.*fract(t),1);
	  s*=e;
	}
	p-=clamp(p,-1.,1.);
	d+=e=length(p)/s;
}
o.rgb*=cos(vec3(1,2,3)+log(s));
