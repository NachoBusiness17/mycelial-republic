#define o(p)length(max(abs(p)-1.,.0))
#define n q=1.-3.*abs(mod(s*e,2.)-1.),d=max(d,(min(o(q.xy),min(o(q.xz),o(q.yz))))/e),e*=3.
void main(){
	vec3 s,q,b;
	float e,d;
    for(int i=0;i<15;i++){
        vec3 l=vec3((gl_FragCoord.xy*2.-r)/min(r.y,r.x),-1.);
        s.yz*=mat2(vec4(cos(t),-sin(t),sin(t),cos(t)));
        e=1.,d=o(s);
        n,n,n;
        b+=d;s=b*l+vec3(0.,0.,3.);
    }gl_FragColor=vec4(vec3(dot(vec2(.5,0.),vec2(length(s)))),1);}
