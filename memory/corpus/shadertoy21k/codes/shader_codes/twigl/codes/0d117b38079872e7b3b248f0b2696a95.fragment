vec3 p;for(float i,g,e,s;++i<99.;e<.001?o+=(cos(vec4(1,2,3,0)+log(s))*.1+.5)/length(p)/i:o){
  p=vec3(g*(FC.xy-.5*r)/r.y,g);
  p-=vec3(0,-.9,1.5);
  p*=rotate3D(t*.3,vec3(1,8,0));
  s=3.;
  s*=e=6./min(dot(p,p),2.);
  p=abs(p)*e;
  for(int i;i++<2;){
    p.x =1.-abs(p.x-5.2);
    p.y =3.6-abs(p.y-4.3);
    p.z =1.8-abs(p.z-2.5);
    s*=e=8./min(dot(p,p),9.);
    p=abs(p)*e;
  }
  g+=e=min(length(p.xz)-.3,p.y)/s;
}
