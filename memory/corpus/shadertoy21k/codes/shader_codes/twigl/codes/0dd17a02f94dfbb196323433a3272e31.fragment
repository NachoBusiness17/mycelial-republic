float i,g,e=1.,d;
for(i;++i<50.&&e>.001;){
  vec3 n=-vec3(.5,cos(PI/5.),0),
  p=g*vec3((gl_FragCoord.xy-.5*r)/r.y,1);
  n.z=sqrt(1.-dot(n,n));
  p.z-=5.;
  p*=rotate3D(t,vec3(1));
  for(int j=0;j<5;j++)
    p.xy=abs(p.xy),
    p-=2.*min(0.,dot(p,n))*n;
  // Dodecahedron
  g+=e=dot(p,normalize(vec3(-n.x,0,-n.y)))-1.;
  // Icosahedron
  //g+=e=dot(p,normalize(vec3(0,n.z,-n.y)))-1.;
}o+=5./i;
