vec4 c=vec4(.2,.4,1,6);
float i,g,h,s,H=1e2;
for(int i=0;i<100;i++){
  mat3 M=rotate3D(t,c.ywx-sin(t-c.xzw));
  vec3 p=vec3((FC.xy-.5*r)/r.y*g,g-H),z,q=p*=M;
  s=h=.01;
  for(int j=0;j<9;j++)z=sin(p*s),h+=abs(z.x*z.z)/s,p.xz*=rotate2D(H),q=abs(q)*M,s+=s;
  g+=min(s=length(q.xz),h=max(0.,p.y+h))*.2;
  gl_FragColor+=pow(c*h/s/s,c)/H;
  
}
