vec3 p;for(float i,g,e,s;++i<99.;e<.001?o.xyz+=hsv(g*.2,.5,.5)/i:p){p=vec3(g*(FC.xy-.5*r)/r.y,g-2.)*rotate3D(t*.5,vec3(0,1,0));p.y-=sin(t*.1)*8.;s=2.;for(int j;j++<8;)s*=e=2./clamp(dot(p,p),.2,1.),p=abs(p)*e-vec3(.5,8,.5);

if(FC.x<r.x/2.) {
  // left half
  e=length(cross(p,vec3(1,1,-1)))/s;
} else {
  // right half
  e=length(p)/s;
}

g+=e;
  
}
