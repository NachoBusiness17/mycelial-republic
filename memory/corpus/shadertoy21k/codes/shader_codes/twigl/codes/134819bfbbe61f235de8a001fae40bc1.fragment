void main(){float T;for(float D,i=0.;i<99.;i+=.1){vec3 R=vec3((gl_FragCoord.xy-r*.5)/r.y*.75,1),O,P,B;P+=O+R*T;P.y+=sin(P.z*8.)*(.5*sin(P.x))+cos(P.z*.01)-10.;P.xy*=mat2(cos(T+.1+vec4(0,11,33,0)));P+=t*.5;P=mod(P,10.)-5.;B=abs(P)-vec3(2.,.01,.2)-.01;D=length(max(B,0.))+min(max(B.x,max(B.y,B.z)),0.);T+=D*.02;if(D<.0001) {o=vec4(1./pow(i,.9)*30.);break;}}}
