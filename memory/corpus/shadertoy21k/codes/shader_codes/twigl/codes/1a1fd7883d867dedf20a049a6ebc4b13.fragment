#define n(p)snoise2D(floor(p.xy))>.5?p.x*=-1.:i
#define m(p)smoothstep(.1,.0,abs(sign(d=p.x+p.y)*d-.5)-.2)+

vec3 c,u;
float g,i,d=1.;
for(;++i<50.&&d>.001;g+=d=length(max(abs(u=vec3((FC.xy-r/2.)/r.y*5.,g-2.)*rotate3D(t,vec3(1,1,0)))-1.,0.))/2.);

c=pow(abs(u),vec3(80.));
u*=7.;n(u.zxy);n(u.yzx);n(u);u-=round(u);
d<.001?o+=c.y*m(u.xz)c.x*m(u.yz)c.z*m(u)o:o;
