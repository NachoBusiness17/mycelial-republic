precision highp float;
uniform vec2 resolution;
uniform vec2 mouse;
uniform float time;
uniform sampler2D backbuffer;
out vec4 O;

#define rot(a)mat2(cos(a),sin(a),-sin(a),cos(a))

float map(vec3 p)
{
  float s = 4.;
  for(int i = 0; i < 8; i++){
    p.xz*=rot(3.1415/3.);
    p=mod(1.-p,2.)-1.;
    float r2=(4./3.)/dot(p,p);
    p*=r2;
    s*=r2;
  }
  return (length(p))*abs(p.y)/s;
}

void main(){
  vec2 uv=(2.*gl_FragCoord.xy-resolution)/resolution.y;
  vec3 ro=vec3(time,1,time);
  vec3 rd = normalize(vec3(uv,1.7));
  vec3 p;
  float h=0.,d=1.,i;
  for(;i<1. && d>.001;i+=.01){
    p=ro+rd*h;    
    d=map(p);
    h+=d;
  }
  float bklight=(p.y+2.)*h*.03;
  O.xyz+=vec3(pow(2.-p.y,.5)*.5,pow(abs(p.y-.8)*4.+3.,.6)*.1,0)-i+bklight*vec3(.8,.9,.7);
}
