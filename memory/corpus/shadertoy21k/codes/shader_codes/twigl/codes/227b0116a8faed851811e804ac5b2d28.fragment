for(float i,g,e;++i<70.;e<1e-3?o+=.4/i:o)
{
  vec3 p=g*vec3((FC.xy-.5*r)/r.y,1);
  p.xz*=rotate2D(t*.2);
  
  float s=1.; // 倍率の初期設定は、1.0。アーティファクトが出る場合は数値を上げる。
  for(int j;++j<8;)
    p.xz=abs(p.xz),
    p.z>p.x?p=p.zyx:p,
    p.y>p.z?p=p.xzy:p,
    p.z=abs(p.z)-1.,
    p.y+=1.,
    p.x-=p.y*.5,
    p=3.*p-vec3(8,1,3),
    //座標にかけた倍率と同じ倍率を掛ける。
    s*=3.;
  // SDFをsで除算してスケールを合わせる。
  g+=e=dot(p,normalize(vec3(1,5,1)))/s-.04;
  //g+=e=dot(p,normalize(vec3(1,5,1)))/3e3-.04;
}
