float map(vec3 p){
  float s = 1.,de=1.;
 	for(int i = 0; i < 7; i++) {
    p=p-2.5*round(p/2.5);
		float r2=1.5/dot(p,p);
		p-=vec3(.09,.15,.12);
    p*=r2;
    s*=r2;
	  de=min(de,length(p.yz)/s-.001);
   }
	return de;
}

void main(){
  vec2 uv=(2.*gl_FragCoord.xy-r)/r.y;
	vec3 p,
  		ro=vec3(2,0,-mod(t,10.)*.3),
  		w=normalize(vec3(.2,sin(t*.05)*.5,-1)),
  		u=normalize(cross(w,vec3(0,1,0))),
  		rd=mat3(u,cross(u,w),w)*normalize(vec3(uv,2));
  float h=0.,d,i,zoom = 3.;
  ro*=zoom;
  for(i=1.;i<80.;i++){
    p=ro+rd*h;
    p/=zoom;
	  d=map(p);
    if(d<0.001||h>25.)break;
    h+=d;
  }
	o.xyz=25.*vec3(cos(p*.4)*.5+.5)/i;
}
