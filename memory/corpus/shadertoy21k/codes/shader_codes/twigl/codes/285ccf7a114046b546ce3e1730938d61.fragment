float d,e=1.,i,s=1.,ss=1.,gl; vec3 p, pp;
for(;e>.001&&i<100.;i++){ // @zozuar 's style
  pp=p=vec3((FC.xy-.5*r)/r.y*d, d-20.);
  
  // p.yz*=rotate2D(-.3);
  p.xz*=rotate2D(t*.3+.5);
  ss=3.;
  
  for(int j=0; j++<7;){
		p=abs(p);
    p.y-=.5;

    s = 1./clamp(dot(p,p),.0,1.);

    p*=s;
		ss*=s;
		p-=vec2(1,.1).xxy;
		p.xyz=p.zxy;
  }
  
  d+=e=length(p)/ss-.04;
  // glowing lines :P
  gl=length(p.xz)/ss+.01;
  o+=6e-5/gl/gl
    * abs(cos(vec4(3,2,1,0)+log(ss)))
    * (sin(-length(pp)+t*10.)*.4+.6);
}
o+=1./i;
