float i,g,e,s;
for(vec3 p;
  ++i<99.;
  e<.001?o.xyz+=hsv(log(s)*.25,.7,1.)/i:p
)
{
  p=vec3(g*(FC.xy-.5*r)/r.y,g-8.)*rotate3D(t*.3,r.xxy);
  p.xz=vec2(atan(p.z,p.x),length(p.xz)-2.5);
  p.yz=vec2(atan(p.z,p.y),length(p.yz)-1.);
  p.z=abs(p.z)-.3;
  p.z=abs(p.z)-.3;
  s=3.;
  for(int j=0;j++<8;)
    s*=e=2.3/clamp(dot(p,p),.1,1.6),
    p=abs(p)*e-vec3(6.5,2,.005);
  g+=e=length(p.xz)/s;
}
