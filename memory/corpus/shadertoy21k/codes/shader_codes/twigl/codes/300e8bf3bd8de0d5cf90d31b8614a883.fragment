#define S cos(Q.z+Q.x+2.)*.7
#define W cos(Q.z*Q.x+t*3.)*.1
#define M min(P.y,length(P-Y)-S*S*S)
#define V t*.2
void main(){vec3 U,T,O,P,Q,Y;while(o.w++<1e3)U=vec3(gl_FragCoord.xy-r*.5,-r.y),U.y+=sin(t*.5)*10.,U.x+=cos(t*2.)*10.,P=.5+U/r.y*T,P.x+=t*.1,P.y+=length(sin(P.xz*.3)),P.x-=V,Q=ceil(P+.5),O=P,P.xz=mod(P.xz,2.)-1.,Y.y=S*S*S,Y.x=W,T+=M*.1;o+=(M<.2)?P+=.1,20.*(P.y>.11?.8:smoothstep(.5,.8,sin((O.x+V)*20.)))*max(M,0.)/T.x:.0;o=mix(vec2(dot((gl_FragCoord.xy/r),vec2(1,.4))),o.xy,.4).xxxx*1.3+ceil(sin(t*5e3)*2.)*.002;
  o*=1.-pow(max(0.,length(U.xy/r.y)-.6),1.5);}
