vec2 p=(FC.xy*2.-r)/r.y;p=length(p)*sin(vec2(0,PI/2.)+mod(atan(p.y,p.x),PI/3.)-PI/6.);for(float i;i++<9.;){vec3 q=vec3(p,i);q.y-=2./(fract(t)+i);for(float j;j++<10.;)q.xy=abs(q.xy)-.6,q.xz=abs(q.xz)-.3,q*=rotate3D(t*.3+sin(t*.2)*.5,vec3(2,-3,5));
o.xyz+=hsv(i*.1+t,.6,.3)*(exp(-q.y*q.y*5e6)*.7+.01/abs(q.y));}
