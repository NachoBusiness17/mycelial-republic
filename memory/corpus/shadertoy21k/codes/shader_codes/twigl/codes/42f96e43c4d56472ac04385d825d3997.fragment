float A=100.,B=250.,C=0.015;

float n(vec3 p){
vec3 r=vec3(1,99,999);
vec4 s=dot(floor(p),r)+vec4(0,r.y,r.z,r.y+r.z);
p=smoothstep(0.,1.,fract(p));
s=mix(fract(sin(s)*5555.),fract(sin(s+1.)*5555.),p.x);
s.xy=mix(s.xz,s.yw,p.y);
return mix(s.x,s.y,p.z);
}

void main(){
  vec2 q,p=(gl_FragCoord.xy*2.-r)/r.y;
  float T=t*20.;
  
  for(float j=0.;j++<8.;){
    q=vec2(0);
    for(float i=1.;i>0.;i-=.03){
      o.xyz=mix(o.xyz,vec3(1), smoothstep(0.01,0.0,abs(length(p+q)-.07*i)));
      q+=.15*(vec2(n(vec3(i*A+15.,j*B+48.+T,T)*C)-.5,n(vec3(i*A+50.,j*B+23.+T,T)*C)-.5));
    }
  }
}
