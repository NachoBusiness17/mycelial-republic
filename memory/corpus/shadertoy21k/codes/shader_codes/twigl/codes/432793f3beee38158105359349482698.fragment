vec2 m = (FC.xy - r * 0.5)/r.y * 5.0;
m *= (1.0 - length(m) * .1);
vec2 p = m;

vec3 c = vec3(0, 0, 0);
p += sin(t * vec2(.1, .15)) * vec2(8, 8);
p = mod(p, 4.) - 2.;

for (int i = 0; i < 8; ++i)
{
  p = abs(p);
  // Polar coordinate
  vec2 q = vec2(atan(p.y, p.x), length(p));
  q.x += t * .1;
  float s = PI * 2.0 / 6.0;
  q.x = mod(q.x, s) - s * .5;
  q.x = abs(q.x);
  
  // Inverse polar coordinate
  p = vec2(cos(q.x), sin(q.x)) * q.y;
  p.x -= 0.5;
  p *= 2.0;
  
  // Circular reflection
  p = p / dot(p, p);
  
  float j = float(i) + t * 4.0;
  vec3 d = vec3(sin(j), sin(j + 1.0), 0) * .01;
  c += d.xyz / abs(p.y);
  c += d.yzx / abs(p.x - 1.1);
  c += d.zxy / abs(length(p) - 1.);

}
c = mix(c, dot(c, vec3(1,1,1)) * vec3(1, 1, 1), .5);
c = clamp(c, vec3(0), vec3(1));
c *= max(0., 4. - length(m * 1.6));
o = vec4(c, 1);
