#define rot(a) mat2(cos(a),sin(a),-sin(a),cos(a))
float orbit;
float map(vec3 p){
	p.yz*=rot(t*0.1);
  p.xz*=rot(t*0.2+2.);
	p=abs(p)-1.7;
	if(p.x<p.z)p.xz=p.zx;
	if(p.y<p.z)p.yz=p.zy;
 	if(p.x<p.y)p.xy=p.yx;
 	float s=3.;
	vec3  off=p*.5;
	for (float i=0.;i<12.;i++){
		  p=1.-abs(p-1.);
  		float k=-1.4*max(1.8/dot(p,p),1.4);
    	s*=abs(k);
   		p*=k;
      p+=off;
    	p.xz*=rot(-1.2);
    }
	orbit = log2(s);
	float a=5.;
	p-=clamp(p,-a,a);
	return length(p)/s;
}

void main(){
  vec2 uv=(2.*gl_FragCoord.xy-r)/r.y;
  vec3 ro=vec3(0,0,-10);
  vec3 rd=normalize(vec3(uv,3));
  float h=0.,d,i;
	for(i=1.;i<100.;i++){
    d=map(ro+rd*h);
  	if(d<.0001)break;
    h+=d;
	}
  o.xyz+=8.*(cos(vec3(9,5,12)+orbit*3.)*.5+.5)/i;
  o.xyz+=15./i;
}
