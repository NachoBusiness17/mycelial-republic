precision highp float;
uniform vec2 resolution;
uniform float time;
out vec4 fragColor;

#define rot(a) mat2(cos(a),sin(a),-sin(a),cos(a))
mat3 lookat(vec3 eye, vec3 target, vec3 up)
{
    vec3 w = normalize(target-eye), u = normalize(cross(w,up));
    return mat3(u,cross(u,w),w);
}

void main(){
  vec2 uv=(gl_FragCoord.xy-.5*resolution.xy)/resolution.y;
  vec3 rd=normalize(vec3(uv,1));
  vec3 ro=vec3(0,0,-3);
  vec3 ta=vec3(0);
  ro.xz*=rot(time);
  rd=lookat(ro,ta,vec3(0,1,0))*rd;
    
  vec3 a=vec3(-.5);
  vec3 b=vec3(.5);
  float r=.3;
    
  vec3 ab=normalize(b-a),ao = a-ro;
	float d0=dot(rd, ab);
	float d1=dot(rd, ao);
	float d2=dot(ab, ao);
	float len=(d0*d1-d2)/(1.-d0*d0);
  len=clamp(len,0.,length(b-a));
  vec3 c=a+ab*len;
    
  vec3 u=cross(c-ro,rd);
  float h=r*r-dot(u,u);
  if(h>0.)
  {
    h=sqrt(h);
    float g=dot(c-ro,rd);
    float near=g-h;
	  float far=g+h;
    vec3 p=ro+near*rd;
    vec3 n=normalize(p-c);
    fragColor.xyz+=n;
  }
}
