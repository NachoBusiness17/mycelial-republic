float i,e;
vec3 s,q,p,d=vec3((FC.xy-.5*r)/r.y,1);
mat3 R,m;
q.z=-14.;
d*=R=rotate3D(t+PI,d/d);
q*=R;
for(;i++<50.;){
  m = mat3(1,0,0,0,1,0,0,0,1);
  p=q+=d*e*.7;
  for(int j;j++<int(t/PI)%6;){
    R=rotate3D(t/2.+float(j),d/d);
    s=sign(p);
    m*=mat3(s.x,0,0,0,s.y,0,0,0,s.z)*R;
    p=(abs(p)-1.)*R;
  }
  e=(length(p.xy)-.7);
  if(e<.001){
    d=reflect(d,normalize(m*vec3(p.xy,0)));
    e=.001;
  }
 }
o+=d.y*.5+.5;
