#define rot(a) mat2(cos(a),sin(a),-sin(a),cos(a))

float de2D(vec2 p, float r, float k1, float k2)
{
    float a = atan(p.y, p.x);
    float d = length(p)-r+cos(a*k1)*k2;
    return d;
}

float de(vec3 p)
{
    p.xy*=rot(t);
    p.yz*=rot(t);
    float a=atan(p.y, p.x);
    vec2 q =rot(a*3.)*vec2(de2D(p.xy,3.,5.,.3),p.z);
    return .8*de2D(q,1.,5.,.05);
}

#define A(a)length(p.a)-0.1
vec3 C(vec3 p){if(A(yz)<.001) return vec3(1,0,0);if(A(zx)<.001) return vec3(0,1,0);if(A(xy)<.001) return vec3(0,0,1);return vec3(.3,.8,1);}void main(){vec2 uv=(gl_FragCoord.xy*2.-r)/r.y;vec3 col,ro=vec3(2,3,10),w=normalize(-ro),u=normalize(cross(w,vec3(0.0,1.0,0.0))),rd=mat3(u,cross(u,w),w)*normalize(vec3(uv,2)),p;float i,h=0.0,d;for(i=1.;i>0.;i-=.02){p=ro+rd*h;h+=d=min(min(min(A(yz),A(zx)),A(xy)),de(p));if(d<.001){o=vec4(C(p),1);o*=i*i;break;}}}
