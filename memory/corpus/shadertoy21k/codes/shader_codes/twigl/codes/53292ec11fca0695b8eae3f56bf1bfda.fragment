precision highp float;
uniform vec2 resolution;
uniform vec2 mouse;
uniform float time;
uniform sampler2D backbuffer;
void main()
{vec2 f=gl_FragCoord.xy*.2+vec2(step(.45,fract(time*10.0))*time*10.0,0);float v=f.y+time*20.0;gl_FragColor=vec4(step(.5,fract(f.x))+sin(time)*.5,step(sin(time),fract(f.y)),sin(v),1);}
