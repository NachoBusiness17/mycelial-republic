#define pmod(p,n) (length(p)*sin(vec2(0,1.571)+mod(atan(p.y,p.x),6.2832/n)-3.1416/n))
float de(vec3 p){
  p.xy=pmod(p.xy,5.0);
  p=abs(p);
  p.y-=5.;
  return dot(p, normalize(vec3(2,1,3)));
}

#define rot(a)mat2(cos(a),sin(a),-sin(a),cos(a))
float map(vec3 p)
{
	p.xz*=rot(t*.5);
	p.xy*=rot(t*.5);
	float d= de(p);
	return d;
}

void main(){
  vec2 uv=(2.*gl_FragCoord.xy-r)/r.y;
  vec3 ro=vec3(0,0,-10);
  vec3 rd=normalize(vec3(uv,2));
  vec3 p;
  float h=0.,d,i;
	for(i=1.;i<50.;i++){
    p=ro+rd*h;    
		d=map(p);
  	if(d<.0001)break;
    h+=d;
	}
  o.xyz+=10./i;
}
