#define rot(a) mat2(cos(a),sin(a),-sin(a),cos(a))

float lpNorm(vec3 p, float n)
{
	p = pow(abs(p), vec3(n));
	return pow(p.x+p.y+p.z, 1.0/n);
}

float map(vec3 p){
  float s = 1.;
	for(int i = 0; i < 9; i++) {
		p =2.*fract(.5-.5*p)-1.;
		float r2=1.5/max(pow(lpNorm(p.xyz, 1.7),2.),.3);
		//float r2=1.2/max(dot(p,p),.2);
    p *= r2;
    s*=r2;
	}
	return length(p)/s-.01;
}

void main(){
  vec2 uv=(2.*gl_FragCoord.xy-r)/r.y;
  vec3 p,
    e0=vec3(5,2,3), e1=vec3(2,3,7),
    d0=vec3(0,1,-1),  d1=vec3(1,0,-1),
  ro=mix(e0,e1,fract(t*.1)),
  w=normalize(mix(d0,d1,fract(t*.1))),
  u=normalize(cross(w,vec3(0,1,0))),
  rd=mat3(u,cross(u,w),w)*normalize(vec3(uv,2));
  float h=0.,d,i,zoom = 3.;
  ro*=zoom;
  for(i=1.;i<80.;i++){
    p=ro+rd*h;
    p/=zoom;
    //p.xy*=rot(t*.3);
    //p.yz*=rot(t*.3);
	  d=map(p);
    if(d<0.001||h>20.)break;
    h+=d;
  }
	o.xyz=25.*vec3(cos(p*.4)*.5+.5)/i;
}
