#define rot(a) mat2(cos(a),sin(a),-sin(a),cos(a))
float lpNorm(vec2 p,float n){
	p = pow(abs(p),vec2(n));
	return pow(p.x+p.y,1./n);
}
vec2 func(float t){
  t*=15.0;
  float x=t*.2-1.2;
  float y=.2*sin(t*.3+2.*sin(t*.5)+t);
	return vec2(x,y);
}
float de(vec3 p)
{
  p.xy*=rot(t);
  p.yz*=rot(t);
  float ITR=30.,pitch=1.,tt=.5,de=9.;   
  for(int j=0; j<2; j++)
  {
    float t0 = tt-pitch*.5;
    pitch /= ITR;
    for(float i=0.0; i<ITR; i++) 
    {
      t0 += pitch;
      float de0=distance(p.xy,func(t0));
      if (de0<de)
      {
        de = de0;
        tt=t0;
      }       
    }
  }
  float d=distance(p.xy,func(tt));
  return min(
    lpNorm(vec2(p.z-clamp(p.z,-.1,.1),d-.1),5.)-.03,
  	length(max(vec2(abs(p.z)-.07,d-.1),0.))-.03
  );
}

#define A(a)length(p.a)-0.01
vec3 C(vec3 p){if(A(yz)<.001) return vec3(1,0,0);if(A(zx)<.001) return vec3(0,1,0);if(A(xy)<.001) return vec3(0,0,1);return vec3(.3,.8,1);}void main(){vec2 uv=(gl_FragCoord.xy*2.-r)/r.y;vec3 col,ro=vec3(.5,.5,2),w=normalize(-ro),u=normalize(cross(w,vec3(0.0,1.0,0.0))),rd=mat3(u,cross(u,w),w)*normalize(vec3(uv,2)),p;float i,h=0.0,d;for(i=1.;i>0.;i-=.02){p=ro+rd*h;h+=d=min(min(min(A(yz),A(zx)),A(xy)),de(p));if(d<.001){o=vec4(C(p),1);o*=i*i;break;}}}
