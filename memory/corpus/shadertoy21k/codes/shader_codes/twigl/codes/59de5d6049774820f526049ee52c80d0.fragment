precision highp float;
uniform vec2 resolution;
uniform float time;
out vec4 fragColor;

#define rot(a) mat2(cos(a),sin(a),-sin(a),cos(a))
#define PI (atan(1.)*4.)

float map(vec3 p){
    p=p.xzy;
    p.xz*=rot(time*.5);
    p.yz*=rot(time*.3+.5);
    p.zx=vec2(atan(p.z,p.x)/PI*1., length(p.zx)-.6);
    p.y*=.5;
    p.xy=vec2(atan(p.x,p.y)/PI*.9, length(p.xy)-.5);
    p.x+=.1*p.z;
    float c=.1;
    p.x=mod(p.x,c*2.)-c;
    return length(p.xy)-.03;
}

void main(){
    vec2 uv=(gl_FragCoord.xy-.5*resolution)/resolution.y;
    vec3 rd=normalize(vec3(uv,1));
    vec3 p=vec3(0,0,-3);
    float d=1.,i;
    for(;++i<99.&&d>.001;)p+=rd*(d=map(p));
    if(d<.001)fragColor+=5./i;
}
