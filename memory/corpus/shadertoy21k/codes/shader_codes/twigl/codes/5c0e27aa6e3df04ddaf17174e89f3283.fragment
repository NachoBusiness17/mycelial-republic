float orbit;
float map(vec3 p){
  p.z-=-t;
  p.xy=abs(p.xy);
  if(p.x<p.y)p.xy=p.yx;
  p.z=mod(p.z,4.)-2.;
  p.x-=3.5;
	float s=1.8;
	p=abs(p);
	for (float i=0.; i<4.; i++){
    	p=1.-abs(p-1.);
    	float k=-5.5*clamp(.28*max(2.5/dot(p,p),.8),0.,1.5);
    	p*=k;
      p+=vec3(1.,.2,1.);
	    s*=abs(k);
  }
  orbit=log2(s);
	return length(p.xz)/s-.003;
}

void main(){
  vec2 uv=(2.*gl_FragCoord.xy-r)/r.y;
  vec3 ro=vec3(0);
  vec3 rd=normalize(vec3(uv,3));
  float h=0.,d,i;
	for(i=1.;i<100.;i++){
    d=map(ro+rd*h);
  	if(d<.0001)break;
    h+=d;
	}
  o.xyz+=5.*(cos(vec3(2,13,7)+orbit*1.)*.5+.5)/i;
  o.xyz+=20./i;
}
