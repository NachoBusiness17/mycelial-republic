vec3 p,q;for(float i,g,e,s;++i<99.;e<.001?o.rgb+=hsv(log(s)*.3,.7,.015*exp(-5./i/i)):p){p=vec3((FC.xy-.5*r)/r.y*g,g-7.)*rotate3D(t,r.xxy);q=p*.5;s=3.;for(int j;j++<8;)p=asin(sin(clamp(-p,-3.,3.)/2.*PI)/1.15)/PI*2.-clamp(p,-3.,3.)+p,e=9.*clamp(.3/min(dot(p,p),1.),0.,1.),p=p*e+q,s*=e;g+=e=length(p)/s;}
