#define rot3(p,a,r)mix(a*dot(p,a),p,cos(r))+sin(r)*cross(p,a)
#define rot2(p,r)p*cos(r)+vec2(-p.y,p.x)*sin(r)

// type vec3
float noise(vec3 p){
    float s=1.;
    float n=0.;
    for(int i=0;i<5;i++){
        p=rot3(p,normalize(vec3(1,2,3)),2.);
        vec3 q=cos(p*s);
        n+=(q.x*q.y*q.z)/s;
        s*=2.;
    }
    return n;
}

// type vec2
float noise(vec2 p){
    float s=1.;
    float n=0.;
    for(int i=0;i<5;i++)
    {
        p=rot2(p,2.);
        vec2 q=cos(p*s);
        n+=(q.x*q.y)/s;
        s*=2.;
    }
    return n;
}

void main(){
    vec2 uv = (gl_FragCoord.xy-.5*r.xy)/r.y;
    vec3 col = vec3(0);
    if(uv.x<0.){
        col+=abs(noise(vec3(uv*5., t*.5)))*.8;
    }else{
        col+=abs(noise(vec2(uv*5.+t*.3)))*.6;
    }
    o = vec4(col,1.0);
}
