float i,g,e=1.,s;for(;e>.001&&++i<99.;){vec3 p=vec3(g*(FC.xy-.5*r)/r.y+2.,g);p.y-=p.z*.7;p.xz=asin(sin((p.xz+t*.3)*PI/2.))/PI*2.;s=1.;for(int i=0;i<5;i++)p.xz=abs(p.xz-vec2(1,2))-1.,s*=e=3.2/clamp(dot(p.xz,p.xz),.5,2.0),p.xz=p.xz*e-.5;vec2 q=vec2(abs(p.z/s),p.y);g+=e=.5*min(p.y,length(q-min(q,vec2(.005,.2))));}o.rgb+=5./i;
