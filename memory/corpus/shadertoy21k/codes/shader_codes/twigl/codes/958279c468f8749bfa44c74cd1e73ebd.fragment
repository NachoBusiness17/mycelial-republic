precision highp float;
uniform vec2 resolution;
uniform float time;
out vec4 o;

#define iResolution resolution.xyy
#define iTime time
void mainImage(out vec4 fragColor, in vec2 fragCoord);
void main(){
  mainImage(o, gl_FragCoord.xy);
}
// +++++++++++++++++++++++++++++++++++++++++++++++++++++
#define t iTime
vec3 rot(vec3 p,vec3 a,float t){
  a=normalize(a);
  return mix(a*dot(p,a),p,cos(t))+sin(t)*cross(p,a);
}
float map(vec3 p){
 float a=2.,s=3.,e,l=dot(p,p);
 p=abs(p)-1.;
 p.x<p.y?p=p.yxz:p;
 p.x<p.z?p=p.zyx:p;
 p.y<p.z?p=p.xzy:p;
  for(int i;i<8;i++){
    s*=e=2.1/clamp(dot(p,p),.1,1.);
    p=abs(p)*e-vec3(.3*l,1,5.*l);
  }
  //return length(cross(p,vec3(.577)))/s;
  p-=clamp(p,-a,a);
  return length(p)/s-0.;
}
void mainImage(out vec4 o, in vec2 fragCoord){
    vec2 uv = (2.*fragCoord-iResolution.xy)/iResolution.y;
    vec3 p,c,d=normalize(vec3(uv,2));
    float i=0.,g=0.,e;
    for(;i<99.;i++){
      p=g*d;
      p.z-=5.;
      p=rot(p,vec3(2,1,1),t);
      g+=e=map(p);
      e<.001?o+=.2/i:o;
      
    }
    //o = vec4(c,1.0);
}
