#define PI acos(-1.0)
float map(vec3 p){
  p.z-=-t*2.;
  p.xy=vec2(length(p.xy)-PI,atan(p.y,p.x)*PI);
  p.yz=mod(p.yz,4.)-2.;
	float scale=-7.5;
	float mr2=.28;
	float off=2.7;
	float s=3.;
	p=abs(p);
	vec3  p0 = p;
	for (float i=0.; i<7.; i++){
    	p=1.-abs(p-1.);
    	float g=clamp(mr2*max(1.8/dot(p,p),1.),0.,1.);
    	p=p*scale*g+p0*off;
      s=s*abs(scale)*g+off;
	}
	return length(p.xz)/s-.005;
}

void main(){
  vec2 uv=(2.*gl_FragCoord.xy-r)/r.y;
  vec3 ro=vec3(0,0,-10);
  vec3 rd=normalize(vec3(uv,3));
  vec3 p;
  float h=0.,d,i;
	for(i=1.;i<100.;i++){
    p=ro+rd*h;    
		d=map(p);
  	if(d<.0001)break;
    h+=d;
	}
  o.xyz+=15./i;
}
