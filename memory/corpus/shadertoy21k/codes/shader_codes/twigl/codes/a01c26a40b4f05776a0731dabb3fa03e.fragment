#define T(e)p.xy*=rotate2D(e)
#define F a=atan(p.x,p.y),T(-ceil(a*n/PI2-.5)*PI2/n)

vec3 p;
float a,g,i,d=1.,n=5.;
for(;++i<50.&&d>.001;g+=d=max(abs(p.y-.25),abs(p.z))-.01){
  p=vec3((FC.xy*2.-r)/r.y,g-2.);
  p*=rotate3D(t,p-p+1.);
  
  T(PI/2.*sign(p.z));p.z=abs(p.z)-.404;
  F;
  p.y-=.25;
  p.yz*=rotate2D(-acos(1./sqrt(5.)));
  p.y-=.25;
  T(PI/n);
  F;
}
o+=8./i;
