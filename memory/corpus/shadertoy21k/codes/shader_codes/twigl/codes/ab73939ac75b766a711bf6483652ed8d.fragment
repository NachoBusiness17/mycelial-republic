#define PI 3.1415926535
vec2 p=(FC.xy*2.-r)/min(r.x,r.y);
for(float i=0.;i<12.;++i)
{
  float j = i + t;
  vec2 q = p + cos(vec2(j + PI / 2., j)) * 0.5;
  vec2 s = sin(j * vec2(9,5)) * 0.3 + 1.0;
  vec2 r = q + sin(j * vec2(2,3)) * .1;
  if (floor(i) < 5. && length(r) < sin(j * 2.0) * 0.03 + 0.1)
  {
    if (length(r + sin(j * vec2(5,9))* 0.05 ) < 0.05)
    {
      o = vec4(0, .6, 1, 1);
      return;
    }
    o=vec4(1,1,1,1);
    return;
  }
  if (length(q * s) < 0.2)
  {
    o=vec4(1,0,0,1);
    return;
  }
}
o=vec4(1,1,1,1);
