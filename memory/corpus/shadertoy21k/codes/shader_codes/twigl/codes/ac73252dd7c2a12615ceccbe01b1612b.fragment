#define P(p,n,a)p=length(p)*sin(vec2(0,1.57)+mod(atan(p.y,p.x),6.28/n)-3.14/n);p.y-a
#define M(a,n)a=mod(a,n)-n*.5
#define R30(a)a=vec2(a.x*.5+a.y,a.y*.5-a.x)
#define R60(a)a=vec2(a.x+a.y*.5,a.y-a.x*.5)
#define R45(a)a=vec2(a.x+a.y,a.y-a.x)
#define G30(a,n)a=abs(a)-n;R30(a)
#define G45(a,n)a=abs(a)-n;R45(a)
#define G60(a,n)a=abs(a)-n;R60(a)
#define A(a,n)a=abs(a)-n
void main(){
  float T=t*.1;
  for(float n,g=.3,e,i;i++<45.;){
    vec3 p=g*normalize(vec3((gl_FragCoord.xy*2.-r)/r.y,1));
    p.xy*=mat2(cos(T+vec4(0,64,5,0)));
    p.z+=T*.2;
    n=ceil(p.z);
    p=fract(p)-.5;
    for(float i; i++<2.+mod(n,3.);){
      G60(p.xy,.05);
      A(p.zx,.08+mod(fract(T*.2),0.15));
      P(p.xy,4.,0.25);
      G30(p.yz,.16+sin(t+sin(T*.5)*3.)*.01);
      P(p.yz,28.,.8+n);
      A(p.zy,.05+mod(fract(T*.2),0.15));
      G30(p.xy,.03+sin(T*.3)*.001);
      A(p.xy,.15+mod(fract(T*.02),0.1));
      G45(p.xz,.05+sin(t)*.01);
      G30(p.zy,.3);
    }
    g+=e=0.2*dot(p,normalize(vec3(2,1,1)))-.001;
    e<.001?o+=abs(sin(p.zyxz*12.*n+T+3.*length(p)*5.*sin(T)))*abs(cos(p.z*90.))*.8/i:o;
  }
}
