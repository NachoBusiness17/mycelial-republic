precision highp float;
uniform vec2 resolution;
uniform float time;
out vec4 fragColor;

#define rot(a) mat2(cos(a),sin(a),-sin(a),cos(a))

void sFold90(inout vec2 p)
{
  vec2 v=normalize(vec2(1,-1)); ;
  float g=dot(p,v);
  p-=(g-sqrt(g*g+1e-2))*v;
}

float map(vec3 p){
  p.xy*=rot(time*.5);
  p.xz*=rot(time*.8);
  float s=1.;
  for(int i=0;i<5;i++){
    p=abs(p)-.3;
    sFold90(p.xz);
    sFold90(p.yz);
    sFold90(p.xy);
    p-=vec3(.2,.4,.3);
    p.xy*=rot(.2);
    p.yz*=rot(.1);
    p=2.*clamp(p,-.04,.04)-p;
    p*=2.;
    s*=2.;
  }
  p/=s;
  float h=.4;
  p.x-=clamp(p.x,-h,h);
  // torus SDF
  return length(vec2(length(p.xy)-.3,p.z))-.01;
}

void main(){
    vec2 uv=(gl_FragCoord.xy-.5*resolution)/resolution.y;
    vec3 rd=normalize(vec3(uv,1));
    vec3 p=vec3(0,0,-5);
    float d=1.,i;
    for(;++i<99.&&d>.001;)p+=rd*(d=map(p));
    if(d<.001)fragColor.xyz+=mix(vec3(1),(cos(vec3(1,9,3)+p*3.+time)*.5+.5),.5)*10./i;
}
