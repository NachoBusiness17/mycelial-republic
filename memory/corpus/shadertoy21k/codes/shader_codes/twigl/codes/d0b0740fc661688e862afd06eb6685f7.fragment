precision highp float;
uniform vec2 resolution;
uniform float time;
out vec4 fragColor;

#define rot(a) mat2(cos(a),sin(a),-sin(a),cos(a))
#define PI (atan(1.)*4.)

float map(vec3 p){
    p=p.xzy;
    p.xy*=rot(time*.5);
    p.yz*=rot(time*.3);
    p.zx=vec2(atan(p.z,p.x)/PI*3., length(p.zx)-1.);
    p.xy=vec2(atan(p.x,p.y)/PI*2., length(p.xy)-.5);
    float c=.2;
    p.x+=p.z;
    p.x=mod(p.x,c*2.)-c;
    return length(p.xy)-.1;
}

void main(){
    vec2 uv=(gl_FragCoord.xy-.5*resolution)/resolution.y;
    vec3 rd=normalize(vec3(uv,1));
    vec3 p=vec3(0,0,-3);
    float d=1.,i;
    for(;++i<99.&&d>.001;)p+=rd*(d=map(p));
    if(d<.001)fragColor+=3./i;
}
