vec3 rot3D(vec3 p,vec3 a,float t) 
{
	a=normalize(a);
	vec3 v=cross(a,p),u=cross(v,a);
	return u*cos(t)+v*sin(t)+a*dot(p, a);   
}
vec3 knot(float a)
{
    a*=8.0*atan(1.);
	return vec3(
		sin(a)+2.0*sin(2.0*a),
		cos(a)-2.0*cos(2.0*a),
		-sin(3.0*a)
	);
}

float castLine(vec3 ro, vec3 rd, vec3 a, vec3 b)
{
    vec3 ab=normalize(b-a),ao=a-ro;
    float d0=dot(rd,ab),d1=dot(rd,ao),d2=dot(ab,ao);
    float len=(d0*d1-d2)/(1.0-d0*d0);
    len=clamp(len,0.0,length(b-a));
    vec3 p=a+ab*len;
    return length(cross(p-ro,rd));
}

#define line(a,b) \
    de= castLine(ro,rd,a,b);\
    col=mix(vec3(0),col,smoothstep(0.,0.5,de));

void main()
{
  vec2 p = (gl_FragCoord.xy*2.0-r.xy)/r.y;
	vec3 ro=vec3(0,0,8);
	vec3 rd=normalize(vec3(p,2));
  float de;
  vec3 col = vec3(1);
  float ITR=200.;
  for(float i=0.;i<ITR;i++)
  {
    vec3 a=rot3D(knot(i/ITR),vec3(1,2,3),t);
    vec3 b=rot3D(knot((i+1.)/ITR),vec3(1,2,3),t);
    line(a,b)
  }
  o.xyz=min(vec3(1),col);
}
