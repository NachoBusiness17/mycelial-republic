float i,g,e,s,l;for(vec3 p;++i<99.;(e<.001)?o.xyz+=hsv(g*.5,.5,.5)/i:p){
  p=vec3(g*(FC.xy-.5*r)/r.y,g-.4)*rotate3D(.8,r.xyy);
  p=mod(p-1.,2.)-1.,
  p.x<-p.z?p.xz=-p.zx:r;
  s=3.;
  for(int j;j++<6;)
    s*=l=2./min(dot(p,p),1.),
    
    //p=abs(p)*l-vec3(1,1,17);
    p=abs(p)*l-vec3(1,1,mix(1.,20.,fract(t*.2)));
    
    g+=e=length(cross(p,p/p))/s;
}
