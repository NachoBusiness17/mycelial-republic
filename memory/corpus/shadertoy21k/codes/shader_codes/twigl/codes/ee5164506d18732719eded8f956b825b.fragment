precision highp float;
uniform vec2 resolution;
uniform float time;
void main(){vec2 p=(gl_FragCoord.xy-resolution*.5)*.003;float c=.7,t=pow(time,.2);for(int i=0;i<7;++i){p.x=sin(p.y)+sin(p.x)*t+c;c=sin(.1*(p.y+p.x));p.y=p.x+sin(sin(p.y)*t)-c;}gl_FragColor=vec4(p.x*.15+.5,c *0.15+0.5,p.y*0.15+.5,1);}
