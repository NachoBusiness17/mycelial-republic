#define PI acos(-1.)
#define rot(a)mat2(cos(a),sin(a),-sin(a),cos(a))
float map(vec3 p)
{
  p.xz*=rot(t*.5);
	p.xy*=rot(t*.5);
	float d= 1.0;
	float s=.06;
	float r=.4;
 	for(int i=0;i<3;i++){
	  vec3 q=p;
	  d= min(d,length(vec2(length(q.xy)-1.,q.z))-s);
	  q.x=abs(q.x)-1.0;
	  d=max(d,-(length(q)-r));
	  d=min(d,length(vec2(length(q.xy)-r,q.z))-s);
	  p.xy*=rot(PI*.5);
	  p.yz*=rot(PI*.5);
 	}
	return d;
}

void main(){
  vec2 uv=(2.*gl_FragCoord.xy-r)/r.y;
  vec3 ro=vec3(0,0,-3);
  vec3 rd=normalize(vec3(uv,2));
  vec3 p;
  float h=0.,d,i;
	for(i=1.;i<50.;i++){
    p=ro+rd*h;    
		d=map(p);
  	if(d<.0001)break;
    h+=d;
	}
  o.xyz+=10./i;
}
