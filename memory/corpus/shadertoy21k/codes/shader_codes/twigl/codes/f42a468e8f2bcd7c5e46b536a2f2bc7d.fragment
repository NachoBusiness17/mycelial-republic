#define R(r)mat2(cos(r),sin(r),-sin(r),cos(r))
void main(){o.xy=(gl_FragCoord.xy*2.-r)/r.y;float a=atan(o.x,o.y)+.4,i=.0,j=mod(floor(5.+t*.4),.9);o.xy*=5.*R(-floor(a/.8)*.8);for(;i<32.;++i)o.xy=(abs(o.xy-vec2(0.,sin(2.+t*.2)))-j)*R(i+j);o=vec4(abs(.2/sin(length(o*32.)*cos(vec4(.44,.33,.22,1))*.2)));}
