#define rot(a)mat2(cos(a),sin(a),-sin(a),cos(a))
float map(vec3 p)
{
	p.xz*=rot(t*.5);
	p.xy*=rot(t*.5);
	p=abs(p)-1.;
	if(p.x<p.z)p.xz=p.zx;
	if(p.y<p.z)p.yz=p.zy;
 	if(p.x<p.y)p.xy=p.yx;
 	p.xy-=1.;
	return length(vec2(length(p.xz)-1.,p.y))-.1;
}

void main(){
  vec2 uv=(2.*gl_FragCoord.xy-r)/r.y;
  vec3 ro=vec3(0,0,-8);
  vec3 rd=normalize(vec3(uv,2));
  vec3 p;
  float h=0.,d,i;
	for(i=1.;i<50.;i++){
    p=ro+rd*h;    
		d=map(p);
  	if(d<.0001)break;
    h+=d;
	}
  o.xyz+=10./i;
}
