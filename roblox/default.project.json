{
  "name": "the_mountain",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Modules": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "$path": "src/server"
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/client"
      }
    },
    "Workspace": {
      "$properties": { "FilteringEnabled": true }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [0.08, 0.07, 0.1],
        "OutdoorAmbient": [0.25, 0.22, 0.3],
        "ClockTime": 18.5
      }
    }
  }
}
