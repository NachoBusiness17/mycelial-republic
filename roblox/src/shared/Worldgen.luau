Worldgen.SPHERES = SPHERES

local AGES: { string } = { "the Age of Myth", "the Age of Heroes", "the Age of Legends" }
local KILLS_PER_AGE = 10

Worldgen.INITIAL_POWERS = 30
local supernaturalPowers = 1 -- default 1: supernatural forces persist until banished

local bossKills = 0
local killLog: { string } = {}

-- megabeast deaths move the world's age; ages recur with ordinals (DF law)
function Worldgen.noteBossKill(name: string)
	bossKills += 1
	table.insert(killLog, name)
end

function Worldgen.setSupernaturalPowers(count: number)
	supernaturalPowers = math.max(0, count)
end

function Worldgen.supernaturalPowers(): number
	return supernaturalPowers
end

function Worldgen.remainingPowers(): number
	return math.max(0, Worldgen.INITIAL_POWERS - bossKills)
end

function Worldgen.resetBossKills()
	bossKills = 0
	table.clear(killLog)
end

local ORDINALS: { string } = { "", "Second", "Third", "Fourth", "Fifth", "Sixth", "Seventh" }

function Worldgen.ageText(): string
	local remaining = Worldgen.remainingPowers()

	-- DF law: the <= 3-great-powers branch takes precedence once megabeasts dwindle
	if remaining <= 3 then
		if remaining == 3 then
			return "The Age of Three Powers"
		elseif remaining == 2 then
			return "The Age of Two Powers"
		elseif remaining == 1 then
			return "The Age of Powers"
		else -- remaining == 0
			if supernaturalPowers > 0 then
				return "The Age of Ghost and Shadows"
			else
				return "The Age of Civilization"
			end
		end
	end

	local stage = math.floor(bossKills / KILLS_PER_AGE) -- 0-based into AGES
	local cycle = math.floor(stage / #AGES)
	local age = AGES[(stage % #AGES) + 1]
	if cycle == 0 then
		return age:sub(1, 1):upper() .. age:sub(2)
	end
	local ordinal = ORDINALS[math.min(cycle + 1, #ORDINALS)]
	-- "the Age of Myth" -> "the Second Age of Myth"
	return age:gsub("^the ", ("the %s "):format(ordinal))
end

function Worldgen.killCount(): number
	return bossKills
end

-- forgotten beast namer: dwarven compound (mined lexicon) + sourced sphere.
-- The beast now carries its kinship rows from the generated graph, so the
-- announcement can file which principles side with it and which oppose it.
export type Beast = {
	name: string,
	sphere: string,
	allies: { string },
	opposed: { string },
}

local function inList(list: { string }, v: string): boolean
	for _, x in ipairs(list) do
		if x == v then
			return true
		end
	end
	return false
end

local function names(list: { string }, cap: number): string
	if #list == 0 then
		return "none" -- negative is a fact: unaligned spheres hold no kin/foes
	end
	local picked: { string } = {}
	for i = 1, math.min(cap, #list) do
		table.insert(picked, list[i])
	end
	return table.concat(picked, " and ")
end

-- sphere kinship = which zones ally (WORLDGEN_MINE.md law 4): opposition
-- (good vs evil) outranks co-occurrence kin; everything else is independent
function Worldgen.zoneAlliance(a: string, b: string): string
	if inList(SphereKinship.OPPOSED[a] or {}, b) then
		return "opposed"
	end
	if inList(SphereKinship.ALLIES[a] or {}, b) then
		return "allied"
	end
	return "independent"
end

function Worldgen.sphereAlignment(sphere: string): string
	return SphereKinship.ALIGNMENT[sphere] or "unaligned"
end

function Worldgen.forgottenBeast(rng: any): Beast
	local dw, en = ArtifactLore.dwarvenCompound(rng)
	local sphere = SPHERES[rng:int(1, #SPHERES)]
	local titled = en:sub(1, 1):upper() .. en:sub(2)
	return {
		name = ('%s, "the %s of %s"'):format(dw, titled, sphere),
		sphere = sphere,
		allies = SphereKinship.ALLIES[sphere] or {},
		opposed = SphereKinship.OPPOSED[sphere] or {},
	}
end

function Worldgen.forgottenName(rng: any): string
	return Worldgen.forgottenBeast(rng).name
end

-- the alliance sentence for the first-seen announcement: sourced rows only
function Worldgen.kinshipLine(beast: Beast): string
	return ("Kin: %s. Foes: %s."):format(names(beast.allies, 2), names(beast.opposed, 2))
end

return Worldgen
