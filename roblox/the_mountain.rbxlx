	{ gloss = "brash", dw = "midrim", pos = "adjective" },
	{ gloss = "carmine", dw = "thastith", pos = "adjective" },
	{ gloss = "dark", dw = "umom", pos = "adjective" },
	{ gloss = "deep", dw = "thol", pos = "adjective" },
	{ gloss = "delight", dw = "amith", pos = "adjective" },
	{ gloss = "dream", dw = "nåzom", pos = "adjective" },
	{ gloss = "flighty", dw = "rersîr", pos = "adjective" },
	{ gloss = "gold", dw = "limul", pos = "adjective" },
	{ gloss = "goldenrod", dw = "thistun", pos = "adjective" },
	{ gloss = "light", dw = "istam", pos = "adjective" },
	{ gloss = "mountain", dw = "onol", pos = "adjective" },
	{ gloss = "name", dw = "kab", pos = "adjective" },
	{ gloss = "roomy", dw = "omthel", pos = "adjective" },
	{ gloss = "salt", dw = "nabid", pos = "adjective" },
	{ gloss = "secret", dw = "nekut", pos = "adjective" },
	{ gloss = "spite", dw = "zakgol", pos = "adjective" },
	{ gloss = "squash", dw = "stukón", pos = "adjective" },
	{ gloss = "stale", dw = "vuzded", pos = "adjective" },
	{ gloss = "tunnel", dw = "ód", pos = "adjective" },
	{ gloss = "unnameable", dw = "nan", pos = "adjective" },
	{ gloss = "wall", dw = "adil", pos = "adjective" },
	{ gloss = "wash", dw = "stelid", pos = "adjective" },
	{ gloss = "word", dw = "il", pos = "adjective" },
	{ gloss = "abate", dw = "med", pos = "adjective" },
	{ gloss = "absolute", dw = "ilas", pos = "adjective" },
	{ gloss = "abysmal", dw = "sosas", pos = "adjective" },
	{ gloss = "abyss", dw = "ngalák", pos = "adjective" },
	{ gloss = "accident", dw = "kuthdêng", pos = "adjective" },
	{ gloss = "ace", dw = "alak", pos = "adjective" },
	{ gloss = "ache", dw = "agseth", pos = "adjective" },
	{ gloss = "acrid", dw = "tatek", pos = "adjective" },
	{ gloss = "admire", dw = "nebél", pos = "adjective" },
	{ gloss = "adore", dw = "salir", pos = "adjective" },
	{ gloss = "adventure", dw = "cenäth", pos = "adjective" },
	{ gloss = "afflict", dw = "thokit", pos = "adjective" },
	{ gloss = "ageless", dw = "gatal", pos = "adjective" },
	{ gloss = "alchemy", dw = "anzish", pos = "adjective" },
	{ gloss = "ally", dw = "astel", pos = "adjective" },
	{ gloss = "amaze", dw = "edos", pos = "adjective" },
	{ gloss = "amber", dw = "thukkan", pos = "adjective" },
	{ gloss = "ambiguous", dw = "umgan", pos = "adjective" },
	{ gloss = "amethyst", dw = "alron", pos = "adjective" },
	{ gloss = "amuse", dw = "ïdath", pos = "adjective" },
	{ gloss = "ancient", dw = "zustash", pos = "adjective" },
	{ gloss = "angel", dw = "sedil", pos = "adjective" },
}
-- END GENERATED (tools/gen_artifact_lore.py)
ArtifactLore.DWARVEN = DWARVEN

local MOODS: { string } = { "fey", "secretive", "possessed" }
local IMPULSES: { string } = { "desire", "fear", "memory", "hope" }
ArtifactLore.MOODS = MOODS
ArtifactLore.IMPULSES = IMPULSES

-- POS-legal compound (DF law): ADJ+NOUN or NOUN+NOUN
function ArtifactLore.dwarvenCompound(rng: any): (string, string)
	local adjPool = {}
	local nounPool = {}
	for _, w in ipairs(DWARVEN) do
		if w.pos == "adjective" then table.insert(adjPool, w) else table.insert(nounPool, w) end
	end
	local useAdj = rng:next() < 0.5
	local first = useAdj and adjPool[rng:int(1, #adjPool)] or nounPool[rng:int(1, #nounPool)]
	local second = nounPool[rng:int(1, #nounPool)]
	return (first.dw .. " " .. second.dw), (first.gloss .. " " .. second.gloss)
end

-- display name: ☼ dwarven ☼ "The English Compound"
function ArtifactLore.name(rng: any): string
	local dw, en = ArtifactLore.dwarvenCompound(rng)
	local titled = en:sub(1, 1):upper() .. en:sub(2)
	return ('☼ %s ☼ "%s"'):format(dw, titled)
end

-- strange-mood history line, DF structure: mood type + impulse + creator
function ArtifactLore.moodLine(rng: any, creator: string, displayName: string): string
	local mood = MOODS[rng:int(1, #MOODS)]
	local impulse = IMPULSES[rng:int(1, #IMPULSES)]
	return ("Taken by a %s mood, this is %s's %s — the ultimate expression of a %s."):format(mood, creator, displayName, impulse)
end

return ArtifactLore
]]></string>
