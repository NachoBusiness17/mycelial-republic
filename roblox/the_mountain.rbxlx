      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">SectionStream</string>
          <string name="Source"><![CDATA[--!strict
-- SectionStream — the GnomeCode ep.1 streamed-sections pattern (Doors: the
-- world materializes ahead of the walker instead of all at boot; ADOPT move 1
-- of docs/ARCHITECTURE_NEXT.md). A stream holds sections, each a one-shot
-- build closure plus a center; poll(positions) builds every unbuilt section
-- whose center sits within `radius` of any position, at most `budget` builds
-- per poll so a neighborhood manifests across frames instead of spiking one.
--
-- ordered = true builds STRICTLY in insertion order: a section never builds
-- before its predecessors even when its own radius trips first. Maze builds
-- whose closures draw from one shared SeedRng stream must use this mode —
-- insertion order then equals rng draw order, so a streamed world is
-- byte-identical to the eager one, only later in time (the Ossuary floors
-- ride one SeedRng(20261031); the per-floor draw counts are unchanged, so
-- every corridor, sentinel, lever and brazier lands where it always did).
--
-- Consumed by OssuaryZone (stacked floors, ordered) and RiddleMazeZone (wall
-- chunks, proximity). Judged too small to stream: SpectralMazeZone (7 doors,
-- 1 hall part) and MazeArenaZone (10 fixed walls) build in microseconds.

export type Section = {
	center: Vector3,
	build: () -> (),
	done: boolean,
}

export type SectionStream = {
	add: (self: SectionStream, center: Vector3, build: () -> ()) -> (),
	poll: (self: SectionStream, positions: { Vector3 }) -> number,
	pending: (self: SectionStream) -> number,
}

export type StreamConfig = {
	radius: number,
	budget: number?,
	ordered: boolean?,
}

local SectionStream = {}
SectionStream.__index = SectionStream

-- ordered-mode gate: a section may build only once every earlier-registered
-- section has built (insertion order = rng draw order for seeded builds)
local function predecessorsDone(sections: { Section }, sec: Section): boolean
	for _, other in ipairs(sections) do
		if other == sec then
			return true -- walked insertion order up to sec: everything before is done
		end
		if not other.done then
			return false
		end
	end
	return true
end

function SectionStream.new(cfg: StreamConfig): SectionStream
	local self = setmetatable({
		_radius = cfg.radius,
		_budget = cfg.budget or math.huge,
		_ordered = cfg.ordered == true,
		_sections = {} :: { Section },
	}, SectionStream)
	return (self :: any) :: SectionStream
end

function SectionStream:add(center: Vector3, build: () -> ())
	table.insert(self._sections :: { Section }, { center = center, build = build, done = false })
end

function SectionStream:poll(positions: { Vector3 }): number
	local sections = self._sections :: { Section }
	local budget = self._budget :: number
	local radius = self._radius :: number
	local built = 0
	for _, sec in ipairs(sections) do
		if built >= budget then
			break
		end
		if not sec.done and (not self._ordered or predecessorsDone(sections, sec)) then
			for _, pos in ipairs(positions) do
				if (pos - sec.center).Magnitude <= radius then
					sec.done = true
					sec.build()
					built += 1
					break
				end
			end
		end
	end
	return built
end

function SectionStream:pending(): number
	local n = 0
	for _, sec in ipairs(self._sections :: { Section }) do
		if not sec.done then
			n += 1
		end
	end
	return n
end

return SectionStream
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">SeedRng</string>
          <string name="Source"><![CDATA[--!strict
-- SeedRng — xorshift32, replay-safe: same seed, same mountain, bit-exact rerun.
-- (mulberry32 needs 32-bit multiply wraparound, which Luau doubles lose above
-- 2^53; xorshift32 uses only xor/shift so it is exact. The fleet's Python
-- mulberry32 seeds map 1:1 — same seed integer, deterministic both sides.)

local SeedRng = {}

export type Rng = {
	next: (self: Rng) -> number,
	int: (self: Rng, lo: number, hi: number) -> number,
	pick: (self: Rng, list: { string }) -> string,
	seed: number,
}

function SeedRng.new(seed: number): Rng
	local self = setmetatable({ seed = seed % 2147483647 }, { __index = SeedRng })
	if self.seed == 0 then self.seed = 1 end -- xorshift32 must not start at zero
	return (self :: any)
end

function SeedRng:next(): number
	local s = self.seed
	s = bit32.bxor(s, bit32.lshift(s, 13))
	s = bit32.bxor(s, bit32.rshift(s, 17))
	s = bit32.bxor(s, bit32.lshift(s, 5))
	self.seed = s
	return s / 4294967296
end

function SeedRng:int(lo: number, hi: number): number
	local n: number = self:next()
	return lo + math.floor(n * (hi - lo + 1))
end

function SeedRng:pick(list: { string }): string
	return list[self:int(1, #list)]
end

return SeedRng
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Soul</string>
          <string name="Source"><![CDATA[--!strict
-- Soul — DF's unit_soul fold: the psyche as a record separate from the body.
-- Mined from DFHack (corpus/df_mine/dfhack_innerlife.json + dfhack_datamodel.json):
--   emotions are timestamped LEDGER ROWS naming their causal thought (never
--   editable scalars); stress aggregates into one signed scalar binned by the
--   exact cutoff ladder into 7 categories Miserable..Ecstatic; needs carry
--   focus_level with the -10000 unbailable pin; traits/values are static
--   multiplier lenses applied at read time, not stored mutations.
-- Two-stage law: events log first, scalars derive, thresholds gate.

local Soul = {}

export type EmotionRow = {
	thought: string,     -- the causal thought, named (DF law: rows name their cause)
	emotion: string,     -- emotion type
	strength: number,    -- 100 x factor, signed
	year: number,        -- timestamp (revocable: synthetic rows flagged, not deleted)
	synthetic: boolean,
}

export type Need = { id: string, focus: number } -- focus -999..+400; <=-10000 = unbailable pin

export type Soul = {
	emotions: { EmotionRow },
	needs: { Need },
	traits: { [string]: number },  -- static lens: multipliers at read time
	values: { [string]: number },  -- -50..+50 (the temptation weights)
	dreams: { { dream: string, accomplished: boolean } },
}

-- DF stress cutoff ladder -> 7 categories (from dfhack_innerlife mine)
local CUTOFFS: { number } = { 50000, 25000, 10000, -10000, -25000, -50000, -100000 }
local CATEGORIES: { string } = { "ecstatic", "quite cheerful", "fine", "haggard", "miserable", "wretched", "broken" }

function Soul.new(): Soul
	return { emotions = {}, needs = {}, traits = {}, values = {}, dreams = {} }
end

-- stage one: events log, naming their cause
function Soul.record(s: Soul, thought: string, emotion: string, strength: number, year: number)
	table.insert(s.emotions, { thought = thought, emotion = emotion, strength = strength, year = year, synthetic = false })
end

-- aggregate: signed scalar derived from the ledger (never stored as truth)
function Soul.stress(s: Soul): number
	local total = 0
	for _, e in ipairs(s.emotions) do
		total += e.strength
	end
	return total
end

function Soul.mood(s: Soul): string
	local stress = Soul.stress(s)
	for i, cut in ipairs(CUTOFFS) do
		if stress >= cut then
			return CATEGORIES[i]
		end
	end
	return CATEGORIES[#CATEGORIES] -- broken
end

-- needs: focus decays toward the pin; <=-10000 is unbailable (activity locks)
function Soul.addNeed(s: Soul, id: string)
	table.insert(s.needs, { id = id, focus = 0 })
end

function Soul.decayNeeds(s: Soul, rate: number)
	for _, n in ipairs(s.needs) do
		n.focus = math.max(n.focus - rate, -10000) -- the unbailable pin
	end
end

function Soul.meetNeed(s: Soul, id: string, amount: number)
	for _, n in ipairs(s.needs) do
		if n.id == id then
			n.focus = math.min(n.focus + amount, 400) -- DF focus ceiling
		end
	end
end

-- strange-mood gates (DF: stress rolls at 20000/50000/100000 -> mood types)
function Soul.moodRisk(s: Soul): string?
	local stress = Soul.stress(s)
	if stress >= 100000 then return "possessed" end
	if stress >= 50000 then return "secretive" end
	if stress >= 20000 then return "fey" end
	return nil
end

return Soul
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">SphereKinship</string>
          <string name="Source"><![CDATA[--!strict
-- GENERATED by tools/gen_df_luau_data.py from corpus/df_mine/ -- do not hand-edit.
-- Regenerate: .venv/Scripts/python.exe tools/gen_df_luau_data.py

-- Fold: sphere kinship graph -> zone alliances (WORLDGEN_MINE.md law 4).
-- Derived from df_spheres.json sourced fields, never authored:
--   alignment = good_spheres / evil_spheres classes;
--   allies = same-class peers + co-occurrence in one generator region
--     (generator_region_spheres) or on one named creature (by_creature);
--   opposed = every sphere of the opposite class; unaligned spheres carry
--     no enmity (empty lists are facts, not omissions). Opposition wins
--     over co-occurrence when a pair lands in both.

local ALIGNMENT = {
	["BLIGHT"] = "evil",
	["CHAOS"] = "evil",
	["CHARITY"] = "good",
	["CONSOLATION"] = "good",
	["DEATH"] = "evil",
	["DEFORMITY"] = "evil",
	["DEPRAVITY"] = "evil",
	["DISEASE"] = "evil",
	["FORGIVENESS"] = "good",
	["FREEDOM"] = "good",
	["GENEROSITY"] = "good",
	["HAPPINESS"] = "good",
	["HEALING"] = "good",
	["HOSPITALITY"] = "good",
	["JEALOUSY"] = "evil",
	["LIES"] = "evil",
