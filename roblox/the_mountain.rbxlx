	["GOLD"] = 30,
	["INDIGO_TOURMALINE"] = 25,
	["IRON"] = 10,
	["LEAD"] = 2,
	["NICKEL"] = 2,
	["NICKEL_SILVER"] = 3,
	["PARCHMENT"] = 10,
	["PEWTER_FINE"] = 5,
	["PEWTER_LAY"] = 3,
	["PEWTER_TRIFLE"] = 4,
	["PIG_IRON"] = 10,
	["PLATINUM"] = 40,
	["ROSE_GOLD"] = 23,
	["SILVER"] = 10,
	["STEEL"] = 30,
	["STERLING_SILVER"] = 8,
	["TIN"] = 2,
	["TSAVORITE"] = 30,
	["ZINC"] = 2,
}

-- tradegoods: base x mv = unit (the mined table cross-checks the formula)
local GOODS = {
	{ good = "adamantine wafer", class = "BAR", base = 5, mv = 300, unit = 1500 },
	{ good = "platinum bar", class = "BAR", base = 5, mv = 40, unit = 200 },
	{ good = "gold bar", class = "BAR", base = 5, mv = 30, unit = 150 },
	{ good = "steel bar", class = "BAR", base = 5, mv = 30, unit = 150 },
	{ good = "iron bar", class = "BAR", base = 5, mv = 10, unit = 50 },
	{ good = "copper bar", class = "BAR", base = 5, mv = 2, unit = 10 },
	{ good = "cut clear diamond", class = "GEM", base = 20, mv = 60, unit = 1200 },
	{ good = "cut tsavorite/demantoid/blue garnet", class = "GEM", base = 20, mv = 30, unit = 600 },
	{ good = "cut topaz/tanzanite (tier-20 gem)", class = "GEM", base = 20, mv = 20, unit = 400 },
	{ good = "cut common gem", class = "GEM", base = 20, mv = 2, unit = 40 },
	{ good = "raw clear diamond", class = "ROUGH", base = 6, mv = 60, unit = 360 },
	{ good = "gold crown", class = "CROWN (engine)", base = 10, mv = 30, unit = 300 },
	{ good = "gold scepter", class = "SCEPTER (engine)", base = 10, mv = 30, unit = 300 },
	{ good = "silver amulet/ring/bracelet/earring", class = "craft (engine)", base = 10, mv = 10, unit = 100 },
	{ good = "bone figurine", class = "FIGURINE (engine)", base = 10, mv = 1, unit = 10 },
	{ good = "steel short sword", class = "WEAPON", base = 10, mv = 30, unit = 300 },
	{ good = "adamantine battle axe", class = "WEAPON", base = 10, mv = 300, unit = 3000 },
	{ good = "iron pick", class = "WEAPON", base = 10, mv = 10, unit = 100 },
	{ good = "steel breastplate", class = "ARMOR", base = 10, mv = 30, unit = 300 },
	{ good = "steel helm", class = "HELM", base = 10, mv = 30, unit = 300 },
	{ good = "steel shield", class = "SHIELD", base = 10, mv = 30, unit = 300 },
	{ good = "gold goblet/mug", class = "GOBLET (engine)", base = 10, mv = 30, unit = 300 },
	{ good = "gold statue", class = "STATUE (engine)", base = 25, mv = 30, unit = 750 },
	{ good = "steel mechanism", class = "MECHANISM (engine)", base = 30, mv = 30, unit = 900 },
	{ good = "steel minecart", class = "TOOL", base = 50, mv = 30, unit = 1500 },
	{ good = "wooden minecart", class = "TOOL", base = 50, mv = 1, unit = 50 },
	{ good = "steel cauldron", class = "TOOL", base = 50, mv = 30, unit = 1500 },
	{ good = "parchment sheet", class = "SHEET", base = 50, mv = 10, unit = 500 },
	{ good = "parchment quire/scroll", class = "BOOK-family (engine)", base = 200, mv = 10, unit = 2000 },
	{ good = "paper quire (raws TOOL)", class = "TOOL", base = 20, mv = 1, unit = 20 },
	{ good = "engraved slab", class = "SLAB (engine)", base = 10, mv = 1, unit = 10 },
	{ good = "barrel/bin/bucket", class = "FURNITURE-family (engine)", base = 10, mv = 1, unit = 10 },
	{ good = "anvil", class = "ANVIL (engine)", base = 10, mv = 30, unit = 300 },
}

-- engine-side quality ladder (wiki Item value, fetched 2026-09-25)
local QUALITY = {
	{ name = "well-crafted", mult = 1.1, bonus = 3 },
	{ name = "finely crafted", mult = 1.2, bonus = 6 },
	{ name = "superior", mult = 1.33, bonus = 10 },
	{ name = "exceptional", mult = 1.5, bonus = 15 },
	{ name = "masterful", mult = 2, bonus = 30 },
}


local DfGoods = {}
DfGoods.MATERIALS = MATERIALS
DfGoods.GOODS = GOODS
DfGoods.QUALITY = QUALITY

return DfGoods
]]></string>
