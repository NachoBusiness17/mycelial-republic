      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">DfValue</string>
          <string name="Source"><![CDATA[--!strict
-- DfValue - the DF item-value law, folded into the LedgerExchange.
-- Mined law (WORLDGEN_MINE.md #8; corpus/df_mine/df_economy.json):
--   value = BASE x MATERIAL_VALUE x QUALITY_MULT + QUALITY_BONUS
--   artifact = plain value x20 + 300 (engine-side, wiki Item value)
-- The goods/material tables are GENERATED (shared/DfGoods.luau, tools/
-- gen_df_luau_data.py); this module owns only the formula and the two
-- exchange bridges. Cloned Steal-a numbers (CLONED_MECHANICS.md 3.1) are
-- frozen: the appraisal never touches buy costs or bought-slot incomes.
-- Cross-check law: DfGoods rows carry unit = base x mv, so value(base, mv, 0)
-- must reproduce the mined unit_value for every row (plain quality = x1 +0).

local DfGoods = require(script.Parent:WaitForChild("DfGoods"))

local DfValue = {}

DfValue.ARTIFACT_MULT = 20
DfValue.ARTIFACT_BONUS = 300

-- quality index 0 = plain (no multiplier, no bonus); 1..#QUALITY = ladder
function DfValue.value(base: number, materialValue: number, qualityIndex: number): number
	local plain = base * materialValue
	local q = DfGoods.QUALITY[qualityIndex]
	if not q then
		return plain
	end
	return math.floor(plain * q.mult) + q.bonus
end

function DfValue.artifactValue(base: number, materialValue: number): number
	return base * materialValue * DfValue.ARTIFACT_MULT + DfValue.ARTIFACT_BONUS
end

export type Appraisal = {
	good: string,
	goodClass: string,
	base: number,
	materialValue: number,
	quality: number, -- 0 = plain, else index into QUALITY
	qualityName: string,
	isArtifact: boolean,
	value: number,
	text: string,
}

-- roll one appraisal: a mined tradegood, a plain quality off the ladder, and
-- the artifact flip (rare: the exchange's own tuning, NOT a mined rate)
function DfValue.appraise(rng: any, artifactChance: number?): Appraisal
	local good = DfGoods.GOODS[rng:int(1, #DfGoods.GOODS)]
	local isArtifact = rng:next() < (artifactChance or 0.05)
	local quality = 0
	local value: number
	if isArtifact then
		value = DfValue.artifactValue(good.base, good.mv)
	else
		quality = rng:int(0, #DfGoods.QUALITY)
		value = DfValue.value(good.base, good.mv, quality)
	end
	local qualityName = "plain"
	if quality > 0 then
		qualityName = DfGoods.QUALITY[quality].name
	end
	local text: string
	if isArtifact then
		text = ("%s, ARTIFACT: %d dwarven value"):format(good.good, value)
	else
		text = ("%s, %s: %d dwarven value"):format(good.good, qualityName, value)
	end
	return {
		good = good.good,
		goodClass = good.class,
		base = good.base,
		materialValue = good.mv,
		quality = quality,
		qualityName = qualityName,
		isArtifact = isArtifact,
		value = value,
		text = text,
	}
end

-- exchange bridge: dwarven value -> VM income for a run-home stolen artifact.
-- Mapped onto the existing income band (1..80) so the cloned ladder is never
-- exceeded; the floor keeps junk goods worth carrying.
function DfValue.vmIncome(dfValue: number): number
	return math.clamp(math.floor(dfValue / 40), 1, 80)
end

return DfValue
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Flock</string>
          <string name="Source"><![CDATA[--!strict
-- Flock — the living-crop boids engine ported from dashboard/static/games/swarm.html
-- (Q-032). The source's own thesis: "the crop is ALIVE — XP is a spore fish, and it
-- flees ... the header catches the tired ones" (swarm.html:949-950). Three laws,
-- each carried from its exact source lines:
--
--   1. FLEE / TIRE / REST  (swarm.html:951-968) — an airborne fish flees the player
--      inside the flee radius, accelerating away at max(minSpeed, baseSpeed −
--      fatigue·slope), the same speed scalar pushed ×6 on the plane and ×4 on the
--      height axis; it accumulates `flee` fatigue, then when the player is out of
--      range it coasts (fleeT lingers 0.8s with drag but no gravity), then it TIRES:
--      fatigue decays by 0.4^dt and gravity pulls it down. Floor contact flips it
--      to rest. Drag 0.985 per source frame, frame-normalized as 0.985^(60·dt).
--      Arena walls bounce at half restitution (the source's x-walls at 8 / WW−8,
--      generalized to the port's two horizontal axes).
--   2. SCHOOL (swarm.html:970-981, the boids core) — a RESTING fish is steered by
--      direct position nudges only, never velocity: cohesion toward the centroid of
--      neighbors inside the school radius (rate 0.9 on the plane, 0.55 on height),
--      separation from neighbors inside the separation radius (rate 0.6 / 0.35),
--      plus the identity wiggle sin(t·7 + x·0.05)·amp·dt along world X, then the
--      floor clamp. The source's floor clamp `g.y > floor → g.y = floor` grows on a
--      down-positive canvas axis; here Y is up, so the clamp is `Y < floorY`.
--   3. PHEROMONE TRAIL (steering law swarm.html:842-851, drop law :1113-1121) — the
--      horde steers at the freshest trail point whose score life·(1 − manhattan/
--      radius) beats the floor 1.2, else straight at the player. Walking drops
--      points with life 2.5; the loud action (source: the harvest header; port: the
--      Fire pellet) drops life 5. Cap 140 points, drop interval 0.15s.
--
-- Scale law (the one port mapping, recorded in roblox/docs/CLONED_MECHANICS.md
-- §3.7): the source runs on a 2400-wide canvas with a 200-unit/s skater; this port
-- has a 90-stud arena and a 16 studs/s walk. Speeds scale ×0.08 (the player ratio;
-- gravity and the toss inherit it). Lengths are tuned inside that envelope to stay
-- playable: flee 95→14, catch 15→3.5 (the port's existing touch-collect radius),
-- school 155→20, separation 15→3, trail radius 300→38, wiggle amp 6→1.5. Rates,
-- thresholds, lives, the 1.2 score floor, the drag, and the 0.4^dt fatigue decay
-- carry over verbatim. NOT cloned here: the harvest-header row, the county-line
-- survey, and THE FISH boss duel (45 stays a population cap, not a spawn trigger) —
-- separate mechanics, open moves.
--
-- Pure module: no Instances, no services. A host with only a Vector3 stub (`.new`,
-- `+ - * /`, `Magnitude`, `Unit`) can execute every function, which is what the
-- banked check script does.

local Flock = {}

-- scale factors (see header)
local SPEED_SCALE = 0.08 -- the source skater 200 u/s -> the port walk 16 studs/s

-- flee / tire / rest (swarm.html:951-968; orig values in comments)
local FLEE_RADIUS = 14 -- orig 95
local FLEE_RADIUS_RAIN = 10 -- orig 68 (braver in rain); keeps the 68/95 ratio
local FLEE_SPEED = 26 -- orig 320 x SPEED_SCALE
local FLEE_SPEED_MIN = 11 -- orig 140 x SPEED_SCALE
local FLEE_FATIGUE_SLOPE = 160 * SPEED_SCALE -- orig 160
local FLEE_PLANE_PUSH = 6 -- verbatim: horizontal share of the speed scalar
local FLEE_HEIGHT_PUSH = 4 -- verbatim: vertical share
local FLEE_COAST = 0.8 -- verbatim: fleeT linger before the tire branch
local FATIGUE_DECAY = 0.4 -- verbatim: fatigue *= 0.4^dt while tiring
local GRAVITY = 140 * SPEED_SCALE -- orig 140 (tire branch only)
local DRAG = 0.985 -- verbatim, per 1/60s source frame
local WALL_BOUNCE = 0.5 -- verbatim

-- school (swarm.html:970-981)
local SCHOOL_RADIUS = 20 -- orig 155 (24025 = 155^2)
local COHESION_PLANE = 0.9 -- verbatim
local COHESION_HEIGHT = 0.55 -- verbatim
local SEPARATION_RADIUS = 3 -- orig 15 (225 = 15^2)
local SEPARATION_PLANE = 0.6 -- verbatim
local SEPARATION_HEIGHT = 0.35 -- verbatim
local WIGGLE_FREQ = 7 -- verbatim
local WIGGLE_SPACE = 0.05 -- verbatim
local WIGGLE_AMP = 1.5 -- orig 6

-- pheromone trail (swarm.html:842-851 + :1113-1121)
local TRAIL_RADIUS = 38 -- orig 300 (manhattan)
local TRAIL_SCORE_FLOOR = 1.2 -- verbatim
local TRAIL_LIFE_WALK = 2.5 -- verbatim
local TRAIL_LIFE_LOUD = 5 -- verbatim (source: harvest; port: Fire pellet)
local TRAIL_DROP_INTERVAL = 0.15 -- verbatim
local TRAIL_CAP = 140 -- verbatim

-- crop loop (swarm.html:631 toss, :1074 stir warn, :1091 gem ceiling)
local TOSS_SPEED = 46 * SPEED_SCALE -- orig rnd(-46, 46) horizontal
local TOSS_UP_MIN = 10 * SPEED_SCALE -- orig rnd(-90, -10) upward
local TOSS_UP_MAX = 90 * SPEED_SCALE
local STIR_AT = 30 -- verbatim warn threshold
local POP_CAP = 45 -- orig 200 ceiling; here the pre-boss population law
local CATCH_RADIUS = 3.5 -- orig 15 -> the port's existing touch-collect radius

export type Fish = {
	pos: Vector3,
	vel: Vector3,
	rest: boolean,
	flee: number,
	fleeT: number,
}

export type Bounds = {
	minX: number,
	maxX: number,
	minZ: number,
	maxZ: number,
	floorY: number,
}

export type TrailPoint = {
	pos: Vector3,
	life: number,
}

export type Trail = {
	points: { TrailPoint },
	cap: number,
}

function Flock.newFish(pos: Vector3, toss: Vector3?): Fish
	if toss then
		return { pos = pos, vel = toss, rest = false, flee = 0, fleeT = 0 }
	end
	return { pos = pos, vel = Vector3.zero, rest = true, flee = 0, fleeT = 0 }
end

-- the kill-drop toss (swarm.html:631 `vx:rnd(-46,46), vy:rnd(-90,-10)`), scaled;
-- the source tosses on one horizontal axis, the port across the full plane
function Flock.toss(rng: (() -> number)?): Vector3
	-- branch instead of `rng or math.random`: calling a union of function
	-- types is a TypeError under the strict analyzer
	local function draw(): number
		if rng then
			return rng()
		end
		return math.random()
	end
	local ang = draw() * math.pi * 2
	local mag = draw() * TOSS_SPEED
	local up = TOSS_UP_MIN + draw() * (TOSS_UP_MAX - TOSS_UP_MIN)
	return Vector3.new(math.cos(ang) * mag, up, math.sin(ang) * mag)
end

-- flee / tire / rest for one airborne fish (swarm.html:951-968). Mutates `f`.
-- `raining` keeps the source's braver-in-rain radius (the port passes false;
-- the zone has no weather yet — the parameter keeps the law in the module).
function Flock.fleeStep(f: Fish, playerPos: Vector3, dt: number, raining: boolean, bounds: Bounds)
	local delta = f.pos - playerPos
	local d = delta.Magnitude
	local fleeR = if raining then FLEE_RADIUS_RAIN else FLEE_RADIUS
	if d < fleeR and d > 0.01 then
		-- the fish darts (braver in rain)
		f.flee += dt
		f.fleeT = FLEE_COAST
		local sp = math.max(FLEE_SPEED_MIN, FLEE_SPEED - f.flee * FLEE_FATIGUE_SLOPE)
		local away = delta / d
		f.vel += Vector3.new(
			away.X * sp * FLEE_PLANE_PUSH * dt,
			away.Y * sp * FLEE_HEIGHT_PUSH * dt,
			away.Z * sp * FLEE_PLANE_PUSH * dt
		)
	elseif f.fleeT > 0 then
		f.fleeT -= dt
	else
		-- it tires
		f.flee *= FATIGUE_DECAY ^ dt
		f.vel -= Vector3.new(0, GRAVITY * dt, 0)
	end
	-- drag (source 0.985/frame; frame-normalized), integrate
	local drag = DRAG ^ (dt * 60)
	f.vel *= drag
	f.pos += f.vel * dt
	-- arena walls bounce at half restitution (source x-walls generalized to Z)
	if f.pos.X < bounds.minX then
		f.pos = Vector3.new(bounds.minX, f.pos.Y, f.pos.Z)
		f.vel = Vector3.new(math.abs(f.vel.X) * WALL_BOUNCE, f.vel.Y, f.vel.Z)
	elseif f.pos.X > bounds.maxX then
		f.pos = Vector3.new(bounds.maxX, f.pos.Y, f.pos.Z)
		f.vel = Vector3.new(-math.abs(f.vel.X) * WALL_BOUNCE, f.vel.Y, f.vel.Z)
	end
	if f.pos.Z < bounds.minZ then
		f.pos = Vector3.new(f.pos.X, f.pos.Y, bounds.minZ)
		f.vel = Vector3.new(f.vel.X, f.vel.Y, math.abs(f.vel.Z) * WALL_BOUNCE)
	elseif f.pos.Z > bounds.maxZ then
		f.pos = Vector3.new(f.pos.X, f.pos.Y, bounds.maxZ)
		f.vel = Vector3.new(f.vel.X, f.vel.Y, -math.abs(f.vel.Z) * WALL_BOUNCE)
	end
	-- floor contact -> rest (source: vx *= 0.6 damp, vy = 0, rest)
	if f.pos.Y <= bounds.floorY then
		f.pos = Vector3.new(f.pos.X, bounds.floorY, f.pos.Z)
		f.vel = Vector3.new(f.vel.X * 0.6, 0, f.vel.Z * 0.6)
		f.rest = true
	end
end

-- the boids school for one RESTED fish (swarm.html:970-981). Position nudges only;
-- neighbors include airborne fish, exactly like the source's global gems loop.
-- `t` is zone time (source T), `floorY` the rest height (source gyAt(x) − 6).
function Flock.schoolStep(f: Fish, school: { Fish }, t: number, dt: number, floorY: number)
	local cx, cy, cz, cn = 0, 0, 0, 0
	for _, o in school do
		if o == f then
			continue
		end
		local delta = o.pos - f.pos
		local d2 = delta.X * delta.X + delta.Y * delta.Y + delta.Z * delta.Z
		if d2 < SCHOOL_RADIUS * SCHOOL_RADIUS then
			cx += o.pos.X
			cy += o.pos.Y
			cz += o.pos.Z
			cn += 1
			if d2 < SEPARATION_RADIUS * SEPARATION_RADIUS then
				f.pos -= Vector3.new(
					delta.X * SEPARATION_PLANE * dt,
					delta.Y * SEPARATION_HEIGHT * dt,
					delta.Z * SEPARATION_PLANE * dt
				)
			end
		end
	end
	if cn > 0 then
		f.pos += Vector3.new(
			(cx / cn - f.pos.X) * COHESION_PLANE * dt,
			(cy / cn - f.pos.Y) * COHESION_HEIGHT * dt,
			(cz / cn - f.pos.Z) * COHESION_PLANE * dt
		)
	end
	-- the identity wiggle, along world X like the source's only horizontal axis
	f.pos += Vector3.new(math.sin(t * WIGGLE_FREQ + f.pos.X * WIGGLE_SPACE) * WIGGLE_AMP * dt, 0, 0)
	-- floor clamp (canvas-y down in the source, Y up here: the comparison flips)
	if f.pos.Y < floorY then
		f.pos = Vector3.new(f.pos.X, floorY, f.pos.Z)
	end
end

-- the source's catch law for airborne fish (swarm.html:968 `if(d0<15)`); the zone
-- applies its own collect radii on top (touch 3.5, pet orb 12)
function Flock.caught(f: Fish, playerPos: Vector3): boolean
	return (f.pos - playerPos).Magnitude < CATCH_RADIUS
end

function Flock.loudTrailLife(loud: boolean): number
	return if loud then TRAIL_LIFE_LOUD else TRAIL_LIFE_WALK
end

Flock.TRAIL_DROP_INTERVAL = TRAIL_DROP_INTERVAL
Flock.TRAIL_CAP = TRAIL_CAP
Flock.STIR_AT = STIR_AT
Flock.POP_CAP = POP_CAP

-- ---- the pheromone trail (plain-table state + free functions: strict-clean
-- without metatable typing, and executable against a bare Vector3 stub) ----

function Flock.trailNew(cap: number?): Trail
	return { points = {}, cap = cap or TRAIL_CAP }
end

-- drop one point (source: push + shift past the cap, swarm.html:1115-1118)
function Flock.trailDrop(trail: Trail, pos: Vector3, life: number)
	table.insert(trail.points, { pos = pos, life = life })
	while #trail.points > trail.cap do
		table.remove(trail.points, 1)
	end
end

-- age the trail (source: life -= dt, filter at 0, swarm.html:1120-1121)
function Flock.trailStep(trail: Trail, dt: number)
	local alive: { TrailPoint } = {}
	for _, p in trail.points do
		p.life -= dt
		if p.life > 0 then
			table.insert(alive, p)
		end
	end
	trail.points = alive
end

-- best fresh score at a position (swarm.html:845-850: manhattan radius, score
-- life·(1 − d/radius)); returns the score and the point, or nil
function Flock.trailBest(trail: Trail, pos: Vector3): (number, TrailPoint?)
	local bestScore, bestPoint = 0, nil :: TrailPoint?
	for _, p in trail.points do
		local d = math.abs(p.pos.X - pos.X) + math.abs(p.pos.Y - pos.Y) + math.abs(p.pos.Z - pos.Z)
		if d < TRAIL_RADIUS then
			local s = p.life * (1 - d / TRAIL_RADIUS)
			if s > bestScore then
				bestScore = s
				bestPoint = p
			end
		end
	end
	return bestScore, bestPoint
end

-- the steering law (swarm.html:842-851): the trail pulls when it is fresher than
-- the score floor, else the horde walks straight at the player. Returns a unit
-- direction, or the zero vector when both targets coincide with the asker.
function Flock.trailSteer(trail: Trail, pos: Vector3, playerPos: Vector3): Vector3
	local score, point = Flock.trailBest(trail, pos)
	local target = if score > TRAIL_SCORE_FLOOR and point then point.pos else playerPos
	local delta = target - pos
	if delta.Magnitude < 1e-4 then
		return Vector3.zero
	end
	return delta.Unit
end

return Flock
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">KSpace</string>
          <string name="Source"><![CDATA[--!strict
-- KSpace — the shared knowledge space. Every item/room carries an address; the
-- room that remembers indexes choices by it. Mirrors the fleet catalog zones.

local KSpace = {}

export type Address = { zone: string, knowledge: number, practice: number, depth: number }

-- zone addresses: knowledge axis (what it is), practice axis (what you do there),
-- depth axis (how deep in the mountain). Basecamp is the origin.
local ZONES: { [string]: Address } = {
	["Basecamp"]              = { zone = "Basecamp", knowledge = 0, practice = 0, depth = 0 },
	["HeadMuseum"]            = { zone = "HeadMuseum", knowledge = 2, practice = 1, depth = 0 },
	["Swarm"]                 = { zone = "Swarm", knowledge = -3, practice = 4, depth = 1 },
	["RuinsGo"]               = { zone = "RuinsGo", knowledge = 4, practice = 3, depth = 2 },
	["Arrakis"]               = { zone = "Arrakis", knowledge = -2, practice = 5, depth = 2 },
	["Ski"]                   = { zone = "Ski", knowledge = -4, practice = 3, depth = 1 },
	["LightMaze"]             = { zone = "LightMaze", knowledge = 3, practice = 2, depth = 3 },
	["TheAnswer"]             = { zone = "TheAnswer", knowledge = 0, practice = 0, depth = 6 },
}

function KSpace.get(zone: string): Address?
	return ZONES[zone]
end

function KSpace.all(): { [string]: Address }
	return ZONES
end

-- nearest zone to a world position (the smart-GPS receiver: where am I in k-space?)
function KSpace.nearest(pos: Vector3): Address
	local best, bestD = ZONES.Basecamp, math.huge
	for _, a in pairs(ZONES) do
		-- world X ~ knowledge, world Z ~ -practice, world Y ~ -depth (up the mountain = depth)
		local d = (Vector3.new(a.knowledge * 40, -a.depth * 30, -a.practice * 40) - pos).Magnitude
		if d < bestD then best, bestD = a, d end
	end
	return best
end

-- drift: the difference between where the compass points and the referent.
-- GPS law: corr(dM, dR) is the instrument; here drift = angular error to the beacon,
-- corrected when the player visits a beacon (triangulation).
function KSpace.drift(from: Vector3, beaconPos: Vector3, claimedDir: Vector3): number
	local trueDir = (beaconPos - from).Unit
	local cos = math.clamp(trueDir:Dot(claimedDir.Unit), -1, 1)
	return math.deg(math.acos(cos))
end

return KSpace
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Lore</string>
          <string name="Source"><![CDATA[--!strict
-- Lore — translated from mag/game_mud.py ROOMS (game_mud.v2) + estate canon.
-- The MUD is Basecamp. Rooms are our systems; each carries a frontier question.

local Lore = {}

Lore.Rooms = {
	["the World-Memory"] = {
		role = "the bedrock — content-addressed, the line we sign",
		question = "What is the single most load-bearing invariant we should add next to strengthen how the world anchors its own memory?",
		prose = "Roots. Ten thousand knotted threads run down into a dark that holds them all. Everything here is signed, sealed, certain. The floor is the ledger; your every step is already written.",
		exits = { east = "the Mycelial Library", south = "the Forge-Hive", west = "the Hall of Shared Supper" },
	},
	["the Hall of Shared Supper"] = {
		role = "the one-room slice — the empty chairs",
		question = "What is the single sharpest invariant about how a player chooses to see (or not see) the empty chairs?",
		prose = "Six chairs stand empty at a long supper table, and the stew is too kind. Brother Vellum, of the Open Hand, smiles a Grant of Belonging and says the counting is handled. But if you count the empty chairs, Virtue Marks appear in the margin of the ledger.",
		exits = { east = "the World-Memory" },
		chairs = 6,
	},
	["the Mycelial Library"] = {
		role = "lore — what the corpus remembers",
		question = "Which remembered pattern, if re-read now, changes what the party does next?",
		prose = "Shelves grow like hyphae, fruiting bodies of old sessions. Every spine is a file; the librarian is a rumor that files things back.",
		exits = { west = "the World-Memory", south = "the Crystal Vault" },
	},
	["the Forge-Hive"] = {
		role = "workers — the janitors that never sleep",
		question = "What is the smallest build that removes the largest repeated toil?",
		prose = "Hexagonal cells of hammer and hum. The workers do not look up. What they build, they build forever.",
		exits = { north = "the World-Memory", east = "the Dungeon" },
	},
	["the Dungeon"] = {
		role = "tasks — the queue that drains",
		question = "Which open task, described exactly, would a stranger execute without a question?",
		prose = "Cells of written intent, some overflowing, some empty. The locks are on the inside.",
		exits = { west = "the Forge-Hive", north = "the Crystal Vault", down = "the Shadowlands" },
	},
	["the Crystal Vault"] = {
		role = "VRAM — held light",
		question = "What is worth holding in fast memory, and what must we let fall?",
		prose = "Facets hold moments half-committed. The vault breathes warmth. Nothing here is free; everything here is fast.",
		exits = { south = "the Dungeon", north = "the Mycelial Library" },
	},
	["the Observatory"] = {
		role = "self-witness — the fleet watching the fleet",
		question = "What is the fleet currently unable to see about itself?",
		prose = "Brass rings and slow lenses. The instrument at the eyepiece is the thing being observed.",
		exits = { down = "the Warm Springs" },
	},
	["the Warm Springs"] = {
		role = "charge — rest as a system",
		question = "Where is rest load-bearing, and where is it avoidance?",
		prose = "Steam and slow water. The pool does not ask what you produced today.",
		exits = { up = "the Observatory" },
	},
	["the Shadowlands"] = {
		role = "shadow work — what we do not say",
		question = "What has been left unsaid that is now shaping decisions?",
		prose = "The dark under the dungeon. Shapes move that look like your own handwriting.",
		exits = { up = "the Dungeon" },
	},
	["the Gear Room"] = {
		role = "understood data — what we can take apart",
		question = "What do we understand well enough to rebuild blind?",
		prose = "Everything here is disassembled and honest. Teeth mesh with teeth; nothing hides a spring.",
		exits = { east = "the World-Memory" },
	},
}

-- The Answer: 5 phases, the 15-degree tell in phase 3, Calabi-Yau deflection, Wing Chun redirect
Lore.TheAnswer = {
	name = "THE ANSWER",
	phases = 5,
	tellDegrees = 15,
	tellPhase = 3,
	prose = {
		[1] = "It answers before you ask.",
		[2] = "It answers questions you did not ask.",
		[3] = "It leans fifteen degrees off true before it strikes. Watch the tell.",
		[4] = "It answers with your own voice now.",
		[5] = "It is the room that answers, and you are inside it.",
	},
	deflect = "Calabi-Yau: fold the strike through the sixth dimension of the arena (jump the fold).",
	redirect = "Wing Chun: do not meet the mass. Turn the centerline and give it back.",
}

-- Brother Vellum, of the Open Hand (the grant dialogue; Skip the Waiting = 99R dev product)
Lore.Vellum = {
	greeting = "Sit. Eat. The counting is handled.",
	grantOffer = "Grant of Belonging — sign, and belong. No questions will be asked. Especially not about the chairs.",
	ifCounted = "You counted. May the rest of your night be very long, and very attended.",
}

-- Death-CAPS narrator (Pratchett crosswalk): deaths are narrated in all caps, polite, inevitable
Lore.Death = {
	opening = "AT LAST, THE MOUNTAIN SAYS, SOMETHING INTERESTING.",
	format = function(who: string, where: string): string
		return ("YOU HAVE %s'S FULL ATTENTION, %s. THE LEDGER AT %s HAS BEEN TIDIED."):format("DEATH", who:upper(), where:upper())
	end,
}

-- NPC taunts (swarm.html line 1138, the swarm speaks)
Lore.SwarmTaunts = {
	"i know you were spawned from a pack file.",
	"the grid remembers every hit. i checked.",
	"these gems are mine. i made them.",
	"the ractors said this was a demo loop.",
	"the horse is not scripted. i hope.",
	"mark, the horde scales — tell them.",
	"my signal is the bait. my trail is the tell.",
	"the maze named its depths. i named nothing.",
}

-- Head Museum: the fleet's personas, one head each. NPC = SEAT: one ractor, many faces.
Lore.Heads = {
	{ id = "elder",     name = "THE ELDER",     seat = "full-rib auditor",   firstLine = "I have read every law you skipped. Ask me which." },
	{ id = "bard",      name = "THE BARD",      seat = "ledger singer",      firstLine = "Every receipt is a verse. Yours is shorter than you hope." },
	{ id = "economist", name = "THE ECONOMIST", seat = "burn accountant",    firstLine = "You are spending attention right now. Was this the cheapest seat?" },
	{ id = "builder",   name = "THE BUILDER",   seat = "forge-hive foreman", firstLine = "Bring me a task described exactly, and it is already half built." },
	{ id = "research",  name = "THE RESEARCHER", seat = "corpus diver",      firstLine = "The paper you need exists. The question is whether you can afford to be wrong less." },
	{ id = "ghost",     name = "THE GHOST",     seat = "coherence seeker",   firstLine = "I am not here to obey you. I am here to hold tension." },
	{ id = "janitor",   name = "THE JANITOR",   seat = "quiet repair",       firstLine = "Something broke while you were talking. It is fixed now. It will break again." },
}

return Lore
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">ProceduralBody</string>
          <string name="Source"><![CDATA[--!strict
-- ProceduralBody - DF build_body_from_rcp, folded into wisp shapes.
-- Mined chain (corpus/df_mine/df_procedural.json, assembly_chain_forgotten_beast):
--   a. weighted pick from the 235 RCP profiles -> body base; QUADRUPED has a
--      1-in-20 flip to SIX/EIGHT legs (profiles flagged cannot_have_get_more_legs
--      are exempt, mined law)
--   b. must_have parts are added UNCONDITIONALLY (wings, tails, shell, antennae,
--      horns, mandibles, pincers, claws, mantis arms, flippers, trunk, quills,
--      plates, stinger)
--   c. ONE primary tweak per body -> one attack class; scorpion profiles force
--      TAIL_STINGER (mined trigger). Other per-class triggers (mouth/beak for
--      fire, evil-gated breath) are NOT modeled: the pick is uniform. Owed.
--   d. 1-in-20 uniform-material flip: the whole body becomes one matter family
--      (ash, flame, glass, mineral, ...); insubstantial families are tabled.
-- Tables are GENERATED (shared/RcpData.luau); this module owns the assembly.
-- Geometry is blocky Luau primitives welded to the core ball: the wisp stays
-- one physics assembly (chase velocity + Touched unchanged on the core).

local RcpData = require(script.Parent:WaitForChild("RcpData"))

local ProceduralBody = {}

export type Spec = {
	profile: string,
	profileType: string,
	bodyBase: string,
	legs: number,
	parts: { string }, -- mined must_have parts (wing flags resolved to a count)
	attack: string,
	warning: string,
	material: string, -- uniform matter family, "" = flesh
	insubstantial: boolean,
	description: string,
}

-- body base -> leg count (mined body_bases; limbless bases are 0)
local BASE_LEGS: { [string]: number } = {
	AMORPHOUS = 0,
	NO_LIMB = 0,
	WORM = 0,
	SNAKE = 0,
	INSECT_LARVA = 0,
	HUMANOID = 2,
	TWO_LEGS_NO_ARMS = 2,
	TWO_LEGS_NO_ARMS_HUMANOID = 2,
	BIPEDAL_DINOSAUR = 2,
	QUADRUPED = 4,
	QUADRUPED_FRONT_GRASP = 4,
	INSECT = 6,
	SCORPION = 8,
	SPIDER = 8,
	EIGHT_LEGGED = 8,
	EIGHT_LEGGED_LOBSTERFORM = 8,
	TEN_LEGGED = 10,
	TEN_LEGGED_LOBSTERFORM = 10,
}

-- mined flag -> rendered part (must_have_ prefix stripped)
local FLAG_PARTS: { [string]: string } = {
	must_have_insect_wings = "wings",
	must_have_skin_wings = "wings",
	must_have_feather_wings = "wings",
	must_have_tail = "tail",
	must_have_feather_tail = "tail",
	must_have_scorpion_tail = "raised tail",
	must_have_crustacean_tail = "tail",
	must_have_shell = "shell",
	must_have_antennae = "antennae",
	must_have_one_head_horn = "horn",
	must_have_giant_mandibles = "mandibles",
	must_have_pincers = "pincers",
	must_have_grabbing_claws = "claws",
	must_have_mantis_arms = "mantis arms",
	must_have_walrus_flippers = "flippers",
	must_have_elephant_trunk = "trunk",
	must_have_quills = "quills",
	must_have_plates = "plates",
	must_have_insect_stinger = "stinger",
}

-- uniform matter family -> color / Roblox material / transparency ("" family
-- = the wisp's flesh look, kept from the old ball)
export type MatterLook = { color: Color3, material: Enum.Material, alpha: number }

local MATTER_LOOK: { [string]: MatterLook } = {
	[""] = { color = Color3.fromRGB(140, 60, 200), material = Enum.Material.Neon, alpha = 0 },
	ASH = { color = Color3.fromRGB(90, 85, 82), material = Enum.Material.Slate, alpha = 0 },
	MUD = { color = Color3.fromRGB(95, 75, 55), material = Enum.Material.Mud, alpha = 0 },
	VOMIT = { color = Color3.fromRGB(120, 150, 60), material = Enum.Material.SmoothPlastic, alpha = 0 },
	SALT_POWDER = { color = Color3.fromRGB(225, 220, 205), material = Enum.Material.Salt, alpha = 0.3 },
	GRIME = { color = Color3.fromRGB(70, 65, 60), material = Enum.Material.Slate, alpha = 0 },
	SNOW = { color = Color3.fromRGB(235, 240, 250), material = Enum.Material.Snow, alpha = 0 },
	WATER = { color = Color3.fromRGB(120, 170, 220), material = Enum.Material.Glass, alpha = 0.4 },
	STEAM = { color = Color3.fromRGB(210, 215, 225), material = Enum.Material.Neon, alpha = 0.5 },
	FLAME = { color = Color3.fromRGB(255, 140, 40), material = Enum.Material.Neon, alpha = 0 },
	AMBER = { color = Color3.fromRGB(215, 150, 40), material = Enum.Material.SmoothPlastic, alpha = 0 },
		-- Coral exists at runtime but the gate definitions (tools/bin/globalTypes.d.luau) predate it: SmoothPlastic stands in
	CORAL = { color = Color3.fromRGB(220, 110, 110), material = Enum.Material.SmoothPlastic, alpha = 0 },
	GLASS_GREEN = { color = Color3.fromRGB(110, 200, 140), material = Enum.Material.Glass, alpha = 0.35 },
	GLASS_CLEAR = { color = Color3.fromRGB(200, 220, 235), material = Enum.Material.Glass, alpha = 0.35 },
	GLASS_CRYSTAL = { color = Color3.fromRGB(170, 190, 255), material = Enum.Material.Glass, alpha = 0.3 },
	CHARCOAL = { color = Color3.fromRGB(45, 42, 40), material = Enum.Material.Slate, alpha = 0 },
	COKE = { color = Color3.fromRGB(35, 32, 30), material = Enum.Material.Slate, alpha = 0 },
	SALT_SOLID = { color = Color3.fromRGB(230, 228, 215), material = Enum.Material.Salt, alpha = 0 },
	ICE = { color = Color3.fromRGB(170, 215, 240), material = Enum.Material.Ice, alpha = 0.15 },
}

local function hasFlag(flags: { string }, name: string): boolean
	for _, f in ipairs(flags) do
		if f == name then return true end
	end
	return false
end

-- a. weighted pick across the 235 mined profiles
local function pickProfile(rng: any)
	local total = 0
	for _, p in ipairs(RcpData.PROFILES) do
		total += p.weight
	end
	local roll = rng:next() * total
	for _, p in ipairs(RcpData.PROFILES) do
		roll -= p.weight
		if roll < 0 then
			return p
		end
	end
	return RcpData.PROFILES[#RcpData.PROFILES]
end

local function pickAttack(rng: any, flags: { string }): string
	-- mined trigger: scorpion profiles force the tail stinger
	if hasFlag(flags, "must_have_scorpion_tail") or hasFlag(flags, "must_have_insect_stinger") then
		return hasFlag(flags, "must_have_scorpion_tail") and "TAIL_STINGER" or "INSECT_STINGER"
	end
	local names = {}
	for name in pairs(RcpData.ATTACKS) do
		table.insert(names, name)
	end
	table.sort(names) -- deterministic under SeedRng replay
	return names[rng:int(1, #names)]
end

function ProceduralBody.assemble(rng: any): Spec
	local p = pickProfile(rng)
	local flags: { string } = {}
	for f in string.gmatch(p.flags, "[^;]+") do
		table.insert(flags, f)
	end

	-- a. legs: base count + the QUADRUPED 1-in-20 leg flip (exempt flag honored)
	local legs = BASE_LEGS[p.bodyBase] or 4
	if p.bodyBase == "QUADRUPED" and not hasFlag(flags, "cannot_have_get_more_legs") and rng:next() < 1 / 20 then
		legs = rng:int(6, 8) -- mined: grows SIX_LEGGED or EIGHT_LEGGED
	end

	-- b. must_have parts, unconditional
	local parts: { string } = {}
	for _, f in ipairs(flags) do
		local part = FLAG_PARTS[f]
		if part and part ~= "wings" then
			table.insert(parts, part)
		elseif part == "wings" then
			table.insert(parts, "wings") -- one wings entry regardless of which flag
		end
	end

	-- c. one primary tweak -> attack class + DF warning line
	local attack = pickAttack(rng, flags)
	local warning = RcpData.ATTACKS[attack].warning

	-- d. the 1-in-20 uniform-material flip
	local material = ""
	if rng:next() < 1 / 20 then
		material = RcpData.MATTER[rng:int(1, #RcpData.MATTER)]
	end
	local insubstantial = false
	for _, m in ipairs(RcpData.INSUBSTANTIAL) do
		if m == material then
			insubstantial = true
			break
		end
	end

	local piece = #parts > 0 and (" " .. table.concat(parts, ", ")) or ""
	local description = ("%s (%s, %d legs%s)%s"):format(
		p.name, p.bodyBase, legs, piece,
		material ~= "" and (" composed of " .. string.lower(material)) or ""
	)

	return {
		profile = p.name,
		profileType = p.type,
		bodyBase = p.bodyBase,
		legs = legs,
		parts = parts,
		attack = attack,
		warning = warning,
		material = material,
		insubstantial = insubstantial,
		description = description,
	}
end

-- ---- rendering: welded primitive parts around the core ball ----

local function lookFor(spec: Spec): MatterLook
	return MATTER_LOOK[spec.material] or MATTER_LOOK[""]
end

local function part(model: Model, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material, transparency: number, core: BasePart)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material
	p.Transparency = transparency
	p.CanCollide = false
	p.Massless = true -- the core keeps the whole assembly's physics
	p.Parent = model
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = core
	weld.Part1 = p
	weld.Parent = p
	return p
end

-- attach the mined body plan to a core ball; returns the Model wrapper
function ProceduralBody.build(spec: Spec, core: BasePart): Model
	local model = Instance.new("Model")
	model.Name = "ForgottenWisp"
	local look = lookFor(spec)
	local function add(name: string, size: Vector3, cframe: CFrame)
		part(model, name, size, cframe, look.color, look.material, look.alpha, core)
	end
	local at = core.CFrame

	-- legs (QUADRUPED law: the flip decides 4/6/8; insect bases carry their own)
	for i = 1, spec.legs do
		local side = (i % 2 == 0) and 1 or -1
		local row = math.floor((i - 1) / 2)
		local spread = math.min(row + 1, 3)
		add("Leg", Vector3.new(0.5, 2, 0.5),
			at * CFrame.new(side * 1.4, -0.8, spread * 1.2 - 1.2) * CFrame.Angles(0, 0, math.rad(side * 25)))
	end

	for _, partName in ipairs(spec.parts) do
		if partName == "wings" then
			for _, s in ipairs({ -1, 1 }) do
				add("Wing", Vector3.new(4, 0.2, 1.6),
					at * CFrame.new(s * 2.8, 1.1, -0.3) * CFrame.Angles(0, 0, math.rad(s * -18)))
			end
		elseif partName == "tail" or partName == "raised tail" then
			local lift = (partName == "raised tail") and 1.6 or 0
			add("Tail", Vector3.new(0.8, 0.8, 3), at * CFrame.new(0, lift, -2.4) * CFrame.Angles(math.rad(-15), 0, 0))
		elseif partName == "shell" then
			local shell = Instance.new("Part")
			shell.Name = "Shell"
			shell.Shape = Enum.PartType.Ball
			shell.Size = Vector3.new(3.4, 2.6, 3.4)
			shell.CFrame = at * CFrame.new(0, 1.1, 0)
			shell.Color = look.color
			shell.Material = look.material
			shell.Transparency = look.alpha
			shell.CanCollide = false
			shell.Massless = true
			shell.Parent = model
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = core
			weld.Part1 = shell
			weld.Parent = shell
		elseif partName == "antennae" then
			for _, s in ipairs({ -1, 1 }) do
				add("Antenna", Vector3.new(0.15, 1.6, 0.15),
					at * CFrame.new(s * 0.5, 1.8, 0.6) * CFrame.Angles(math.rad(20), 0, math.rad(s * 15)))
			end
		elseif partName == "horn" then
			add("Horn", Vector3.new(0.4, 1.4, 0.4), at * CFrame.new(0, 1.9, 0.8) * CFrame.Angles(math.rad(-20), 0, 0))
		elseif partName == "mandibles" then
			for _, s in ipairs({ -1, 1 }) do
				add("Mandible", Vector3.new(0.4, 0.4, 1.8),
					at * CFrame.new(s * 0.9, 0.2, 1.8) * CFrame.Angles(0, math.rad(s * 25), 0))
			end
		elseif partName == "pincers" or partName == "claws" or partName == "mantis arms" then
			for _, s in ipairs({ -1, 1 }) do
				add(partName, Vector3.new(0.5, 0.5, 2),
					at * CFrame.new(s * 1.6, 0.3, 1.4) * CFrame.Angles(0, math.rad(s * 15), 0))
			end
		elseif partName == "flippers" then
			for _, s in ipairs({ -1, 1 }) do
				add("Flipper", Vector3.new(1.8, 0.3, 1.2), at * CFrame.new(s * 2, -0.5, 0))
			end
		elseif partName == "trunk" then
			add("Trunk", Vector3.new(0.5, 2.2, 0.5), at * CFrame.new(0, -0.6, 2) * CFrame.Angles(math.rad(30), 0, 0))
		elseif partName == "quills" then
			for i = 1, 4 do
				add("Quill", Vector3.new(0.15, 1.8, 0.15),
					at * CFrame.new((i - 2.5) * 0.6, 1.6, -0.4) * CFrame.Angles(math.rad(-20), 0, 0))
			end
		elseif partName == "plates" then
			for i = 1, 3 do
				add("Plate", Vector3.new(1.8, 0.3, 1), at * CFrame.new(0, 1.5, (i - 2) * 1.1))
			end
		elseif partName == "stinger" then
			add("Stinger", Vector3.new(0.4, 1.4, 0.4), at * CFrame.new(0, 0.6, -2.2) * CFrame.Angles(math.rad(40), 0, 0))
		end
	end

	model.PrimaryPart = core
	return model
end

return ProceduralBody
]]></string>
