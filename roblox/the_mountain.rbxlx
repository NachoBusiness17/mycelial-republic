	["TORTURE"] = { "CHARITY", "CONSOLATION", "FORGIVENESS", "FREEDOM", "GENEROSITY", "HAPPINESS", "HEALING", "HOSPITALITY", "LOVE", "MERCY", "PEACE", "REVELRY", "SACRIFICE", "TRUTH", "WISDOM" },
	["TRADE"] = {  },
	["TRAVELERS"] = {  },
	["TREACHERY"] = { "CHARITY", "CONSOLATION", "FORGIVENESS", "FREEDOM", "GENEROSITY", "HAPPINESS", "HEALING", "HOSPITALITY", "LOVE", "MERCY", "PEACE", "REVELRY", "SACRIFICE", "TRUTH", "WISDOM" },
	["TREES"] = {  },
	["TRICKERY"] = {  },
	["TRUTH"] = { "BLIGHT", "CHAOS", "DEATH", "DEFORMITY", "DEPRAVITY", "DISEASE", "JEALOUSY", "LIES", "MISERY", "MURDER", "NIGHTMARES", "SUICIDE", "THEFT", "THRALLDOM", "TORTURE", "TREACHERY" },
	["TWILIGHT"] = {  },
	["VALOR"] = {  },
	["VICTORY"] = {  },
	["VOLCANOS"] = {  },
	["WAR"] = {  },
	["WATER"] = {  },
	["WEALTH"] = {  },
	["WEATHER"] = {  },
	["WIND"] = {  },
	["WISDOM"] = { "BLIGHT", "CHAOS", "DEATH", "DEFORMITY", "DEPRAVITY", "DISEASE", "JEALOUSY", "LIES", "MISERY", "MURDER", "NIGHTMARES", "SUICIDE", "THEFT", "THRALLDOM", "TORTURE", "TREACHERY" },
	["WRITING"] = {  },
	["YOUTH"] = {  },
}

local SphereKinship = {}

SphereKinship.ALIGNMENT = ALIGNMENT

SphereKinship.ALLIES = ALLIES

SphereKinship.OPPOSED = OPPOSED

SphereKinship.COUNT = 130


return SphereKinship
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Temptation</string>
          <string name="Source"><![CDATA[--!strict
-- Temptation - DF's villain law, folded onto Vellum's grant.
-- Mined law (dwarffortresswiki.org Villain, WORLDGEN_MINE.md #5): temptation
-- is checked against the target's personality and VALUES, and failure to
-- resist becomes ONGOING CORRUPTION. The act also carries an ETHIC, weighed
-- against the value it offends (DF ethics-shaped; the axes are DF value
-- tokens). The player's value profile is read at roll time from ledger facts
-- (attributes the ShadowLedger already files), so the counted chairs are the
-- spine of the resistance exactly as the hall teaches.
--   succumb iff roll(0..99) < threshold
--   threshold = plot.strength + sum(weight * value / 50), clamped 5..95

local Temptation = {}

Temptation.VALUES = { "LAW", "LOYALTY", "TRUTH", "POWER", "WEALTH", "BELONGING" }

-- the ethics chain: each plot's act weighs against one value (the pull is
-- applied through that value's weight in the plot, so profiles that hold the
-- value high resist harder, DF's values-vs-temptation shape)
Temptation.ETHICS = {
	OATH_BREAKING = { weighs = "LAW", note = "signing without counting" },
}

Temptation.PLOTS = {
	grant_of_belonging = {
		ethic = "OATH_BREAKING",
		strength = 45,
		-- positive: values that FEED the temptation; negative: values that resist
		weights = { BELONGING = 30, POWER = 10, LAW = -25, TRUTH = -25, LOYALTY = -10, WEALTH = -5 },
	},
}

export type Profile = { [string]: number }

-- the player's values, derived from ledger facts (never stored mutations)
function Temptation.profile(player: Player): Profile
	local counted = player:GetAttribute("CountedChairs") == true
	local rebirths = (tonumber((player:GetAttribute("Rebirths"))) or 0)
	local marks = (tonumber((player:GetAttribute("VirtueMarks"))) or 0)
	return {
		LAW = counted and 30 or 0, -- the count is an oath kept
		TRUTH = counted and 30 or 0, -- they looked at what the hall hides
		LOYALTY = counted and 10 or 0,
		POWER = math.min(rebirths * 10, 40),
		WEALTH = marks >= 1000 and 20 or 0,
		BELONGING = 20, -- everyone wants a seat; the grant says it is handled
	}
end

-- one temptation roll; returns succumbed, the roll, and the threshold it met
function Temptation.roll(rng: any, plotId: string, profile: Profile): (boolean, number, number)
	local plot = Temptation.PLOTS[plotId]
	if not plot then
		return false, 0, 0
	end
	local bias = 0
	for value, weight in pairs(plot.weights) do
		bias += weight * ((profile[value] or 0) / 50)
	end
	local roll = math.floor(rng:next() * 100)
	local threshold = math.clamp(math.floor(plot.strength + bias), 5, 95)
	return roll < threshold, roll, threshold
end

return Temptation
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Trove</string>
          <string name="Source"><![CDATA[--!strict
-- Trove — scoped cleanup, the Sleitnick/RbxUtil Trove pattern (the ADOPT row
-- of docs/ARCHITECTURE_NEXT.md: "every portal ring, NPC loop and sentinel
-- gets Trove-scoped teardown"). A trove tracks instances, connections,
-- threads, functions and cleanup tables; one Clean() tears them all down, so
-- a hand-rolled task.spawn loop dies by OWNERSHIP instead of polling .Parent
-- or waiting out a task.delay age (ARCHITECTURE_NEXT move 3: "six loops in
-- zones currently die by task.delay age, not ownership" — Q-043 landed the
-- conversions; see each zone's fix receipt).
--
-- Minimal in-repo implementation: the full RbxUtil package is not vendored
-- (no Packages tree in this repo), so this file keeps the upstream SHAPE —
-- Add / Connect / AttachToInstance / Clean / Destroy with the same cleanup
-- dispatch (Instance Destroy, connection Disconnect, thread cancel, function
-- call, table method) — plus one local extension, Loop(interval, fn), which
-- spawns a repeating thread the trove owns. Loop contract:
--   - the body runs immediately, then every `interval` seconds (the shape
--     every converted loop already had: check, act, task.wait);
--   - returning exactly `false` from the body ends the thread (a loop that
--     destroys its own subject returns false; the thread exits on its own);
--     any other return (including none) keeps the loop running;
--   - Clean() task.cancels the thread (safe no-op if it already ended, and
--     safe if it is the thread currently running the body: the Destroying
--     handler fires synchronously from Destroy inside the body, the pcall'd
--     cancel is a no-op on a running thread, and the false return then ends
--     it naturally — both paths terminate, nothing spins).

export type Trove = {
	Add: (self: Trove, object: any, cleanupMethod: string?) -> any,
	Connect: (self: Trove, signal: RBXScriptSignal, fn: (...any) -> (...any)) -> RBXScriptConnection,
	AttachToInstance: (self: Trove, instance: Instance) -> RBXScriptConnection,
	Loop: (self: Trove, interval: number, fn: () -> ...any) -> thread,
	Clean: (self: Trove) -> (),
	Destroy: (self: Trove) -> (),
}

local Trove = {}
Trove.__index = Trove

local function cleanupEntry(entry: { any })
	local object, method = entry[1], entry[2]
	local kind = typeof(object)
	if kind == "Instance" then
		(object :: Instance):Destroy()
	elseif kind == "RBXScriptConnection" then
		(object :: RBXScriptConnection):Disconnect()
	elseif kind == "thread" then
		pcall(task.cancel, object :: thread) -- a dead or running thread just refuses; that is fine
	elseif kind == "function" then
		(object :: () -> ())()
	elseif kind == "table" then
		local tbl = object :: { [string]: any }
		local name = method
			or (typeof(tbl.Destroy) == "function" and "Destroy" or nil)
			or (typeof(tbl.Disconnect) == "function" and "Disconnect" or nil)
			or (typeof(tbl.Clean) == "function" and "Clean" or nil)
		if name then
			tbl[name](tbl)
		end
	end
end

function Trove.new(): Trove
	local self = setmetatable({
		_entries = {} :: { { any } },
		_locked = false,
		_cleaning = false,
	}, Trove)
	return (self :: any) :: Trove
end

function Trove:Add(object: any, cleanupMethod: string?): any
	if self._locked then
		error("Trove is locked (Destroy was called)", 2)
	end
	table.insert(self._entries, { object, cleanupMethod })
	return object
end

function Trove:Connect(signal: RBXScriptSignal, fn: (...any) -> (...any)): RBXScriptConnection
	return self:Add(signal:Connect(fn)) :: RBXScriptConnection
end

function Trove:AttachToInstance(instance: Instance): RBXScriptConnection
	return self:Connect(instance.Destroying, function()
		self:Clean()
	end)
end

function Trove:Loop(interval: number, fn: () -> ...any): thread
	local thread: thread
	thread = task.spawn(function()
		while true do
			if fn() == false then
				break
			end
			task.wait(interval)
		end
	end)
	return self:Add(thread) :: thread
end

function Trove:Clean()
	if self._cleaning then
		return -- re-entrant: a Destroy inside the sweep re-fired Destroying
	end
	self._cleaning = true
	local entries = self._entries
	self._entries = {}
	for i = #entries, 1, -1 do -- LIFO: last-added torn down first
		cleanupEntry(entries[i])
	end
	self._cleaning = false
	self._locked = false
end

function Trove:Destroy()
	self:Clean()
	self._locked = true
end

return Trove
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Worldgen</string>
          <string name="Source"><![CDATA[--!strict
-- Worldgen — DF world-history laws mined from the wiki (LINKS-341/342/343),
-- now driving THE MOUNTAIN's world state.
--   AGES: worlds start in the Age of Myth; age transitions are driven by
--   megabeast deaths; ages recur with ordinals ("The Second Age of Legends").
--   [Calendar page; the <=3-great-powers branch is UNMINED — owed]
--   SPHERES: cosmic principles held by gods and beasts. Sourced from the raws
--   embedded on the Titan page ([SPHERE:ANIMALS] [SPHERE:NATURE] [SPHERE:PLANTS]
--   [SPHERE:RIVERS]) + the Forgotten beast page text (caverns, water, theft,
--   thralldom, darkness, suicide, muck). The full list renders as an image on
--   SPHERE LIST: FULL 130, closed from the raws mine (df_spheres.json; the
--   canonical list hid in data/init/globals.lua random_sphere_adjective keys).
--   KINSHIP: the engine-side enemies/parents graph is unmined, so the graph
--   here is DERIVED from the mine's own fields (alignment classes +
--   co-occurrence; generated shared/SphereKinship.luau, WORLDGEN_MINE.md
--   law 4) and drives zone alliances + the beast announcement.
--   FORGOTTEN BEASTS: named procedurally, drawn to WEALTH AND NOISE, and the
--   world pauses when one is first seen (announcement law).

local ArtifactLore = require(script.Parent:WaitForChild("ArtifactLore"))
local SphereKinship = require(script.Parent:WaitForChild("SphereKinship"))

local Worldgen = {}

-- BEGIN GENERATED by tools/gen_worldgen_spheres.py from corpus/df_mine/df_spheres.json (spheres key) -- do not hand-edit.
-- Regenerate: .venv/Scripts/python.exe tools/gen_worldgen_spheres.py
local SPHERES: { string } = {
	"AGRICULTURE",
	"ANIMALS",
	"ART",
	"BALANCE",
	"BEAUTY",
	"BIRTH",
	"BLIGHT",
	"BOUNDARIES",
	"CAVERNS",
	"CHAOS",
	"CHARITY",
	"CHILDREN",
	"COASTS",
	"CONSOLATION",
	"COURAGE",
	"CRAFTS",
	"CREATION",
	"DANCE",
	"DARKNESS",
	"DAWN",
	"DAY",
	"DEATH",
	"DEFORMITY",
	"DEPRAVITY",
	"DISCIPLINE",
	"DISEASE",
	"DREAMS",
	"DUSK",
	"DUTY",
	"EARTH",
	"FAME",
	"FAMILY",
	"FATE",
	"FERTILITY",
	"FESTIVALS",
	"FIRE",
	"FISH",
	"FISHING",
	"FOOD",
	"FORGIVENESS",
	"FORTRESSES",
	"FREEDOM",
	"GAMBLING",
	"GAMES",
	"GENEROSITY",
	"HAPPINESS",
	"HEALING",
	"HOSPITALITY",
	"HUNTING",
	"INSPIRATION",
	"JEALOUSY",
	"JEWELS",
	"JUSTICE",
	"LABOR",
	"LAKES",
	"LAWS",
	"LIES",
	"LIGHT",
	"LIGHTNING",
	"LONGEVITY",
	"LOVE",
	"LOYALTY",
	"LUCK",
	"LUST",
	"MARRIAGE",
	"MERCY",
	"METALS",
	"MINERALS",
	"MISERY",
	"MIST",
	"MOON",
	"MOUNTAINS",
	"MUCK",
	"MURDER",
	"MUSIC",
	"NATURE",
	"NIGHT",
	"NIGHTMARES",
	"OATHS",
	"OCEANS",
	"ORDER",
	"PAINTING",
	"PEACE",
	"PERSUASION",
	"PLANTS",
	"POETRY",
	"PREGNANCY",
	"RAIN",
	"RAINBOWS",
	"REBIRTH",
	"REVELRY",
	"REVENGE",
	"RIVERS",
	"RULERSHIP",
	"RUMORS",
	"SACRIFICE",
	"SALT",
	"SCHOLARSHIP",
	"SEASONS",
	"SILENCE",
	"SKY",
	"SONG",
	"SPEECH",
	"STARS",
	"STORMS",
	"STRENGTH",
	"SUICIDE",
	"SUN",
	"THEFT",
	"THRALLDOM",
	"THUNDER",
	"TORTURE",
	"TRADE",
	"TRAVELERS",
	"TREACHERY",
	"TREES",
	"TRICKERY",
	"TRUTH",
	"TWILIGHT",
	"VALOR",
	"VICTORY",
	"VOLCANOS",
	"WAR",
	"WATER",
	"WEALTH",
	"WEATHER",
	"WIND",
	"WISDOM",
	"WRITING",
	"YOUTH",
}
-- END GENERATED (tools/gen_worldgen_spheres.py)
Worldgen.SPHERES = SPHERES

local AGES: { string } = { "the Age of Myth", "the Age of Heroes", "the Age of Legends" }
local KILLS_PER_AGE = 10

local bossKills = 0
local killLog: { string } = {}

-- megabeast deaths move the world's age; ages recur with ordinals (DF law)
function Worldgen.noteBossKill(name: string)
	bossKills += 1
	table.insert(killLog, name)
end

local ORDINALS: { string } = { "", "Second", "Third", "Fourth", "Fifth", "Sixth", "Seventh" }

function Worldgen.ageText(): string
	local stage = math.floor(bossKills / KILLS_PER_AGE) -- 0-based into AGES
	local cycle = math.floor(stage / #AGES)
	local age = AGES[(stage % #AGES) + 1]
	if cycle == 0 then
		return age:sub(1, 1):upper() .. age:sub(2)
	end
	local ordinal = ORDINALS[math.min(cycle + 1, #ORDINALS)]
	-- "the Age of Myth" -> "the Second Age of Myth"
	return age:gsub("^the ", ("the %s "):format(ordinal))
end

function Worldgen.killCount(): number
	return bossKills
end

-- forgotten beast namer: dwarven compound (mined lexicon) + sourced sphere.
-- The beast now carries its kinship rows from the generated graph, so the
-- announcement can file which principles side with it and which oppose it.
export type Beast = {
	name: string,
	sphere: string,
	allies: { string },
	opposed: { string },
}

local function inList(list: { string }, v: string): boolean
	for _, x in ipairs(list) do
		if x == v then
			return true
		end
	end
	return false
end

local function names(list: { string }, cap: number): string
	if #list == 0 then
		return "none" -- negative is a fact: unaligned spheres hold no kin/foes
	end
	local picked: { string } = {}
	for i = 1, math.min(cap, #list) do
		table.insert(picked, list[i])
	end
	return table.concat(picked, " and ")
end

-- sphere kinship = which zones ally (WORLDGEN_MINE.md law 4): opposition
-- (good vs evil) outranks co-occurrence kin; everything else is independent
function Worldgen.zoneAlliance(a: string, b: string): string
	if inList(SphereKinship.OPPOSED[a] or {}, b) then
		return "opposed"
	end
	if inList(SphereKinship.ALLIES[a] or {}, b) then
		return "allied"
	end
	return "independent"
end

function Worldgen.sphereAlignment(sphere: string): string
	return SphereKinship.ALIGNMENT[sphere] or "unaligned"
end

function Worldgen.forgottenBeast(rng: any): Beast
	local dw, en = ArtifactLore.dwarvenCompound(rng)
	local sphere = SPHERES[rng:int(1, #SPHERES)]
	local titled = en:sub(1, 1):upper() .. en:sub(2)
	return {
		name = ('%s, "the %s of %s"'):format(dw, titled, sphere),
		sphere = sphere,
		allies = SphereKinship.ALLIES[sphere] or {},
		opposed = SphereKinship.OPPOSED[sphere] or {},
	}
end

function Worldgen.forgottenName(rng: any): string
	return Worldgen.forgottenBeast(rng).name
end

-- the alliance sentence for the first-seen announcement: sourced rows only
function Worldgen.kinshipLine(beast: Beast): string
	return ("Kin: %s. Foes: %s."):format(names(beast.allies, 2), names(beast.opposed, 2))
end

return Worldgen
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Script" referent="21">
    <Properties>
      <string name="Name">ServerScriptService</string>
      <token name="RunContext">0</token>
      <string name="Source"><![CDATA[--!strict
-- init.server — THE MOUNTAIN. One experience:
--   Basecamp = the Roshomon MUD (the WoW mud is Basecamp, operator 2026-09-24)
--   HeadMuseum = the fleet's minds as AI NPC heads (one ractor, many faces)
--   climbs = the ports: Swarm, RuinsGo, Arrakis, Ski, LightMaze, TheAnswer
--   TheOssuary = the Halloween spearhead (spooky skeleton maze)
--   zones_extra = the wave: 12 estate games ported by fan-out agents
-- Every surface feeds the ShadowLedger (the room that remembers), every item
-- zone carries a k-space address, and the NPC heads ride the free stealth
-- lanes through the local gateway.

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Modules")
local Config = require(Shared:WaitForChild("Config"))

local MudBasecamp = require(script:WaitForChild("MudBasecamp"))
local HeadMuseum = require(script:WaitForChild("HeadMuseum"))
local ShadowLedger = require(script:WaitForChild("ShadowLedger"))
local Monetization = require(script:WaitForChild("Monetization"))
local PlayerFeel = require(script:WaitForChild("PlayerFeel"))
local AbilitySlots = require(script:WaitForChild("AbilitySlots"))
local LedgerExchange = require(script:WaitForChild("LedgerExchange"))
local SwarmZone = require(script:WaitForChild("SwarmZone"))
local RuinsGoZone = require(script:WaitForChild("RuinsGoZone"))
local ArrakisZone = require(script:WaitForChild("ArrakisZone"))
local SkiZone = require(script:WaitForChild("SkiZone"))
local LightMazeZone = require(script:WaitForChild("LightMazeZone"))
local TheAnswerBoss = require(script:WaitForChild("TheAnswerBoss"))
local OssuaryZone = require(script:WaitForChild("OssuaryZone"))
-- the cathedral eigen-map (ractor eigenmap-two, panel 2026-09-26; the sibling
-- build eigenmap-one was killed by the judge on the mirrored minimap and
-- pruned 2026-09-27, record in watch/inbox/ractor_panel_20260926/cands/):
-- the coherent-compass plate far south; see the CathedralMap.luau header
-- for the convention
local CathedralPlate = require(script:WaitForChild("CathedralPlate"))
local ZoneGate = require(script:WaitForChild("ZoneGate"))

-- the wave: the estate's remaining games, ported by the zones_extra fan-out
-- t67 spec: each row carries its own generator_region_spheres join in the
-- strict-required `region` field, so a wave zone cannot exist without a
-- join (type error) and ZoneGate's join map is derived from these rows at
-- init, not kept as a second hand-maintained name list (t64 audit: the old
-- WAVE names and ZONE_REGION keys were diff-identical 11 vs 11 by
-- discipline alone; see ZoneGate.luau header)
type WaveZone = { name: string, region: string, module: any, pos: Vector3, color: Color3 }
local WAVE: { WaveZone } = {
	{ name = "GALLERY",         region = "LAKE",      module = require(script:WaitForChild("zones_extra"):WaitForChild("GalleryZone")),         pos = Vector3.new(0, 8, -260),    color = Color3.fromRGB(217, 164, 65) },
	{ name = "FRONTIER SOULS",  region = "GRASSLAND", module = require(script:WaitForChild("zones_extra"):WaitForChild("FrontierSoulsZone")),    pos = Vector3.new(-200, 8, -200), color = Color3.fromRGB(192, 80, 56) },
	{ name = "TOY BOX",         region = "FOREST",    module = require(script:WaitForChild("zones_extra"):WaitForChild("ToyBoxZone")),          pos = Vector3.new(200, 8, -200),  color = Color3.fromRGB(143, 217, 143) },
	{ name = "HARDWARE PRIMER", region = "DESERT",    module = require(script:WaitForChild("zones_extra"):WaitForChild("HardwarePrimerZone")),   pos = Vector3.new(220, 8, 220),   color = Color3.fromRGB(110, 198, 181) },
	{ name = "INCIDENT DUNGEON", region = "MOUNTAINS", module = require(script:WaitForChild("zones_extra"):WaitForChild("IncidentDungeonZone")), pos = Vector3.new(220, 8, -220),  color = Color3.fromRGB(124, 245, 255) },
	{ name = "MAZE ARENA",      region = "DESERT",    module = require(script:WaitForChild("zones_extra"):WaitForChild("MazeArenaZone")),       pos = Vector3.new(300, 8, 0),     color = Color3.fromRGB(124, 245, 255) },
	{ name = "SPECTRAL MAZE",   region = "SWAMP",     module = require(script:WaitForChild("zones_extra"):WaitForChild("SpectralMazeZone")),    pos = Vector3.new(-220, 8, -60),  color = Color3.fromRGB(232, 180, 90) },
	{ name = "RIDDLE MAZE",     region = "HILLS",     module = require(script:WaitForChild("zones_extra"):WaitForChild("RiddleMazeZone")),      pos = Vector3.new(300, 8, 200),   color = Color3.fromRGB(180, 140, 255) },
	{ name = "LIGHTMAP ROOMS",  region = "GLACIER",   module = require(script:WaitForChild("zones_extra"):WaitForChild("LightmapRoomsZone")),   pos = Vector3.new(-300, 8, 0),    color = Color3.fromRGB(124, 245, 255) },
	{ name = "EROSION FIELD",   region = "TUNDRA",    module = require(script:WaitForChild("zones_extra"):WaitForChild("ErosionFieldZone")),    pos = Vector3.new(0, 8, -420),    color = Color3.fromRGB(76, 106, 62) },
	{ name = "STEER FIELD",     region = "OCEAN",     module = require(script:WaitForChild("zones_extra"):WaitForChild("SteerFieldZone")),      pos = Vector3.new(-400, 8, -110), color = Color3.fromRGB(111, 216, 255) },
}

-- ---- build the world ----
Monetization.init()
MudBasecamp.build()
HeadMuseum.build()
SwarmZone.build()
RuinsGoZone.build()
ArrakisZone.build()
SkiZone.build()
LightMazeZone.build()
TheAnswerBoss.build()
OssuaryZone.build()
-- THE CATHEDRAL: beacons at the scan's eigen_centroids, one compass held in
-- map + world + bearing (north = eigen -y = world -Z); no edge anchors on
-- the DARK region; the walker HUD (client/CathedralMapHud) reads the same
-- shared module
CathedralPlate.build()
-- t67: the gate's join derives from the WAVE rows above (single authorship
-- site); ZoneGate owns no zone-name list, see ZoneGate.luau header spec
local zoneRegions: { [string]: string } = {}
for _, z in ipairs(WAVE) do
	zoneRegions[z.name] = z.region
end
ZoneGate.init(zoneRegions) -- law 4 (t35): WAVE portals gated by sphereAlliance
LedgerExchange.init()

-- wave builds are fault-isolated: one bad zone must not kill the mountain
local waveTicks: { (number) -> () } = {}
for _, z in ipairs(WAVE) do
	local ok, built = pcall(function()
		return z.module.build()
	end)
	if ok and type(built) == "table" and typeof((built :: any).tick) == "function" then
		table.insert(waveTicks, (built :: any).tick :: (number) -> ())
	elseif not ok then
		warn(("[THE MOUNTAIN] zone %s failed to build: %s"):format(z.name, tostring(built)))
	end
end

-- ---- the nervous system: input remotes (client courier -> server brain) ----
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local movement = Instance.new("RemoteEvent")
movement.Name = "Movement"
movement.Parent = remotes
local ability = Instance.new("RemoteEvent")
ability.Name = "Ability"
ability.Parent = remotes
-- Q-037 2026-09-28: the chat relay MudBasecamp.say() promised at its old
-- stub comment — one server->client line per world-voice say()
local chat = Instance.new("RemoteEvent")
chat.Name = "Chat"
chat.Parent = remotes
remotes.Parent = ReplicatedStorage
MudBasecamp.bindChat(chat)
PlayerFeel.bind(movement)
PlayerFeel.init()
AbilitySlots.bind(ability)
AbilitySlots.init()

-- ---- portal rings: fixed climbs + the wave, all from Basecamp ----
type Portal = { to: string, pos: Vector3, color: Color3 }
local PORTALS: { Portal } = {
	{ to = "SWARM",        pos = Vector3.new(-120, 8, 120),  color = Color3.fromRGB(160, 40, 90) },
	{ to = "RUINS GO",     pos = Vector3.new(120, 8, 120),   color = Color3.fromRGB(150, 130, 80) },
	{ to = "ARRAKIS",      pos = Vector3.new(120, 8, -120),  color = Color3.fromRGB(200, 150, 60) },
	{ to = "SKI",          pos = Vector3.new(-120, 8, -120), color = Color3.fromRGB(180, 220, 240) },
	{ to = "LIGHT MAZE",   pos = Vector3.new(0, 40, 200),    color = Color3.fromRGB(150, 180, 255) },
	{ to = "THE ANSWER",   pos = Vector3.new(0, 188, 0),     color = Color3.fromRGB(220, 216, 235) },
	{ to = "THE OSSUARY",  pos = Vector3.new(-60, 8, 0),     color = Color3.fromRGB(255, 130, 40) },
}
-- the cathedral's landing is derived, never hand-set: entry() puts the
-- walker NORTH of the floor (plateCenter - (size.Z/2 + 8) on Z)
table.insert(PORTALS, { to = "THE CATHEDRAL", pos = CathedralPlate.entry(),
	color = Color3.fromRGB(91, 75, 138) })
for _, z in ipairs(WAVE) do
	table.insert(PORTALS, { to = z.name, pos = z.pos, color = z.color })
end

for i, p in ipairs(PORTALS) do
	local pad = Instance.new("Part")
	pad.Anchored = true
	pad.Size = Vector3.new(8, 0.4, 8)
	-- two concentric rings so 18 portals fit: climbs inner, wave outer
	local angle = (i / #PORTALS) * math.pi * 2
	local radius = (i <= 7) and 30 or 46
	pad.Position = Vector3.new(math.cos(angle) * radius, 8.4, math.sin(angle) * radius)
	pad.Color = p.color
	pad.Material = Enum.Material.Neon
	pad.Name = ("Portal_%s"):format(p.to)
	pad.Parent = workspace

	local lbl = Instance.new("BillboardGui")
	lbl.Size = UDim2.new(0, 140, 0, 28)
	lbl.StudsOffset = Vector3.new(0, 3, 0)
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = p.to
	t.TextColor3 = p.color
	t.Font = Enum.Font.Garamond
	t.TextSize = 18
	t.Parent = lbl
	lbl.Parent = pad

	pad.Touched:Connect(function(hit)
		local player = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
		-- law 4 (t35): the gate answers before the pivot; a refusal is a
		-- locked door, so no teleport and no ledger line for the crossing
		if player and player.Character and ZoneGate.portalGate(player, p.to) then
			player.Character:PivotTo(CFrame.new(p.pos + Vector3.new(0, 6, 0)))
			ShadowLedger.record(player, "Basecamp", ("took the portal to %s"):format(p.to))
		end
	end)
end

-- ---- one heartbeat drives every climb ----
RunService.Heartbeat:Connect(function(dt: number)
	SwarmZone.tick(dt)
	ArrakisZone.tick(dt)
	SkiZone.tick(dt)
	LightMazeZone.tick(dt)
	OssuaryZone.tick(dt)
	LedgerExchange.tick(dt)
	CathedralPlate.tick(dt) -- the chain strips breathe (THE CATHEDRAL)
	for _, tick in ipairs(waveTicks) do
		-- fix t1b 2026-09-25: waveTicks is (number) -> (), so pcall's type was
		-- just (boolean) and `local ok, err` needed 2 values (a01 TypeError at
		-- 150,3). The ...any tail is the err channel pcall forwards on failure.
		local ok, err = pcall(function(): ...any
			tick(dt)
		end)
		if not ok then
			warn(("[THE MOUNTAIN] wave tick fault: %s"):format(tostring(err)))
		end
	end
end)

-- ---- leaderstats: the Roblox-standard visible scorecard (M-key player list) ----
local function attachLeaderstats(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local marks = Instance.new("IntValue")
	marks.Name = "Virtue Marks"
	marks.Parent = stats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = stats
	local invariants = Instance.new("IntValue")
	invariants.Name = "Invariants"
	invariants.Parent = stats
	local summits = Instance.new("IntValue")
	summits.Name = "Summits"
	summits.Parent = stats
	stats.Parent = player

	-- t56 2026-09-25: the 1s GetAttributes poll (t14c's stopgap) is gone;
	-- leaderstats now update on change signals. VirtueMarks/Rebirths/Invariants
	-- each bind GetAttributeChangedSignal. The Summit_ round booleans have
	-- dynamic names, so they ride the catch-all AttributeChanged event:
	-- first-time SetAttribute fires it with the new name per the official
	-- attributes doc example (SetAttribute("Grow", false) on a fresh instance
	-- "Fires Changed and AttributeChanged"). Sole Summit_ writer is the
	-- LightMazeZone.luau:156 SetAttribute (guarded at :155, once per round);
	-- t14c's finding still holds that no dedicated Summits attribute exists in
	-- src, so the scorecard counts Summit_ names instead of inventing a stat.
	-- Scripts cannot remove attributes, and the seed calls below cover values
	-- present before attach, so every case is signal-covered: no polling
	-- fallback remains.
	local function syncMarks()
		marks.Value = player:GetAttribute("VirtueMarks") or 0
	end
	local function syncRebirths()
		rebirths.Value = player:GetAttribute("Rebirths") or 0
	end
	local function syncInvariants()
		invariants.Value = player:GetAttribute("Invariants") or 0
	end
	local function syncSummits()
		local summitCount = 0
		for name in pairs(player:GetAttributes()) do
			if string.sub(name, 1, 7) == "Summit_" then
				summitCount += 1
			end
		end
		summits.Value = summitCount
	end

	syncMarks()
	syncRebirths()
	syncInvariants()
	syncSummits()

	player:GetAttributeChangedSignal("VirtueMarks"):Connect(syncMarks)
	player:GetAttributeChangedSignal("Rebirths"):Connect(syncRebirths)
	player:GetAttributeChangedSignal("Invariants"):Connect(syncInvariants)
	player.AttributeChanged:Connect(function(name: string)
		if string.sub(name, 1, 7) == "Summit_" then
			syncSummits()
		end
	end)
end
Players.PlayerAdded:Connect(attachLeaderstats)
for _, p in ipairs(Players:GetPlayers()) do
	attachLeaderstats(p)
end

local summary: string = ("%d wave zones wired, %d portals live"):format(#WAVE, #PORTALS)
	print(("[THE MOUNTAIN] built: %s. Basecamp is the mud, the heads are listening on %s.")
		:format(summary, Config.Gateway.url))
]]></string>
