          <string name="Source"><![CDATA[--!strict
-- ArtifactLore — dwarven artifact naming + strange-mood histories for the
-- estate's items. UPGRADED from the raws mine (corpus/df_mine/): real
-- dictionary entries with POS tags from language_words.txt (CP437 decoded),
-- compounds now POS-legal per DF law: ADJ+NOUN or NOUN+NOUN.
-- Source: dwarffortresswiki.org + the local install's vanilla_languages raws.
-- Provenance (reconciled 2026-09-25, gala t4): the 130-entry DWARVEN pool is
-- folded from corpus/df_mine/df_lexicon_full.json (dwarf key), POS via the
-- language_words.txt join; 130/130 entries verified word+POS grounded.
-- tools/df_words.json (41 entries) is the superseded wiki-era bank
-- (commit 65c4af34a), kept as an era receipt only; no code reads it.

local ArtifactLore = {}

export type Word = { gloss: string, dw: string, pos: string }


-- BEGIN GENERATED by tools/gen_artifact_lore.py from corpus/df_mine/df_lexicon_full.json (dwarf key) -- do not hand-edit.
-- Regenerate: .venv/Scripts/python.exe tools/gen_artifact_lore.py
local DWARVEN: { Word } = {
	{ gloss = "anvil", dw = "zuntîr", pos = "noun" },
	{ gloss = "ash", dw = "ibruk", pos = "noun" },
