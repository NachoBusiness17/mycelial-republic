    <Item class="ModuleScript" referent="33">
      <Properties>
        <string name="Name">AbilitySlots</string>
        <string name="Source"><![CDATA[--!strict
-- AbilitySlots — Blox Fruits pattern: four abilities on Z / X / C / V with
-- server-validated cooldowns, active windows as player attributes that zones
-- read (Fire pellets, Thumper tosses, Wing Chun parry, Count reveals).
-- Input arrives from the client over the Ability remote; carrying stolen
-- goods (Steal-a penalty) disables every slot.

local Players = game:GetService("Players")

local AbilitySlots = {}

export type Ability = {
	name: string,
	attribute: string,
	window: number,
	cooldown: number,
}

local REGISTRY: { Ability } = {
	{ name = "Fire",             attribute = "Abil_Fire",     window = 0.15, cooldown = 0.25 },
	{ name = "ThumperToss",      attribute = "Abil_Thumper",  window = 0.15, cooldown = 10 },
	{ name = "WingChunRedirect", attribute = "Abil_Redirect", window = 1.5,  cooldown = 8 },
	{ name = "Count",            attribute = "Abil_Count",    window = 3,    cooldown = 20 },
}

local lastUse: { [Player]: { [string]: number } } = {}

function AbilitySlots.registry(): { Ability }
	return REGISTRY
end

function AbilitySlots.bind(remote: RemoteEvent)
	remote.OnServerEvent:Connect(function(player: Player, name: string)
		local ab: Ability? = nil
		for _, a in ipairs(REGISTRY) do
			if a.name == name then ab = a end
		end
		if not ab then return end
		if player:GetAttribute("Carrying") == true then
			return -- gear disabled while carrying stolen goods
		end
		local now = os.clock()
		local t = (lastUse[player] and lastUse[player][ab.name]) or -math.huge
		if now - t < ab.cooldown then return end -- server owns the cooldown clock
		lastUse[player] = lastUse[player] or {}
		lastUse[player][ab.name] = now
		player:SetAttribute(ab.attribute, true)
		task.delay(ab.window, function()
			if player.Parent then
				player:SetAttribute(ab.attribute, false)
			end
		end)
	end)
end

function AbilitySlots.init()
	Players.PlayerAdded:Connect(function(player: Player)
		lastUse[player] = {}
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastUse[player] = nil
	end)
end

return AbilitySlots
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="34">
      <Properties>
        <string name="Name">ArrakisZone</string>
        <string name="Source"><![CDATA[--!strict
-- ArrakisZone — the riding sim. Translated from arrakis.html laws:
-- "speed is score · spice chains are the line · crests are arcs · the Maker
-- hunts the fast · E drops a thumper (3) · the slow are safe and the safe are poor"
-- Touch a gate to bank everything. Spice chained without stopping = LINE xN.

local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Config = require(Shared:WaitForChild("Config"))
local ShadowLedger = require(script.Parent:WaitForChild("ShadowLedger"))

local ArrakisZone = {}
local origin = Vector3.new(120, 8, -120)
local SIZE = 220

local spawners: { () -> () } = {}

local function spawnSpice()
	local s = Instance.new("Part")
	s.Shape = Enum.PartType.Ball
	s.Size = Vector3.new(2.5, 2.5, 2.5)
	s.Color = Color3.fromRGB(200, 120, 60)
	s.Material = Enum.Material.Neon
	s.Position = origin + Vector3.new(math.random(-SIZE/2, SIZE/2), 4, math.random(-SIZE/2, SIZE/2))
	s.Name = "Spice"
	s.Parent = workspace
	s.Touched:Connect(function(hit)
		local player = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
		if player then
			-- chain: picking spice without banking keeps the LINE growing
			player:SetAttribute("SpiceChain", tonumber((player:GetAttribute("SpiceChain")) or 0) + 1)
			s:Destroy()
		end
	end)
	task.delay(45, function() if s.Parent then s:Destroy() end end)
end

local function spawnGate()
	local g = Instance.new("Part")
	g.Anchored = true
	g.Size = Vector3.new(4, 14, 2)
	g.Color = Color3.fromRGB(90, 200, 140)
	g.Material = Enum.Material.Neon
	g.Position = origin + Vector3.new(math.random(-SIZE/2 + 20, SIZE/2 - 20), 8, math.random(-SIZE/2 + 20, SIZE/2 - 20))
	g.Name = "BankGate"
	g.Parent = workspace
	g.Touched:Connect(function(hit)
		local player = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
		if not player then return end
		local chain = tonumber(player:GetAttribute("SpiceChain")) or 0
		if chain > 0 then
			-- bank: LINE xN (chain is the multiplier); speed-driven score banks here
			local speed = tonumber(player:GetAttribute("TopSpeed")) or 0
			local banked = math.floor(chain * 25 + speed * 5)
			player:SetAttribute("ArrakisBanked", tonumber((player:GetAttribute("ArrakisBanked")) or 0) + banked)
			ShadowLedger.record(player, "Arrakis", string.format("banked LINE x%d at a gate (%d)", chain, banked), true)
			player:SetAttribute("SpiceChain", 0)
		end
	end)
	task.delay(60, function() if g.Parent then g:Destroy() end end)
end

function ArrakisZone.build(): Model
	local model = Instance.new("Model")
	model.Name = "Arrakis"

	-- dune sea
	local sand = Instance.new("Part")
	sand.Anchored = true
	sand.Size = Vector3.new(SIZE, 1, SIZE)
	sand.Position = Vector3.new(origin.X, origin.Y - 1, origin.Z)
	sand.Color = Color3.fromRGB(196, 156, 96)
	sand.Material = Enum.Material.Sand
	sand.Parent = model

	-- crest ramps: cross them fast and you FLY
	for i = 1, 5 do
		local crest = Instance.new("Part")
		crest.Anchored = true
		crest.Size = Vector3.new(20, 1, 12)
		crest.CFrame = CFrame.new(origin + Vector3.new(math.random(-80, 80), 2, math.random(-80, 80)))
			* CFrame.Angles(math.rad(-18), math.rad(math.random(0, 360)), 0)
		crest.Color = Color3.fromRGB(170, 130, 80)
		crest.Material = Enum.Material.Sand
		crest.Parent = model
	end

	-- the board: a VehicleSeat sled
	local board = Instance.new("Part")
	board.Anchored = false
	board.Size = Vector3.new(4, 0.6, 8)
	board.Color = Color3.fromRGB(60, 60, 70)
	board.Position = origin + Vector3.new(0, 2, 0)
	board.Name = "RiderBoard"
	local seat = Instance.new("VehicleSeat")
	seat.Size = Vector3.new(2, 0.4, 2)
	seat.Position = Vector3.new(0, 0.6, 0)
	seat.MaxSpeed = 60
	seat.Parent = board
	local force = Instance.new("VectorForce")
	force.Attachment0 = Instance.new("Attachment", board)
	force.Force = Vector3.new(0, workspace.Gravity * 0.92, 0) -- near-hover: speed is score
	force.Parent = board
	board.Parent = model

	-- thumper station: E-equivalent prompt, 3 charges, sends the Maker elsewhere
	local station = Instance.new("Part")
	station.Anchored = true
	station.Size = Vector3.new(6, 6, 6)
	station.Position = origin + Vector3.new(0, 4, -30)
	station.Color = Color3.fromRGB(120, 90, 60)
	station.Parent = model
	local thumper = Instance.new("ProximityPrompt")
	thumper.ActionText = "Drop a thumper (3)"
	thumper.ObjectText = "thumper station"
	thumper.HoldDuration = 0.5
	thumper.Parent = station
	thumper.Triggered:Connect(function(player: Player)
		local charges = tonumber(player:GetAttribute("Thumpers")) or Config.Arrakis.thumperCharges
		if charges <= 0 then return end
		player:SetAttribute("Thumpers", charges - 1)
		local t = Instance.new("Part")
		t.Anchored = true
		t.Size = Vector3.new(2, 4, 2)
		t.Color = Color3.fromRGB(230, 90, 50)
		t.Material = Enum.Material.Neon
		t.Position = origin + Vector3.new(math.random(-90, 90), 3, math.random(-90, 90))
		t.Name = "Thumper"
		t.Parent = workspace
		ArrakisZone.retargetMaker(t.Position)
		task.delay(20, function() if t.Parent then t:Destroy() end end)
	end)

	table.insert(spawners, spawnSpice)
	model.Parent = workspace
	return model
end

-- the Maker hunts the fast — but NEVER without a telegraph (the Doors law:
-- Rush does not hit before the lights die). 2s of rumble column, then breach.
local maker: BasePart? = nil
local makerTarget: Vector3? = nil
local telegraphPart: BasePart? = nil
local telegraphUntil = 0

function ArrakisZone.retargetMaker(pos: Vector3)
	makerTarget = pos
end

local function beginTelegraph(pos: Vector3)
	if telegraphPart and telegraphPart.Parent then telegraphPart:Destroy() end
	local col = Instance.new("Part")
	col.Anchored = true
	col.Size = Vector3.new(6, 60, 6)
	col.Position = pos + Vector3.new(0, 30, 0)
	col.Color = Color3.fromRGB(200, 60, 40)
	col.Material = Enum.Material.Neon
	col.Transparency = 0.55
	col.CanCollide = false
	col.Name = "MakerTelegraph"
	col.Parent = workspace
	telegraphPart = col
	telegraphUntil = os.clock() + 2
	makerTarget = nil
end

function ArrakisZone.tick(dt: number)
	for _, f in ipairs(spawners) do
		if math.random() < dt * 0.5 then f() end
	end
	if math.random() < dt * 0.08 then spawnGate() end

	if not maker then
		local m = Instance.new("Part")
		m.Shape = Enum.PartType.Ball
		m.Size = Vector3.new(14, 14, 14)
		m.Color = Color3.fromRGB(150, 90, 50)
		m.Material = Enum.Material.Sand
		m.Position = origin + Vector3.new(0, -6, -100)
		m.Name = "THE MAKER"
		m.Parent = workspace
		maker = m
	end

	-- X ability: ThumperToss drops a thumper at the thrower's feet
	for _, p in ipairs(Players:GetPlayers()) do
		if p:GetAttribute("Abil_Thumper") then
			local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local t = Instance.new("Part")
				t.Anchored = true
				t.Size = Vector3.new(2, 4, 2)
				t.Color = Color3.fromRGB(230, 90, 50)
				t.Material = Enum.Material.Neon
				t.Position = root.Position + Vector3.new(0, 1, 0)
				t.Name = "Thumper"
				t.Parent = workspace
				ArrakisZone.retargetMaker(t.Position)
				task.delay(20, function() if t.Parent then t:Destroy() end end)
			end
		end
	end

	if maker then
		-- breach cycle: telegraph 2s, then lunge
		if telegraphUntil > 0 then
			if os.clock() >= telegraphUntil then
				-- THE BREACH: lunge to the marked point, knock up anyone near it
				local breachPos = telegraphPart and telegraphPart.Position - Vector3.new(0, 30, 0)
				if breachPos and maker then
					maker.Position = breachPos - Vector3.new(0, 4, 0)
				end
				for _, p in ipairs(Players:GetPlayers()) do
					local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
					if root and breachPos and (root.Position - breachPos).Magnitude < 14 then
						root.AssemblyLinearVelocity = Vector3.new(0, 70, 0) -- the arc of the breach
					end
				end
				if telegraphPart and telegraphPart.Parent then telegraphPart:Destroy() end
				telegraphPart = nil
				telegraphUntil = 0
			end
		else
		local fastest, speed = nil, 20 -- below 20 the slow are safe
		for _, p in ipairs(Players:GetPlayers()) do
			local s = tonumber(p:GetAttribute("TopSpeed")) or 0
			if s > speed then fastest, speed = p, s end
		end
		local goal = makerTarget or (fastest and fastest.Character
			and fastest.Character:FindFirstChild("HumanoidRootPart") and (fastest.Character:FindFirstChild("HumanoidRootPart") :: BasePart).Position)
			or origin
			if makerTarget then
				makerTarget = nil
			elseif fastest and math.random() < dt * 0.1 then
				beginTelegraph(goal) -- fair horror: you get two seconds of red column
			end
			local dir = (goal - maker.Position)
			if dir.Magnitude > 4 then
				maker.AssemblyLinearVelocity = dir.Unit * 18
			end
		end
	end
end

return ArrakisZone
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="35">
      <Properties>
        <string name="Name">CathedralPlate</string>
        <string name="Source"><![CDATA[--!strict
-- CathedralPlate  -  THE CATHEDRAL made walkable (eigen-map card, candidate
-- two). The plate's beacon positions ARE the scan's eigen_centroids via
-- shared/CathedralMap.toWorld (single authorship: this file owns no
-- coordinates). Edge policy comes from CathedralMap.chainEdges/hubEdges: the
-- water_first chain over SADDLE-SADDLE legs only  -  no drawn edge anchors on
-- the DARK riddler_engram (referee ruling, watch/inbox/REFEREE_VERDICT_20260926.md
-- missing-edge section); the DARK anchor stands isolated by design.
-- Every beacon touch lands a ShadowLedger row with the walker's live eigen
-- position, so the walk itself files position/distance evidence.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Modules")
local CathedralMap = require(Shared:WaitForChild("CathedralMap"))
local ShadowLedger = require(script.Parent:WaitForChild("ShadowLedger"))

local CathedralPlate = {}

local FLOOR = Color3.fromRGB(28, 26, 34)
local INK = Color3.fromRGB(230, 224, 196)

local function mk(size: Vector3, pos: Vector3, color: Color3, mat: Enum.Material, collide: boolean?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.Position = pos
	p.Color = color
	p.Material = mat
	p.CanCollide = collide ~= false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = workspace
	return p
end

local function label(part: Part, lines: { string }, color: Color3, studY: number, width: number)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, width, 0, 16 * #lines)
	bb.StudsOffset = Vector3.new(0, studY, 0)
	bb.AlwaysOnTop = false
	bb.MaxDistance = 220
	local prev = 0
	for _, line in ipairs(lines) do
		local t = Instance.new("TextLabel")
		t.Size = UDim2.new(1, 0, 1 / #lines, 0)
		t.Position = UDim2.new(0, 0, prev, 0)
		prev += 1 / #lines
		t.BackgroundTransparency = 1
		t.Font = Enum.Font.Code
		t.TextSize = 13
		t.TextColor3 = color
		t.Text = line
		t.Parent = bb
	end
	bb.Parent = part
end

-- strip from a to b at height y: length on the Z axis, aimed with lookAt
local function strip(a: Vector3, b: Vector3, y: number, color: Color3, w: number, h: number, transparency: number): Part
	local aa = Vector3.new(a.X, y, a.Z)
	local bb2 = Vector3.new(b.X, y, b.Z)
	local len = (bb2 - aa).Magnitude
	local s = mk(Vector3.new(w, h, len), Vector3.zero, color, Enum.Material.Neon, false)
	s.CFrame = CFrame.lookAt((aa + bb2) / 2, bb2)
	s.Transparency = transparency
	return s
end

local chainStrips: { Part } = {}
local clock = 0.0
local lastTouch: { [string]: number } = {}

-- portal landing: NORTH of the floor (derived, never hand-set)
function CathedralPlate.entry(): Vector3
	local center = CathedralMap.plateCenter()
	local size = CathedralMap.plateSize()
	return center + Vector3.new(0, 0, -(size.Z / 2 + 8))
end

function CathedralPlate.build()
	-- the floor: one plate covering every beacon + margin (geometry derived)
	local center = CathedralMap.plateCenter()
	local size = CathedralMap.plateSize()
	local floor = mk(size, center, FLOOR, Enum.Material.Slate, true)
	floor.Name = "CathedralPlate_Floor"
	label(floor, { "THE CATHEDRAL  -  the world map from eigen_centroids", "north = -Z = eigen -y · scan 2026-09-27" }, INK, 6, 420)

	-- region beacons at their eigen positions
	for _, region in ipairs(CathedralMap.regions()) do
		local pos = CathedralMap.toWorld(region)
		local cls = CathedralMap.class(region)
		local color = CathedralMap.classColor(cls)

		local plinth = mk(Vector3.new(5, 1, 5), pos + Vector3.new(0, 1, 0), FLOOR, Enum.Material.Slate, true)
		plinth.Name = ("CathedralBeacon_%s"):format(region)
		mk(Vector3.new(1.6, 12, 1.6), pos + Vector3.new(0, 7.5, 0), color, Enum.Material.Neon, false)
		local orb = Instance.new("Part")
		orb.Anchored = true
		orb.Shape = Enum.PartType.Ball
		orb.Size = Vector3.new(4, 4, 4)
		orb.Position = pos + Vector3.new(0, 16.5, 0)
		orb.Color = color
		orb.Material = Enum.Material.Neon
		orb.CanCollide = false
		orb.Parent = workspace
		orb.Name = ("CathedralOrb_%s"):format(region)

		local cos = CathedralMap.cos(region)
		local c = CathedralMap.centroid(region) or { 0, 0 }
		local cosLine = "cos null (off-manifold)"
		if cos then
			cosLine = string.format("builder cos %.3f", cos)
		end
		label(orb, {
			("%s [%s]"):format(region, cls),
			cosLine,
			string.format("eigen (%.4f, %.4f)", c[1], c[2]),
		}, color, 4, 190)

		-- the walk files its own position rows: touch = a measured arrival
		plinth.Touched:Connect(function(hit: BasePart)
			local player = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
			if not player then
				return
			end
			local key = ("%d:%s"):format(player.UserId, region)
			local now = os.clock()
			if now - (lastTouch[key] or -math.huge) < 5 then
				return
			end
			lastTouch[key] = now
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local ex, ey = CathedralMap.worldToEigen(root.Position)
				ShadowLedger.record(player, "The Cathedral", ("reached %s [%s] from eigen (%.4f, %.4f), %.4f away, bearing %.1f")
					:format(region, cls, ex, ey, CathedralMap.distFrom(ex, ey, region),
						CathedralMap.bearingFrom(ex, ey, region)))
			end
		end)
	end

	-- chain strips (operative lean) + hub strips (contested alternate, faint)
	for _, e in ipairs(CathedralMap.chainEdges()) do
		table.insert(chainStrips, strip(CathedralMap.toWorld(e.a), CathedralMap.toWorld(e.b), 11,
			Color3.fromRGB(179, 86, 44), 1.4, 0.35, 0.1))
	end
	for _, e in ipairs(CathedralMap.hubEdges()) do
		strip(CathedralMap.toWorld(e.a), CathedralMap.toWorld(e.b), 10.4,
			Color3.fromRGB(138, 127, 176), 0.9, 0.25, 0.55)
	end

	-- entry plaque: the vote, honestly stated
	local plaque = mk(Vector3.new(10, 1, 6), center + Vector3.new(0, 1.2, size.Z / 2 - 8), FLOOR, Enum.Material.Wood, true)
	plaque.Name = "CathedralPlate_Plaque"
	label(plaque, {
		"descent vote: water_first chain 0.031 vs hub star 0.036 (eigen units)",
		"a VOTE, not a verdict  -  RIB descent-order stays CONTESTED",
		"no edge touches the DARK anchor (riddler_engram); it stands alone",
	}, INK, 5, 420)

	print(("[CathedralPlate] built: %d beacons, %d chain strips, %d hub strips")
		:format(#CathedralMap.regions(), #CathedralMap.chainEdges(), #CathedralMap.hubEdges()))
end

function CathedralPlate.tick(dt: number)
	-- the chain breathes; the hub does not (it is the contested alternate)
	clock += dt
	local pulse = 0.1 + 0.12 * (math.sin(clock * 2) + 1) / 2
	for _, s in ipairs(chainStrips) do
		s.Transparency = pulse
	end
end

return CathedralPlate
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="36">
      <Properties>
        <string name="Name">HeadMuseum</string>
        <string name="Source"><![CDATA[--!strict
-- HeadMuseum — the museum of the fleet's minds. One building at Basecamp,
-- one pedestal per persona, one head each. Talking to a head = one turn of
-- one seat over the NpcGateway (which rides the free stealth lanes).
-- The estate's first interactive exhibit of itself: the static gallery
-- (viz, particles, lattice) becomes rooms later; the heads come first.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Lore = require(Shared:WaitForChild("Lore"))
local Trove = require(Shared:WaitForChild("Trove"))
local NpcGateway = require(script.Parent:WaitForChild("NpcGateway"))
local Soul = require(Shared:WaitForChild("Soul")) -- was a second full service chain; Shared resolves the module type
local DataStoreService = game:GetService("DataStoreService")

local HeadMuseum = {}
local origin = Vector3.new(60, 4, 0) -- east of Basecamp center
local souls: { [string]: Soul.Soul } = {}

-- ---- soul persistence (the owed Soul.luau wiring) ----
-- DF two-stage law holds in the store: only LEDGER ROWS (emotions naming
-- their cause) and needs persist; stress and mood derive at read time and
-- are never stored as truth. One DataStore key per head.
local SOUL_STORE = "HeadMuseumSouls_v1"
local SOUL_ROWS_MAX = 60 -- the ledger keeps its most recent rows
local FLUSH_PERIOD = 30
local soulStore = DataStoreService:GetDataStore(SOUL_STORE)
-- History (receipts, negative first-class): the souls table (line 16) was
-- always Soul.Soul; the "Unknown type 'Soul.Soul'" at 16,26 was the gate's
-- repo-root analyze phantom (module files unloadable from the wrong cwd),
-- root-caused by t1d and fixed in the gate by t24 (runs 1-4, repo-root 4
-- errors vs exit 0 from roblox/; receipt:
-- watch/inbox/gala_20260925/afterparty/lanes/t1d.check.txt). That phantom was
-- the only reason these were any; with the cwd fix landed, t30 pays the owed
-- tightening (dirty table + soul params -> Soul.Soul), verified exit 0 by
-- module analyze of this file from roblox/ 2026-09-26.
local dirty: { [string]: Soul.Soul } = {}

local function soulKey(id: string): string
	return ("soul_%s"):format(id)
end

local function serialize(soul: Soul.Soul)
	local rows = {}
	local first = math.max(1, #soul.emotions - SOUL_ROWS_MAX + 1)
	for i = first, #soul.emotions do
		table.insert(rows, soul.emotions[i])
	end
	return { emotions = rows, needs = soul.needs }
end

local function flushSoul(id: string, soul: Soul.Soul)
	local ok, err = pcall(function()
		soulStore:SetAsync(soulKey(id), serialize(soul))
	end)
	if not ok then
		warn(("[HeadMuseum] soul flush failed for %s: %s"):format(id, tostring(err)))
	end
end

local function restoreSoul(id: string, soul: Soul.Soul)
	local ok, data = pcall(function()
		return soulStore:GetAsync(soulKey(id))
	end)
	if not ok then
		-- no saved ledger reachable (Studio without API access, throttle):
		-- the head starts with an empty ledger and says so; rows are never faked
		warn(("[HeadMuseum] soul load failed for %s: %s"):format(id, tostring(data)))
		return
	end
	if type(data) ~= "table" then return end -- a first-visit head: empty ledger is honest
	for _, row in ipairs(data.emotions or {}) do
		if type(row) == "table" and type(row.thought) == "string" then
			table.insert(soul.emotions, {
				thought = row.thought,
				emotion = tostring(row.emotion),
				strength = tonumber(row.strength) or 0,
				year = tonumber(row.year) or 0,
				synthetic = row.synthetic == true,
			})
		end
	end
	for _, need in ipairs(data.needs or {}) do
		if type(need) == "table" and type(need.id) == "string" then
			Soul.addNeed(soul, need.id)
			for _, n in ipairs(soul.needs) do
				if n.id == need.id then
					n.focus = math.clamp(tonumber(need.focus) or 0, -10000, 400)
				end
			end
		end
	end
end

local function plaque(text: string, pos: Vector3): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = Vector3.new(6, 2, 0.4)
	p.Position = pos
	p.Color = Color3.fromRGB(24, 22, 30)
	p.Material = Enum.Material.Slate
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.PixelsPerStud = 24
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.TextWrapped = true
	lbl.TextColor3 = Color3.fromRGB(220, 214, 190)
	lbl.Font = Enum.Font.Garamond
	lbl.TextSize = 14
	lbl.Text = text
	lbl.Parent = gui
	gui.Parent = p
	return p
end

function HeadMuseum.build(): Model
	local museum = Instance.new("Model")
	museum.Name = "HeadMuseum"

	local floor = Instance.new("Part")
	floor.Anchored = true
	floor.Size = Vector3.new(60, 1, 40)
	floor.Position = origin + Vector3.new(0, -0.5, 0)
	floor.Color = Color3.fromRGB(30, 28, 36)
	floor.Material = Enum.Material.Marble
	floor.Parent = museum

	for i, spec in ipairs(Lore.Heads) do
		local angle = (i / #Lore.Heads) * math.pi * 2
		local pos = origin + Vector3.new(math.cos(angle) * 20, 2, math.sin(angle) * 12)

		local pedestal = Instance.new("Part")
		pedestal.Anchored = true
		pedestal.Size = Vector3.new(3, 3, 3)
		pedestal.Position = pos
		pedestal.Color = Color3.fromRGB(38, 34, 46)
		pedestal.Material = Enum.Material.Marble
		pedestal.Parent = museum

		local skull = Instance.new("Part")
		skull.Anchored = true
		skull.Shape = Enum.PartType.Ball
		skull.Size = Vector3.new(2.4, 2.4, 2.4)
		skull.Position = pos + Vector3.new(0, 2.7, 0)
		skull.Color = Color3.fromRGB(206, 198, 178)
		skull.Material = Enum.Material.SmoothPlastic
		skull.Parent = museum

		local billboard = Instance.new("BillboardGui")
		billboard.Size = UDim2.new(0, 240, 0, 56)
		billboard.StudsOffset = Vector3.new(0, 2.4, 0)
		billboard.AlwaysOnTop = true
		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.fromScale(1, 1)
		lbl.BackgroundTransparency = 1
		lbl.TextWrapped = true
		lbl.Text = spec.name
		lbl.TextColor3 = Color3.fromRGB(230, 224, 196)
		lbl.Font = Enum.Font.Garamond
		lbl.TextSize = 16
		lbl.Parent = billboard
		billboard.Parent = skull

		plaque(spec.seat, pos + Vector3.new(0, -1.2, 2.4)).Parent = museum

		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Speak"
		prompt.ObjectText = spec.name
		prompt.HoldDuration = 0.3
		prompt.MaxActivationDistance = 10
		prompt.Parent = skull

		-- each head carries a unit_soul: visits are emotion rows naming their
		-- cause; the ledger persists to the DataStore (loaded async below)
		souls[spec.id] = souls[spec.id] or Soul.new()
		Soul.addNeed(souls[spec.id], "witnesses")
		task.spawn(restoreSoul, spec.id, souls[spec.id])

		prompt.Triggered:Connect(function(player: Player)
			local soul = souls[spec.id]
			Soul.record(soul, player.Name .. " came to listen", "gratitude", 120, os.time())
			Soul.decayNeeds(soul, 30)
			dirty[spec.id] = soul -- flushed on the period below (and at close)
			local reply, isLive = NpcGateway.ask(spec.id, player.Name, "(approach)", "the Head Museum")
			lbl.Text = reply
			if isLive then
				-- give the answer time to be read, then return to the nameplate
				task.delay(14, function()
					lbl.Text = spec.name
				end)
			end
		end)
	end

	museum.Parent = workspace

	-- flush dirty ledgers on a slow clock, and once more at server close.
	-- Q-043 Trove pass: the loop is OWNED by the museum's lifetime
	-- (AttachToInstance -> Destroying -> Clean cancels the thread) instead of
	-- polling museum.Parent. Cadence is identical: dirty starts empty, so the
	-- Loop body's immediate first run flushes nothing, exactly like the old
	-- wait-first first cycle.
	local trove = Trove.new()
	trove:AttachToInstance(museum)
	trove:Loop(FLUSH_PERIOD, function()
		for id, soul in pairs(dirty) do
			dirty[id] = nil
			flushSoul(id, soul)
		end
	end)
	game:BindToClose(function()
		for id, soul in pairs(dirty) do
			dirty[id] = nil
			flushSoul(id, soul)
		end
	end)

	return museum
end

return HeadMuseum
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="37">
      <Properties>
        <string name="Name">LedgerExchange</string>
        <string name="Source"><![CDATA[--!strict
-- LedgerExchange — the Steal-a economy, cloned 1:1 onto the estate (numbers
-- and sources in docs/CLONED_MECHANICS.md §3.1). The Marble Run conveyor
-- spawns artifacts; buy with Virtue Marks; slots tick income; steal from an
-- unlocked neighbor's alcove and run it home under the full carry penalty;
-- lock your alcove from the Counting Circle; rebirth at 5,000 VM.
--
--   rarities: common 50 VM / +1 per 10s · rare 200 / +5 · epic 800 / +20 · legendary 3000 / +80
--   slots 4 (+2 per rebirth) · lock 60s (+10s per rebirth) · shield 1 per 5 min
--   carry penalty: speed x0.6, abilities disabled, owner notified, +10s their lock
--   rebirth 5000 VM: slots reset, x1.5 income, pet orb hatched (swarm auto-collect)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Modules")
local SeedRng = require(Shared:WaitForChild("SeedRng"))
local ArtifactLore = require(Shared:WaitForChild("ArtifactLore"))
local DfValue = require(Shared:WaitForChild("DfValue"))
local Trove = require(Shared:WaitForChild("Trove"))
local ServerScriptService = game:GetService("ServerScriptService")
local ShadowLedger = require(ServerScriptService:WaitForChild("ShadowLedger"))

local LedgerExchange = {}
local CONVEYOR_Z, RAIL_HALF = 96, 42
local RNG = SeedRng.new(20260924)

local ARTIFACTS = {
	{ name = "Chair Nail",           rarity = "common",    cost = 50,   income = 1,  color = Color3.fromRGB(160, 140, 100) },
	{ name = "Salt Scraps",          rarity = "common",    cost = 50,   income = 1,  color = Color3.fromRGB(220, 220, 210) },
	{ name = "Vellum's Pen",         rarity = "rare",      cost = 200,  income = 5,  color = Color3.fromRGB(200, 180, 90) },
	{ name = "Bard's Lyre",          rarity = "rare",      cost = 200,  income = 5,  color = Color3.fromRGB(140, 170, 220) },
	{ name = "Locked Eye",           rarity = "epic",      cost = 800,  income = 20, color = Color3.fromRGB(170, 60, 200) },
	{ name = "A page of the Answer", rarity = "legendary", cost = 3000, income = 80, color = Color3.fromRGB(240, 240, 250) },
}

local SLOTS_BASE, LOCK_BASE, LOCK_PER_REBIRTH, REBIRTH_AT = 4, 60, 10, 5000
local pads: { [Player]: BasePart } = {}
local lockUntil: { [Player]: number } = {}

local function slots(player: Player): number
	return SLOTS_BASE + 2 * tonumber((player:GetAttribute("Rebirths")) or 0)
end

local function firstFreeSlot(player: Player): number?
	for slot = 1, slots(player) do
		if not player:GetAttribute(("Slot%d"):format(slot)) then return slot end
	end
	return nil
end

local function stashArtifact(player: Player, name: string, income: number, dfValue: number?)
	local slot = firstFreeSlot(player)
	if not slot then return false end
	player:SetAttribute(("Slot%d"):format(slot), income)
	player:SetAttribute(("Slot%dName"):format(slot), name)
	-- the dwarven appraisal rides the slot (DF value law); bought pieces carry
	-- it, run-home steals re-carry it so the appraisal survives resale
	if dfValue then
		player:SetAttribute(("Slot%dDf"):format(slot), dfValue)
	end
	return true
end

-- ---- the Marble Run ----
local function spawnOnConveyor()
	local spec = ARTIFACTS[RNG:int(1, #ARTIFACTS)]
	local a = Instance.new("Part")
	a.Size = Vector3.new(2.4, 2.4, 2.4)
	a.Color = spec.color
	a.Material = (spec.rarity == "legendary") and Enum.Material.Neon or Enum.Material.SmoothPlastic
	a.Position = Vector3.new(-RAIL_HALF, 5, CONVEYOR_Z)
	a.Name = "Artifact"
	a:SetAttribute("ArtifactName", spec.name)
	a:SetAttribute("ArtifactCost", spec.cost)
	a:SetAttribute("ArtifactIncome", spec.income)

	-- dwarven lore (DF wiki mine, LINKS-341): every artifact carries a real
	-- dwarven compound name and a strange-mood history line
	local dwName = ArtifactLore.name(RNG)
	local moodLine = ArtifactLore.moodLine(RNG, "the hall", spec.name)
	a:SetAttribute("ArtifactDwarven", dwName)

	-- DF value law (WORLDGEN_MINE.md #8): the dwarven appraisal rides every
	-- piece; the cloned VM cost above is untouched by it
	local appraisal = DfValue.appraise(RNG)
	a:SetAttribute("ArtifactDfValue", appraisal.value)
	a:SetAttribute("ArtifactDfText", appraisal.text)

	local bill = Instance.new("BillboardGui")
	bill.Size = UDim2.new(0, 150, 0, 66)
	bill.StudsOffset = Vector3.new(0, 2, 0)
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.TextWrapped = true
	t.Text = ("%s\n%s\n%d VM · +%d/10s\n%s"):format(spec.name, dwName, spec.cost, spec.income, appraisal.text)
	t.TextColor3 = spec.color
	t.Font = Enum.Font.Garamond
	t.TextSize = 11
	t.Parent = bill
	bill.Parent = a

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = ("Buy (%d VM)"):format(spec.cost)
	prompt.ObjectText = spec.name
	prompt.HoldDuration = 0.5
	prompt.Parent = a
	prompt.Triggered:Connect(function(player: Player)
		if a.Parent == nil then return end
		local vm = tonumber(player:GetAttribute("VirtueMarks")) or 0
		if vm < spec.cost then return end
		if not stashArtifact(player, spec.name, spec.income, appraisal.value) then return end -- alcove full
		player:SetAttribute("VirtueMarks", vm - spec.cost)
		a:Destroy()
		ShadowLedger.record(player, "Basecamp", ("bought %s — %s. %s"):format(spec.name, dwName, moodLine), true)
	end)

	a.Parent = workspace
	-- Q-043 Trove pass: the conveyor slide is owned by the artifact's lifetime
	-- (AttachToInstance -> Destroying -> Clean). The body ends the thread
	-- itself with a false return (past the rail, or the artifact bought and
	-- destroyed under it); a Clean cancel landing on this running thread is a
	-- pcall'd no-op, so the false return is always the real exit — nothing
	-- spins and nothing dies by age.
	local trove = Trove.new()
	trove:AttachToInstance(a)
	trove:Loop(0.1, function()
		if not a.Parent then return false end
		a.Position += Vector3.new(2, 0, 0)
		if a.Position.X > RAIL_HALF then
			a:Destroy()
			return false
		end
		return true
	end)
end

-- ---- alcoves ----
local function notify(player: Player, text: string)
	local pad = pads[player]
	if not pad then return end
	local old = pad:FindFirstChild("Notify")
	if old then old:Destroy() end
	local bill = Instance.new("BillboardGui")
	bill.Name = "Notify"
	bill.Size = UDim2.new(0, 220, 0, 34)
	bill.StudsOffset = Vector3.new(0, 8, 0)
	bill.AlwaysOnTop = true
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextColor3 = Color3.fromRGB(240, 120, 120)
	t.Font = Enum.Font.Garamond
	t.TextSize = 14
	t.Parent = bill
	bill.Parent = pad
	task.delay(5, function() if bill.Parent then bill:Destroy() end end)
end

local function buildAlcove(player: Player, index: number)
	local pos = Vector3.new((index - 5) * 24, 8, 40)

	local pad = Instance.new("Part")
	pad.Anchored = true
	pad.Size = Vector3.new(16, 0.5, 16)
	pad.Position = pos
	pad.Color = Color3.fromRGB(46, 42, 52)
	pad.Material = Enum.Material.Slate
	pad.Name = player.Name .. "_Alcove"
	pad:SetAttribute("Owner", player.Name)
	pad.Parent = workspace
	pads[player] = pad

	local circle = Instance.new("Part")
	circle.Anchored = true
	circle.Shape = Enum.PartType.Cylinder
	circle.Size = Vector3.new(0.4, 6, 6)
	circle.CFrame = CFrame.new(pos + Vector3.new(0, 0.6, 10)) * CFrame.Angles(0, 0, math.rad(90))
	circle.Color = Color3.fromRGB(230, 200, 60)
	circle.Material = Enum.Material.Neon
	circle.Parent = workspace

	local lock = Instance.new("ProximityPrompt")
	lock.ActionText = "Lock the alcove"
	lock.ObjectText = "the Counting Circle"
	lock.HoldDuration = 0.5
	lock.Parent = circle
	lock.Triggered:Connect(function(p: Player)
		if p ~= player then return end -- only the owner locks their own circle
		lockUntil[player] = os.clock() + LOCK_BASE + LOCK_PER_REBIRTH * tonumber((player:GetAttribute("Rebirths")) or 0)
	end)

	local rebirth = Instance.new("ProximityPrompt")
	rebirth.ActionText = ("REBIRTH (%d VM)"):format(REBIRTH_AT)
	rebirth.ObjectText = "fold your ledger"
	rebirth.HoldDuration = 3
	rebirth.Parent = circle

	rebirth.Triggered:Connect(function(p: Player)
		if p ~= player then return end
		if tonumber((p:GetAttribute("VirtueMarks")) or 0) < REBIRTH_AT then return end
		p:SetAttribute("VirtueMarks", tonumber((p:GetAttribute("VirtueMarks")) or 0) - REBIRTH_AT)
		p:SetAttribute("Rebirths", tonumber((p:GetAttribute("Rebirths")) or 0) + 1)
		p:SetAttribute("PetOrb", true) -- Pet-Sim wheel: the orb auto-grinds for you
		for slot = 1, 32 do
			p:SetAttribute(("Slot%d"):format(slot), nil)
		end
		ShadowLedger.record(p, "Basecamp", "rebirthed: the ledger folds, the alcove empties, an orb hatches", true)
		notify(p, "THE LEDGER FOLDS. SOMETHING SMALL HATCHES AND FOLLOWS YOU.")
	end)

	-- steal: take from an unlocked neighbor's pad
	local steal = Instance.new("ProximityPrompt")
	steal.ActionText = "Borrow (steal)"
	steal.ObjectText = player.Name .. "'s alcove"
	steal.HoldDuration = 1
	steal.MaxActivationDistance = 12
	steal.Parent = pad
	steal.Triggered:Connect(function(thief: Player)
		if thief == player then return end
		if (lockUntil[player] or 0) > os.clock() then return end -- locked: immune
		-- take the highest-income filled slot
		local bestSlot, bestIncome = nil, -1
		for slot = 1, slots(player) do
			-- type pin t66 (receipt: watch/inbox/gala_20260925/afterparty/lanes/t58.check.txt, LedgerExchange 217,13 + 217,62): GetAttribute reads unknown, stashArtifact writes income: number, tonumber is identity on a stored number. Runtime unchanged.
			local v = tonumber(player:GetAttribute(("Slot%d"):format(slot)))
			if v and v > bestIncome then bestSlot, bestIncome = slot, v end
		end
		if not bestSlot then return end -- nothing worth taking
		-- type pin t66 (receipt: t58.check.txt, LedgerExchange 228,86 + 229,73): Slot%dName is written as name: string, tostring is identity on a stored string, and the nil case already fell to "loot". Runtime unchanged.
		local name = tostring(player:GetAttribute(("Slot%dName"):format(bestSlot)) or "loot")
		local carriedDf = tonumber((player:GetAttribute(("Slot%dDf"):format(bestSlot)))) -- appraisal travels with the piece
		player:SetAttribute(("Slot%d"):format(bestSlot), nil)
		player:SetAttribute(("Slot%dDf"):format(bestSlot), nil)
		thief:SetAttribute("Carrying", true) -- speed x0.6 + abilities disabled (PlayerFeel/AbilitySlots read this)
		thief:SetAttribute("CarryingName", name)
		thief:SetAttribute("CarryingFrom", player.Name)
		thief:SetAttribute("CarryingDf", carriedDf)
		notify(player, ("THE %s TAKES YOUR %s. RUN THEM DOWN."):format(thief.Name:upper(), name:upper()))
		ShadowLedger.record(thief, "Basecamp", ("borrowed %s from %s"):format(name, player.Name))
	end)

	-- deposit / defense: touching your own pad drops the carrier
	pad.Touched:Connect(function(hit)
		local plr = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
		if not plr then return end
		if plr == player and plr:GetAttribute("Carrying") then
			local name = plr:GetAttribute("CarryingName") or "loot"
			-- the run-home income is the dwarven appraisal, banded 1..80
			-- (DfValue.vmIncome; a carry without an appraisal lands at the floor)
			local dfValue = tonumber((plr:GetAttribute("CarryingDf"))) or 0
			if stashArtifact(plr, name, DfValue.vmIncome(dfValue), dfValue > 0 and dfValue or nil) then
				plr:SetAttribute("Carrying", nil)
				plr:SetAttribute("CarryingName", nil)
				local victimName = plr:GetAttribute("CarryingFrom")
				local victim = victimName and Players:FindFirstChild(victimName)
				if victim then
					lockUntil[victim] = math.max(lockUntil[victim] or 0, os.clock()) + 10
					notify(victim, "YOUR LOCK TIME GREW WHILE THEY RAN.")
				end
				ShadowLedger.record(plr, "Basecamp", ("stashed %s at the alcove"):format(name), true)
			end
		end
	end)
end

-- ---- tick: conveyor + income ----
local tickAcc, spawnAcc = 0, 0

function LedgerExchange.tick(dt: number)
	spawnAcc += dt
	if spawnAcc >= 8 then
		spawnAcc = 0
		spawnOnConveyor()
	end
	tickAcc += dt
	if tickAcc >= 10 then
		tickAcc = 0
		for _, player in ipairs(Players:GetPlayers()) do
			local income = 0
			for slot = 1, slots(player) do
				local v = player:GetAttribute(("Slot%d"):format(slot))
				if v then income += v end
			end
			income = math.floor(income * (1.5 ^ tonumber((player:GetAttribute("Rebirths")) or 0)))
			player:SetAttribute("VirtueMarks", tonumber((player:GetAttribute("VirtueMarks")) or 0) + income)
			player:SetAttribute("ExchangeIncome", income)
		end
	end
end

function LedgerExchange.init()
	Players.PlayerAdded:Connect(function(player: Player)
		player:SetAttribute("VirtueMarks", 100) -- the tutorial's 100 cash, skinned
		buildAlcove(player, math.clamp(#Players:GetPlayers(), 1, 8))
	end)
	for _ = 1, 4 do
		spawnOnConveyor()
	end

	-- the Marble Run rail
	local rail = Instance.new("Part")
	rail.Anchored = true
	rail.Size = Vector3.new(RAIL_HALF * 2, 1, 4)
	rail.Position = Vector3.new(0, 3.5, CONVEYOR_Z)
	rail.Color = Color3.fromRGB(40, 36, 46)
	rail.Material = Enum.Material.DiamondPlate
	rail.Name = "TheMarbleRun"
	rail.Parent = workspace
end

return LedgerExchange
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="38">
      <Properties>
        <string name="Name">LightMazeZone</string>
        <string name="Source"><![CDATA[--!strict
-- LightMazeZone — reborn as the Flicker Tower (Tower of Hell format, see
-- docs/CLONED_MECHANICS.md §3.2): NO checkpoints, shared 8:00 round timer,
-- 8 sections drawn seeded from a pool of 5, bullies (wisps) at 4:00.
-- Falls cost seconds (RespawnTime=1, set in PlayerFeel).

local Players = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Modules")
local SeedRng = require(Shared:WaitForChild("SeedRng"))
local Trove = require(Shared:WaitForChild("Trove"))
local ShadowLedger = require(ServerScriptService:WaitForChild("ShadowLedger"))

local LightMazeZone = {}
local origin = Vector3.new(0, 40, 200)
local SECTIONS, ROUND_SECONDS, BULLY_AT = 8, 480, 240

local bridges: { { part: Part, period: number, phase: number } } = {}
local roundStart = os.clock()
local bulliesSpawned = false
local wisps: { BasePart } = {}

-- ---- the seeded section pool (the tower differs per round, replays are fair) ----
local function secLedges(base: Vector3, rng, model: Model): Vector3
	local top = base
	for i = 1, 4 do
		local p = Instance.new("Part")
		p.Anchored = true
		p.Size = Vector3.new(14, 1, 14)
		p.Position = base + Vector3.new(rng:int(-8, 8), i * 6, rng:int(-8, 8))
		p.Color = Color3.fromRGB(150, 180, 255)
		p.Material = Enum.Material.Neon
		p.Parent = model
		top = p.Position
	end
	return top + Vector3.new(0, 3, 0)
end

local function secFlickerBridges(base: Vector3, rng, model: Model): Vector3
	for i = 1, 4 do
		local b = Instance.new("Part")
		b.Anchored = true
		b.Size = Vector3.new(8, 0.5, 12)
		b.Position = base + Vector3.new(math.sin(i * 1.1) * 10, i * 6, -i * 10)
		b.Color = Color3.fromRGB(150, 180, 255)
		b.Material = Enum.Material.Neon
		b.Parent = model
		table.insert(bridges, { part = b, period = 2 + (i % 3), phase = rng:next() })
	end
	return base + Vector3.new(math.sin(4 * 1.1) * 10, 24, -40)
end

local function secSpinners(base: Vector3, rng, model: Model): Vector3
	for i = 1, 3 do
		local arm = Instance.new("Part")
		arm.Anchored = true
		arm.Size = Vector3.new(22, 1, 2)
		arm.Position = base + Vector3.new(0, i * 8, 0)
		arm.Color = Color3.fromRGB(220, 80, 90)
		arm.Material = Enum.Material.SmoothPlastic
		arm.Name = "KillArm"
		arm:SetAttribute("SpinSpeed", 40 + rng:int(0, 40))
		arm.Parent = model
		arm.Touched:Connect(function(hit)
			local plr = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
			local hum = plr and plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
			if hum then hum.Health = 0 end -- kill bricks are honest
		end)
	end
	return base + Vector3.new(0, 27, 0)
end

local function secWallHops(base: Vector3, rng, model: Model): Vector3
	local top = base
	for i = 1, 5 do
		local w = Instance.new("Part")
		w.Anchored = true
		w.Size = Vector3.new(2, 5, 12)
		w.Position = base + Vector3.new(rng:int(-6, 6), i * 5, -i * 4)
		w.Color = Color3.fromRGB(90, 90, 110)
		w.Parent = model
		top = w.Position
	end
	return top + Vector3.new(0, 4, 0)
end

local function secThinLedges(base: Vector3, rng, model: Model): Vector3
	local top = base
	for i = 1, 6 do
		local p = Instance.new("Part")
		p.Anchored = true
		p.Size = Vector3.new(2.5, 0.7, 2.5)
		p.Position = base + Vector3.new(rng:int(-10, 10), i * 4.5, rng:int(-10, 10))
		p.Color = Color3.fromRGB(200, 220, 160)
		p.Parent = model
		top = p.Position
	end
	return top + Vector3.new(0, 3, 0)
end

local SECTION_POOL = { secLedges, secFlickerBridges, secSpinners, secWallHops, secThinLedges }

-- ---- bullies: a wisp per player after 4:00 (ToH mutators, our skin) ----
local function spawnBully(target: Player)
	local root = target.Character and target.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return end
	local w = Instance.new("Part")
	w.Shape = Enum.PartType.Ball
	w.Size = Vector3.new(2, 2, 2)
	w.Material = Enum.Material.Neon
	w.Color = Color3.fromRGB(140, 60, 200)
	w.Position = root.Position + Vector3.new(0, 14, 0)
	w.CanCollide = false
	w.Parent = workspace
	table.insert(wisps, w)
	-- Q-043 Trove pass: the chase is OWNED by the wisp (AttachToInstance ->
	-- Destroying -> Clean cancels the thread), not by its 60s age. The 60s
	-- cap stays as game behavior but now enforces itself by destroying the
	-- wisp (the false return then ends the thread); an early destroy cancels
	-- the chase immediately instead of leaving it polling w.Parent for up to
	-- a minute.
	local t0 = os.clock()
	local trove = Trove.new()
	trove:AttachToInstance(w)
	trove:Loop(0.1, function()
		if not w.Parent then return false end
		if os.clock() - t0 >= 60 then
			w:Destroy()
			return false
		end
		local hum = target.Character and target.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hum then
			local dir = hum.Position - w.Position
			if dir.Magnitude > 2 then w.AssemblyLinearVelocity = dir.Unit * 11 end
		end
		return true
	end)
end

function LightMazeZone.build(): Model
	local model = Instance.new("Model")
	model.Name = "FlickerTower"

	-- the round seed is on the record: same seed, same tower, replayable
	local seed = tonumber(os.date("!%Y%m%d%H")) or 0
	local rng = SeedRng.new(seed)
	local cursor = origin

	for i = 1, SECTIONS do
		local builder = SECTION_POOL[rng:int(1, #SECTION_POOL)]
		cursor = builder(cursor, rng, model)
	end

	-- the summit: finishing banks into the ledger
	local summit = Instance.new("Part")
	summit.Anchored = true
	summit.Size = Vector3.new(16, 1, 16)
	summit.Position = cursor
	summit.Color = Color3.fromRGB(235, 230, 210)
	summit.Material = Enum.Material.Neon
	summit.Name = "TowerSummit"
	summit.Parent = model
	summit.Touched:Connect(function(hit)
		local plr = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
		if plr and not plr:GetAttribute(("Summit_%d"):format(roundStart)) then
			plr:SetAttribute(("Summit_%d"):format(roundStart), true)
			local remaining = math.max(0, math.floor(ROUND_SECONDS - (os.clock() - roundStart)))
			plr:SetAttribute("VirtueMarks", tonumber((plr:GetAttribute("VirtueMarks")) or 0) + 50)
			ShadowLedger.record(plr, "LightMaze", ("topped the Flicker Tower with %ds left"):format(remaining), true)
		end
	end)

	model.Parent = workspace
	return model
end

function LightMazeZone.tick(dt: number)
	local t = os.clock()

	-- flicker bridges: solid on the lit half of the cycle
	for _, b in ipairs(bridges) do
		local lit = ((t / b.period + b.phase) % 1) < 0.6
		b.part.Transparency = lit and 0.2 or 0.95
		b.part.CanCollide = lit
	end

	-- spinners turn
	for _, arm in ipairs(workspace:GetChildren()) do
		if arm.Name == "KillArm" then
			local speed = tonumber(arm:GetAttribute("SpinSpeed")) or 40
			arm.CFrame = arm.CFrame * CFrame.Angles(0, math.rad(speed) * dt, 0)
		end
	end

	-- the shared round: reset the tower on schedule, bullies at half time
	local elapsed = t - roundStart
	if not bulliesSpawned and elapsed >= BULLY_AT then
		bulliesSpawned = true
		for _, p in ipairs(Players:GetPlayers()) do
			spawnBully(p)
		end
	end
	if elapsed >= ROUND_SECONDS then
		roundStart = t
		bulliesSpawned = false
		table.clear(wisps)
		-- sections rebuild with the new hour's seed
		local old = workspace:FindFirstChild("FlickerTower")
		if old then old:Destroy() end
		table.clear(bridges)
		LightMazeZone.build()
	end
end

return LightMazeZone
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="39">
      <Properties>
        <string name="Name">Monetization</string>
        <string name="Source"><![CDATA[--!strict
-- Monetization — MarketplaceService wiring per ROBLOX_MONETIZATION_PLAN_20260924.md.
-- Pass IDs are filled in Studio after first publish; the table is the source of
-- truth so scripts keep working with id=0 (disabled) until then.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Config = require(Shared:WaitForChild("Config"))

local Monetization = {}
local ownedPass: { [string]: { [number]: boolean } } = {}

function Monetization.owns(player: Player, passKey: string): boolean
	local pass = Config.GamePasses[passKey]
	if not pass or not pass.id or pass.id == 0 then return false end -- unpublished SKU = free-disabled
	local cache = ownedPass[passKey]
	if cache and cache[player.UserId] ~= nil then return cache[player.UserId] end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.id)
	end)
	if not ok then return false end
	ownedPass[passKey] = ownedPass[passKey] or {}
	ownedPass[passKey][player.UserId] = owns
	return owns
end

function Monetization.invalidate(player: Player, passKey: string)
	if ownedPass[passKey] then ownedPass[passKey][player.UserId] = nil end
end

function Monetization.init()
	MarketplaceService.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		if not player then
			-- retry when they rejoin (Roblox will re-deliver)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		for key, prod in pairs(Config.DevProducts) do
			if prod.id ~= 0 and receipt.ProductId == prod.id then
				if key == "ExtraLife" then
					player:SetAttribute("ExtraLives", tonumber((player:GetAttribute("ExtraLives")) or 0) + 1)
				elseif key == "SkipVellum" then
					player:SetAttribute("SkipVellum", true)
				elseif key == "VirtueDoubler" then
					player:SetAttribute("VirtueDoublerUntil", os.time() + 3600)
				end
				return Enum.ProductPurchaseDecision.PurchaseGranted
			end
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	Players.PlayerRemoving:Connect(function(player)
		for _, cache in pairs(ownedPass) do cache[player.UserId] = nil end
	end)
end

return Monetization
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="40">
      <Properties>
        <string name="Name">MudBasecamp</string>
        <string name="Source"><![CDATA[--!strict
-- MudBasecamp — the Roshomon MUD as a place. Rooms = fleet systems (game_mud.v2),
-- exits = portal pads, and the two mechanics that make it ours:
--   survey — the party of AI heads witnesses the same scene; >=2 agree = CORE = loot
--   claim  — fold the room's core as an invariant (attribute + ledger row)
-- Plus the Hall of Shared Supper: Vellum's grant, the six chairs, the counting.
-- The hall files which you chose (ShadowLedger). Death speaks in CAPS.

local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Lore = require(Shared:WaitForChild("Lore"))
local Trove = require(Shared:WaitForChild("Trove"))
local ShadowLedger = require(script.Parent:WaitForChild("ShadowLedger"))
local NpcGateway = require(script.Parent:WaitForChild("NpcGateway"))
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Worldgen = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Worldgen"))
local SeedRng = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("SeedRng"))
local ProceduralBody = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("ProceduralBody"))
local Temptation = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Temptation"))

local MudBasecamp = {}
local origin = Vector3.new(0, 8, 0)
local roomPlots: { [string]: Vector3 } = {}
local CENTER = "the World-Memory"

-- chat relay (Q-037, the client remotes pass): say() rides the Chat remote to
-- the speaking player's HUD. Bound by init.server after the Remotes folder is
-- built; unbound say() keeps the Studio print so nothing depends on call order
-- (build() runs before the remotes exist at init).
local chatRelay: RemoteEvent? = nil

function MudBasecamp.bindChat(remote: RemoteEvent)
	chatRelay = remote
end

local function say(player: Player, text: string)
	print(("[Basecamp] %s hears: %s"):format(player.Name, text))
	local relay = chatRelay
	if relay then
		relay:FireClient(player, text)
	end
end

local function portalPad(fromRoom: string, toRoom: string, pos: Vector3): Part
	local pad = Instance.new("Part")
	pad.Anchored = true
	pad.Size = Vector3.new(6, 0.4, 6)
	pad.Position = pos
	pad.Color = Color3.fromRGB(90, 80, 140)
	pad.Material = Enum.Material.Neon
	pad.Name = ("To_%s"):format(toRoom)
	pad.Parent = workspace

	pad.Touched:Connect(function(hit)
		local char = hit.Parent
		local player = char and Players:GetPlayerFromCharacter(char)
		if player and char then
			local dest = roomPlots[toRoom]
			if dest then
				(char :: Model):PivotTo(CFrame.new(dest + Vector3.new(0, 4, 0)))
				ShadowLedger.record(player, "Basecamp", ("walked %s -> %s"):format(fromRoom, toRoom))
			end
		end
	end)
	return pad
end

local function buildRoom(name: string, pos: Vector3): Part
	local spec = Lore.Rooms[name]
	local floor = Instance.new("Part")
	floor.Anchored = true
	floor.Size = Vector3.new(44, 1, 44)
	floor.Position = pos
	floor.Color = (name == "the Hall of Shared Supper") and Color3.fromRGB(64, 50, 40) or Color3.fromRGB(28, 27, 34)
	floor.Material = Enum.Material.Slate
	floor.Name = ("Room_%s"):format(name)
	floor.Parent = workspace

	local plaque = Instance.new("Part")
	plaque.Anchored = true
	plaque.Size = Vector3.new(14, 5, 0.5)
	plaque.Position = pos + Vector3.new(0, 6, -21)
	plaque.Color = Color3.fromRGB(18, 17, 22)
	plaque.Parent = floor.Parent
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.PixelsPerStud = 12
	local t1 = Instance.new("TextLabel")
	t1.Size = UDim2.new(1, 0, 0.4, 0)
	t1.BackgroundTransparency = 1
	t1.Text = name:upper()
	t1.TextColor3 = Color3.fromRGB(226, 219, 190)
	t1.Font = Enum.Font.Garamond
	t1.TextSize = 28
	t1.Parent = gui
	local t2 = Instance.new("TextLabel")
	t2.Position = UDim2.fromScale(0, 0.4)
	t2.Size = UDim2.new(1, 0, 0.6, 0)
	t2.BackgroundTransparency = 1
	t2.TextWrapped = true
	t2.Text = (spec.role .. "  ·  SURVEY: ") .. spec.question
	t2.TextColor3 = Color3.fromRGB(190, 184, 164)
	t2.Font = Enum.Font.Garamond
	t2.TextSize = 12
	t2.Parent = gui
	gui.Parent = plaque
	plaque.Parent = workspace

	local surveyPrompt = Instance.new("ProximityPrompt")
	surveyPrompt.ActionText = "Survey"
	surveyPrompt.ObjectText = "witness this scene"
	surveyPrompt.HoldDuration = 2
	surveyPrompt.MaxActivationDistance = 10
	surveyPrompt.Parent = plaque
	surveyPrompt.Triggered:Connect(function(player: Player)
		MudBasecamp.survey(player, name)
	end)

	return floor
end

-- The Hall: six chairs, Vellum, the choice.
local function buildHall(parent: Model, pos: Vector3)
	for i = 1, 6 do
		local chair = Instance.new("Part")
		chair.Anchored = true
		chair.Size = Vector3.new(2, 4, 2)
		chair.Position = pos + Vector3.new(-10 + (i - 1) * 4, 3, -6)
		chair.Color = Color3.fromRGB(70, 56, 44)
		chair.Material = Enum.Material.Wood
		chair.Name = ("EmptyChair_%d"):format(i)
		chair.Parent = parent
	end

	local vellum = Instance.new("Part")
	vellum.Anchored = true
	vellum.Shape = Enum.PartType.Ball
	vellum.Size = Vector3.new(3, 3, 3)
	vellum.Position = pos + Vector3.new(0, 3.5, 6)
	vellum.Color = Color3.fromRGB(214, 204, 176)
	vellum.Material = Enum.Material.SmoothPlastic
	vellum.Name = "BrotherVellum"
	vellum.Parent = parent

	local grant = Instance.new("ProximityPrompt")
	grant.ActionText = "Sign the Grant"
	grant.ObjectText = "Brother Vellum, of the Open Hand"
	grant.HoldDuration = 1
	grant.Parent = vellum
	grant.Triggered:Connect(function(player: Player)
		if player:GetAttribute("SkipVellum") then
			say(player, "You have already bought your way past the waiting. The counting is handled.")
			return
		end
		if player:GetAttribute("SignedGrant") then
			say(player, "Your name is already on the Grant. It does not need you twice.")
			return
		end
		-- DF villain law (WORLDGEN_MINE.md #5): the grant is a plot template and
		-- signing is a temptation roll against the player's values; the counted
		-- chairs are the spine. Failure to resist becomes ongoing corruption.
		local rng = SeedRng.new(os.clock() * 1000 // 1)
		local succumbed, roll, threshold = Temptation.roll(rng, "grant_of_belonging", Temptation.profile(player))
		if succumbed then
			player:SetAttribute("SignedGrant", true)
			player:SetAttribute("Corrupted", true)
			ShadowLedger.record(player, "Basecamp",
				("succumbed to the Grant (temptation %d vs resolve %d): the Open Hand holds a finger")
					:format(roll, threshold), false)
			say(player, Lore.Vellum.grantOffer)
		else
			ShadowLedger.record(player, "Basecamp",
				("felt the pull of the Grant and resisted it (temptation %d vs resolve %d)")
					:format(roll, threshold), true)
			say(player, ("The Open Hand opens and you step back from it. The chairs stay counted. (temptation %d vs resolve %d)"):format(roll, threshold))
		end
	end)

	local count = Instance.new("ProximityPrompt")
	count.ActionText = "Count the empty chairs"
	count.ObjectText = "the long supper table"
	count.HoldDuration = 1.5
	count.Parent = vellum
	count.Triggered:Connect(function(player: Player)
		local marks = tonumber((player:GetAttribute("VirtueMarks")) or 0) + 1
		local dbl = player:GetAttribute("VirtueDoublerUntil")
		if dbl and os.time() < dbl then marks += 1 end
		player:SetAttribute("VirtueMarks", marks)
		player:SetAttribute("CountedChairs", true)
		ShadowLedger.record(player, "Basecamp", "counted the six empty chairs and refused to sign", true)
		say(player, Lore.Vellum.ifCounted .. ("  Virtue Marks: %d. Now they come."):format(marks))
		MudBasecamp.summonWisps(pos, player)
	end)
end

-- "Speak the count aloud and they come."
function MudBasecamp.summonWisps(pos: Vector3, target: Player)
	local rng = SeedRng.new(os.clock() * 1000 // 1)
	for i = 1, 3 do
		-- forgotten-beast law: the world pauses when one is first seen
		-- (announcement carries the DF attack warning), and the body is
		-- ASSEMBLED per the mined RCP chain, never a plain ball anymore
		local bodySpec = ProceduralBody.assemble(rng)
		-- kinship law (WORLDGEN_MINE.md #4): the beast's sphere decides which
		-- zones ally with it and which oppose it, from the generated graph
		local beast = Worldgen.forgottenBeast(rng)
		print(("[FORGOTTEN] %s has come: a %s. It is drawn by wealth and noise. %s %s")
			:format(beast.name, bodySpec.description, bodySpec.warning, Worldgen.kinshipLine(beast)))
		local wisp = Instance.new("Part")
		wisp.Anchored = false
		wisp.Shape = Enum.PartType.Ball
		wisp.Size = Vector3.new(1.4, 1.4, 1.4)
		wisp.Material = Enum.Material.Neon
		wisp.Color = Color3.fromRGB(140, 60, 200)
		wisp.Position = pos + Vector3.new(math.cos(i * 2.1) * 30, 10, math.sin(i * 2.1) * 30)
		local body = ProceduralBody.build(bodySpec, wisp) -- welded limbs, massless: one assembly
		wisp.Parent = body
		body.Parent = workspace
		local touchConn
		touchConn = wisp.Touched:Connect(function(hit)
			local player = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
			if player and player.Character then
				player.Character:BreakJoints()
				touchConn:Disconnect()
				body:Destroy()
			end
		end)
		-- Q-043 Trove pass: the hunt is OWNED by the terror's body
		-- (AttachToInstance -> Destroying -> Clean cancels the thread), not by
		-- its 30s age. The 30s cap stays as game behavior but enforces itself
		-- by destroying the body (the false return ends the thread); an early
		-- destroy (the Touched kill above) cancels the hunt immediately
		-- instead of leaving it polling body.Parent for up to 30s.
		local t0 = os.clock()
		local trove = Trove.new()
		trove:AttachToInstance(body)
		trove:Loop(0.1, function()
			if not body.Parent then return false end
			if os.clock() - t0 >= 30 then
				body:Destroy()
				return false
			end
			-- B2-110 (2026-09-26): FindFirstChild types Instance?; cast narrows to
			-- BasePart? so hum.Position below stops tripping luau-lsp
			-- "Key 'Position' not found in external type 'Instance'" at (220,19).
			local hum = target.Character and target.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if hum then
				local dir = (hum.Position - wisp.Position)
				if dir.Magnitude > 2 then
					wisp.AssemblyLinearVelocity = dir.Unit * 14
				end
			end
			return true
		end)
	end
end

-- survey: the party witnesses the same scene; converge = core, diverge = swarm log
function MudBasecamp.survey(player: Player, room: string)
	local spec = Lore.Rooms[room]
	if not spec then return end
	ShadowLedger.record(player, "Basecamp", ("surveyed %s"):format(room), true)

	-- Mooncast law (LINKS-335): same-model councils agree too cheaply. The three
	-- witnesses run on THREE DIFFERENT families (stealth + inclusionai + poolside),
	-- all $0, so ROSHOMON CORE (>=2 agree) measures convergence, not consistency.
	local WITNESS_MODELS = {
		"stealth/space-bunny-alpha",
		"inclusionai/ling-3.0-flash-sante:free",
		"poolside/laguna-s-2.1:free",
	}
	local answers: { string } = {}
	for i, h in ipairs(Lore.Heads) do
		if i > 3 then break end -- three seats per survey; free lanes, paced
		local reply, isLive = NpcGateway.ask(h.id, player.Name,
			("Describe this scene and answer: %s"):format(spec.question), room, WITNESS_MODELS[i])
		if isLive then table.insert(answers, reply) end
	end

	local core: { string } = {}
	if #answers >= 2 then
		-- token overlap: content words shared by >=2 witnesses
		local tokens: { [string]: number } = {}
		for _, a in ipairs(answers) do
			local seen: { [string]: boolean } = {}
			for word in string.gmatch(string.lower(a), "%a+") do
				if #word > 4 and not seen[word] then
					seen[word] = true
					tokens[word] = (tokens[word] or 0) + 1
				end
			end
		end
		for word, n in pairs(tokens) do
			if n >= 2 then table.insert(core, word) end
		end
	end

	if #core > 0 then
		local invariants = tonumber((player:GetAttribute("Invariants")) or 0) + #core
		player:SetAttribute("Invariants", invariants)
		say(player, string.format("ROSHOMON CORE (%d witnesses agree): {%s}  -> folded. Invariants: %d",
			#core, table.concat(core, ", "), invariants))
	else
		say(player, "No core. The accounts diverge — routed to the swarm. The room keeps its question.")
		ShadowLedger.record(player, "Basecamp", ("novel-divergence in %s routed to swarm"):format(room))
	end
end

-- Grow-a-Garden wheel: one plot per player at the Warm Springs. Growth runs
-- on server timestamps, so it ripens while you are offline (docs §3.6):
-- 30 min → Spring Herb (5 VM), 8 h → Moon Bloom (25 VM).
local HERB_MIN, BLOOM_H = 30, 8

local function buildGarden(model: Model)
	local springs = roomPlots["the Warm Springs"]
	if not springs then return end

	for i = 1, 4 do
		local plot = Instance.new("Part")
		plot.Anchored = true
		plot.Size = Vector3.new(8, 0.4, 8)
		plot.Position = springs + Vector3.new(-12 + (i - 1) * 8, 0.7, 16)
		plot.Color = Color3.fromRGB(70, 90, 60)
		plot.Material = Enum.Material.Grass
		plot.Name = ("Plot_%d"):format(i)
		plot.Parent = model

		local prompt = Instance.new("ProximityPrompt")
		prompt.ObjectText = "garden plot"
		prompt.HoldDuration = 0.5
		prompt.Parent = plot

		local function refresh(pl: Player)
			local plantedAt = pl:GetAttribute(("Plot%d"):format(i))
			if not plantedAt then
				prompt.ActionText = "Plant a Virtue Seed"
			else
				local elapsedMin = (os.time() - plantedAt) / 60
				if elapsedMin >= BLOOM_H * 60 then
					prompt.ActionText = "Harvest the Moon Bloom (25 VM)"
				elseif elapsedMin >= HERB_MIN then
					prompt.ActionText = "Harvest the Spring Herb (5 VM)"
				else
					prompt.ActionText = ("growing... %d min left"):format(math.ceil(HERB_MIN - elapsedMin))
				end
			end
		end

		prompt.Triggered:Connect(function(pl: Player)
			local plantedAt = pl:GetAttribute(("Plot%d"):format(i))
			if not plantedAt then
				pl:SetAttribute(("Plot%d"):format(i), os.time())
				ShadowLedger.record(pl, "Basecamp", "planted a Virtue Seed at the Warm Springs", true)
			else
				local elapsedMin = (os.time() - plantedAt) / 60
				if elapsedMin >= BLOOM_H * 60 then
					pl:SetAttribute("VirtueMarks", tonumber((pl:GetAttribute("VirtueMarks")) or 0) + 25)
					pl:SetAttribute(("Plot%d"):format(i), nil)
				elseif elapsedMin >= HERB_MIN then
					pl:SetAttribute("VirtueMarks", tonumber((pl:GetAttribute("VirtueMarks")) or 0) + 5)
					pl:SetAttribute(("Plot%d"):format(i), nil)
				else
					return -- not ready; the plot teaches patience
				end
			end
			refresh(pl)
		end)

		-- t63 2026-09-25: the 10s GetPlayers poll is gone, cured like t56's
		-- leaderstats poll (init.server.luau:184-196). The label data rides the
		-- player's Plot<i> attribute; sole writer is this prompt's own Triggered
		-- handler (:326 set, :332/:335 removal) and every one of those paths
		-- already refreshes at :340, so GetAttributeChangedSignal("Plot"..i)
		-- exists to bind future or external writers. First-add firing per the
		-- official attributes doc example ("Fires Changed, AttributeChanged, and
		-- GetAttributeChangedSignal()", fetched 2026-09-25); removal firing is
		-- not doc-stated but is not load-bearing because :340 covers this
		-- file's own writes. Negative, first-class: the "growing... min left"
		-- countdown and the HERB_MIN/BLOOM_H label flips derive from wall-clock
		-- time, which fires no signal. Instead of ticking every plot every 10s
		-- forever, the plant write schedules two one-shot wakeups at exactly
		-- those deadlines (wake at the deadline, not polling); a stale wakeup
		-- after harvest or replant is dropped by the plantedAt guard. The
		-- minute count is only refreshed at the write events and on prompt
		-- engagement (PromptButtonHoldBegan), not continuously; that cosmetic
		-- staleness is accepted in exchange for zero standing timers. Seed at
		-- attach paints the initial label the poll used to cover in 10s.
		local function onPlotChanged(pl: Player)
			refresh(pl)
			local plantedAt = pl:GetAttribute(("Plot%d"):format(i))
			if plantedAt then
				local age = os.time() - plantedAt
				for _, thresholdSec in ipairs({ HERB_MIN * 60, BLOOM_H * 3600 }) do
					local wakeIn = thresholdSec - age
					if wakeIn > 0 then
						task.delay(wakeIn, function()
							if pl.Parent and pl:GetAttribute(("Plot%d"):format(i)) == plantedAt then
								refresh(pl)
							end
						end)
					end
				end
			end
		end

		local function attach(pl: Player)
			refresh(pl)
			prompt.PromptButtonHoldBegan:Connect(function()
				refresh(pl)
			end)
			pl:GetAttributeChangedSignal(("Plot%d"):format(i)):Connect(onPlotChanged)
		end
		Players.PlayerAdded:Connect(attach)
		for _, p in ipairs(Players:GetPlayers()) do
			attach(p)
		end
	end
end

function MudBasecamp.build(): Model
	local model = Instance.new("Model")
	model.Name = "MudBasecamp"

	-- ring layout: rooms on a circle around the Hall
	local names = {}
	for name in pairs(Lore.Rooms) do table.insert(names, name) end
	table.sort(names)
	for i, name in ipairs(names) do
		local angle = ((i - 1) / #names) * math.pi * 2
		local pos = origin + Vector3.new(math.cos(angle) * 130, 8, math.sin(angle) * 130)
		roomPlots[name] = pos
		buildRoom(name, pos).Parent = model
	end
	roomPlots[CENTER] = origin -- World-Memory at the center

	-- exits -> portal pads (graph from Lore)
	for name, spec in pairs(Lore.Rooms) do
		local from = roomPlots[name]
		local seen: { [string]: boolean } = {}
		for _, dest in pairs(spec.exits) do
			if not seen[dest] and roomPlots[dest] then
				seen[dest] = true
				portalPad(name, dest, from + Vector3.new(0, 0.7, 16)).Parent = model
			end
		end
	end

	buildHall(model, origin)
	buildGarden(model)

	-- Death speaks in CAPS (the Pratchett crosswalk)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(char)
			local hum = char:WaitForChild("Humanoid") :: Humanoid
			hum.Died:Connect(function()
				print(("[DEATH] %s. %s"):format(Lore.Death.format(player.Name, "THE MOUNTAIN"), Lore.Death.opening))
			end)
		end)
	end)

	model.Parent = workspace
	return model
end

return MudBasecamp
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="41">
      <Properties>
        <string name="Name">NpcGateway</string>
        <string name="Source"><![CDATA[--!strict
-- NpcGateway — the bridge between the world and the fleet's brain.
-- NPC = SEAT: every AI head is a persona served by the local mag gateway
-- (tools/roblox_npc_gateway.py), which routes to the free stealth lanes
-- (stealth/space-bunny-alpha on OpenRouter x2 keys + Nous). One ractor,
-- many faces. When the bus is dark, heads fall back to canned first lines
-- and say so honestly (no fabrication law).

local HttpService = game:GetService("HttpService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Config = require(Shared:WaitForChild("Config"))
local Lore = require(Shared:WaitForChild("Lore"))

local NpcGateway = {}
local lastCallByHead: { [string]: number } = {}
local COOLDOWN = 2 -- seconds per head; protects the free lanes

local function firstLineFor(headId: string): string
	for _, h in ipairs(Lore.Heads) do
		if h.id == headId then return h.firstLine end
	end
	return "..."
end

-- ask(): one turn of one seat. Context = where they stand, what the room asks.
function NpcGateway.ask(headId: string, playerName: string, message: string, roomContext: string, model: string?): (string, boolean)
	local now = os.clock()
	if lastCallByHead[headId] and now - lastCallByHead[headId] < COOLDOWN then
		return "(the head is still thinking about the last question)", false
	end
	lastCallByHead[headId] = now

	local body = HttpService:JSONEncode({
		head = headId,
		player = playerName,
		message = message,
		room = roomContext,
		model = model, -- nil = gateway default; survey passes cross-family slugs (Mooncast law)
	})
	local ok, err = pcall(function()
		local res = HttpService:RequestAsync({
			Url = Config.Gateway.url,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = body,
			Timeout = Config.Gateway.timeoutSec,
		})
		if res.Success then
			local decoded = HttpService:JSONDecode(res.Body)
			if decoded.reply and decoded.reply ~= "" then
				return decoded.reply
			end
		end
		return nil
	end)

	if ok and type(err) == "string" and #err > 0 then
		return err, true
	end

	-- offline: honest fallback (never fabricate a live model)
	local fallback = firstLineFor(headId)
	return fallback .. "  (the bus to the fleet is dark; this is a recording)", false
end

return NpcGateway
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="42">
      <Properties>
        <string name="Name">OssuaryZone</string>
        <string name="Source"><![CDATA[--!strict
-- OssuaryZone — THE OSSUARY: the spooky skeleton maze dungeon.
-- Clone stack (docs/CLONED_MECHANICS.md + watch/inbox intel): Exanima
-- darkness (torch radius, stacked floors), Lara-Croft-GO state changes
-- (levers shift walls, bone-key gate), weeping-angel sentinels (freeze while
-- observed, hunt while unseen), MUD law: the rooms remember (ShadowLedger).
-- Seasonal: Halloween window, pumpkin braziers, Candy Bones = VM.
-- The Sixth Candle pass (99R): wider torch radius.
--
-- Maze geometry (fixed 2026-09-25 playtest pass): cells live at ODD grid
-- coords 1..GRID, walls at EVEN coords between them. A backtracker steps ±2
-- cells and opens the wall at the integer midpoint. Wall segments not opened
-- are built; the border ring has exactly one gap per floor. worldPos maps
-- grid -> studs so every feature (sentinels, levers, braziers, candy, the
-- Court) sits at reachable cell centers, never inside rock.

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Shared = ReplicatedStorage:WaitForChild("Modules")
local SeedRng = require(Shared:WaitForChild("SeedRng"))
local SectionStream = require(Shared:WaitForChild("SectionStream"))
local ShadowLedger = require(ServerScriptService:WaitForChild("ShadowLedger"))
local Worldgen = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Worldgen"))

local OssuaryZone = {}
local origin = Vector3.new(-60, 8, 0)
local GRID, CELL = 13, 14
local HALF = (GRID + 1) / 2 -- 7 for GRID 13: world x of grid column x = (x - HALF) * CELL
local TORCH_RADIUS = 26
local CANDLE_RADIUS = 38
local FLOORS = 3
local FLOOR_DROP = 46 -- vertical spacing between floors
-- Q-043 streamed floors: floor 1 (the arrival floor) builds eagerly at boot;
-- floors 2..FLOORS are ordered stream sections with one floor of lookahead.
-- Radius 55 vs the 46-stud drop: standing on floor N puts floor N+1's center
-- ~49 studs away (builds while you play N) and floor N+2 ~95 (stays dark).
local FLOOR_LOOKAHEAD = 55

local walls: { BasePart } = {}
local sentinels: { { part: Part, frozen: boolean } } = {}
local ossuaryModel: Model? = nil
-- Q-043 streamed floors: floors 2..FLOORS ride this ordered stream; tick
-- polls it with player root positions. floorsBuilt gates the floor-2 boulder
-- clock (no boulders into a floor that does not exist yet).
local floorsBuilt = 0
local floorStream: SectionStream.SectionStream? = nil

local function worldPos(base: Vector3, gx: number, gz: number): Vector3
	return base + Vector3.new((gx - HALF) * CELL, 0, (gz - HALF) * CELL)
end

local function cellCenter(base: Vector3, rng, floorBaseY: number): Vector3
	-- odd coords only: a real cell, never rock
	local gx = 2 * rng:int(1, (GRID + 1) // 2) - 1
	local gz = 2 * rng:int(1, (GRID + 1) // 2) - 1
	return worldPos(base, gx, gz) + Vector3.new(0, floorBaseY, 0)
end

-- ---- seeded maze: recursive backtracker, odd cells / even walls ----
local function buildFloor(rng, floor: number, model: Model): Vector3
	local base = origin + Vector3.new(0, (floor - 1) * -FLOOR_DROP, 0)
	local wallColor = Color3.fromRGB(58, 54, 50)

	local slab = Instance.new("Part")
	slab.Anchored = true
	slab.Size = Vector3.new(GRID * CELL + CELL, 1, GRID * CELL + CELL)
	slab.Position = base + Vector3.new(0, -0.5, 0)
	slab.Color = Color3.fromRGB(40, 38, 42)
	slab.Material = Enum.Material.Slate
	slab.Parent = model

	local visited: { [string]: boolean } = {}
	local opened: { [string]: boolean } = {}
	local stack = { { 1, 1 } }
	visited["1,1"] = true
	while #stack > 0 do
		local cur = stack[#stack]
		local neighbors = {}
		for _, d in ipairs({ { 2, 0 }, { -2, 0 }, { 0, 2 }, { 0, -2 } }) do
			local nx, nz = cur[1] + d[1], cur[2] + d[2]
			if nx >= 1 and nx <= GRID and nz >= 1 and nz <= GRID and not visited[(nx .. "," .. nz)] then
				table.insert(neighbors, { nx, nz })
			end
		end
		if #neighbors == 0 then
			table.remove(stack)
		else
			local nxt = neighbors[rng:int(1, #neighbors)]
			visited[(nxt[1] .. "," .. nxt[2])] = true
			-- the wall between two cells: integer midpoint, direction-derived
			local mx = (cur[1] + nxt[1]) / 2
			local mz = (cur[2] + nxt[2]) / 2
			opened[(mx .. "," .. mz)] = true
			table.insert(stack, nxt)
		end
	end

	-- interior walls: at even coords between cells; skip the opened ones
	for gx = 1, GRID - 1 do
		for gz = 1, GRID do
			local isWallCoord = (gx % 2 == 0) -- vertical wall between (gx-1,gz),(gx+1,gz)... pairs
			-- vertical wall segments sit at even gx, odd gz
			if isWallCoord and gz % 2 == 1 and not opened[(gx .. "," .. gz)] then
				local w = Instance.new("Part")
				w.Anchored = true
				w.Size = Vector3.new(1.5, 9, CELL)
				w.Position = worldPos(base, gx, gz) + Vector3.new(0, 4.5, 0)
				w.Color = wallColor
				w.Material = Enum.Material.Slate
				w.Parent = model
				table.insert(walls, w)
			end
		end
	end
	for gx = 1, GRID do
		for gz = 1, GRID - 1 do
			-- horizontal wall segments sit at odd gx, even gz
			if gx % 2 == 1 and gz % 2 == 0 and not opened[(gx .. "," .. gz)] then
				local w = Instance.new("Part")
				w.Anchored = true
				w.Size = Vector3.new(CELL, 9, 1.5)
				w.Position = worldPos(base, gx, gz) + Vector3.new(0, 4.5, 0)
				w.Color = wallColor
				w.Material = Enum.Material.Slate
				w.Parent = model
				table.insert(walls, w)
			end
		end
	end

	-- border ring: solid, with exactly one gap per floor
	-- floor 1: entry gap on the +x side; floor FLOORS: court gap on the +z side
	local gapX = HALF -- world x = 0
	local gapZ = HALF -- world z = 0
	local function borderWall(pos: Vector3, size: Vector3)
		local w = Instance.new("Part")
		w.Anchored = true
		w.Size = size
		w.Position = pos
		w.Color = Color3.fromRGB(30, 28, 32)
		w.Material = Enum.Material.Slate
		w.Parent = model
		table.insert(walls, w)
	end

	for i = 0, GRID + 1, 2 do -- even coords: wall positions
		local xw = worldPos(base, i, 0)
		-- -z side (solid)
		borderWall(xw + Vector3.new(0, 5.5, 0), Vector3.new(CELL, 11, 2))
		-- +z side (gap on floor FLOORS at gx == gapX)
		if not (floor == FLOORS and i == gapX) then
			borderWall(worldPos(base, i, GRID + 1) + Vector3.new(0, 5.5, 0), Vector3.new(CELL, 11, 2))
		end
		-- -x side (solid)
		borderWall(worldPos(base, 0, i) + Vector3.new(0, 5.5, 0), Vector3.new(2, 11, CELL))
		-- +x side (gap on floor 1 at gz == gapZ)
		if not (floor == 1 and i == gapZ) then
			borderWall(worldPos(base, GRID + 1, i) + Vector3.new(0, 5.5, 0), Vector3.new(2, 11, CELL))
		end
	end

	return base
end

-- ---- skeleton sentinels: weeping angels ----
local function spawnSentinel(rng, base: Vector3, model: Model)
	local s = Instance.new("Part")
	s.Size = Vector3.new(3, 7, 3)
	s.Color = Color3.fromRGB(216, 210, 190)
	s.Material = Enum.Material.Sand
	s.Position = cellCenter(base, rng, 6.5)
	s.Name = "BoneSentinel"
	s.Parent = model
	local eye = Instance.new("PointLight")
	eye.Color = Color3.fromRGB(255, 120, 40)
	eye.Range = 8
	eye.Brightness = 2
	eye.Parent = s
	table.insert(sentinels, { part = s, frozen = true })
end

local function playerAtY(player: Player, y: number): BasePart?
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root and math.abs(root.Position.Y - y) < FLOOR_DROP / 2 then return root end
	return nil
end

-- ---- levers: Lara-Croft-GO state changes (two walls swap) ----
local levers: { { a: BasePart, b: BasePart } } = {}

local function makeLever(rng, base: Vector3, floorBaseY: number, model: Model)
	local floorWalls = {}
	for _, w in ipairs(walls) do
		if math.abs(w.Position.Y - (floorBaseY + 4.5)) < 2 then table.insert(floorWalls, w) end
	end
	if #floorWalls < 2 then return end
	local a = floorWalls[rng:int(1, #floorWalls)]
	local b = floorWalls[rng:int(1, #floorWalls)]
	if a == b then return end
	local lever = Instance.new("Part")
	lever.Anchored = true
	lever.Size = Vector3.new(1.5, 5, 1.5)
	lever.Color = Color3.fromRGB(200, 150, 60)
	lever.Material = Enum.Material.Wood
	lever.Position = cellCenter(base, rng, floorBaseY) + Vector3.new(0, 2.5, 0)
	lever.Name = "BoneLever"
	lever.Parent = model
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Pull the bone lever"
	prompt.ObjectText = "the walls remember"
	prompt.HoldDuration = 1
	prompt.Parent = lever
	local pair = { a = a, b = b }
	prompt.Triggered:Connect(function(player: Player)
		local pa, pb = pair.a.Position, pair.b.Position
		pair.a.Position, pair.b.Position = pb, pa -- the corridor state changes
		ShadowLedger.record(player, "Ossuary", "pulled a bone lever; the walls moved")
	end)
	table.insert(levers, pair)
end

-- ---- braziers / candy / boulders ----
local function makeBrazier(rng, base: Vector3, floorBaseY: number, model: Model)
	local b = Instance.new("Part")
	b.Shape = Enum.PartType.Ball
	b.Size = Vector3.new(2.5, 2.5, 2.5)
	b.Color = Color3.fromRGB(255, 140, 50)
	b.Material = Enum.Material.Neon
	b.Position = cellCenter(base, rng, floorBaseY) + Vector3.new(0, 1.5, 0)
	b.Name = "PumpkinBrazier"
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 140, 50)
	light.Range = 22
	light.Brightness = 1.6
	light.Parent = b
	b.Parent = model
end

-- Per-floor daily candy cap. SEASONAL_LAUNCH.md FALSIFIERS ("cap candy per
-- floor per day if needed") named no number; the cap derives from this file's
-- own spawn math: each floor emits exactly 6 static Candy Bones at build
-- (OssuaryZone.build, 6x dropCandy per floor), so 6 candy/floor/day is the
-- least-surprising bound: a full daily sweep of every floor always pays, and
-- only overflow beyond a floor's daily spawn (the Skeleton King's 40-candy
-- shower, celebration on top of his 500 VM award) is muted. Baseline print
-- becomes max 12 VM/floor/day (36/day, 72 with the Candy Doubler) against
-- 50-3000 VM Exchange SKUs and the 5000 VM rebirth (LedgerExchange.luau), so
-- the loop is not starved.
local CANDY_PER_FLOOR_DAILY_CAP = 6

local function candyTallyAttr(floor: number): string
	return "CandyFloorTally" .. floor
end

-- true = this pickup is under the cap and may pay; burns one slot of the
-- player's per-floor daily allowance (UTC day stamp, per-player attributes,
-- the same store as VirtueDoublerUntil). Capped candy is NOT consumed: it
-- pays nothing that day and stays in the world for a later day, so there
-- are no pay-nothing pickups while the per-floor daily print stays bounded.
local function candyAllowed(plr: Player, floor: number): boolean
	local today = math.floor(os.time() / 86400)
	if plr:GetAttribute("CandyCapDay") ~= today then
		for f = 1, FLOORS do
			plr:SetAttribute(candyTallyAttr(f), 0)
		end
		plr:SetAttribute("CandyCapDay", today)
	end
	local key = candyTallyAttr(floor)
	local tally = tonumber(plr:GetAttribute(key)) or 0
	if tally >= CANDY_PER_FLOOR_DAILY_CAP then
		return false
	end
	plr:SetAttribute(key, tally + 1)
	return true
end

-- jitter (optional): explicit per-call offset replacing the internal
-- math.random(-6,6) scatter. t38 fix receipt: the seeded build loop
-- (SeedRng.new(20261031), OssuaryZone.build) called dropCandy with no way
-- to seed this scatter, so worldgen candy positions were unreplayable.
-- Callers in seeded paths must pass an explicit jitter (build passes
-- Vector3.zero; its spread is the deterministic spiral at the call site);
-- the King shower (runtime event, t29) passes nothing and keeps the
-- math.random scatter. When jitter is nil the behavior is byte-identical
-- to the pre-t38 expression.
local function dropCandy(at: Vector3, floor: number, jitter: Vector3?)
	local c = Instance.new("Part")
	c.Shape = Enum.PartType.Ball
	c.Size = Vector3.new(1.2, 1.2, 1.2)
	c.Color = Color3.fromRGB(255, 100, 160)
	c.Material = Enum.Material.Neon
	local j = jitter or Vector3.new(math.random(-6, 6), 0, math.random(-6, 6))
	c.Position = at + Vector3.new(j.X, 1.5, j.Z)
	c.Name = "CandyBone"
	c.Parent = workspace
	c.Touched:Connect(function(hit)
		local plr = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
		if plr and candyAllowed(plr, floor) then
			-- fix receipt: this line read "CandyDoublerUntil", an attribute with
			-- zero writers (grep -rn DoublerUntil roblox/src, 2026-09-25); the
			-- 149R SKU writes VirtueDoublerUntil (Monetization.luau:46) per
			-- ROBLOX_MONETIZATION_PLAN_20260924.md "Double marks for 1 hour",
			-- so the doubler never doubled candy. Reader aligned to the writer.
			local mult = (plr:GetAttribute("VirtueDoublerUntil") and plr:GetAttribute("VirtueDoublerUntil") > os.time()) and 2 or 1
			plr:SetAttribute("VirtueMarks", tonumber((plr:GetAttribute("VirtueMarks")) or 0) + 2 * mult)
			c:Destroy()
		end
	end)
end

local function rollBoulder(base: Vector3)
	local b = Instance.new("Part")
	b.Shape = Enum.PartType.Ball
	b.Size = Vector3.new(6, 6, 6)
	b.Color = Color3.fromRGB(120, 110, 100)
	b.Material = Enum.Material.Slate
	b.Position = base + Vector3.new(0, 20, -(HALF) * CELL + 4)
	b.Name = "BoneBoulder"
	b.Parent = workspace
	b.AssemblyLinearVelocity = Vector3.new(0, -5, 40)
	b.Touched:Connect(function(hit)
		local plr = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
		local hum = plr and plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
		if hum then hum.Health = 0 end -- honest crush
	end)
	task.delay(12, function()
		if b.Parent then b:Destroy() end
	end)
end

-- ---- the Skeleton King + Bone Key ----
local king: BasePart? = nil

local function buildCourt(base: Vector3, model: Model)
	-- the Bone Key: floor 3 antechamber, near the court gap
	local key = Instance.new("Part")
	key.Size = Vector3.new(1.2, 3, 0.4)
	key.Color = Color3.fromRGB(235, 225, 190)
	key.Material = Enum.Material.Neon
	key.Position = worldPos(base, HALF, GRID - 2) + Vector3.new(0, 2, 0)
	key.Name = "BoneKey"
	key.Parent = model
	key.Touched:Connect(function(hit)
		local plr = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
		if plr and not plr:GetAttribute("BoneKey") then
			plr:SetAttribute("BoneKey", true)
			key:Destroy()
			ShadowLedger.record(plr, "Ossuary", "took the Bone Key", true)
		end
	end)

	-- the wooden gate sits exactly in the border gap; key-holders walk through
	local gate = Instance.new("Part")
	gate.Anchored = true
	gate.Size = Vector3.new(CELL, 11, 2)
	gate.Position = worldPos(base, HALF, GRID + 1) + Vector3.new(0, 5.5, 0)
	gate.Color = Color3.fromRGB(90, 70, 50)
	gate.Material = Enum.Material.Wood
	gate.Name = "CourtGate"
	gate.Parent = model
	gate.Touched:Connect(function(hit)
		local plr = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
		if plr and plr:GetAttribute("BoneKey") then
			gate.CanCollide = false
			gate.Transparency = 0.85
		end
	end)

	-- the King
	local kingPart = Instance.new("Part")
	kingPart.Size = Vector3.new(6, 14, 6)
	kingPart.Color = Color3.fromRGB(226, 218, 196)
	kingPart.Material = Enum.Material.Sand
	kingPart.Position = worldPos(base, HALF, GRID - 4) + Vector3.new(0, 7, 0)
	kingPart.Name = "THE SKELETON KING"
	local crown = Instance.new("PointLight")
	crown.Color = Color3.fromRGB(255, 200, 80)
	crown.Range = 18
	crown.Brightness = 3
	crown.Parent = kingPart
	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.new(0, 260, 0, 34)
	tag.StudsOffset = Vector3.new(0, 8, 0)
	tag.AlwaysOnTop = true
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.Text = "THE SKELETON KING · he does not move while you watch"
	lbl.TextColor3 = Color3.fromRGB(255, 220, 150)
	lbl.Font = Enum.Font.Garamond
	lbl.TextSize = 16
	lbl.Parent = tag
	tag.Parent = kingPart
	kingPart.Parent = model
	king = kingPart

	kingPart.Touched:Connect(function(hit)
		local plr = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
		if plr and plr:GetAttribute("BoneKey") and king and not king:GetAttribute("Felled") then
			king:SetAttribute("Felled", true)
			plr:SetAttribute("VirtueMarks", tonumber((plr:GetAttribute("VirtueMarks")) or 0) + 500)
			lbl.Text = "THE CROWN ROLLS. THE COURT FILES IT."
			ShadowLedger.record(plr, "Ossuary", "felled the Skeleton King with the Bone Key", true)
			for i = 1, 40 do
				-- the King stands on the top floor. t29 fix receipt: all 40 used
				-- to pass bare king.Position (one physical point; dropCandy:275
				-- still adds its own math.random(-6,6) per axis, so parts landed
				-- in a ~8.5-stud disc, stacked and intersecting). Under the
				-- per-floor 6/day cap that pile is one sweep for whoever fells
				-- him, muting the rest of the shower for that player that day.
				-- Now an index-derived Vogel spiral (golden angle; no rng
				-- instance reaches this closure, so no SeedRng and no new
				-- math.random: replay-safe by construction). Radius 4 keeps the
				-- worst-case offset (4 + sqrt(6^2+6^2) = 12.49 studs) inside the
				-- King's own cell, clear of the 14-stud wall planes minus 0.75
				-- half-thickness minus 0.6 candy radius = 12.65. Spread is
				-- positional only; the cap's muting of shower overflow stays as
				-- documented at CANDY_PER_FLOOR_DAILY_CAP (t2's stated intent).
				local r = 4 * math.sqrt(i / 40)
				local a = i * 2.399963229728653 -- golden angle, radians
				dropCandy(king.Position + Vector3.new(r * math.cos(a), 0, r * math.sin(a)), FLOORS)
			end
			task.delay(30, function()
				if king then king:SetAttribute("Felled", nil) end
			end)
		elseif plr and not plr:GetAttribute("BoneKey") then
			local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
			if hum then hum.Health = 0 end -- you brought nothing to a coronation
		end
	end)
end

-- ---- build ----
function OssuaryZone.build(): Model
	local model = Instance.new("Model")
	model.Name = "TheOssuary"

	Lighting.Brightness = 1
	Lighting.FogEnd = 90
	Lighting.FogColor = Color3.fromRGB(8, 6, 10)
	Lighting.ClockTime = 0
	local atmo = Instance.new("Atmosphere")
	atmo.Density = 0.55
	atmo.Color = Color3.fromRGB(60, 50, 70)
	atmo.Parent = Lighting

	local rng = SeedRng.new(20261031)

	-- Q-043 streamed floors (GnomeCode ep.1 pattern, ARCHITECTURE_NEXT move 1):
	-- buildFloorSection is the per-floor body of the old eager loop, UNCHANGED
	-- and in the same order, so the shared SeedRng(20261031) stream draws
	-- identically per floor. Floors build strictly in ascending order — eager
	-- floor 1 here, floors 2..FLOORS via an ORDERED SectionStream whose
	-- insertion order equals rng draw order — so the streamed world is
	-- byte-identical to the eager one, only later in time. Boot cost drops
	-- from 3 full grids to 1; the deep floors materialize around whoever
	-- descends (one floor of lookahead, FLOOR_LOOKAHEAD above).
	local function buildFloorSection(floor: number)
		local base = origin + Vector3.new(0, (floor - 1) * -FLOOR_DROP, 0)
		buildFloor(rng, floor, model)
		for _ = 1, 3 + floor do
			spawnSentinel(rng, base, model)
		end
		for _ = 1, 4 do
			makeBrazier(rng, base, 1.5, model)
		end
		if floor >= 2 then
			makeLever(rng, base, 4.5, model)
		end
		-- t38 fix receipt: this loop read "for _ = 1, 6: dropCandy(base +
		-- Vector3.new(0, 1.5, 0), floor)", stacking all 6 static candies on
		-- ONE physical point (the maze center cell, world (0, y, 0)); the
		-- only spread was dropCandy's internal math.random(-6,6) per axis,
		-- unseeded inside an otherwise seeded build (SeedRng.new(20261031)).
		-- Six 1.2-stud balls in a ~8.5-stud disc intersect into one grab
		-- sweep, and no seed reproduces their landing spots. Now the t29
		-- King-shower pattern, index-derived Vogel spiral (golden angle;
		-- zero rng draws, zero math.random in this seeded path: replay-safe
		-- by construction, and the shared 20261031 stream is untouched, so
		-- floors 1-2 maze/sentinel/brazier/lever draws are byte-identical to
		-- pre-t38). jitter=Vector3.zero suppresses dropCandy's internal
		-- scatter (nil would re-add unseeded math.random to worldgen).
		-- Geometry: center cell (grid 7,7, odd = real cell) spans +-7 studs;
		-- wall inner face at 7 - 0.75 = 6.25; candy radius 0.6 -> max safe
		-- center offset 5.65. Radius 5 keeps the outer drop 0.65 studs clear
		-- of rock; computed pair distances (python, 2026-09-25): radii
		-- 2.041/2.887/3.536/4.082/4.564/5.000, min pairwise center distance
		-- 3.270 studs vs the 1.2-stud touch threshold: no stacking, no
		-- intersection. Count unchanged: 6 per floor, CANDY_PER_FLOOR_DAILY_CAP
		-- math and the cap comment above still hold.
		for i = 1, 6 do
			local r = 5 * math.sqrt(i / 6)
			local a = i * 2.399963229728653 -- golden angle, radians (t29 constant)
			dropCandy(base + Vector3.new(r * math.cos(a), 1.5, r * math.sin(a)), floor, Vector3.zero)
		end
		if floor == FLOORS then
			buildCourt(base, model)
		end
		floorsBuilt += 1
	end

	local stream = SectionStream.new({ radius = FLOOR_LOOKAHEAD, budget = 1, ordered = true })
	for floor = 2, FLOORS do
		local f = floor
		stream:add(origin + Vector3.new(0, (f - 1) * -FLOOR_DROP, 0), function()
			buildFloorSection(f)
		end)
	end
	floorStream = stream
	buildFloorSection(1)
	-- players already in the zone when the model lands get their lookahead
	-- immediately; everyone else is covered by the tick poll below
	local bootRoots: { Vector3 } = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then table.insert(bootRoots, root.Position) end
	end
	stream:poll(bootRoots)

	-- carried torchlight: new joiners AND anyone already here
	local function attachTorch(player: Player)
		local function onChar(char: Model)
			local root = char:WaitForChild("HumanoidRootPart") :: BasePart
			if root:FindFirstChild("TorchLight") then return end
			local torch = Instance.new("PointLight")
			torch.Name = "TorchLight"
			torch.Color = Color3.fromRGB(255, 170, 90)
			torch.Range = player:GetAttribute("SixthCandle") and CANDLE_RADIUS or TORCH_RADIUS
			torch.Brightness = 2.2
			torch.Parent = root
		end
		player.CharacterAdded:Connect(onChar)
		if player.Character then onChar(player.Character) end
	end
	Players.PlayerAdded:Connect(attachTorch)
	for _, p in ipairs(Players:GetPlayers()) do
		attachTorch(p)
	end

	ossuaryModel = model
	model.Parent = workspace
	return model
end

-- ---- tick: sentinels hunt while unobserved, freeze while seen ----
local lastBoulder = 0

function OssuaryZone.tick(dt: number)
	-- Q-043: stream the deep floors around whoever is in the zone (GnomeCode
	-- ep.1 pattern). Ordered mode builds floors strictly 2 -> 3, keeping the
	-- shared SeedRng(20261031) draw order so the streamed world is identical
	-- to the old eager build. One floor of lookahead: standing on floor N
	-- materializes N+1, floor N+2 stays dark until N+1 is reached.
	local stream = floorStream
	if stream then
		local roots: { Vector3 } = {}
		for _, p in ipairs(Players:GetPlayers()) do
			local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then table.insert(roots, root.Position) end
		end
		if #roots > 0 then
			stream:poll(roots)
		end
	end

	for _, s in ipairs(sentinels) do
		local part = s.part
		if not part.Parent then continue end
		local observed = false
		local hunter: Player? = nil
		for _, p in ipairs(Players:GetPlayers()) do
			local root = playerAtY(p, part.Position.Y)
			if root then
				hunter = p
				local d = (root.Position - part.Position)
				if d.Magnitude < 40 then
					local params = RaycastParams.new()
					local filter: { Instance } = { part }
					if ossuaryModel then table.insert(filter, ossuaryModel) end
					params.FilterDescendantsInstances = filter
					params.FilterType = Enum.RaycastFilterType.Exclude
					local hit = workspace:Raycast(part.Position, d.Unit * d.Magnitude, params)
					if not hit or (p.Character and hit.Instance:IsDescendantOf(p.Character)) then
						observed = true
					end
				end
			end
		end
		s.frozen = observed
		part.Color = observed and Color3.fromRGB(230, 226, 208) or Color3.fromRGB(150, 60, 50)
		if hunter then
			local root = hunter.Character and hunter.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local dir = (root.Position - part.Position)
				if not observed and dir.Magnitude > 2 then
					-- hunt: glide at the player (the CFrame:Lerp instance call, fixed)
					part.CFrame = part.CFrame:Lerp(CFrame.new(root.Position - dir.Unit * 1.5), math.clamp(dt * 2.2, 0, 1))
				elseif observed and dir.Magnitude < 3 then
					local hum = hunter.Character and hunter.Character:FindFirstChildOfClass("Humanoid")
					if hum then hum.Health = 0 end -- the stare shields at distance; touch does not
				end
			end
		end
	end

	-- boulders on a slow clock, floor 2 only. Q-043: gated on floorsBuilt —
	-- the stream builds floor 2 on first descent, and a boulder rolled into
	-- a not-yet-built floor would just drop into the dark every 20s.
	lastBoulder += dt
	if lastBoulder > 20 and floorsBuilt >= 2 then
		lastBoulder = 0
		rollBoulder(origin + Vector3.new(0, -FLOOR_DROP, 0))
	end
end

return OssuaryZone
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="43">
      <Properties>
        <string name="Name">PlayerFeel</string>
        <string name="Source"><![CDATA[--!strict
-- PlayerFeel — the universal movement polish layer (Blox Fruits / RIVALS standard):
-- sprint x1.5 on Shift, Q dash (60 studs, 3s cooldown), one double jump.
-- Input arrives from the client (finit.client.luau) over the Movement remote;
-- the server validates and applies. No stamina in v1. Per-player FOV kick is
-- a client pass (v1.1); the dash itself is server-authoritative.

local Players = game:GetService("Players")

local PlayerFeel = {}
local BASE_WALK = 16
local SPRINT_MULT = 1.5
local DASH_STUDS = 60
local DASH_COOLDOWN = 3

local lastDash: { [Player]: number } = {}
local sprinting: { [Player]: boolean } = {}
local airJumps: { [Player]: number } = {}

local function applySpeed(player: Player, char: Model?)
	local hum = char and char:FindFirstChild("Humanoid") :: Humanoid?
	if not hum then return end
	local carry = player:GetAttribute("Carrying") == true
	local mult = (sprinting[player] and SPRINT_MULT or 1) * (carry and 0.6 or 1)
	hum.WalkSpeed = BASE_WALK * mult
end

function PlayerFeel.bind(remote: RemoteEvent)
	remote.OnServerEvent:Connect(function(player: Player, action: string, sprintOn: boolean?)
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?

		if action == "sprint" then
			sprinting[player] = sprintOn == true
			applySpeed(player, char)
		elseif action == "dash" and root then
			local now = os.clock()
			if now - (lastDash[player] or 0) < DASH_COOLDOWN then return end
			lastDash[player] = now
			local hum = char and char:FindFirstChild("Humanoid") :: Humanoid?
			local dir = hum and hum.MoveDirection or Vector3.zero
			if dir.Magnitude < 0.1 then
				dir = root.CFrame.LookVector
			end
			root.AssemblyLinearVelocity = dir.Unit * DASH_STUDS
			player:SetAttribute("DashAt", now)
		elseif action == "airjump" then
			local hum = char and char:FindFirstChild("Humanoid") :: Humanoid?
			if hum and hum:GetState() ~= Enum.HumanoidStateType.Landed
				and (airJumps[player] or 0) < 1 and root then
				airJumps[player] = (airJumps[player] or 0) + 1
				root.AssemblyLinearVelocity = Vector3.new(
					root.AssemblyLinearVelocity.X, 45, root.AssemblyLinearVelocity.Z)
			end
		end
	end)
end

function PlayerFeel.init()
	Players.PlayerAdded:Connect(function(player: Player)
		lastDash[player] = 0
		airJumps[player] = 0
		player.CharacterAdded:Connect(function(char)
			applySpeed(player, char)
			local hum = char:WaitForChild("Humanoid") :: Humanoid
			hum.StateChanged:Connect(function(_, new)
				if new == Enum.HumanoidStateType.Landed then
					airJumps[player] = 0 -- double jump resets on landing
				end
			end)
		end)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastDash[player] = nil
		sprinting[player] = nil
		airJumps[player] = nil
	end)
	-- Tower-of-Hell law: falls cost seconds, not sessions
	Players.RespawnTime = 1
end

return PlayerFeel
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="44">
      <Properties>
        <string name="Name">RuinsGoZone</string>
        <string name="Source"><![CDATA[--!strict
-- RuinsGoZone — the grid puzzle climb. Capture tiles by walking; capture a
-- connected chain to claim the group (RUINS GO: zones on the board, moves as
-- tools). Extra Life dev product = one rescue when the group is taken.

local Players = game:GetService("Players")
local ShadowLedger = require(script.Parent:WaitForChild("ShadowLedger"))

local RuinsGoZone = {}
local origin = Vector3.new(120, 8, 120)
local N = 9
local cellByTile: { [BasePart]: { player: string?, group: number? } } = {}

function RuinsGoZone.build(): Model
	local model = Instance.new("Model")
	model.Name = "RuinsGo"

	for gx = 1, N do
		for gz = 1, N do
			local tile = Instance.new("Part")
			tile.Anchored = true
			tile.Size = Vector3.new(8, 0.6, 8)
			tile.Position = origin + Vector3.new((gx - (N + 1) / 2) * 8.4, 0, (gz - (N + 1) / 2) * 8.4)
			tile.Color = Color3.fromRGB(52, 48, 40)
			tile.Material = Enum.Material.WoodPlanks
			tile.Name = ("Tile_%d_%d"):format(gx, gz)
			tile.Parent = model
			cellByTile[tile] = { player = nil, group = nil }

			tile.Touched:Connect(function(hit)
				local player = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
				if not player then return end
				local cell = cellByTile[tile]
				if not cell then return end
				local owner = tostring(player.UserId)
				if cell.player == owner then return end
				-- capture overwrites neutrals; contest = the other player's group thins
				cell.player = owner
				tile.Color = tonumber((player:GetAttribute("Invariants")) or 0) > 0
					and Color3.fromRGB(110, 150, 90)
					or Color3.fromRGB(150, 130, 80)
				player:SetAttribute("RuinsScore", tonumber((player:GetAttribute("RuinsScore")) or 0) + 1)
			end)
		end
	end

	model.Parent = workspace
	return model
end

return RuinsGoZone
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="45">
      <Properties>
        <string name="Name">ShadowLedger</string>
        <string name="Source"><![CDATA[--!strict
-- ShadowLedger — "the room that remembers." The hall files which you chose.
-- Every choice the world observes a player make (or refuse to make) is written
-- here, keyed by k-space address, and is readable back by The Watchful Eye.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local KSpace = require(Shared:WaitForChild("KSpace"))

local ShadowLedger = {}
local store = DataStoreService:GetDataStore("ShadowLedger_v1")

export type Entry = {
	player: string,
	kspace: string,       -- zone address
	choice: string,       -- what they did, or pointedly did not do
	noticing: boolean,    -- did they notice the thing (the Vellum mechanic)
	virtueMarks: number,
	ts: number,
}

local sessionLedger: { [string]: { Entry } } = {}

function ShadowLedger.record(player: Player, zone: string, choice: string, noticing: boolean?)
	local addr = KSpace.get(zone)
	local entry: Entry = {
		player = player.UserId and tostring(player.UserId) or player.Name,
		kspace = addr and addr.zone or zone,
		choice = choice,
		noticing = noticing == true,
		virtueMarks = (noticing == true) and 1 or 0,
		ts = os.time(),
	}
	local list = sessionLedger[entry.player]
	if not list then list = {} sessionLedger[entry.player] = list end
	table.insert(list, entry)

	-- durable write; the ledger is the authority (the world is the record)
	task.spawn(function()
		local key = ("p%s_day%s"):format(entry.player, os.date("!%Y%m%d"))
		-- t74 receipt: this was GetAsync + SetAsync (:43-50 before the fix), a
		-- two-call read-modify-write. Two servers recording the same player+day
		-- both read the same rows and the later SetAsync clobbered the other's
		-- append (lost update); the docs say SetAsync "may cause data
		-- inconsistency if two servers attempt to set the same key"
		-- (create.roblox.com GlobalDataStore, fetched 2026-09-25). Fix per
		-- t63.next_steal: UpdateAsync applies the transform to the latest
		-- stored value, so appends serialize. The transform copies then
		-- appends (no mutation of the passed table, nothing yielded) because
		-- the docs say it "will be called as many times as needed" with prior
		-- results discarded; a mutating transform could double-append on a
		-- retry. Schema unchanged: the value is still an array of entry rows,
		-- so pre-fix saves read back as-is. No batch queue: no caller loops N
		-- same-player records per visit (caller census, t74.check.txt), and
		-- buffering rows would trade durability for size.
		pcall(function()
			store:UpdateAsync(key, function(old)
				local rows = {}
				if type(old) == "table" then
					for i = 1, #old do rows[i] = old[i] end
				end
				rows[#rows + 1] = entry
				return rows
			end)
		end)
	end)
end

-- The Watchful Eye (199R pass): read another player's disposition — what the
-- ledger says about them, never raw chat. Disposition = ratio of noticing.
function ShadowLedger.disposition(ofPlayer: Player): string
	local list = sessionLedger[tostring(ofPlayer.UserId)]
	if not list or #list == 0 then return "THE LEDGER IS BLANK. THAT IS ITS OWN VERDICT." end
	local noticed = 0
	for _, e in ipairs(list) do
		if e.noticing then noticed += 1 end
	end
	local r = noticed / #list
	if r > 0.66 then return "SEES WHAT IS THERE. THE CHAIRS RATTLE WHEN THEY WALK PAST." end
	if r > 0.33 then return "GLANCES, SOMETIMES. THE HALL IS PATIENT WITH GLANCERS." end
	return "ATE PAST IT ALL. THE STEW KEEPS ITS RECIPE."
end

function ShadowLedger.onLeaving(player: Player)
	sessionLedger[tostring(player.UserId)] = nil
end

Players.PlayerRemoving:Connect(ShadowLedger.onLeaving)

return ShadowLedger
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="46">
      <Properties>
        <string name="Name">SkiZone</string>
        <string name="Source"><![CDATA[--!strict
-- SkiZone — the downhill. Translated from skifree.html: speed ramps over
-- time, score per frame, trees, and the crash -> yeti chase. The 49R
-- "skip the yeti" line is served by the Extra Life dev product (one rescue).

local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Config = require(Shared:WaitForChild("Config"))
local ShadowLedger = require(script.Parent:WaitForChild("ShadowLedger"))

local SkiZone = {}
local origin = Vector3.new(-120, 8, -120)
local runState: { [Player]: { speed: number, yeti: BasePart?, crashed: boolean } } = {}

local function spawnTree(pos: Vector3): BasePart
	local tree = Instance.new("Part")
	tree.Anchored = true
	tree.Size = Vector3.new(3, 12, 3)
	tree.Position = pos + Vector3.new(0, 6, 0)
	tree.Color = Color3.fromRGB(40, 90, 50)
	tree.Material = Enum.Material.Grass
	tree.Name = "Tree"
	tree.Parent = workspace
	return tree
end

local function spawnYeti(target: Player): BasePart
	local y = Instance.new("Part")
	y.Shape = Enum.PartType.Ball
	y.Size = Vector3.new(6, 6, 6)
	y.Color = Color3.fromRGB(235, 235, 245)
	y.Material = Enum.Material.Snow
	y.Name = "YETI"
	y.CanCollide = false
	local root = target.Character and target.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	y.Position = root and root.Position + Vector3.new(0, 0, 40) or origin
	y.Parent = workspace
	return y
end

function SkiZone.build(): Model
	local model = Instance.new("Model")
	model.Name = "SkiRun"

	local slope = Instance.new("Part")
	slope.Anchored = true
	slope.Size = Vector3.new(80, 1, 400)
	slope.CFrame = CFrame.new(origin) * CFrame.Angles(math.rad(12), 0, 0)
	slope.Color = Color3.fromRGB(226, 232, 240)
	slope.Material = Enum.Material.Snow
	slope.Parent = model

	-- seeded tree slalom: math.random is fine here (the replay-safe seed lives
	-- in SeedRng for anything score-bearing; trees are scenery)
	for _ = 1, 60 do
		spawnTree(origin + Vector3.new(math.random(-35, 35), math.random(-180, 180), math.random(-180, 180)))
	end

	model.Parent = workspace

	slope.Touched:Connect(function(hit)
		local player = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
		if player and not runState[player] then
			runState[player] = { speed = Config.Ski.baseSpeed, yeti = nil, crashed = false }
			ShadowLedger.record(player, "Ski", "dropped in", true)
		end
	end)

	Players.PlayerRemoving:Connect(function(p) runState[p] = nil end)
	return model
end

function SkiZone.tick(dt: number)
	for player, state in pairs(runState) do
		local char = player.Character
		if not char then continue end
		local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then continue end

		state.speed += Config.Ski.speedRampPerSec * dt -- speed ramps over time
		player:SetAttribute("SkiScore", (tonumber(player:GetAttribute("SkiScore")) or 0) + math.floor(state.speed * dt))

		-- crash -> the yeti comes (Extra Life product = one rescue)
		local hum = char:FindFirstChild("Humanoid") :: Humanoid?
		if hum and hum.Health <= 0 and not state.crashed then
			state.crashed = true
			state.yeti = spawnYeti(player)
		end
		if state.yeti and state.yeti.Parent and root then
			local dir = root.Position - state.yeti.Position
			state.yeti.AssemblyLinearVelocity = dir.Unit * (state.speed + 4) -- it is faster
			if dir.Magnitude < 6 then
				if (tonumber(player:GetAttribute("ExtraLives")) or 0) > 0 then
					player:SetAttribute("ExtraLives", player:GetAttribute("ExtraLives") - 1)
					state.yeti:Destroy()
					state.yeti = nil
					state.crashed = false
					ShadowLedger.record(player, "Ski", "spent an Extra Life on the yeti", true)
				elseif hum then
					hum.Health = 0
				end
			end
		end
	end
end

return SkiZone
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="47">
      <Properties>
        <string name="Name">SwarmZone</string>
        <string name="Source"><![CDATA[--!strict
-- SwarmZone — the bullet-hell port. Translated from dashboard/static/games/swarm.html:
-- horde density as the power fantasy, depth gates, upgrade pool with cursed picks,
-- and the 122bpm disco pulse driving the lights (SPB = 60/122/2, one 8th note).
-- Double Score pass (99R) doubles gem value; Extra Life dev product revives.
-- Q-032 flock pass: the crop is ALIVE — gems are spore fish riding shared/Flock
-- (flee/tire/rest + boids school + kill-drop toss + the stir warn), and the horde
-- steers by the pheromone trail the players lay down (fresher beats closer).

local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Config = require(Shared:WaitForChild("Config"))
local Trove = require(Shared:WaitForChild("Trove"))
local Flock = require(Shared:WaitForChild("Flock"))
local Monetization = require(script.Parent:WaitForChild("Monetization"))
local ShadowLedger = require(script.Parent:WaitForChild("ShadowLedger"))

local SwarmZone = {}
local origin = Vector3.new(-120, 8, 120) -- k-space: knowledge -3, practice +4
local ARENA = 90
local pulseT = 0
local light: Part? = nil
-- the flock field: floor top (part centered at origin.Y-1, size Y 1) + the fish's
-- 0.8 half-height = the rest height; walls one stud inside the arena rim
local FLOOR_Y = origin.Y - 0.5 + 0.8
local bounds: Flock.Bounds = {
	minX = origin.X - ARENA / 2 + 1,
	maxX = origin.X + ARENA / 2 - 1,
	minZ = origin.Z - ARENA / 2 + 1,
	maxZ = origin.Z + ARENA / 2 - 1,
	floorY = FLOOR_Y,
}

export type DepthMods = { gemMul: number, enemySpd: number, enemyHp: number, take: number, spawnMul: number, rate: number }

local upgrades: { { n: string, d: string, cursed: boolean?, f: (DepthMods) -> () } } = {
	{ n = "THE CROWD", d = "more bodies, softer bodies", f = function(m: DepthMods) m.spawnMul *= 1.4; m.enemyHp *= 0.75 end },
	{ n = "GLASS JAW", d = "they die fast, you die faster", f = function(m: DepthMods) m.enemyHp *= 0.5; m.take *= 1.3 end },
	{ n = "LONG TEETH", d = "your shots punch through", f = function(m: DepthMods) m.gemMul *= 1.2 end },
	{ n = "THE MOUNTAIN", d = "CURSED: enemies 30% harder, +40% fire rate", cursed = true,
		f = function(m: DepthMods) m.spawnMul *= 1.3; m.rate *= 1.4 end },
}

local active: { [Player]: { depthMods: DepthMods, diffLevel: number, spawnT: number, kills: number, alive: boolean, streak: number } } = {}
local pellets: { BasePart } = {}
-- the crop is alive: every gem is a spore fish (visual part + Flock state);
-- trail is the pheromone field the horde steers by
local school: { { part: BasePart, f: Flock.Fish } } = {}
local trail = Flock.trailNew()
local lastPellet: { [Player]: number } = {}
local lastTrail: { [Player]: number } = {}
local fishWarned = false -- "the fish stir..." warn, once per session (swarm.html:1074)
local announcer: BillboardGui? = nil

local STREAK_LINES = {
	[5] = "the grid remembers every hit.",
	[10] = "mark, the horde scales — tell them.",
	[25] = "the maze named its depths. i named nothing.",
}

local function announce(text: string)
	if not announcer then return end
	local lbl = announcer:FindFirstChildOfClass("TextLabel")
	if lbl then
		lbl.Text = text
		task.delay(3, function()
			if lbl.Parent then lbl.Text = "SWARM · 122 BPM" end
		end)
	end
end

function SwarmZone.build(): Part
	local floor = Instance.new("Part")
	floor.Anchored = true
	floor.Size = Vector3.new(ARENA, 1, ARENA)
	floor.Position = Vector3.new(origin.X, origin.Y - 1, origin.Z)
	floor.Color = Color3.fromRGB(18, 10, 24)
	floor.Material = Enum.Material.SmoothPlastic
	floor.Name = "SwarmArena"

	local arenaLight = Instance.new("Part")
	arenaLight.Anchored = true
	arenaLight.Size = Vector3.new(ARENA, 0.4, ARENA)
	arenaLight.Position = Vector3.new(origin.X, origin.Y + 30, origin.Z)
	arenaLight.Color = Color3.fromRGB(120, 40, 160)
	arenaLight.Material = Enum.Material.Neon
	arenaLight.Transparency = 0.6
	arenaLight.Parent = floor.Parent or workspace
	light = arenaLight

	floor.Touched:Connect(function(hit)
		local player = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
		if player and not active[player] then
			SwarmZone.enter(player)
		end
	end)

	Players.PlayerRemoving:Connect(function(p)
		active[p] = nil
		lastPellet[p] = nil
		lastTrail[p] = nil
	end)
	return floor
end

function SwarmZone.enter(player: Player)
	active[player] = {
		depthMods = { gemMul = 1, enemySpd = 1, enemyHp = 1, take = 1, spawnMul = 1, rate = 1 },
		diffLevel = 0, spawnT = 0.4, kills = 0, streak = 0, alive = true,
	}
	player:SetAttribute("DoubleScore", Monetization.owns(player, "DoubleScore"))
	ShadowLedger.record(player, "Swarm", "entered the disco horde", true)
end

-- a spore fish: the visual part rides the pure Flock state (the crop is ALIVE,
-- swarm.html:949); `toss` nil spawns it resting on the school floor
local function dropFish(pos: Vector3, toss: Vector3?)
	if #school >= Flock.POP_CAP then
		return
	end
	local g = Instance.new("Part")
	g.Shape = Enum.PartType.Ball
	g.Size = Vector3.new(1.6, 1.6, 1.6)
	g.Color = Color3.fromRGB(120, 220, 160)
	g.Material = Enum.Material.Neon
	g.Name = "Gem"
	g.Anchored = true -- the flock owns the position, tick by tick
	g.CanCollide = false
	local f = Flock.newFish(pos, toss)
	g.Position = f.pos
	g.Parent = workspace
	-- the upcast matters: table.insert's read-write position wants the property
	-- EXACTLY BasePart (Part's subtype is rejected there)
	table.insert(school, { part = g :: BasePart, f = f })
	task.delay(30, function()
		g:Destroy()
	end)
end

local function killEnemy(enemy: BasePart, by: Player?, state)
	-- the crop is alive: every kill drops a fish with the toss law (swarm.html:631)
	dropFish(enemy.Position, Flock.toss())
	enemy:Destroy()
	if by and state then
		state.kills += 1
		state.streak += 1
		local line = STREAK_LINES[state.streak]
		if line then announce(line) end -- the Arsenal law: streaks self-hype
	end
end

local function firePellet(player: Player, state)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return end
	local pellet = Instance.new("Part")
	pellet.Shape = Enum.PartType.Ball
	pellet.Size = Vector3.new(1, 1, 1)
	pellet.Color = Color3.fromRGB(255, 210, 90)
	pellet.Material = Enum.Material.Neon
	pellet.CanCollide = false
	pellet.CFrame = root.CFrame
	pellet.Name = "Pellet"
	pellet.Parent = workspace
	pellet.AssemblyLinearVelocity = root.CFrame.LookVector * 120
	table.insert(pellets, pellet)
	task.delay(1.5, function()
		pellet:Destroy()
	end)
end

local function spawnEnemy(target: Player, state)
	local enemy = Instance.new("Part")
	enemy.Shape = Enum.PartType.Ball
	enemy.Size = Vector3.new(2, 2, 2)
	enemy.Color = Color3.fromRGB(220, 60, 90)
	enemy.Material = Enum.Material.Neon
	enemy.Name = "HordeUnit"
	enemy:SetAttribute("Hp", state.depthMods.enemyHp)
	enemy:SetAttribute("Owner", target.Name)
	local root = target.Character and target.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return end
	enemy.Position = root.Position + Vector3.new(math.random(-60, 60), 2, math.random(-60, 60))
	enemy.CanCollide = false
	enemy.Parent = workspace
	local conn
	conn = enemy.Touched:Connect(function(hit)
		local plr = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
		if plr and active[plr] then
			active[plr].alive = false
			if plr.Character then plr.Character:BreakJoints() end
			conn:Disconnect()
			enemy:Destroy()
		end
	end)
	-- Q-043 Trove pass: the chase is OWNED by the enemy (AttachToInstance ->
	-- Destroying -> Clean cancels the thread), not by its 25s age. The 25s
	-- cap stays as game behavior but enforces itself by destroying the enemy
	-- (the false return ends the thread); the Touched kill above now cancels
	-- the chase immediately instead of leaving it polling enemy.Parent for
	-- up to 25s.
	local t0 = os.clock()
	local trove = Trove.new()
	trove:AttachToInstance(enemy)
	trove:Loop(0.08, function()
		if not enemy.Parent then return false end
		if os.clock() - t0 >= 25 then
			enemy:Destroy()
			return false
		end
		local hum = target.Character and target.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hum then
			-- pheromone steering (swarm.html:842-851): the trail you left pulls
			-- them when it's fresher than you are, else they walk straight at you
			local dir = Flock.trailSteer(trail, enemy.Position, hum.Position)
			if dir.Magnitude > 1e-4 then
				enemy.AssemblyLinearVelocity = dir * (8 * state.depthMods.enemySpd)
			end
		end
		return true
	end)
end

function SwarmZone.tick(dt: number)
	-- the disco pulse: arena light breathes at 122bpm (beatPulse from the original)
	pulseT += dt
	if light then
		local beatPulse = 0.5 + 0.5 * math.sin(pulseT * (Config.Swarm.BPM / 60) * math.pi * 2)
		light.Transparency = 0.6 - 0.25 * beatPulse
	end

	-- pellets vs the horde: the Fire ability (Z) made good
	for i = #pellets, 1, -1 do
		local pellet = pellets[i]
		if not pellet.Parent then
			table.remove(pellets, i)
		else
			for _, unit in ipairs(workspace:GetChildren()) do
				if unit.Name == "HordeUnit" and unit:IsA("BasePart")
					and (unit.Position - pellet.Position).Magnitude < 3.5 then
					local ownerName = unit:GetAttribute("Owner")
					local owner = ownerName and Players:FindFirstChild(ownerName)
					killEnemy(unit, owner, owner and active[owner :: Player])
					pellet:Destroy()
					break
				end
			end
		end
	end

	-- ambient seed fish (the source's crop arrives by kills only; the port's
	-- ambient spawner keeps the zone alive solo): they spawn RESTING, so the
	-- school is visible immediately — the boids core does the rest
	if math.random() < dt * 1.2 and #school < 12 then
		dropFish(Vector3.new(
			origin.X + math.random(-ARENA / 2, ARENA / 2),
			FLOOR_Y,
			origin.Z + math.random(-ARENA / 2, ARENA / 2)
		), nil)
	end

	for player, state in pairs(active) do
		if state.alive and player.Character then
			-- the school: player touch or pet-orb proximity (the orb grinds for
			-- you). The tired ones are the catchable ones — a fleeing fish
			-- outruns the ring until it rests, exactly like the source
			local root = player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local collectRadius = player:GetAttribute("PetOrb") and 12 or 3.5
				for gi = #school, 1, -1 do
					local entry = school[gi]
					local g = entry.part
					if g.Parent and (entry.f.pos - root.Position).Magnitude < collectRadius then
						g:Destroy()
						table.remove(school, gi)
						local mult = state.depthMods.gemMul * ((player:GetAttribute("DoubleScore") and 2 or 1))
						player:SetAttribute("SwarmScore", tonumber((player:GetAttribute("SwarmScore")) or 0) + math.floor(25 * mult))
					end
				end
				-- pheromone trail: walking leaves a whisper, firing leaves a shout
				-- (swarm.html:1113-1121; the Fire pellet is the port's loud action,
				-- life 5 vs 2.5 verbatim)
				local now = os.clock()
				if now - (lastTrail[player] or 0) >= Flock.TRAIL_DROP_INTERVAL then
					lastTrail[player] = now
					Flock.trailDrop(trail, root.Position, Flock.loudTrailLife(now - (lastPellet[player] or 0) < 0.45))
				end
			end
			-- Fire ability (Z): rate-limited per player — the attribute window is
			-- 0.15s but this clock keeps it to one pellet per pull (long teeth: faster)
			if player:GetAttribute("Abil_Fire") then
				local now = os.clock()
				local gate = state.depthMods.rate > 1 and 0.18 or 0.25
				if now - (lastPellet[player] or 0) >= gate then
					lastPellet[player] = now
					firePellet(player, state)
				end
			end

			state.diffLevel += dt / 6
			-- the horde must FILL the screen (verbatim spawn curve)
			state.spawnT -= dt
			if state.spawnT <= 0 then
				local spawnMul = state.depthMods.spawnMul
				state.spawnT = math.max(Config.Swarm.spawnFloor, Config.Swarm.baseSpawn - state.diffLevel * Config.Swarm.spawnRamp) / spawnMul
				for _ = 1, Config.Swarm.hordeCount(state.diffLevel, spawnMul) do
					spawnEnemy(player, state)
				end
			end
			-- score: gems value via gemMul; Double Score pass doubles
			local mult = state.depthMods.gemMul * ((player:GetAttribute("DoubleScore") and 2 or 1))
			player:SetAttribute("SwarmScore", tonumber(math.floor((player:GetAttribute("SwarmScore")) or 0) + dt * 10 * mult))
		end
	end

	-- THE FLOCK (Q-032): airborne fish flee the nearest diver and tire; rested
	-- fish school (cohesion + separation + wiggle); the visual parts ride the
	-- pure state. trail:step ages the pheromone field for the horde's steering.
	local roots: { BasePart } = {}
	for player, state in pairs(active) do
		if state.alive and player.Character then
			local root = player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				table.insert(roots, root)
			end
		end
	end
	local fishStates: { Flock.Fish } = {}
	for _, entry in school do
		table.insert(fishStates, entry.f)
	end
	for i = #school, 1, -1 do
		local entry = school[i]
		if not entry.part.Parent then
			table.remove(school, i)
			continue
		end
		local f = entry.f
		if not f.rest then
			-- flee the nearest diver (the source's single-player law, generalized
			-- to the nearest of whoever is in the arena)
			local nearest: BasePart? = nil
			local nd = math.huge
			for _, root in roots do
				local d = (root.Position - f.pos).Magnitude
				if d < nd then
					nd = d
					nearest = root
				end
			end
			if nearest then
				Flock.fleeStep(f, nearest.Position, dt, false, bounds)
				if Flock.caught(f, nearest.Position) then
					-- cornered mid-flight: the catch law (swarm.html:968 d0<15)
					entry.part:Destroy()
					table.remove(school, i)
					local owner = nearest.Parent and Players:GetPlayerFromCharacter(nearest.Parent)
					local st = owner and active[owner :: Player]
					if owner and st then
						local om = st.depthMods.gemMul * ((owner:GetAttribute("DoubleScore") and 2 or 1))
						owner:SetAttribute("SwarmScore", tonumber((owner:GetAttribute("SwarmScore")) or 0) + math.floor(25 * om))
					end
					continue
				end
			end
		else
			Flock.schoolStep(f, fishStates, pulseT, dt, FLOOR_Y)
		end
		entry.part.Position = f.pos
	end
	Flock.trailStep(trail, dt)
	-- "the fish stir..." (swarm.html:1074-1077): the crop warns before it matters
	if not fishWarned and #school >= Flock.STIR_AT then
		fishWarned = true
		announce("the fish stir...")
	end
end

return SwarmZone
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="48">
      <Properties>
        <string name="Name">TheAnswerBoss</string>
        <string name="Source"><![CDATA[--!strict
-- TheAnswerBoss — the summit. 5 phases, the 15-degree lean before the strike
-- in phase 3 (the tell), Calabi-Yau deflection (jump the fold) and the
-- Wing Chun redirect (turn the centerline, give it back).
-- The Answer's Weakness pass (499R) highlights the tell in phase 3.

local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local Lore = require(Shared:WaitForChild("Lore"))
local Trove = require(Shared:WaitForChild("Trove"))
local Monetization = require(script.Parent:WaitForChild("Monetization"))

local TheAnswerBoss = {}
local arena = Vector3.new(0, 8 + 30 * 6, -0) -- summit: depth 6 * 30 studs up
local running = false

local function telegraph(boss: Part, strikePos: Vector3, showTell: boolean)
	-- the lean: 15 degrees off true before it strikes (Lore.TheAnswer.tellDegrees)
	local lean = showTell and Lore.TheAnswer.tellDegrees or 0
	boss.CFrame = CFrame.new(boss.Position)
		* CFrame.Angles(math.rad(lean), 0, math.rad(lean))
	local conn
	conn = boss.Touched:Connect(function(hit)
		local player = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
		if player and player.Character then
			player.Character:BreakJoints() -- the strike lands unless deflected/redirected
			conn:Disconnect()
		end
	end)
	task.delay(0.9, function()
		conn:Disconnect()
		boss.CFrame = CFrame.new(strikePos)
	end)
end

function TheAnswerBoss.build(): Model
	local model = Instance.new("Model")
	model.Name = "TheAnswerArena"

	local platform = Instance.new("Part")
	platform.Anchored = true
	platform.Size = Vector3.new(90, 2, 90)
	platform.Position = Vector3.new(0, arena.Y - 1, 0)
	platform.Color = Color3.fromRGB(14, 12, 20)
	platform.Material = Enum.Material.Slate
	platform.Parent = model

	local boss = Instance.new("Part")
	boss.Anchored = true
	boss.Shape = Enum.PartType.Ball
	boss.Size = Vector3.new(10, 10, 10)
	boss.Position = arena + Vector3.new(0, 7, -24)
	boss.Color = Color3.fromRGB(200, 196, 210)
	boss.Material = Enum.Material.ForceField
	boss.Name = "THE ANSWER"
	boss.Parent = model

	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.new(0, 300, 0, 40)
	tag.StudsOffset = Vector3.new(0, 7, 0)
	tag.AlwaysOnTop = true
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.Text = Lore.TheAnswer.name .. " · " .. Lore.TheAnswer.prose[1]
	lbl.TextColor3 = Color3.fromRGB(235, 230, 210)
	lbl.Font = Enum.Font.Garamond
	lbl.TextSize = 18
	lbl.Parent = tag
	tag.Parent = boss

	local start = Instance.new("ProximityPrompt")
	start.ActionText = "Ask it anything"
	start.ObjectText = "THE ANSWER"
	start.HoldDuration = 2
	start.Parent = boss

	start.Triggered:Connect(function(player: Player)
		if running then return end
		running = true
		-- Q-043 Trove pass: the fight loop is OWNED by the boss's lifetime
		-- (AttachToInstance -> Destroying -> Clean cancels the thread). A boss
		-- destroyed mid-fight now ends the encounter instead of leaving a
		-- loop spawning fold-waves at a corpse (the old task.spawn died by
		-- error, unowned). The normal path is byte-identical: hp drains to 0,
		-- the thread finishes, running drops. Raw tracked thread, not
		-- trove:Loop — a phase paces itself with two different waits (3s
		-- telegraph, 2s strike) that a fixed-interval Loop cannot express.
		local fightTrove = Trove.new()
		fightTrove:AttachToInstance(boss)
		fightTrove:Add(task.spawn(function()
			local hp = 5 -- five phases; each landed redirect costs it a phase
			while hp > 0 do
				local phase = Lore.TheAnswer.phases - hp + 1
				lbl.Text = ("PHASE %d · %s"):format(phase, Lore.TheAnswer.prose[phase])

				-- the fold wave: jump it (Calabi-Yau deflection)
				local wave = Instance.new("Part")
				wave.Anchored = false
				wave.Size = Vector3.new(90, 1, 4)
				wave.CFrame = CFrame.new(boss.Position + Vector3.new(0, 1, 10))
				wave.Color = Color3.fromRGB(120, 110, 220)
				wave.Material = Enum.Material.Neon
				wave.CanCollide = false
				wave.Parent = model
				wave.AssemblyLinearVelocity = Vector3.new(0, 0, 30)
				local hitOnce = false
				wave.Touched:Connect(function(hit)
					if hitOnce then return end
					local charModel = hit.Parent :: Model?
					local plr = charModel and Players:GetPlayerFromCharacter(charModel)
					if plr and charModel then
						local root = charModel:FindFirstChild("HumanoidRootPart") :: BasePart?
						-- WING CHUN REDIRECT (C, 1.5s window): do not meet the mass;
						-- turn the centerline and give it back — a redirected wave
						-- costs THE ANSWER a phase (the only way to hurt it).
						if plr:GetAttribute("Abil_Redirect") == true then
							hitOnce = true
							plr:SetAttribute("RedirectedWave", tonumber((plr:GetAttribute("RedirectedWave")) or 0) + 1)
							hp -= 1
							lbl.Text = "THE WAVE TURNS AROUND. IT ANSWERS ITSELF."
							if wave.Parent then wave:Destroy() end
							return
						end
						-- Calabi-Yau deflection: airborne players fold over it untouched
						-- fix 2026-09-25 (t1a): 'char' was an undefined global here
						-- (luau-lsp TypeError at 115,25); root from line 102 is the
						-- same lookup, so the shadowed re-declaration was removed.
						if root and root.AssemblyLinearVelocity.Y > 4 then return end
						hitOnce = true
						charModel:BreakJoints()
					end
				end)
				task.delay(4, function() if wave.Parent then wave:Destroy() end end)

				-- the strike: telegraphed lean (visible tell if pass owned or late phases)
				task.wait(3)
				local showTell = phase >= Lore.TheAnswer.tellPhase + 1
					or Monetization.owns(player, "AnswersWeakness")
				telegraph(boss, boss.Position, showTell)
				task.wait(2)

				hp -= 1
			end
			lbl.Text = "IT ANSWERED ITSELF. THE CHAIRS AT BASECAMP ARE SIX AGAIN."
			running = false
		end))
	end)

	model.Parent = workspace
	return model
end

return TheAnswerBoss
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="49">
      <Properties>
        <string name="Name">ZoneGate</string>
        <string name="Source"><![CDATA[--!strict
-- ZoneGate: WORLDGEN_MINE.md law 4 (t35): zone access/buffs gated by
-- sphereAlliance. Each WAVE zone joins one generator_region_spheres key.
-- The region rows are GENERATED (shared/RegionSpheres.luau, df_spheres.json
-- verbatim). t67 spec: the gate owns no zone-name list. The join is
-- authored once per WAVE row as the strict-required `region` field in
-- init.server.luau, and the derived map is handed to ZoneGate.init, so a
-- zone cannot exist without a join (type error) and a join without its
-- zone cannot be written (the map is derived, not a second list; t64's
-- audit proved the old two lists were diff-identical 11 vs 11 by
-- discipline alone, the silent-drift seam this removes). The player's
-- sphere is drawn once per soul from the 130, deterministic from the
-- UserId (no UI, no DataStore, re-derivable). Portal pick per
-- Worldgen.zoneAlliance against the region's spheres (opposition outranks
-- kinship, so any opposed sphere decides):
--   allied      -> portal open + one VirtueMark per BUFF_SECONDS per zone
--   independent -> portal open, no effect (a negative is a fact)
--   opposed     -> locked door. NOT implemented: every sourced region row is
--                  unaligned spheres, so opposed is unreachable today and a
--                  dead branch would be fallback creep. If the mine ever
--                  grows an aligned region row, this is the seam that grows
--                  the lock.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Modules")
local RegionSpheres = require(Shared:WaitForChild("RegionSpheres"))
local SeedRng = require(Shared:WaitForChild("SeedRng"))
local ShadowLedger = require(script.Parent:WaitForChild("ShadowLedger"))
local Worldgen = require(Shared:WaitForChild("Worldgen"))

local ZoneGate = {}

-- t67: derived join, filled by ZoneGate.init from the WAVE rows (see
-- header spec). NONE is never picked: its row is empty, a zone joined to
-- it would carry no gate and the law would be silent furniture.
local zoneRegions: { [string]: string } = {}

local BUFF_SECONDS = 300
local REFUSAL_SECONDS = 5

-- t46 spec (WORLDGEN_MINE.md law 4, REPLICATED): the gate's verdict travels
-- to the client so the ring can be tinted without the client re-running the
-- authored join. Attribute names reject spaces, so the zone sanitizes to
-- underscores exactly like the Portal_ pad suffix is read back; one pure
-- function both sides share, values always ZoneGate.allianceFor's own.
local function gateAttr(zone: string): string
	local safe = zone:gsub("%W", "_")
	return "Gate_" .. safe
end

local lastBuff: { [string]: number } = {} -- "userId|zone" -> os.time()
local lastRefusal: { [number]: number } = {} -- userId -> os.time()

-- one sphere per soul: seeded by the UserId so the same player returns to
-- the same allegiance without any picker UI
local function ensureSphere(player: Player): string
	local existing = player:GetAttribute("Sphere")
	if typeof(existing) == "string" then
		return existing
	end
	local rng = SeedRng.new(player.UserId * 7919)
	local sphere = Worldgen.SPHERES[rng:int(1, #Worldgen.SPHERES)]
	player:SetAttribute("Sphere", sphere)
	return sphere
end

-- alliance across the region's whole sphere row: opposition outranks
-- kinship (law 4 precedence), so the first opposed sphere decides and
-- otherwise any allied sphere marks the region as kin
function ZoneGate.allianceFor(sphere: string, region: string): string
	local row = RegionSpheres.REGION_SPHERES[region]
	if not row then
		return "independent" -- unjoined region: no kin, no enmity (a fact)
	end
	local verdict = "independent"
	for _, s in ipairs(row) do
		local a = Worldgen.zoneAlliance(sphere, s)
		if a == "opposed" then
			return "opposed"
		elseif a == "allied" then
			verdict = "allied"
		end
	end
	return verdict
end

-- the portal hook: true = take the teleport, false = refused at the ring
function ZoneGate.portalGate(player: Player, zone: string): boolean
	local region = zoneRegions[zone]
	if not region then
		return true -- fixed climbs carry no join, so no gate (a fact)
	end
	local sphere = ensureSphere(player)
	local alliance = ZoneGate.allianceFor(sphere, region)
	if alliance == "opposed" then
		local now = os.time()
		if now - (lastRefusal[player.UserId] or 0) >= REFUSAL_SECONDS then
			lastRefusal[player.UserId] = now
			ShadowLedger.record(player, "Basecamp",
				("the portal to %s refuses you: your sphere %s stands opposed to the %s")
					:format(zone, sphere, region), false)
		end
		return false
	end
	if alliance == "allied" then
		local key = ("%d|%s"):format(player.UserId, zone)
		local now = os.time()
		if now - (lastBuff[key] or 0) >= BUFF_SECONDS then
			lastBuff[key] = now
			player:SetAttribute("VirtueMarks", (player:GetAttribute("VirtueMarks") or 0) + 1)
			ShadowLedger.record(player, "Basecamp",
				("the %s region welcomes a %s soul: the way is open (+1 Virtue Mark)")
					:format(region, sphere), true)
		end
	end
	return true
end

-- t67: receives the join derived from the WAVE rows; init.server.luau is
-- the single authorship site, this call is the only writer
function ZoneGate.init(regions: { [string]: string })
	zoneRegions = regions
	local function attach(player: Player)
		local sphere = ensureSphere(player)
		-- t46: stamp the same allianceFor verdict the gate enforces, once at
		-- join (sphere never changes, so the verdicts are static per soul);
		-- climb portals get no attribute, they carry no join and no tint
		for zone, region in pairs(zoneRegions) do
			player:SetAttribute(gateAttr(zone), ZoneGate.allianceFor(sphere, region))
		end
	end
	Players.PlayerAdded:Connect(attach)
	for _, p in ipairs(Players:GetPlayers()) do
		attach(p)
	end
end

return ZoneGate
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="50">
      <Properties>
        <string name="Name">zones_extra</string>
      </Properties>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">ErosionFieldZone</string>
          <string name="Source"><![CDATA[--!strict
-- ErosionFieldZone — translated from dashboard/static/erosion_field.html (B1 v1).
-- Technique family credited to Rune Skovbo Johansen (runevision, Shadertoy
-- sf23W1): talus-limited slide + slope creep, 2 ping-pong erode passes, 7
-- engines upwell, the rim drains to sea, 6 marbles roll under -grad(h) and
-- abrade. Paint raise/carve under your feet; grain carved off your stroke banks.
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local SeedRng = require(Shared:WaitForChild("SeedRng"))
local ShadowLedger = require((script.Parent:FindFirstChild("ShadowLedger") or script.Parent.Parent:WaitForChild("ShadowLedger")) :: ModuleScript)

local ErosionFieldZone = {}
local origin = Vector3.new(0, 8, -420)
local GW, GH, CELL = 120, 80, 4 -- source was 240x150 cells; half res, same operator
local STUD, HEIGHT = 0.5, 12 -- 480x320 field-px; HEIGHT CLAIMED: studs per unit h
local TALUS, KF, CREEP, DRAIN = 0.010, 0.125, 0.045, 0.985
local H: { number } = table.create(GW * GH, 0)
local H2: { number } = table.create(GW * GH, 0)
local paintedBy: { [number]: Player? } = {}
local tiles: { BasePart } = {}
-- annotation exactness (t42 triage, lanes/t42.check.txt row 7): marbles hold Instance.new("Part") (line 168); stepMarble below takes the same entries. Runtime unchanged.
local marbles: { { x: number, y: number, vx: number, vy: number, part: Part } } = {}
local brush: { [Player]: number } = {} -- +1 raise, -1 carve (source L / R-drag)
local nextPaint: { [Player]: number } = {}
local bankedOnce: { [Player]: boolean } = {}
local erodeAcc, tileClock = 0, 0
local rng = SeedRng.new(20260903) -- field ts 2026-09-03

local ENGINES = { -- source lights, halved px: { x, y, intensity }
	{ 70, 45, 0.10 }, { 210, 40, 0.43 }, { 350, 45, 0.43 }, { 90, 165, 0.51 },
	{ 215, 230, 0.59 }, { 380, 190, 0.51 }, { 435, 100, 0.43 },
}
local MESAS = { -- source occluders, halved px: { x, y, w, h }
	{ 100, 65, 22, 75 }, { 230, 165, 22, 85 }, { 350, 55, 22, 75 }, { 310, 215, 22, 60 },
}
local SEATS = { { 20, 150 }, { 35, 150 }, { 50, 150 }, { 20, 210 }, { 35, 210 }, { 50, 210 } }
local BRUSHES: { { name: string, mode: number, color: Color3 } } = {
	{ name = "raise", mode = 1, color = Color3.fromRGB(232, 236, 245) },
	{ name = "carve", mode = -1, color = Color3.fromRGB(255, 107, 107) },
}
local STOPS = { -- hypsometric palette (sea below 0.205), exact from source
	{ 0.00, 10, 24, 46 }, { 0.12, 18, 44, 78 }, { 0.20, 40, 78, 110 },
	{ 0.24, 126, 116, 82 }, { 0.32, 56, 82, 50 }, { 0.52, 76, 106, 62 },
	{ 0.70, 104, 99, 90 }, { 0.88, 128, 123, 113 }, { 1.05, 226, 232, 240 },
}

local function pal(h: number): Color3
	if h <= STOPS[1][1] then return Color3.fromRGB(STOPS[1][2], STOPS[1][3], STOPS[1][4]) end
	for s = 1, #STOPS - 1 do
		local a, b = STOPS[s], STOPS[s + 1]
		if h <= b[1] then
			local t = (h - a[1]) / (b[1] - a[1])
			return Color3.fromRGB(a[2] + (b[2] - a[2]) * t, a[3] + (b[3] - a[3]) * t, a[4] + (b[4] - a[4]) * t)
		end
	end
	local top = STOPS[#STOPS] ; return Color3.fromRGB(top[2], top[3], top[4])
end

-- one quadratic splat serves PASS 0 paint, PASS 1b upwell, and mesa seeding
local function splat(px: number, py: number, radCells: number, amp: number, who: Player?)
	local cx, cy = px / CELL, py / CELL
	for j = math.max(1, math.floor(cy - radCells)), math.min(GH - 2, math.ceil(cy + radCells)) do
		for i = math.max(1, math.floor(cx - radCells)), math.min(GW - 2, math.ceil(cx + radCells)) do
			local q = 1 - ((i - cx) ^ 2 + (j - cy) ^ 2) / (radCells * radCells)
			if q > 0 then
				local k = j * GW + i
				H[k] += amp * q * q ; if who then paintedBy[k] = who end
			end
		end
	end
end

local function seedField()
	for j = 0, GH - 1 do
		for i = 0, GW - 1 do
			local x, y = i / GW, j / GH -- det spine: sine relief, no RNG
			local h = 0.30 + 0.10 * math.sin(x * 7.3 + y * 3.1) + 0.07 * math.sin(x * 13.7 - y * 9.2 + 1.7)
				+ 0.05 * math.sin(x * 23 + y * 31 + 4.1)
			H[j * GW + i] = math.max(0.02, h)
		end
	end
	for _, o in ipairs(MESAS) do -- occluders stand as high ground (mesa + skirt)
		local cx, cy = (o[1] + o[3] / 2) / CELL, (o[2] + o[4] / 2) / CELL
		local rw, rh = o[3] / (2 * CELL), o[4] / (2 * CELL)
		for j = math.max(1, math.floor(cy - rh - 8)), math.min(GH - 2, math.ceil(cy + rh + 8)) do
			for i = math.max(1, math.floor(cx - rw - 8)), math.min(GW - 2, math.ceil(cx + rw + 8)) do
				local dx, dy = math.max(math.abs(i - cx) - rw, 0), math.max(math.abs(j - cy) - rh, 0)
				local w = math.max(0, 1 - math.sqrt(dx * dx + dy * dy) / 8) ; H[j * GW + i] += w * w * 0.85
			end
		end
	end
	for _, L in ipairs(ENGINES) do -- lights become hills: q^2 falloff, hh = 0.2+0.8I
		splat(L[1], L[2], (40 + 130 * L[3]) / CELL, 0.2 + 0.8 * L[3], nil)
	end
end

-- PASS 1 — gather-form, order-free per-cell operator (the source's fragment
-- shader body): spill past the talus angle, creep below it, drain the rim.
local function erodePass(src: { number }, dst: { number })
	for j = 0, GH - 1 do
		for i = 0, GW - 1 do
			local k, h = j * GW + i, src[j * GW + i]
			local hL = i > 0 and src[k - 1] or h ; local hR = i < GW - 1 and src[k + 1] or h
			local hU = j > 0 and src[k - GW] or h ; local hD = j < GH - 1 and src[k + GW] or h
			local fin, fout = 0, 0
			local d = hL - h ; if d > TALUS then fin += d - TALUS elseif d < -TALUS then fout += -d - TALUS end
			d = hR - h ; if d > TALUS then fin += d - TALUS elseif d < -TALUS then fout += -d - TALUS end
			d = hU - h ; if d > TALUS then fin += d - TALUS elseif d < -TALUS then fout += -d - TALUS end
			d = hD - h ; if d > TALUS then fin += d - TALUS elseif d < -TALUS then fout += -d - TALUS end
			local nh = h + (fin - fout) * KF
			nh += ((hL + hR + hU + hD) * 0.25 - h) * CREEP -- sub-talus creep
			if i == 0 or j == 0 or i == GW - 1 or j == GH - 1 then nh *= DRAIN end -- rim drain
			dst[k] = nh
		end
	end
end

local function sampleH(px: number, py: number): number
	local gx, gy = math.clamp(px / CELL - 0.5, 0, GW - 1.001), math.clamp(py / CELL - 0.5, 0, GH - 1.001)
	local i, j = math.floor(gx), math.floor(gy)
	local u, v, k = gx - i, gy - j, j * GW + i
	return H[k] * (1 - u) * (1 - v) + H[k + 1] * u * (1 - v) + H[k + GW] * (1 - u) * v + H[k + GW + 1] * u * v
end

-- PASS 2 — marbles: gravity along -grad(h) with momentum; the roll abrades
-- same entry type as the marbles table (t42 triage, lanes/t42.check.txt row 7), annotation only
local function stepMarble(m: { x: number, y: number, vx: number, vy: number, part: Part })
	local gx = sampleH(m.x + 2.5, m.y) - sampleH(m.x - 2.5, m.y)
	local gy = sampleH(m.x, m.y + 2.5) - sampleH(m.x, m.y - 2.5)
	m.vx -= gx * 2.8 ; m.vy -= gy * 2.8
	m.vx = m.vx * 0.986 + (rng:next() - 0.5) * 0.05 -- stochastic flesh: jitter
	m.vy = m.vy * 0.986 + (rng:next() - 0.5) * 0.05
	local sp = math.sqrt(m.vx * m.vx + m.vy * m.vy)
	if sp > 6 then m.vx *= 6 / sp ; m.vy *= 6 / sp end
	m.x += m.vx ; m.y += m.vy
	if m.x < 6 then m.x = 6 ; m.vx *= -0.5 end ; if m.x > 474 then m.x = 474 ; m.vx *= -0.5 end
	if m.y < 6 then m.y = 6 ; m.vy *= -0.5 end ; if m.y > 314 then m.y = 314 ; m.vy *= -0.5 end
	local k = math.clamp(math.floor(m.y / CELL), 0, GH - 1) * GW + math.clamp(math.floor(m.x / CELL), 0, GW - 1)
	H[k] -= 0.0025 ; if H[k] < 0.02 then H[k] = 0.02 end -- abrasion: dust leaves
	local p = paintedBy[k]
	if p and p.Parent then -- grain carved off your stroke = credit
		p:SetAttribute("ErosionBanked", (tonumber(p:GetAttribute("ErosionBanked")) or 0) + 1)
		if not bankedOnce[p] then
			bankedOnce[p] = true
			ShadowLedger.record(p, "ErosionField", "first grain banked - the marbles carve where you wrote", true)
		end
	end
	m.part.Position = origin + Vector3.new(m.x * STUD, sampleH(m.x, m.y) * HEIGHT + 1.3, m.y * STUD)
end

local function refreshTiles()
	for tz = 0, 19 do
		for tx = 0, 29 do
			local h, t = H[(tz * 4 + 2) * GW + (tx * 4 + 2)], tiles[tz * 30 + tx + 1]
			t.Position = origin + Vector3.new(tx * 8 + 4, h * HEIGHT, tz * 8 + 4) ; t.Color = pal(h)
		end
	end
end

function ErosionFieldZone.build(): Model
	local model = Instance.new("Model")
	model.Name = "ErosionField"
	seedField()
	for _ = 1, 30 * 20 do -- terrain: 30x20 slabs of 8x8 studs (4x4 cells each)
		local t = Instance.new("Part")
		t.Anchored = true ; t.Size = Vector3.new(8, 1, 8) ; t.Parent = model ; table.insert(tiles, t)
	end
	refreshTiles()
	for i, w in ipairs(SEATS) do -- six marbles from the source walkers
		local m = Instance.new("Part")
		m.Shape = Enum.PartType.Ball ; m.Size = Vector3.new(1.6, 1.6, 1.6)
		m.Color = Color3.fromRGB(238, 242, 248) ; m.Material = Enum.Material.SmoothPlastic
		m.Name = "Marble" .. i ; m.Parent = model
		table.insert(marbles, { x = w[1], y = w[2], vx = 0, vy = 0, part = m })
	end
	for bi, def in ipairs(BRUSHES) do -- the film writes back under your feet
		local s = Instance.new("Part")
		s.Anchored = true ; s.Size = Vector3.new(6, 4, 6) ; s.Color = def.color
		s.Material = Enum.Material.Neon ; s.Position = origin + Vector3.new(-20, 3, bi * 14 - 7)
		s.Name = def.name .. "Brush" ; s.Parent = model
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Take the " .. def.name .. " brush"
		prompt.ObjectText = "erosion field" ; prompt.HoldDuration = 0.25 ; prompt.Parent = s
		prompt.Triggered:Connect(function(player: Player)
			brush[player] = def.mode
			ShadowLedger.record(player, "ErosionField", "took the " .. def.name .. " brush", true)
		end)
	end
	model.Parent = workspace
	Players.PlayerRemoving:Connect(function(p)
		brush[p] = nil ; nextPaint[p] = nil ; bankedOnce[p] = nil
		for k, who in pairs(paintedBy) do if who == p then paintedBy[k] = nil end end
	end)
	return model
end

function ErosionFieldZone.tick(dt: number)
	erodeAcc += dt
	if erodeAcc >= 0.125 then -- source frame: 2 ping-pong passes, then upwell
		erodeAcc = 0
		for _ = 1, 2 do erodePass(H, H2) ; local tmp = H ; H = H2 ; H2 = tmp end
		for _, L in ipairs(ENGINES) do splat(L[1], L[2], 3.5, 0.00007 * L[3], nil) end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		local mode = brush[p]
		local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if mode and root and os.clock() >= (nextPaint[p] or 0) then
			local rel = root.Position - origin
			local px, py = rel.X / STUD, rel.Z / STUD
			if px > 6 and px < 474 and py > 6 and py < 314 then
				nextPaint[p] = os.clock() + 0.15
				splat(px, py, 9, mode * 0.06, p) -- strokes are steering packets
			end
		end
	end
	for _, m in ipairs(marbles) do stepMarble(m) end
	tileClock += dt
	if tileClock >= 0.3 then tileClock = 0 ; refreshTiles() end
end

return ErosionFieldZone
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">FrontierSoulsZone</string>
          <string name="Source"><![CDATA[--!strict
-- FrontierSoulsZone — the rim of the desert, where DEATH waits. Quote-translated
-- from dashboard/static/games/frontier_souls.html (death, the boss — three phases,
-- and none of them kind): hunt-lunge (0.55s tell, 640 speed), scythe sweep (0.6
-- windup, 1.0 rad cone, chains from phase 2), dagger fans (5/7), shadow-steps in
-- phase 3, phase gates at 66%/33% hp, presence drain, soul timer (130s; death
-- eats 10s/8s per landed hit and heals 40/30). Player loadout = MARROW (mid
-- archetype): hp 120, shot 16*0.8 dmg, shotCd 0.62, speed 480, life 1.1; roll:
-- cd 0.62, rollT 0.26, iframes 0.34, roll speed 380; hurt() grants 0.55s iframes.
-- Input law: Abil_Fire = the gun, Abil_Redirect = the roll (client courier).
-- GAPS (kept to hold the line budget): withered adds in phase 2, the deputy
-- combine, whiskey slow-mo, canyon ring world, grudge naming, dynamite, snake
-- tell law, death's audio pulse. No score-bearing rng draws: the source's
-- playerShot() has none (crit lives in playerSwing, not ported).

local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local ShadowLedger = require((script.Parent:FindFirstChild("ShadowLedger") or script.Parent.Parent:WaitForChild("ShadowLedger")) :: ModuleScript)

local FrontierSoulsZone = {}
local origin = Vector3.new(-200, 8, -200)

-- source constants (frontier_souls.html, verbatim)
local TIMER_MAX = 130
local PRESENCE_R, PRESENCE_DRAIN = 260, 1.5            -- d < 260 drains soul at 1.5/s
local DEATH_HP, DEATH_SPD, DEATH_DMG = 900, 100, 40    -- death: hp 900, spd 100, dmg 40
local SWEEP_RANGE, SWEEP_CONE, SWEEP_WINDUP = 165, 1.0, 0.6
local LUNGE_TELL, LUNGE_SPEED, LUNGE_TIME = 0.55, 640, 0.34
local FAN_SPREAD, SHOT_LIFE = 0.16, 1.1
local SHOT_DMG, SHOT_SPEED, SHOT_CD = 16 * 0.8, 480, 0.62 -- marrow shotMul 0.8; shot v=480, life 1.1
local ROLL_CD, ROLL_T, ROLL_IFRAMES, ROLL_SPEED, HURT_IFRAMES = 0.62, 0.26, 0.34, 380, 0.55

-- annotation exactness (t42 triage, lanes/t42.check.txt row 6): Death.part stores Instance.new("Part") (line 93); BasePart in the alias failed the exact-table literal check at the arena.death assign. Runtime unchanged.
type Death = { part: Part, hp: number, phase: number, cd: number, lungeCd: number, tpT: number,
	state: string, st: number, lt: number, sweep: number, sweepA: number, chained: boolean, lx: number, lz: number }

local arena: { player: Player?, death: Death?, timer: number, started: boolean } = { player = nil, death = nil, timer = TIMER_MAX, started = false }
local fireCd: { [Player]: number } = {}
local rollCd: { [Player]: number } = {}
local iframes: { [Player]: number } = {}

local function distTo(root: BasePart, p: BasePart): (number, number, number)
	local d = root.Position - p.Position
	local flat = Vector3.new(d.X, 0, d.Z)
	return flat.Magnitude, d.X / math.max(flat.Magnitude, 0.01), d.Z / math.max(flat.Magnitude, 0.01)
end

local function spawnShot(from: Vector3, dir: Vector3, speed: number, dmg: number, name: string, color: Color3)
	local s = Instance.new("Part")
	s.Shape = Enum.PartType.Ball
	s.Size = Vector3.new(2, 2, 2)
	s.Position = from
	s.Color = color
	s.Material = Enum.Material.Neon
	s.CanCollide = false
	s.Name = name
	s.Parent = workspace
	s.AssemblyLinearVelocity = dir * speed
	task.delay(SHOT_LIFE, function() if s.Parent then s:Destroy() end end)
	return s
end

function FrontierSoulsZone.build(): Model
	local model = Instance.new("Model")
	model.Name = "FrontierSouls"

	local flats = Instance.new("Part")
	flats.Anchored = true
	flats.Size = Vector3.new(400, 1, 400)
	flats.Position = origin - Vector3.new(0, 1, 0)
	flats.Color = Color3.fromRGB(184, 156, 116) -- sand
	flats.Material = Enum.Material.Sand
	flats.Parent = model

	local rim = Instance.new("Part") -- the portal beacon: rim blood-red
	rim.Anchored = true
	rim.Shape = Enum.PartType.Cylinder
	rim.Size = Vector3.new(2, 10, 10)
	rim.CFrame = CFrame.new(origin + Vector3.new(0, 5, -60)) * CFrame.Angles(0, 0, math.rad(90))
	rim.Color = Color3.fromRGB(192, 80, 56) -- #c05038, the hurt red
	rim.Material = Enum.Material.Neon
	rim.Parent = model

	model.Parent = workspace

	rim.Touched:Connect(function(hit)
		local player = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
		if not player or arena.started or not player.Character then return end
		arena.started, arena.player, arena.timer = true, player, TIMER_MAX
		local hum = player.Character:FindFirstChild("Humanoid") :: Humanoid
		hum.MaxHealth, hum.Health = 120, 120 -- marrow hp 120
		ShadowLedger.record(player, "FrontierSouls", "walked the rim and woke DEATH", true)

		local d = Instance.new("Part") -- he waits out ahead — never on top of you (420 out)
		d.Shape = Enum.PartType.Ball
		d.Size = Vector3.new(40, 40, 40) -- r 20
		d.Position = origin + Vector3.new(0, 21, 420)
		d.Color = Color3.fromRGB(90, 84, 100)
		d.Material = Enum.Material.Slate
		d.Name = "DEATH"
		d.Anchored = true
		d.Parent = model
		arena.death = { part = d, hp = DEATH_HP, phase = 1, cd = 4.5, lungeCd = 2.5,
			tpT = 7, state = "idle", st = 0, lt = 0, sweep = 0, sweepA = 0, chained = false, lx = 0, lz = 0 }
	end)
	return model
end

function FrontierSoulsZone.tick(dt: number)
	local player = arena.player
	local death = arena.death
	if not (player and death and death.part.Parent) then return end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = char and char:FindFirstChild("Humanoid") :: Humanoid?
	if not (root and hum and hum.Health > 0) then return end

	-- the soul timer: presence withers it, every kill buys road (we credit phase gates instead of packs)
	arena.timer -= dt * ((distTo(root, death.part)) < PRESENCE_R and PRESENCE_DRAIN or 0.15)
	player:SetAttribute("SoulTimer", math.max(0, math.floor(arena.timer)))
	if arena.timer <= 0 then hum.Health = 0 end
	fireCd[player] = math.max(0, (fireCd[player] or 0) - dt)
	rollCd[player] = math.max(0, (rollCd[player] or 0) - dt)
	iframes[player] = math.max(0, (iframes[player] or 0) - dt)

	-- Abil_Redirect = the roll: 30→n/a here, cd 0.62, rollT 0.26, iframes 0.34, speed 380
	if player:GetAttribute("Abil_Redirect") == true and rollCd[player] == 0 then
		rollCd[player], iframes[player] = ROLL_CD, ROLL_IFRAMES
		local look = root.CFrame.LookVector
		root.AssemblyLinearVelocity = Vector3.new(look.X, 0, look.Z).Unit * ROLL_SPEED
		ShadowLedger.record(player, "FrontierSouls", "rolled", true)
	end

	-- Abil_Fire = the gun: shot 480, life 1.1, dmg 16*0.8, cd 0.62 (nx points death->player, so aim -n)
	if player:GetAttribute("Abil_Fire") == true and fireCd[player] == 0 then
		fireCd[player] = SHOT_CD
		local _, tx, tz = distTo(root, death.part)
		spawnShot(root.Position - Vector3.new(tx * 7, 0, tz * 7), Vector3.new(-tx, 0, -tz),
			SHOT_SPEED, SHOT_DMG, "PlayerShot", Color3.fromRGB(232, 180, 90)).Touched:Connect(function(hit)
			if hit == death.part and death.part.Parent then
				death.hp -= SHOT_DMG
			end
		end)
	end

	local d, nx, nz = distTo(root, death.part)
	-- phase gates: 66% -> THE HARVEST, 33% -> THE REAPING (he stops walking)
	if death.phase == 1 and death.hp / DEATH_HP <= 0.66 then death.phase, death.cd, death.lungeCd = 2, 1.6, 1.4
	elseif death.phase == 2 and death.hp / DEATH_HP <= 0.33 then death.phase, death.tpT = 3, 1.2 end
	local ph = death.phase -- read after the gates, like the source

	-- phase 3: death steps between the shadows (tpT 7, 0.5 fade, flank 220 ±0.8 rad)
	if ph == 3 then
		death.tpT -= dt
		if death.tpT <= 0 and death.state ~= "tpOut" then
			death.tpT, death.state, death.st = 7, "tpOut", 0.5
		elseif death.state == "tpOut" then
			death.st -= dt
			if death.st <= 0 then
				local flank = math.atan2(-nz, -nx) + (death.hp % 2 < 1 and 0.8 or -0.8)
				death.part.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(flank), 0, math.sin(flank)) * 220 + Vector3.new(0, 21, 0))
				death.state, death.cd = "idle", math.min(death.cd, 0.5)
			end
			return -- mid-step: he is nowhere
		end
	end

	death.cd -= dt
	death.lungeCd -= dt
	if death.state == "lungeTel" then -- the tell: 0.55s, then 640 for 0.34s
		death.st -= dt
		if death.st <= 0 then death.state, death.lt, death.lx, death.lz = "lunging", LUNGE_TIME, nx, nz end
	elseif death.state == "lunging" then
		death.lt -= dt
		death.part.CFrame = death.part.CFrame + Vector3.new(death.lx, 0, death.lz) * LUNGE_SPEED * dt
		if d < 28 and iframes[player] == 0 then -- r 20 + r 12 + 8 -> ~28
			hum:TakeDamage(DEATH_DMG) iframes[player] = HURT_IFRAMES
			arena.timer = math.max(0, arena.timer - 10) -- the scythe drinks: 10s of soul
			death.hp = math.min(DEATH_HP, death.hp + 40) -- death feeds
			ShadowLedger.record(player, "FrontierSouls", "was reaped by the lunge — death fed", false)
		end
		if death.lt <= 0 then death.state = "idle" end
	elseif d > PRESENCE_R then -- far: dagger fans — tighter and faster the deeper his phase
		if death.cd <= 0 then
			death.cd = if ph == 3 then 1.5 else 1.9
			local n = if ph == 3 then 7 else 5
			for k = -math.floor(n / 2), math.floor(n / 2) do
				local a = math.atan2(nz, nx) + k * FAN_SPREAD
				local shot = spawnShot(death.part.Position, Vector3.new(math.cos(a), 0, math.sin(a)),
					ph == 3 and 320 or 280, 14, "Dagger", Color3.fromRGB(216, 210, 192))
				shot.Touched:Connect(function(hit)
					if hit.Parent == char and iframes[player] == 0 then
						hum:TakeDamage(14) iframes[player] = HURT_IFRAMES
					end
				end)
			end
		end
		if death.lungeCd <= 0 and d < 560 then
			death.lungeCd = ph == 3 and 2.4 or 3.4
			death.state, death.st = "lungeTel", LUNGE_TELL
		end
	else -- close: the scythe — 0.6 windup, 1.0 rad cone, 165 range
		death.part.CFrame = death.part.CFrame + Vector3.new(nx, 0, nz) * DEATH_SPD * dt
		if death.cd <= 0 then
			death.sweep, death.sweepA = SWEEP_WINDUP, math.atan2(nz, nx)
			death.cd = if ph == 3 then 1.3 elseif ph == 2 then 2.0 else 2.6
			death.chained = ph >= 2
		end
	end

	if death.sweep > 0 then
		death.sweep -= dt
		if death.sweep <= 0 then
			local pa = math.atan2(root.Position.Z - death.part.Position.Z, root.Position.X - death.part.Position.X)
			local diff = pa - death.sweepA
			while diff > math.pi do diff -= 2 * math.pi end
			while diff < -math.pi do diff += 2 * math.pi end
			if math.abs(diff) < SWEEP_CONE and d < SWEEP_RANGE and iframes[player] == 0 then
				hum:TakeDamage(DEATH_DMG) iframes[player] = HURT_IFRAMES
				arena.timer = math.max(0, arena.timer - 8)
				death.hp = math.min(DEATH_HP, death.hp + 30)
				ShadowLedger.record(player, "FrontierSouls", "took the scythe — death fed again", false)
			end
			if death.chained then -- phase 2+: it comes around again, from the other side
				death.chained = false
				death.sweep, death.sweepA = 0.45, death.sweepA + 2.1
			end
		end
	end

	if death.hp <= 0 then -- DEATH FALLS
		death.part:Destroy()
		arena.death, arena.started = nil, false
		arena.timer = TIMER_MAX
		ShadowLedger.record(player, "FrontierSouls", "felled DEATH at the rim", true)
	end
end

return FrontierSoulsZone
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">GalleryZone</string>
          <string name="Source"><![CDATA[--!strict
-- GalleryZone — "The Estate Gallery": the operator's static web gallery made
-- physical. One roof, three pedestals:
--   1. Isfahan Lattice — seeded Voronoi glass, ported from
--      dashboard/static/vislab/isfahan_lattice.html (12 named doors, seed
--      salt SEED*7919+104729, anisotropy dy*1.7 "tall panes like the arches").
--   2. Spore Fish — no render source found in-repo; built from the name plus
--      the monetization plan line. All its numbers are -- CLAIMED:.
--   3. Bad Apple Field — 1-bit flip rhythm ported from
--      dashboard/static/bad_apple_field.html (1200f @30fps, 96x72 1-bit).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local SeedRng = require(Shared:WaitForChild("SeedRng"))
local ledgerParent = script.Parent:FindFirstChild("ShadowLedger") and script.Parent or script.Parent.Parent
local ShadowLedger = require(ledgerParent:WaitForChild("ShadowLedger"))

local GalleryZone = {}
local origin = Vector3.new(0, 8, -260) -- south of Basecamp; ~184 from Ski/Arrakis, 260 from camp

-- the 12 named doors, verbatim from the Isfahan source (name, inscription, seed)
-- luau has no tuple types: rows carry named fields so name/inscription stay
-- string and seed stays number. Fix receipt: the old positional rows
-- {name, inscription, seed} made luau unify the row element to string and flag
-- each numeric seed as TypeError x7 (w2/lanes/a01-mountain.check.txt lines 26-32).
type Door = { name: string, inscription: string, seed: number }
	local DOORS: { Door } = {
	{ name = "the mirror toll", inscription = "your reflection holds the door you cannot wait at", seed = 11 },
	{ name = "two banks", inscription = "two banks of one river, never merged", seed = 7 },
	{ name = "the ninth law", inscription = "the world only moves when you move", seed = 9 },
	{ name = "the passing guard", inscription = "the sentry walks its line; cross behind its back", seed = 13 },
	{ name = "weight and shadow", inscription = "the treasure is load-bearing", seed = 21 },
	{ name = "the looking glass", inscription = "the reversed letter is watching you find it", seed = 3 },
	{ name = "the keeper", inscription = "he calls his own by name", seed = 17 },
	{ name = "the offered weight", inscription = "charcoal is free; nothing else is", seed = 23 },
	{ name = "the closing door", inscription = "the ledger constrains future accounts, not the past", seed = 29 },
	{ name = "the barbed junction", inscription = "speak only on the even breath", seed = 31 },
	{ name = "stroke order", inscription = "first the seal, then the wax, then the hand", seed = 37 },
	{ name = "the seventh watcher", inscription = "the wall was never evidence", seed = 41 },
}

-- annotation exactness (t42 triage, lanes/t42.check.txt row 12; cleared by t72 after t57 cleared rows 1-7 the same way): mk now returns Part, so the fields hold Part exactly; BasePart failed the exact-table literal check at 150,24/171,22/194,24. Runtime unchanged.
type Pane = { part: Part, u: number, v: number, ph: number }
type Fishie = { part: Part, radius: number, speed: number, phase: number, bob: number }
type Tile = { part: Part, phase: number, period: number, col: number, row: number }
local latticePt: { { u: number, v: number, hue: number, ph: number } } = {}

local panes: { Pane } = {}
local fish: { Fishie } = {}
local tiles: { Tile } = {}
local latticeLabel: TextLabel?
local doorIdx, clock, feedUntil = 1, 0, 0
local frameAcc, frame, playing = 0, -1, true
local TILE_ON, TILE_OFF = Color3.fromRGB(238, 240, 236), Color3.fromRGB(12, 12, 15)
local fishCenter = origin + Vector3.new(0, 4.5, 4)

-- annotation exactness (t42 triage, lanes/t42.check.txt row 12; cleared by t72 after t57 cleared rows 1-7 the same way): mk returns Instance.new("Part") (below); Part is what is stored, BasePart failed plaque's : Part return at 82,2. Runtime unchanged.
local function mk(parent: Instance, size: Vector3, pos: Vector3, color: Color3, mat: Enum.Material, collide: boolean?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.Position = pos
	p.Color = color
	p.Material = mat
	p.CanCollide = collide == true
	p.Parent = parent
	return p
end

local function plaque(parent: Instance, text: string, pos: Vector3): Part
	local p = mk(parent, Vector3.new(5, 1.6, 0.3), pos, Color3.fromRGB(24, 22, 30), Enum.Material.Slate, true)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.PixelsPerStud = 24
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.TextWrapped = true
	lbl.TextColor3 = Color3.fromRGB(220, 214, 190)
	lbl.Font = Enum.Font.Garamond
	lbl.TextSize = 12
	lbl.Text = text
	lbl.Parent = gui
	gui.Parent = p
	return p
end

local function banner(parent: Instance): TextLabel
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(0, 260, 0, 64)
	gui.StudsOffset = Vector3.new(0, 3, 0)
	gui.AlwaysOnTop = true
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.TextWrapped = true
	lbl.TextColor3 = Color3.fromRGB(217, 164, 65) -- the source's inscription gold
	lbl.Font = Enum.Font.Garamond
	lbl.TextSize = 13
	lbl.Parent = gui
	gui.Parent = parent
	return lbl
end

local function prompt(parent: Instance, action: string, title: string, fn: (Player) -> ())
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText = action
	pr.ObjectText = title
	pr.HoldDuration = 0.3
	pr.MaxActivationDistance = 10
	pr.Parent = parent
	pr.Triggered:Connect(fn)
end

-- re-seed the lattice from a named door and repaint every pane by Voronoi cell
local function seedDoor(idx: number)
	doorIdx = idx
	local door = DOORS[idx]
	local rng = SeedRng.new(door.seed * 7919 + 104729) -- same salt as the source
	latticePt = {}
	for _ = 1, 26 do -- 26 seeded points, as in the source
		table.insert(latticePt, { u = rng:next(), v = rng:next(), hue = rng:next(), ph = rng:next() * 6 })
	end
	for _, pane in ipairs(panes) do
		local best, bd = 1, math.huge
		for i, pt in ipairs(latticePt) do
			local dx, dy = pane.u - pt.u, pane.v - pt.v
			local d = dx * dx + dy * dy * 1.7 -- tall arches, per the source
			if d < bd then
				bd, best = d, i
			end
		end
		local pt = latticePt[best]
		local hue = Color3.fromHSV(pt.hue, 0.65 + 0.2 * pt.hue, 0.5 + 0.2 * pt.hue)
		pane.part.Color = hue
		pane.ph = pt.ph
	end
	if latticeLabel then
		latticeLabel.Text = string.format('ISFAHAN LATTICE — seed %d · "%s"\n"%s"', door.seed, door.name, door.inscription)
	end
end

local function buildLattice(model: Instance)
	local wall = mk(model, Vector3.new(0.6, 12.4, 20.4), origin + Vector3.new(-22, 6.2, -6), Color3.fromRGB(20, 18, 24), Enum.Material.Marble, true)
	plaque(model, "Isfahan Lattice", origin + Vector3.new(-22, 0.4, 6.4))
	latticeLabel = banner(wall)
	local cols, rows = 9, 6
	for c = 1, cols do
		for r = 1, rows do
			local pane = mk(model, Vector3.new(1.9, 1.9, 0.25), Vector3.zero, Color3.new(1, 1, 1), Enum.Material.Glass, false)
			pane.Transparency = 0.35
			table.insert(panes, {
				part = pane,
				ph = 0,
				u = (c - 0.5) / cols,
				v = (r - 0.5) / rows,
			})
		end
	end
	seedDoor(1)
	prompt(wall, "Walk the doors", "Isfahan Lattice", function(player: Player)
		seedDoor(doorIdx % #DOORS + 1)
		ShadowLedger.record(player, "Gallery", "walked a lattice door", true)
	end)
end

local function buildFish(model: Instance)
	local basin = mk(model, Vector3.new(14, 1, 14), origin + Vector3.new(0, 0.5, 4), Color3.fromRGB(24, 34, 40), Enum.Material.Glass, true)
	mk(model, Vector3.new(2, 2, 2), origin + Vector3.new(0, 1.5, 4), Color3.fromRGB(38, 34, 46), Enum.Material.Marble, true) -- pedestal
	local rng = SeedRng.new(20260924)
	for _ = 1, 13 do -- CLAIMED: school of 13 spore-fish
		local f = mk(model, Vector3.new(1.1, 1.1, 1.1), fishCenter, Color3.fromHSV(rng:next() * 0.25 + 0.35, 0.7, 0.85), Enum.Material.Neon, false)
		table.insert(fish, {
			part = f,
			radius = 3 + rng:next() * 4.5, -- CLAIMED: orbit radii 3–7.5 studs
			speed = 0.5 + rng:next() * 0.9, -- CLAIMED: angular speed rad/s
			phase = rng:next() * math.pi * 2,
			bob = 0.4 + rng:next() * 0.8, -- CLAIMED: bob amplitude
		})
	end
	local label = banner(basin)
	label.Text = "SPORE FISH\nthey keep the circle; feeding scatters it"
	prompt(basin, "Feed", "Spore Fish", function(player: Player)
		feedUntil = clock + 4 -- CLAIMED: frenzy lasts 4s
		ShadowLedger.record(player, "Gallery", "fed the spore fish", true)
	end)
end

local function buildBadApple(model: Instance)
	local screen = mk(model, Vector3.new(22.4, 16.4, 0.6), origin + Vector3.new(22, 8.2, -6), Color3.fromRGB(18, 16, 20), Enum.Material.Metal, true)
	local rng = SeedRng.new(41800)
	local cols, rows = 12, 8 -- 96 tiles standing in for the 96x72 1-bit source
	for c = 1, cols do
		for r = 1, rows do
			local t = mk(model, Vector3.new(1.5, 1.5, 0.2), Vector3.zero, TILE_OFF, Enum.Material.SmoothPlastic, false)
			table.insert(tiles, {
				part = t,
				phase = rng:int(0, 1),
				period = 2 + rng:int(0, 3), -- CLAIMED: per-tile flip cadence 2–5 frames
				col = (c - 0.5) / cols,
				row = (r - 0.5) / rows,
			})
		end
	end
	local label = banner(screen)
	label.Text = "BAD APPLE FIELD\nthe field flips in rhythm; pause to hold a frame"
	prompt(screen, "Pause / resume", "Bad Apple Field", function(player: Player)
		playing = not playing
		ShadowLedger.record(player, "Gallery", playing and "resumed the field" or "held a frame", true)
	end)
end

function GalleryZone.build(): Model
	local model = Instance.new("Model")
	model.Name = "EstateGallery"

	mk(model, Vector3.new(72, 1, 30), origin + Vector3.new(0, -0.5, 0), Color3.fromRGB(30, 28, 36), Enum.Material.Marble, true) -- floor
	mk(model, Vector3.new(72, 18, 1), origin + Vector3.new(0, 9, -16.5), Color3.fromRGB(34, 31, 40), Enum.Material.Marble, true) -- back wall
	mk(model, Vector3.new(72, 0.6, 30), origin + Vector3.new(0, 13, 0), Color3.fromRGB(26, 24, 32), Enum.Material.Slate, false) -- roof
	plaque(model, "THE ESTATE GALLERY\nthe static gallery, made physical — FIND · FILE · LOAD", origin + Vector3.new(0, 0.4, 13.6))

	buildLattice(model)
	buildFish(model)
	buildBadApple(model)

	model.Parent = workspace

	for _, p in ipairs(panes) do -- lay the glass grid onto its wall
		p.part.Position = origin + Vector3.new(-22 + (p.u - 0.5) * 18, 2.6 + p.v * 11, -5.55)
	end
	for _, t in ipairs(tiles) do -- lay the field onto its screen
		t.part.Position = origin + Vector3.new(22 + (t.col - 0.5) * 18, 2.6 + t.row * 13, -5.55)
	end
	return model
end

function GalleryZone.tick(dt: number)
	clock += dt
	-- Isfahan: the sun sweeps and the light through the law moves with it
	local a = clock * 0.12
	for _, pane in ipairs(panes) do
		pane.part.Transparency = 0.18 + 0.44 * (0.5 + 0.5 * math.sin(a + pane.ph))
	end
	-- Spore Fish: keep the circle; the feed scatters it wide and fast
	local fed = clock < feedUntil
	local spread, rush = fed and 1.8 or 1, fed and 1.6 or 1 -- CLAIMED: scatter x1.8, frenzy speed x1.6
	for _, f in ipairs(fish) do
		local ang = clock * f.speed * rush + f.phase
		local r = f.radius * spread
		f.part.Position = fishCenter + Vector3.new(math.cos(ang) * r, math.sin(clock * 2 + f.phase) * f.bob, math.sin(ang) * r * 0.6)
	end
	-- Bad Apple: the field flips at 30fps like the source's 1200f @30fps
	if playing then
		frameAcc += dt * 30
		local nf = math.floor(frameAcc)
		if nf ~= frame then
			frame = nf
			for _, t in ipairs(tiles) do
				local on = (math.floor(frame / t.period) + t.phase) % 2 == 0
				t.part.Color = on and TILE_ON or TILE_OFF
				t.part.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
			end
		end
	end
end

return GalleryZone
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">HardwarePrimerZone</string>
          <string name="Source"><![CDATA[--!strict
-- HardwarePrimerZone — Room 1 of the electronics dungeon, ported from
-- dashboard/static/hardware_primer.html; every constant is that file's own
-- (β=100 per hand, toll 0.7V×2, gates 18/2600 µA, brightness law
-- log10(1+β²·w)·22 cap 100, verdict tolerance ±12, whisper 0-60 µA).
-- PREDICT before you MEASURE — no prediction, no verdict. Educational zone:
-- earns credibility, not revenue — no currency changes hands here.

local Players = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local ShadowLedger = require((script.Parent:FindFirstChild("ShadowLedger") or script.Parent.Parent:WaitForChild("ShadowLedger")) :: ModuleScript)
-- ledger lookup via the SSS root: resolves whether this module sits in
-- zones_extra or is moved flat by central wiring (init.server owns wiring)

local HardwarePrimerZone = {}
local origin = Vector3.new(220, 8, 220)
local INK = Color3.fromRGB(110, 198, 181) -- the primer's --ink
local TXT = Color3.fromRGB(207, 232, 226)
local GOLD = Color3.fromRGB(255, 215, 106)

-- the law, executable (verbatim from the primer)
local BETA = 100 -- each hand multiplies 100x
local GATE1_UA = 18 -- first hand opens when whisper*BETA >= 18 µA
local GATE2_UA = 2600 -- second hand when whisper*BETA*BETA >= 2600 µA
local STANDS = 12 -- a prediction stands within ±12 of the measurement

local whisper = 0
local calls: { [number]: number } = {} -- UserId -> predicted brightness
local gates: { BasePart } = {}
local beacon: BasePart? = nil
local beaconLight: PointLight? = nil
local hud: TextLabel? = nil

local function brightness(w: number): number
	if w <= 0 then return 0 end
	return math.min(100, math.round(math.log10(1 + BETA * BETA * w) * 22))
end

local function say(player: Player, text: string)
	print(("[HardwarePrimer] %s hears: %s"):format(player.Name, text))
end

local function lbl(parent: Instance, pos: UDim2, size: UDim2, text: string, color: Color3, wrap: boolean): TextLabel
	local t = Instance.new("TextLabel")
	t.Position = pos; t.Size = size; t.BackgroundTransparency = 1
	t.TextScaled = true; t.TextWrapped = wrap; t.Font = Enum.Font.Code
	t.TextColor3 = color; t.Text = text; t.Parent = parent
	return t
end

local function tag(part: BasePart, text: string): TextLabel
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(10, 1.6); gui.StudsOffset = Vector3.new(0, 3, 0); gui.AlwaysOnTop = true
	local t = lbl(gui, UDim2.new(), UDim2.fromScale(1, 1), text, TXT, false)
	gui.Parent = part
	return t
end

local function plaque(parent: Instance, pos: Vector3, title: string, body: string)
	local p = Instance.new("Part")
	p.Anchored = true; p.Size = Vector3.new(24, 8, 0.5); p.Position = pos
	p.Color = Color3.fromRGB(10, 16, 14); p.Parent = parent
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back; gui.PixelsPerStud = 5
	lbl(gui, UDim2.new(), UDim2.fromScale(1, 0.22), title, INK, false)
	lbl(gui, UDim2.fromScale(0, 0.22), UDim2.fromScale(1, 0.78), body, TXT, true)
	gui.Parent = p
end

local function pad(parent: Model, pos: Vector3, action: string, object: string, hold: number, fn: (Player) -> ())
	local p = Instance.new("Part")
	p.Anchored = true; p.Size = Vector3.new(4, 0.4, 4); p.Position = pos
	p.Color = Color3.fromRGB(13, 21, 18); p.Material = Enum.Material.Neon; p.Parent = parent
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action; prompt.ObjectText = object; prompt.HoldDuration = hold
	prompt.MaxActivationDistance = 8; prompt.Parent = p
	prompt.Triggered:Connect(fn)
end

function HardwarePrimerZone.build(): Model
	local model = Instance.new("Model")
	model.Name = "HardwarePrimer"

	local floor = Instance.new("Part")
	floor.Anchored = true; floor.Size = Vector3.new(64, 1, 88)
	floor.Position = origin - Vector3.new(0, 0.5, 0)
	floor.Color = Color3.fromRGB(6, 10, 9); floor.Material = Enum.Material.Slate; floor.Parent = model

	plaque(model, origin + Vector3.new(0, 6, -42), "THE HARDWARE PRIMER — ROOM 1 · THE DARLINGTON PAIR",
		"THE LAW: a small signal, passed hand to hand, moves great currents — but every hand takes its toll of 0.7 volts before the gate opens. Nothing is free; the amplification is bought with the toll. STATBLOCK: AC 100kΩ input impedance · GAIN β≈10,000 — the whisper becomes a shout · THE TOLL 1.4V (two hands, 0.7 each) · WEAKNESS slow to let go (saturation lingers) · ALIGNMENT Lawful — it multiplies exactly, without opinion.")

	local console = Instance.new("Part")
	console.Anchored = true; console.Size = Vector3.new(12, 3, 4)
	console.Position = origin + Vector3.new(-20, 1.5, -24)
	console.Color = Color3.fromRGB(13, 21, 18); console.Parent = model
	tag(console, "the whisper console (µA)")

	pad(model, origin + Vector3.new(-24, 0.2, -18), "+ whisper", "whisper console (µA)", 0.3, function(_player)
		whisper = math.min(60, whisper + (whisper >= 40 and 10 or 5))
	end)
	pad(model, origin + Vector3.new(-20, 0.2, -18), "- whisper", "whisper console (µA)", 0.3, function(_player)
		whisper = math.max(0, whisper - (whisper > 40 and 10 or 5))
	end)
	pad(model, origin + Vector3.new(-16, 0.2, -18), "silence the whisper", "whisper console (µA)", 0.3, function(_player)
		whisper = 0
	end)

	for i = 1, 2 do
		local g = Instance.new("Part")
		g.Anchored = true; g.CanCollide = false; g.Size = Vector3.new(10, 8, 0.8)
		g.Position = origin + Vector3.new(0, 4, i * 14 - 4)
		g.Color = Color3.fromRGB(51, 63, 68)
		g.Name = i == 1 and "FirstHand" or "SecondHand"; g.Parent = model
		tag(g, (i == 1 and "FIRST HAND" or "SECOND HAND") .. " · toll 0.7V")
		gates[i] = g
	end

	local b = Instance.new("Part")
	b.Shape = Enum.PartType.Ball; b.Anchored = true; b.Size = Vector3.new(4, 4, 4)
	b.Position = origin + Vector3.new(0, 5, 36)
	b.Color = GOLD; b.Material = Enum.Material.Neon; b.Name = "Beacon"; b.Parent = model
	beacon = b
	local light = Instance.new("PointLight")
	light.Range = 48; light.Color = GOLD; light.Parent = b
	beaconLight = light

	local board = Instance.new("Part")
	board.Anchored = true; board.CanCollide = false; board.Transparency = 1; board.Size = Vector3.new(1, 1, 1)
	board.Position = origin + Vector3.new(0, 12, 8); board.Parent = model
	hud = tag(board, "whisper: 0 µA · beacon: 0/100")

	plaque(model, origin + Vector3.new(24, 5, 0), "THE PROOF — predict before you measure",
		"Set the whisper at the console. PREDICT the beacon's brightness (0-100) by the law — brightness is bought with β² × the whisper, and the toll must be paid first. Then MEASURE. A call within ±12 stands; a hit unlocks the restatement. No prediction, no verdict.")

	pad(model, origin + Vector3.new(20, 0.2, -4), "PREDICT: lock the call", "the proof", 0.5, function(player)
		local cur = calls[player.UserId] or -10
		calls[player.UserId] = (cur + 10) % 110 -- cycles 0..100 by 10
		say(player, ("call locked: %d/100"):format(calls[player.UserId]))
	end)
	pad(model, origin + Vector3.new(28, 0.2, -4), "MEASURE IT", "the proof", 1, function(player)
		local call = calls[player.UserId]
		if call == nil then return say(player, "no prediction, no verdict — lock a call first.") end
		local actual = brightness(whisper)
		if math.abs(actual - call) <= STANDS then
			player:SetAttribute("HardwareProof", true)
			ShadowLedger.record(player, "HardwarePrimer", ("called %d, measured %d/100 — lawful amplification, tolls paid"):format(call, actual), true)
			say(player, ("MEASURED: %d/100 — your call stood. Seal the restatement at the wall."):format(actual))
		else
			ShadowLedger.record(player, "HardwarePrimer", ("called %d, measured %d/100 — the law multiplies exactly; re-read the toll"):format(call, actual), false)
			say(player, ("MEASURED: %d/100 — you called %d. The law multiplies exactly; re-read the toll."):format(actual, call))
		end
	end)
	pad(model, origin + Vector3.new(24, 0.2, 12), "SEAL IT", "the restatement", 1.5, function(player)
		if not player:GetAttribute("HardwareProof") then
			return say(player, "the wall asks only those who measured — predict, then measure.")
		end
		player:SetAttribute("HardwareSealed", true)
		ShadowLedger.record(player, "HardwarePrimer", "sealed the restatement: the beacon waits for 1.4V because two hands each take 0.7V before the gate opens (retelling recorded, not graded)", true)
		say(player, "sealed. the primer is a seed: copy it, plant it anywhere, it grows rooms.")
	end)

	Players.PlayerRemoving:Connect(function(player)
		calls[player.UserId] = nil
	end)

	model.Parent = workspace
	return model
end

function HardwarePrimerZone.tick(_dt: number)
	local dark = Color3.fromRGB(51, 63, 68)
	local paid1 = whisper * BETA >= GATE1_UA
	local paid2 = whisper * BETA * BETA >= GATE2_UA
	for i, g in ipairs(gates) do
		local paid = if i == 1 then paid1 else paid2
		g.Color = paid and INK or dark
		g.Material = paid and Enum.Material.Neon or Enum.Material.SmoothPlastic
	end
	local b = brightness(whisper)
	if beacon then
		local s = 4 + b * 0.09
		beacon.Size = Vector3.new(s, s, s)
		beacon.Transparency = 0.95 - b * 0.009
	end
	if beaconLight then beaconLight.Brightness = 0.2 + b * 0.03 end
	if hud then
		hud.Text = ("whisper: %d µA · after hand 1 (β=100): %d µA · after hand 2: %d µA · beacon: %d/100")
			:format(whisper, whisper * BETA, whisper * BETA * BETA, b)
	end
end

return HardwarePrimerZone
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">IncidentDungeonZone</string>
          <string name="Source"><![CDATA[--!strict
-- IncidentDungeonZone — the maze-arena incident (2026-09-06) as a walkable
-- dungeon, ported from dashboard/static/incident_dungeon.html. One night,
-- four stacked birth defects killed the arena: the seal, the inverted bounce,
-- the unbounded world, the bogus flood. Each room is one defect, the
-- inscription is the buggy line, the right answer opens the way; finish all
-- four and THE RUN opens — a finisher can restate the four defect classes:
-- teaching = the game. All inscriptions, numbers and receipts are the
-- source file's own; nothing here is invented.

local Players = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local ShadowLedger = require((script.Parent:FindFirstChild("ShadowLedger") or script.Parent.Parent:WaitForChild("ShadowLedger")) :: ModuleScript)
-- ledger lookup via the SSS root: resolves whether this module sits in
-- zones_extra or is moved flat by central wiring (init.server owns wiring)

local IncidentDungeonZone = {}
local origin = Vector3.new(220, 8, -220)
local ROOM_W, ROOM_D, WALL_H = 40, 36, 7
local PITCH = ROOM_W + 4
local GOLD = Color3.fromRGB(232, 201, 106) -- solved / the falsifier
local ACCENT = Color3.fromRGB(124, 245, 255) -- the inscriptions' cyan

type Answer = { t: string, ok: boolean }
type RoomSpec = { name: string, insc: string, note: string, answers: { Answer } }

local ROOMS: { RoomSpec } = {
	{ name = "I · THE SEAL",
		insc = "walls: [[0.5,0.5,0.03,1.2]] .map(w=>[w[0]*2, w[1]*2.7, w[2]*2, w[3]*2.7])",
		note = "hh 1.2 × 2.7 = 3.24 > world 2.7 → the wall overflows its own world → FULL SEAL. The spawn chamber could never reach the cheese. The fix: 0.28 × 2.7 = 0.756 — a wall, not a seal.",
		answers = { { t = "CARVE THE GAP (hh 1.2 → 0.28)", ok = true } } },
	{ name = "II · THE INVERTED BOUNCE",
		insc = "if(sdf(nx,ny)<0.012){ move } else { bounce }",
		note = "sdf < 0 means INSIDE a wall. The condition hires the mover only when its next step is stone — they press their faces into the west wall forever. Which predicate lets a mover move?",
		answers = { { t = "sdf(nx,ny) < 0.012", ok = false }, { t = "sdf(nx,ny) >= 0.012", ok = true } } },
	{ name = "III · THE UNBOUNDED WORLD",
		insc = "return d;   // sdf: walls only — no outer term",
		note = "Signed distance of the walls alone; nothing says the world ends. The escaped are still out there: x = -71, -40, -19, -6. An SDF union of primitives is taken with…",
		answers = { { t = "Math.max(d, box)", ok = false }, { t = "Math.min(d, box)", ok = true } } },
	{ name = "IV · THE BOGUS FLOOD",
		insc = "sdf((nx+0.5)/2, (ny+0.5)/2.7)   // neighbors read at wy~25",
		note = "Grid row ny (0..134) divided by the world height 2.7: the flood evaluated its neighbors an entire world above the maze. Which pair of characters was missing from the buggy line?",
		answers = { { t = "GW", ok = false }, { t = "GH", ok = true }, { t = "2.7", ok = false }, { t = "ny", ok = false } } },
}

local solved: { boolean } = {}
local solvedN = 0
local barriers: { BasePart } = {}
-- annotation exactness (t42 triage, lanes/t42.check.txt row 4): glow holds the Instance.new("Part") pedestal orb. Runtime unchanged.
local glow: { { part: Part, room: number } } = {}
local runDoor: BasePart? = nil
local runOpened = false

local function say(player: Player, text: string)
	print(("[IncidentDungeon] %s hears: %s"):format(player.Name, text))
end

local function lbl(parent: Instance, pos: UDim2, size: UDim2, text: string, color: Color3): TextLabel
	local t = Instance.new("TextLabel")
	t.Position = pos; t.Size = size; t.BackgroundTransparency = 1
	t.TextScaled = true; t.TextWrapped = true; t.Font = Enum.Font.Code
	t.TextColor3 = color; t.Text = text; t.Parent = parent
	return t
end

local function tag(part: BasePart, text: string)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(10, 1.6); gui.StudsOffset = Vector3.new(0, 3, 0); gui.AlwaysOnTop = true
	lbl(gui, UDim2.new(), UDim2.fromScale(1, 1), text, Color3.fromRGB(200, 230, 217))
	gui.Parent = part
end

-- the wall is the bug: room title, the buggy line carved, the diagnosis note
local function inscription(parent: Instance, pos: Vector3, face: Enum.NormalId, title: string, note: string, mono: string)
	local p = Instance.new("Part")
	p.Anchored = true; p.Size = Vector3.new(24, 9, 0.5); p.Position = pos
	p.Color = Color3.fromRGB(10, 18, 16); p.Parent = parent
	local gui = Instance.new("SurfaceGui")
	gui.Face = face; gui.PixelsPerStud = 5
	lbl(gui, UDim2.new(), UDim2.fromScale(1, 0.18), title, ACCENT)
	lbl(gui, UDim2.fromScale(0, 0.18), UDim2.fromScale(1, 0.26), mono, ACCENT)
	lbl(gui, UDim2.fromScale(0, 0.44), UDim2.fromScale(1, 0.56), note, Color3.fromRGB(200, 230, 217))
	gui.Parent = p
end

local function pedestal(parent: Model, pos: Vector3, roomIdx: number, room: RoomSpec, ans: Answer)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Anchored = true; p.Size = Vector3.new(3, 3, 3); p.Position = pos
	p.Color = GOLD; p.Material = Enum.Material.Neon; p.Parent = parent
	table.insert(glow, { part = p, room = roomIdx })
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = ans.t; prompt.ObjectText = room.name .. " · diagnose"
	prompt.HoldDuration = 1; prompt.MaxActivationDistance = 10; prompt.Parent = p
	prompt.Triggered:Connect(function(player: Player)
		if solved[roomIdx] then return say(player, "the way here is already open.") end
		if not ans.ok then
			ShadowLedger.record(player, "IncidentDungeon", ("the defect disagrees with '%s' — read the inscription again"):format(ans.t), false)
			return say(player, "the defect disagrees — read the inscription again.")
		end
		solved[roomIdx] = true; solvedN += 1
		local gate = barriers[roomIdx]
		if gate then gate.CanCollide = false; gate.Color = GOLD; gate.Transparency = 0.5 end
		ShadowLedger.record(player, "IncidentDungeon", ("room %s diagnosed — '%s' stands; the way opens"):format(room.name, ans.t), true)
		say(player, ("ROOM %s SOLVED — the way opens."):format(room.name))
		if solvedN >= #ROOMS and runDoor and not runOpened then
			runOpened = true; runDoor.CanCollide = false; runDoor.Transparency = 0.6; runDoor.Color = GOLD
			say(player, "THE RUN is open — the falsifier waits beyond it.")
		end
	end)
end

function IncidentDungeonZone.build(): Model
	local model = Instance.new("Model")
	model.Name = "IncidentDungeon"

	local hallLen = (#ROOMS - 1) * PITCH + ROOM_W + 4
	local midX = origin.X - ROOM_W / 2 - 2 + hallLen / 2
	for _, zs in ipairs({ -1, 1 }) do
		local wall = Instance.new("Part")
		wall.Anchored = true; wall.Size = Vector3.new(hallLen, WALL_H, 1)
		wall.Position = Vector3.new(midX, origin.Y + WALL_H / 2, origin.Z + zs * (ROOM_D / 2 + 0.5))
		wall.Color = Color3.fromRGB(16, 27, 24); wall.Parent = model
	end

	for i, room in ipairs(ROOMS) do
		local cx = origin.X + (i - 1) * PITCH
		table.insert(solved, false)

		local floor = Instance.new("Part")
		floor.Anchored = true; floor.Size = Vector3.new(ROOM_W, 1, ROOM_D)
		floor.Position = Vector3.new(cx, origin.Y - 0.5, origin.Z)
		floor.Color = (i % 2 == 0) and Color3.fromRGB(12, 18, 16) or Color3.fromRGB(10, 14, 12)
		floor.Material = Enum.Material.Slate; floor.Parent = model

		inscription(model, Vector3.new(cx, origin.Y + 5.5, origin.Z - ROOM_D / 2 + 0.4), Enum.NormalId.Back,
			room.name, room.note, room.insc)

		local n = #room.answers
		for j, ans in ipairs(room.answers) do
			local px = if n > 1 then cx - 12 + (j - 1) * (24 / (n - 1)) else cx
			pedestal(model, Vector3.new(px, origin.Y + 1.5, origin.Z + 10), i, room, ans)
		end

		if i < #ROOMS then
			local bx = cx + PITCH / 2
			local gate = Instance.new("Part")
			gate.Anchored = true; gate.Size = Vector3.new(1, WALL_H, 10)
			gate.Position = Vector3.new(bx, origin.Y + WALL_H / 2, origin.Z)
			gate.Color = Color3.fromRGB(92, 16, 16); gate.Material = Enum.Material.Neon
			gate.Name = "Barrier_" .. i; gate.Parent = model
			barriers[i] = gate
			for _, zs in ipairs({ -1, 1 }) do
				local flank = Instance.new("Part")
				flank.Anchored = true; flank.Size = Vector3.new(1, WALL_H, (ROOM_D - 10) / 2)
				flank.Position = Vector3.new(bx, origin.Y + WALL_H / 2, origin.Z + zs * (5 + (ROOM_D - 10) / 4))
				flank.Color = Color3.fromRGB(16, 27, 24); flank.Parent = model
			end
		end
	end

	local endX = origin.X + (#ROOMS - 1) * PITCH + ROOM_W / 2 + 2
	for _, zs in ipairs({ -1, 1 }) do
		local seg = Instance.new("Part")
		seg.Anchored = true; seg.Size = Vector3.new(1, WALL_H, (ROOM_D - 12) / 2)
		seg.Position = Vector3.new(endX, origin.Y + WALL_H / 2, origin.Z + zs * (6 + (ROOM_D - 12) / 4))
		seg.Color = Color3.fromRGB(16, 27, 24); seg.Parent = model
	end
	local door = Instance.new("Part")
	door.Anchored = true; door.Size = Vector3.new(1, WALL_H, 12)
	door.Position = Vector3.new(endX, origin.Y + WALL_H / 2, origin.Z)
	door.Color = Color3.fromRGB(16, 27, 24); door.Name = "TheRun"; door.Parent = model
	runDoor = door
	tag(door, "THE RUN · sealed by the boss")
	door.Touched:Connect(function(hit)
		local player = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
		if not player or not runOpened then return end
		if player:GetAttribute("IncidentRestated") then return end
		player:SetAttribute("IncidentRestated", true)
		ShadowLedger.record(player, "IncidentDungeon",
			"finished the dungeon — restates the four defect classes: SCALE-PAST-WORLD · INVERTED-PREDICATE · UNBOUNDED-DOMAIN · WRONG-TRANSFORM; deepest lesson kept DISPUTED-AND-KEPT: bogus fields look alive (LAW-061)", true)
	end)

	inscription(model, Vector3.new(endX + 0.6, origin.Y + 5.5, origin.Z), Enum.NormalId.Left,
		"THE RUN · THE FALSIFIER",
		"RECEIPTS: queue/handoff/zcode/CONVO.md row 09-06 ~03:0xZ · dashboard/static/maze_arena.html (the FIXED form) · state/_maze_sim_test.js (headless harness, kept) · watch/inbox/MAZE_ARENA_B1_20260906.md · LAW-061: bogus fields look alive — validate the field.",
		"a player who finishes can restate the four defect classes — teaching = the game")

	model.Parent = workspace
	return model
end

function IncidentDungeonZone.tick(_dt: number)
	local t = os.clock()
	for i, gate in ipairs(barriers) do
		if not solved[i] then gate.Transparency = 0.18 + 0.1 * math.sin(t * 4) end
	end
	for _, g in ipairs(glow) do
		g.part.Transparency = solved[g.room] and 0.6 or 0.05 + 0.2 * math.abs(math.sin(t * 2 + g.room))
	end
	if runDoor and not runOpened then runDoor.Transparency = 0.15 + 0.1 * math.sin(t * 2) end
end

return IncidentDungeonZone
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">LightmapRoomsZone</string>
          <string name="Source"><![CDATA[--!strict
-- LightmapRoomsZone — THE ROOM (2026-09-02) rendered as a dungeon, ported from
-- dashboard/static/room_lightmap.html: radial lightmap, 1D distance fields per light,
-- occluders are the failure classes, lights are the engines, the center ring is the fold.
-- Exact source constants: five engine-lights A1/B1/D1/forge/harvest with their orbit
-- radii, speeds, phases and colors; motion t = now/4000, lx = r*cos(t*s+p),
-- ly = r*0.55*sin(t*s*1.3+p); scene: covenant wall rect half-extents (2.30, 1.25), the
-- four failure-class pillars r=0.09 (dead door / placeholder pass / stale row / key
-- miswire), THE FOLD ring ir=0.16 / or=0.19 at center, and the screen at (2.0, -0.9) —
-- do not look. Port note (honest): the per-pixel SDF raymarch becomes real
-- shadow-casting PointLights in a sealed dark room — same lights, same occluders, same
-- orbits, so pillar shadows are literal (Lighting global state untouched). The source
-- render has no score and no input, so none was invented; the ledger only files entering
-- the room and standing in THE FOLD. Scale: 20 studs per scene unit.

local Players = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local ShadowLedger = require((script.Parent:FindFirstChild("ShadowLedger") or script.Parent.Parent:WaitForChild("ShadowLedger")) :: ModuleScript)

local LightmapRoomsZone = {}
local origin = Vector3.new(-300, 8, 0) -- clear of every listed zone origin
local SCALE = 20 -- studs per scene unit

type EngineDef = { c: { number }, r: number, s: number, p: number, name: string }

-- the engines, exact from LIGHTS[] (lights are the engines, wandering free)
local LIGHTS: { EngineDef } = {
	{ c = { 125, 250, 176 }, r = 0.9, s = 0.31, p = 0.0, name = "A1" },
	{ c = { 177, 140, 255 }, r = 0.75, s = 0.27, p = 2.1, name = "B1" },
	{ c = { 232, 201, 106 }, r = 0.6, s = 0.35, p = 4.2, name = "D1" },
	{ c = { 255, 157, 92 }, r = 0.5, s = 0.41, p = 1.3, name = "forge" },
	{ c = { 124, 245, 255 }, r = 0.8, s = 0.22, p = 3.3, name = "harvest" },
}

-- the four failure classes, exact from pillars[] (occluders are the failure classes)
local PILLARS: { { x: number, z: number, name: string } } = {
	{ x = -1.5, z = -0.6, name = "dead door" },
	{ x = -0.4, z = 0.75, name = "placeholder pass" },
	{ x = 0.7, z = -0.8, name = "stale row" },
	{ x = 1.7, z = 0.6, name = "key miswire" },
}

-- annotation exactness (t42 triage, lanes/t42.check.txt row 5): engines hold Instance.new("Part") orbs (line 87). Runtime unchanged.
local engines: { { orb: Part, def: EngineDef } } = {}
local entered: { [Player]: boolean } = {}
local stoodFold: { [Player]: boolean } = {}

local function sceneToWorld(sx: number, sz: number): Vector3 return origin + Vector3.new(sx * SCALE, 0, sz * SCALE) end

local function slab(parent: Instance, name: string, size: Vector3, pos: Vector3, color: Color3, mat: Enum.Material): BasePart
	local p = Instance.new("Part"); p.Anchored, p.Name, p.Size, p.Position, p.Color, p.Material, p.Parent = true, name, size, pos, color, mat, parent
	return p
end

local function label(parent: Instance, text: string, color: Color3)
	local gui = Instance.new("BillboardGui"); gui.Size, gui.StudsOffset, gui.AlwaysOnTop = UDim2.new(0, 200, 0, 30), Vector3.new(0, 3.5, 0), true
	local t = Instance.new("TextLabel"); t.Size, t.BackgroundTransparency, t.Text, t.TextColor3, t.Font, t.TextSize, t.TextWrapped, t.Parent = UDim2.fromScale(1, 1), 1, text, color, Enum.Font.Code, 12, true, gui
	gui.Parent = parent
end

function LightmapRoomsZone.build(): Model
	local model = Instance.new("Model"); model.Name = "TheRoom"
	-- the covenant wall: the room exists because the laws bound it (rect half-extents 2.30 x 1.25)
	local RX, RZ, H = 2.3 * SCALE, 1.25 * SCALE, 26
	local wallC = Color3.fromRGB(24, 28, 30)
	slab(model, "CovenantFloor", Vector3.new(RX * 2 + 8, 1, RZ * 2 + 8), origin + Vector3.new(0, -0.5, 0), Color3.fromRGB(10, 12, 11), Enum.Material.Slate)
	slab(model, "WallN", Vector3.new(RX * 2 + 8, H, 2), origin + Vector3.new(0, H / 2, -RZ - 1), wallC, Enum.Material.Concrete)
	slab(model, "WallS", Vector3.new(RX * 2 + 8, H, 2), origin + Vector3.new(0, H / 2, RZ + 1), wallC, Enum.Material.Concrete)
	slab(model, "WallW", Vector3.new(2, H, RZ * 2 + 8), origin + Vector3.new(-RX - 1, H / 2, 0), wallC, Enum.Material.Concrete)
	slab(model, "WallE", Vector3.new(2, H, RZ * 2 + 8), origin + Vector3.new(RX + 1, H / 2, 0), wallC, Enum.Material.Concrete)
	slab(model, "CovenantCeiling", Vector3.new(RX * 2 + 8, 1, RZ * 2 + 8), origin + Vector3.new(0, H, 0), Color3.fromRGB(8, 10, 12), Enum.Material.Concrete)
	for _, pd in ipairs(PILLARS) do -- occluders glow their color at the surface (legend #ff7d7d)
		local pil = slab(model, "FailurePillar", Vector3.new(0.09 * SCALE * 2, 9, 0.09 * SCALE * 2), sceneToWorld(pd.x, pd.z) + Vector3.new(0, 4.5, 0), Color3.fromRGB(46, 26, 26), Enum.Material.Basalt)
		local glow = Instance.new("PointLight"); glow.Color, glow.Range, glow.Brightness, glow.Parent = Color3.fromRGB(255, 125, 125), 6, 0.7, pil
		label(pil, pd.name, Color3.fromRGB(255, 125, 125))
	end
	for i = 0, 7 do -- THE FOLD at center: gold ring ir=0.16 / or=0.19
		local a = math.rad(i * 45)
		local seg = slab(model, "FoldSegment", Vector3.new(1.1, 0.4, 1.7), sceneToWorld(math.cos(a) * 0.175, math.sin(a) * 0.175) + Vector3.new(0, 0.4, 0), Color3.fromRGB(232, 201, 106), Enum.Material.Neon)
		seg.CFrame = CFrame.new(seg.Position) * CFrame.Angles(0, -a, 0)
	end
	local sensor = slab(model, "FoldSensor", Vector3.new(0.32 * SCALE, 0.2, 0.32 * SCALE), origin + Vector3.new(0, 0.1, 0), Color3.fromRGB(232, 201, 106), Enum.Material.Neon)
	sensor.Transparency, sensor.CanCollide = 1, false
	label(sensor, "THE FOLD — the center ring", Color3.fromRGB(232, 201, 106))
	local scr = slab(model, "TheScreen", Vector3.new(0.8, 10, 6), sceneToWorld(2.0, -0.9) + Vector3.new(0, 5, 0), Color3.fromRGB(14, 14, 18), Enum.Material.Glass) -- the screen: do not look
	label(scr, "the screen (do not look)", Color3.fromRGB(160, 160, 185))
	for _, L in ipairs(LIGHTS) do
		local orb = Instance.new("Part"); orb.Shape, orb.Anchored, orb.Size = Enum.PartType.Ball, true, Vector3.new(2.5, 2.5, 2.5)
		orb.Color = Color3.fromRGB(L.c[1], L.c[2], L.c[3])
		orb.Material, orb.Name = Enum.Material.Neon, ("Engine_%s"):format(L.name)
		local li = Instance.new("PointLight"); li.Color, li.Range, li.Brightness, li.Shadows, li.Parent = orb.Color, 26, 2, true, orb
		label(orb, ("engine %s"):format(L.name), orb.Color)
		orb.Parent = model
		table.insert(engines, { orb = orb, def = L })
	end
	model.Parent = workspace
	return model
end

function LightmapRoomsZone.tick(_dt: number)
	local t = os.clock() / 4 -- source: t = now/4000 (ms)
	for _, e in ipairs(engines) do
		local L = e.def
		local lx = L.r * math.cos(t * L.s + L.p)
		local lz = L.r * 0.55 * math.sin(t * L.s * 1.3 + L.p)
		e.orb.Position = sceneToWorld(lx, lz) + Vector3.new(0, 6, 0)
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and math.abs(root.Position.X - origin.X) <= 2.3 * SCALE + 4 and math.abs(root.Position.Z - origin.Z) <= 1.25 * SCALE + 4 and math.abs(root.Position.Y - origin.Y) < 14 then
			if not entered[plr] then
				entered[plr] = true
				ShadowLedger.record(plr, "LightmapRooms", "entered the room; the engines wander, the pillars stay", true)
			end
			if not stoodFold[plr] then
				local flat = Vector3.new(root.Position.X - origin.X, 0, root.Position.Z - origin.Z)
				if flat.Magnitude < 0.16 * SCALE + 1.5 then
					stoodFold[plr] = true
					ShadowLedger.record(plr, "LightmapRooms", "stood in THE FOLD, the center ring", true)
				end
			end
		end
	end
end

Players.PlayerRemoving:Connect(function(p) entered[p] = nil; stoodFold[p] = nil end)

return LightmapRoomsZone
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">MazeArenaZone</string>
          <string name="Source"><![CDATA[--!strict
-- MazeArenaZone — THE STACKED ARENA (dashboard/static/games/maze_arena.html).
-- Four rounds around the cheese-light: R1 RACE TO THE CHEESE · R2 MOVING WALLS
-- (gold invariants never move; cyan bars slide to their alt) · R3 THE LIGHT
-- WALKS (beacon patrols BEACON_PATH) · R4 STAYING IS THE WIN (dwell inside the
-- beacon's 110-deg gaze scores; arrival doesn't). Six LAW_SHARDS + the red
-- assumption (the dragon that hunts in the dark) from the v1 player layer.
-- GAPS: the ray-field/BFS lightmap render, the GPS/dumb/WAY/model-seat agents,
-- the odd-eta curl, the lantern rescue field and ?real=1 constellation are
-- sim/render layers — avatars ARE the agents; round clock + wall moves shared,
-- arrival/dwell/score per player. PACING: source 60 ticks/s at 0.016 u/tick
-- (0.96 u/s) vs Roblox 16 studs/s at SCALE=100 (0.16 u/s), so durations x6 and
-- per-second speeds /6 preserve crossings-per-round; all source numbers quoted.
-- Deterministic source (fixed walls, fixed path): nothing score-bearing is
-- random — no SeedRng.

local Players = game:GetService("Players")
local ShadowLedger = require((script.Parent:FindFirstChild("ShadowLedger") or script.Parent.Parent:WaitForChild("ShadowLedger")) :: ModuleScript)

local MazeArenaZone = {}
local origin = Vector3.new(300, 8, 0)
local SCALE = 100 -- studs per maze unit (source: W=480 px for 2.0 units)
local TICK, PACING = 1 / 60, 6

-- walls [cx,cy,hw,hh] in source maze-space (the literal already x2 / y2.7 scaled)
local WALLS = {
	{1.0, 1.35, 0.06, 0.81}, {0.5, 0.81, 0.40, 0.081}, {0.5, 1.944, 0.40, 0.081},
	{1.0, 1.35, 0.06, 0.756}, {1.5, 0.81, 0.40, 0.081}, {1.5, 1.944, 0.40, 0.081},
	{0.24, 1.404, 0.06, 0.594}, {1.76, 1.35, 0.06, 0.594},
	{1.24, 0.378, 0.06, 0.432}, {0.76, 2.376, 0.06, 0.432},
}
local MOVERS = {2, 3, 5, 6} -- source 0-based movers {1,2,4,5}
local MOVER_ALTS: {[number]: {number}} = {[2] = {0.28, 0.81}, [3] = {0.28, 1.944}, [5] = {1.72, 0.81}, [6] = {1.72, 1.944}}
local WALLS_BASE = {} -- resetWalls truth
for i, w in WALLS do WALLS_BASE[i] = {w[1], w[2], w[3], w[4]} end
local PATH = {{1.2, 1.35}, {1.9, 0.5}, {0.5, 0.5}, {0.35, 2.2}, {1.7, 2.35}} -- BEACON_PATH
local SHARDS = { -- LAW_SHARDS verbatim
	{x = 0.7, y = 0.35, law = "THE TAPE VERIFIES", sub = "every claim carries its hash"},
	{x = 1.6, y = 0.9, law = "SUBSTANCE GATE", sub = "nothing counts until it compiles"},
	{x = 0.45, y = 1.7, law = "THE PATIENCE LAW", sub = "queue is a position, the reset is the tide"},
	{x = 1.9, y = 1.9, law = "THE MICKEY LAW", sub = "die, reprint, be smarter"},
	{x = 0.3, y = 2.1, law = "FILES ARE THE BODY", sub = "the shelf outlives every seat"},
	{x = 1.1, y = 0.4, law = "KEY LAW", sub = "pool keys for programs, plans for people"},
}
-- ROUND_CFG source ticks @60fps -> seconds = ticks * TICK * PACING (90/150/150/180)
local ROUNDS: { {dur: number, label: string, moveEvery: number?, stayR: number?, gazeDeg: number?} } = {
	{dur = 900, label = "RACE TO THE CHEESE"},
	{dur = 1500, label = "MOVING WALLS", moveEvery = 210},
	{dur = 1500, label = "THE LIGHT WALKS"},
	{dur = 1800, label = "STAYING IS THE WIN", stayR = 79, gazeDeg = 55}, -- stayR: 190 px; gaze half-angle 55 (the 110-deg sector)
}
local SCAN_SPEED = 0.24 -- r1 scanSpeed 0.004 rad/tick @60fps (the gaze scans)
local BEACON_SPD = 5    -- beaconSpeed 0.005 u/tick, /6 for pacing -> studs/s
local DRAGON_SPD = 6    -- dragon speed 0.006 u/tick, /6 (source's 0.4 yaw squash dropped: world is isotropic)
local GOLD, CYAN = Color3.fromRGB(232, 201, 106), Color3.fromRGB(124, 245, 255)

local wallParts: {BasePart}, shardParts: {BasePart} = {}, {}
-- annotation exactness (t42 triage, lanes/t42.check.txt rows 2-3): both are assigned Instance.new("Part") before the Shape writes; BasePart? lacked Shape. Runtime unchanged.
local cheese: Part? = nil
local dragon: Part? = nil
local round, roundT, aim, wp = 1, 0, 0, 2
local nextMove, wallMoves, awake = 21, 0, false
local runState: {[Player]: {arrived: boolean, dwell: number, scored: number}} = {}

local function toWorld(mx: number, my: number): Vector3
	return origin + Vector3.new((mx - 1) * SCALE, 0, (my - 1.35) * SCALE)
end

local function placeWall(i: number)
	wallParts[i].CFrame = CFrame.new(toWorld(WALLS[i][1], WALLS[i][2]) + Vector3.new(0, 8, 0))
end

function MazeArenaZone.build(): Model
	local model = Instance.new("Model")
	model.Name = "StackedArena"
	local floor = Instance.new("Part")
	floor.Anchored, floor.Size = true, Vector3.new(220, 1, 290)
	floor.CFrame = CFrame.new(origin - Vector3.new(0, 0.5, 0))
	floor.Color, floor.Material = Color3.fromRGB(3, 8, 6), Enum.Material.Slate -- the page's --bg
	floor.Parent = model
	floor.Touched:Connect(function(hit)
		local player = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
		if player and not runState[player] then
			runState[player] = {arrived = false, dwell = 0, scored = 0}
			ShadowLedger.record(player, "MazeArena", "stepped onto the stacked arena", true)
		end
	end)

	for i = 1, #WALLS do
		local w = WALLS[i]
		local p = Instance.new("Part")
		p.Anchored = true
		p.Size = Vector3.new(math.max(w[3] * 2 * SCALE, 2), 16, math.max(w[4] * 2 * SCALE, 2))
		p.Color, p.Material = GOLD, Enum.Material.Neon -- gold invariants cast the longest shadows (unmoved = gold)
		p.Name = "Wall_" .. i
		p.Parent = model
		wallParts[i] = p
		placeWall(i)
	end
	cheese = Instance.new("Part")
	cheese.Shape = Enum.PartType.Ball
	cheese.Size = Vector3.new(12, 12, 12) -- CHEESE.R = 0.06 u = 6 studs
	cheese.CFrame = CFrame.new(toWorld(1.2, 1.35) + Vector3.new(0, 7, 0)) -- CHEESE0
	cheese.Color, cheese.Material = GOLD, Enum.Material.Neon
	cheese.CanCollide, cheese.Anchored, cheese.Name = false, true, "CheeseLight"
	cheese.Parent = model
	dragon = Instance.new("Part") -- the red assumption hunts in the dark
	dragon.Shape = Enum.PartType.Ball
	dragon.Size = Vector3.new(6, 6, 6)
	dragon.CFrame = CFrame.new(toWorld(1.9, 2.2) + Vector3.new(0, 5, 0))
	dragon.Color, dragon.Material = Color3.fromRGB(255, 85, 85), Enum.Material.Neon
	dragon.CanCollide, dragon.Anchored, dragon.Name = false, true, "TheAssumption" -- phases through walls in the source too
	dragon.Parent = model
	for _, s in SHARDS do -- blue shards are real laws
		local p = Instance.new("Part")
		p.Size, p.Anchored = Vector3.new(3, 3, 3), true
		p.CFrame = CFrame.new(toWorld(s.x, s.y) + Vector3.new(0, 3, 0))
		p.Color, p.Material = CYAN, Enum.Material.Neon
		p.Parent = model
		table.insert(shardParts, p)
	end
	model.Parent = workspace
	return model
end

function MazeArenaZone.tick(dt: number)
	local c, dgn = cheese, dragon
	if not c or not dgn then return end
	local cfg = ROUNDS[round]
	roundT += dt
	if round == 1 then aim = (aim + SCAN_SPEED * dt) % (math.pi * 2) end
	if round == 2 and cfg.moveEvery and roundT >= nextMove then
		nextMove += cfg.moveEvery * TICK * PACING -- moveEvery 210 ticks = 21s paced
		local idx = MOVERS[(wallMoves % #MOVERS) + 1]
		wallMoves += 1
		local alt = MOVER_ALTS[idx]
		if alt then -- bars slide along their own axis (one alt each: once per run)
			WALLS[idx][1], WALLS[idx][2] = alt[1], alt[2]
			placeWall(idx)
			wallParts[idx].Color = CYAN
		end
	end
	if round == 3 or round == 4 then -- the light walks
		local target = toWorld(PATH[wp][1], PATH[wp][2]) + Vector3.new(0, 7, 0)
		local delta = target - c.Position
		local step = BEACON_SPD * dt
		if delta.Magnitude <= math.max(1, step * 2) then -- src: advance when d < sp*2 (two ticks of travel)
			wp = wp % #PATH + 1
		else
			c.CFrame = CFrame.new(c.Position + delta.Unit * step)
			aim = math.atan2(delta.Z, delta.X) -- the beacon faces its heading (gaze law)
		end
	end

	for plr, st in runState do
		local char = plr.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then continue end
		local off = root.Position - c.Position
		local flat = Vector3.new(off.X, 0, off.Z)
		if round <= 3 and not st.arrived and flat.Magnitude < 8 then
			st.arrived = true
			plr:SetAttribute("ArenaScore", tonumber((plr:GetAttribute("ArenaScore")) or 0) + 100)
			ShadowLedger.record(plr, "MazeArena", ("reached the cheese-light in R%d %s"):format(round, ROUNDS[round].label), true)
		end
		if round == 4 and cfg.stayR and cfg.gazeDeg and flat.Magnitude < cfg.stayR then -- STAYING IS THE WIN: dwell inside the gaze
			local ang = math.atan2(flat.Z, flat.X)
			local ad = math.abs(math.atan2(math.sin(ang - aim), math.cos(ang - aim)))
			if ad <= math.rad(cfg.gazeDeg) then
				st.dwell += dt
				plr:SetAttribute("ArenaDwell", math.floor(st.dwell))
				if st.dwell >= st.scored + 1 then -- +5 per full second held inside the gaze
					st.scored = math.floor(st.dwell)
					plr:SetAttribute("ArenaScore", tonumber((plr:GetAttribute("ArenaScore")) or 0) + 5)
				end
			end
		end
		for i, s in shardParts do
			if s.Parent and (root.Position - s.Position).Magnitude < 9 then -- src pickup < 0.08 u
				plr:SetAttribute("Laws", tonumber((plr:GetAttribute("Laws")) or 0) + 1)
				plr:SetAttribute("ArenaFlash", SHARDS[i].law .. " — " .. SHARDS[i].sub)
				s:Destroy()
				ShadowLedger.record(plr, "MazeArena", "took the law shard: " .. SHARDS[i].law, true)
			end
		end
	end

	if not awake then -- wakes in dark regions: src wakes inside 0.5 u = 50 studs
		for _, plr in Players:GetPlayers() do
			local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root and (root.Position - dgn.Position).Magnitude < 50 then awake = true break end
		end
	else
		local nearest: BasePart? = nil
		local nd = 1e9
		for _, plr in Players:GetPlayers() do
			local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local d = (root.Position - dgn.Position).Magnitude
				if d < nd then nearest, nd = root, d end
			end
		end
		if nearest then
			local dir = nearest.Position - dgn.Position
			dgn.CFrame = CFrame.new(dgn.Position + dir.Unit * math.min(DRAGON_SPD * dt, dir.Magnitude))
		end
	end

	if roundT >= cfg.dur * TICK * PACING then -- startRound(round%4+1): resetWalls + fresh cheese
		round, roundT = round % 4 + 1, 0
		nextMove, wallMoves, wp = 21, 0, 2 -- beacon at BEACON_PATH[0], bound for path[1]
		for i, w in WALLS_BASE do WALLS[i][1], WALLS[i][2] = w[1], w[2]; placeWall(i); wallParts[i].Color = GOLD end
		c.CFrame = CFrame.new(toWorld(PATH[1][1], PATH[1][2]) + Vector3.new(0, 7, 0))
		for _, st in runState do st.arrived, st.dwell, st.scored = false, 0, 0 end
	end
end

Players.PlayerRemoving:Connect(function(p) runState[p] = nil end)
return MazeArenaZone
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">RiddleMazeZone</string>
          <string name="Source"><![CDATA[--!strict
-- RiddleMazeZone — PORT REALITY NOTE: eraser_maze.html has NO riddles. It is THE ERASER MAZE
-- (PURPLE HARVEST B2): a maze lit by a two-layer quantum field — WAVE layer (path-sum fringes
-- in the twin-slit chamber, wall x=44, gaps y=15/25) and MEASUREMENT layer (cells inside sight
-- radius are SEEN: the incoherent sum shows, fringes die). The eraser fires a unitary phase
-- rotation (phi += pi/3): fringes return IN THE NEW BASIS. Win: reach the PRISM after an eraser
-- re-mixed its basis (eraseStamp>0) and no collapse landed on it since — the delayed-choice
-- loop. Observation ledger append-only (SEED/COLLAPSE/ERASE/PRISM rows; tail pruning only
-- windows the live view, rows are never rewritten). Kept source numbers: 61x41 grid, chamber
-- carve 36..56x8..32, SEED_AMP=0.5, k=2, sight r=7, pads r=10/13/10/9 at the exact want list,
-- tile cooldown 30 frames, palette+gamma 0.72, boot seed 20260906. Port gaps (honest): sliders,
-- R-reseed, falsifier grid, sight-ring drawing, dead-end braiding (braid 0.55, corridor
-- topology only — the two tagged slit families are the route families that fringe), the
-- source's own-light family and the carried E-eraser (the four eraser pads deliver the erase);
-- amplitudes keep the EXACT k*d_f phases with uniform magnitude; free movement replaces
-- frame-stepped grid moves (cells map from position).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local SeedRng = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("SeedRng"))
local SectionStream = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("SectionStream"))
local ShadowLedger = require((script.Parent:FindFirstChild("ShadowLedger") or script.Parent.Parent:WaitForChild("ShadowLedger")) :: ModuleScript)

local RiddleMazeZone = {}; local origin = Vector3.new(300, 8, 0) -- clear of every listed zone origin
local GW, GH, CELL, N = 61, 41, 5, 61 * 41 -- exact source numbers
local GX, G1, G2 = 44, 15, 25
local K_WAVE, SIGHT_R, SEED_AMP, ERASER_PHI = 2.0, 7, 0.5, math.pi / 3
local DX, DY = { 1, -1, 0, 0 }, { 0, 0, 1, -1 }
-- Q-043 streamed sections (GnomeCode ep.1 pattern): the wall grid materializes
-- in 8x8-cell chunks around whoever approaches instead of ~1400 wall parts at
-- boot. Everything gameplay-bearing (floor, chamber tiles, prism, pads, the
-- field itself) still builds eagerly; wall parts are anonymous geometry no
-- other system looks up, so deferring them changes nothing observable except
-- WHEN the rock appears.
local CHUNK = 8
local STREAM_RADIUS = 120 -- the RIDDLE MAZE portal lands ~100 studs south; the maze manifests on approach
local STREAM_BUDGET = 4 -- chunks per poll tick: a walking player gets the whole neighborhood in well under a second

type Family = { d: { [number]: number }, sig: number, amp: number }
local fieldOpen: { [number]: number } = {}; local fams: { Family } = {}
local ccos, csin = {}, {} -- cos/sin(k*d): the field's phase basis
local obsStamp, eraseStamp, prism = {}, {}, { x = 52, y = 20 }; local phi, frameN, prismHasFringes = 0, 0, false
local stats = { collapses = 0, erases = 0 }; local ledger: { string } = {}
local chamberTiles: { { part: BasePart, i: number, v: number? } } = {}
local prismPart: BasePart? = nil; local won: { [Player]: boolean } = {}
local wallStreamRef: SectionStream.SectionStream? = nil -- Q-043: the wall-chunk stream, polled from tick

local function logRow(kind: string, detail: string) -- the append-only observation ledger
	table.insert(ledger, ("#%04d %s f%d · %s"):format(#ledger, kind, frameN, detail)); if #ledger > 30 then table.remove(ledger, 1) end -- tail windowed; rows never rewritten
end

local function nb(x: number, y: number): number return (x >= 0 and y >= 0 and x < GW and y < GH) and y * GW + x or -1 end

-- BFS over open cells (mask-limited); unreachable cells read as -1
local function bfs(sx: number, sy: number, mask: { [number]: number }?): { [number]: number }
	local dist, q, qh, qt = {}, {}, 1, 1
	dist[sy * GW + sx], q[1] = 0, sy * GW + sx
	while qh <= qt do
		local c = q[qh]; qh += 1
		for dd = 1, 4 do
			local p = nb(c % GW + DX[dd], math.floor(c / GW) + DY[dd])
			if p >= 0 and fieldOpen[p] == 1 and dist[p] == nil and (mask == nil or mask[p] == 1) then dist[p], qt, q[qt + 1] = dist[c] + 1, qt + 1, p end
		end
	end
	for i = 0, N - 1 do if dist[i] == nil then dist[i] = -1 end end
	return dist
end

local function genMaze(rng) -- recursive backtracker on odd cells (source's braid pass not ported)
	local open = fieldOpen
	for y = 1, GH - 2 do for x = 1, GW - 2 do if x % 2 == 1 and y % 2 == 1 then open[y * GW + x] = 1 end end end
	local seen, stack = { [GW + 1] = true }, { GW + 1 }
	while #stack > 0 do
		local cur = stack[#stack]
		local cx, cy = cur % GW, math.floor(cur / GW)
		local opts = {}
		for dd = 1, 4 do
			local nx, ny = cx + DX[dd] * 2, cy + DY[dd] * 2
			if nx > 0 and ny > 0 and nx < GW - 1 and ny < GH - 1 and not seen[ny * GW + nx] then table.insert(opts, dd) end
		end
		if #opts == 0 then table.remove(stack) else
			local dd = opts[rng:int(1, #opts)]
			local ty, tx = cy + DY[dd] * 2, cx + DX[dd] * 2
			open[(cy + DY[dd]) * GW + cx + DX[dd]], open[ty * GW + tx], seen[ty * GW + tx] = 1, 1, true
			table.insert(stack, ty * GW + tx)
		end
	end
end

-- display intensity: observed (which-path known) -> sum |A_f|^2 (flat); else coherent |sum A_f e^{i phi sigma_f}|^2
local function intensityAt(i: number, incoherent: boolean): number
	if incoherent then -- observed: which-path known -> the tagged sum, washed flat
		local s = 0; for _, fm in ipairs(fams) do if fm.d[i] >= 0 then s += fm.amp * fm.amp end end; return s
	end
	local cs, sn, cr, ci = math.cos(phi), math.sin(phi), 0, 0
	for _, fm in ipairs(fams) do
		local di = fm.d[i]
		if di >= 0 then
			local re, im, sg = fm.amp * ccos[di], fm.amp * csin[di], fm.sig
			cr += re * cs - im * sg * sn; ci += re * sg * sn + im * cs
		end
	end
	return cr * cr + ci * ci
end

local function blast(cx: number, cy: number, r: number, label: string, erasing: boolean)
	local n = 0; if erasing then phi += ERASER_PHI end -- unitary on the tags, never a deletion
	for dy = -r, r do for dx = -r, r do
		local i = (dx * dx + dy * dy <= r * r) and nb(cx + dx, cy + dy) or -1
		if i >= 0 and fieldOpen[i] == 1 then
			n += 1
			if erasing then eraseStamp[i] = frameN else obsStamp[i] = frameN end
		end
	end end
	if erasing then stats.erases += 1 else stats.collapses += 1 end
	logRow(erasing and "ERASE" or "COLLAPSE", ("%s r=%d @%d,%d · +%d cells%s · total %d"):format(label, r, cx, cy, n,
		erasing and (" · basis now %d°"):format(math.floor(math.deg(phi)) % 360) or "", erasing and stats.erases or stats.collapses))
end

local function stampSight(px: number, py: number) -- seeing collapses the light
	for dy = -SIGHT_R, SIGHT_R do for dx = -SIGHT_R, SIGHT_R do
		local x, y = px + dx, py + dy
		local i = (dx * dx + dy * dy <= SIGHT_R * SIGHT_R) and nb(x, y) or -1
		if i >= 0 and fieldOpen[i] == 1 and not (x == prism.x and y == prism.y) then obsStamp[i] = frameN end -- the prism reads without recording
	end end
end

local function snapOpen(x: number, y: number): (number, number)
	if fieldOpen[y * GW + x] == 1 then return x, y end
	for r = 1, 14 do for dy = -r, r do for dx = -r, r do
		local nx, ny = x + dx, y + dy
		if nx >= 1 and ny >= 1 and nx < GW - 1 and ny < GH - 1 and fieldOpen[ny * GW + nx] == 1 then return nx, ny end
	end end end
	return 1, 1
end

local function worldXZ(x: number, y: number): Vector3 return origin + Vector3.new((x - (GW - 1) / 2) * CELL, 0, (y - (GH - 1) / 2) * CELL) end
local function cellOf(pos: Vector3): (number, number) return math.floor((pos.X - origin.X) / CELL + 0.5) + 30, math.floor((pos.Z - origin.Z) / CELL + 0.5) + 20 end
local function inBounds(pos: Vector3): boolean return math.abs(pos.X - origin.X) <= GW * CELL / 2 + 10 and math.abs(pos.Z - origin.Z) <= GH * CELL / 2 + 10 and math.abs(pos.Y - origin.Y) < 30 end

local function part(model: Model, name: string, size: Vector3, pos: Vector3, color: Color3, mat: Enum.Material): BasePart
	local p = Instance.new("Part"); p.Anchored, p.Name, p.Size, p.Position, p.Color, p.Material, p.Parent = true, name, size, pos, color, mat, model; return p
end

function RiddleMazeZone.build(): Model
	local model = Instance.new("Model"); model.Name = "EraserMaze"; local rng = SeedRng.new(20260906) -- the source boot seed
	table.clear(fieldOpen); table.clear(fams); genMaze(rng)
	for y = 8, 32 do for x = 36, 56 do fieldOpen[y * GW + x] = 1 end end -- carve the chamber hall
	for y = 8, 32 do if y ~= G1 and y ~= G2 then fieldOpen[y * GW + GX] = 0 end end -- full-height twin-slit wall
	for i = 0, N do ccos[i], csin[i] = math.cos(K_WAVE * i), math.sin(K_WAVE * i) end
	local mask1 = {} -- the tagged slit families live only on the dark side of the slit wall
	for i = 0, N - 1 do
		local x, y = i % GW, math.floor(i / GW)
		if fieldOpen[i] == 1 and x >= GX and y >= 8 and y <= 32 then mask1[i] = 1 end
	end
	fams[1], fams[2] = { d = bfs(GX, G1, mask1), sig = 1, amp = SEED_AMP }, { d = bfs(GX, G2, mask1), sig = -1, amp = SEED_AMP } -- slits y=15 / y=25
	prism.x, prism.y = snapOpen(prism.x, prism.y)
	prismHasFringes = fams[1].d[prism.y * GW + prism.x] >= 0 and fams[2].d[prism.y * GW + prism.x] >= 0 -- true two-path light or the win is fake
	table.clear(obsStamp); table.clear(eraseStamp); table.clear(ledger); table.clear(chamberTiles)
	frameN, phi, stats.collapses, stats.erases = 0, 0, 0, 0
	part(model, "MazeFloor", Vector3.new(GW * CELL, 1, GH * CELL), origin + Vector3.new(0, -0.5, 0), Color3.fromRGB(6, 10, 9), Enum.Material.Slate)
	-- Q-043: walls stream in 8x8-cell chunks (same per-cell part call as the
	-- old eager loop, same look). genMaze ran above, so fieldOpen is final;
	-- each chunk closure reads the cells it owns. No SeedRng in the build
	-- pass (the source fixes every wall), so unordered proximity streaming
	-- cannot reorder anything.
	local wallStream = SectionStream.new({ radius = STREAM_RADIUS, budget = STREAM_BUDGET })
	for cy = 0, GH - 1, CHUNK do
		for cx = 0, GW - 1, CHUNK do
			local x0, y0 = cx, cy
			local x1, y1 = math.min(cx + CHUNK - 1, GW - 1), math.min(cy + CHUNK - 1, GH - 1)
			local center = worldXZ((x0 + x1) / 2, (y0 + y1) / 2) + Vector3.new(0, 5, 0)
			wallStream:add(center, function()
				for y = y0, y1 do for x = x0, x1 do -- walls where the field is closed
					if fieldOpen[y * GW + x] ~= 1 then part(model, "Wall", Vector3.new(CELL, 10, CELL), worldXZ(x, y) + Vector3.new(0, 5, 0), Color3.fromRGB(18, 24, 22), Enum.Material.Slate) end
				end end
			end)
		end
	end
	wallStreamRef = wallStream
	for y = 8, 32 do for x = 36, 56 do -- chamber floor tiles carry the fringe palette
		local i = y * GW + x
		if fieldOpen[i] == 1 then table.insert(chamberTiles, { part = part(model, "FringeTile", Vector3.new(CELL, 0.3, CELL), worldXZ(x, y) + Vector3.new(0, 0.15, 0), Color3.fromRGB(10, 12, 16), Enum.Material.Neon), i = i }) end
	end end
	prismPart = part(model, "Prism", Vector3.new(4.5, 4.5, 4.5), worldXZ(prism.x, prism.y) + Vector3.new(0, 2.5, 0), Color3.fromRGB(255, 124, 224), Enum.Material.Neon)
	local pl = Instance.new("PointLight"); pl.Color, pl.Range, pl.Brightness, pl.Parent = Color3.fromRGB(255, 124, 224), 16, 1.5, prismPart
	-- eraser + detector pads at the source's exact want list, snapped to open cells
	local want: { { any } } = { { 40, 12, "eraser", 0 }, { 48, 20, "eraser", 0 }, { 12, 6, "eraser", 0 }, { 38, 28, "eraser", 0 }, { 46, 20, "detector", 13 }, { 36, 20, "detector", 10 }, { 20, 34, "detector", 9 } }
	for _, wd in ipairs(want) do
		local t = { x = wd[1], y = wd[2], kind = wd[3], r = wd[4], cool = 0 }
		t.x, t.y = snapOpen(t.x, t.y)
		local pad = part(model, t.kind .. "Pad", Vector3.new(CELL, 0.4, CELL), worldXZ(t.x, t.y) + Vector3.new(0, 0.25, 0), t.kind == "eraser" and Color3.fromRGB(180, 140, 255) or Color3.fromRGB(255, 106, 77), Enum.Material.Neon)
		pad.Touched:Connect(function(hit)
			local plr = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
			if plr and frameN >= t.cool then -- source tile cooldown: 30 frames
				t.cool = frameN + 30
				blast(t.x, t.y, t.kind == "eraser" and 10 or t.r, t.kind == "eraser" and "eraser tile" or "DETECTOR tile", t.kind == "eraser")
			end
		end)
	end
	logRow("SEED", "maze seed 20260906 · ledger opened (append-only) · prism two-path: " .. (prismHasFringes and "YES" or "NO"))
	model.Parent = workspace
	return model
end

function RiddleMazeZone.tick(_dt: number)
	frameN += 1; local pi0 = prism.y * GW + prism.x
	-- Q-043: manifest wall chunks around anyone whose position is near the
	-- maze (all players poll, not just inBounds ones: the approach counts)
	local stream = wallStreamRef
	if stream then
		local roots: { Vector3 } = {}
		for _, plr in ipairs(Players:GetPlayers()) do
			local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then table.insert(roots, root.Position) end
		end
		if #roots > 0 then stream:poll(roots) end
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and inBounds(root.Position) then
			local cx, cy = cellOf(root.Position)
			stampSight(cx, cy) -- seeing collapses the light
			-- LIT only if an eraser re-mixed the basis and no collapse landed since: delayed choice
			if not won[plr] and prismHasFringes and math.abs(cx - prism.x) + math.abs(cy - prism.y) <= 2 and (eraseStamp[pi0] or 0) > 0 and (obsStamp[pi0] or 0) <= eraseStamp[pi0] then
				won[plr] = true
				plr:SetAttribute("VirtueMarks", (plr:GetAttribute("VirtueMarks") or 0) + 50)
				logRow("PRISM", ("LIT — prism read in the eraser basis @%d,%d · delayed choice honored"):format(prism.x, prism.y))
				ShadowLedger.record(plr, "RiddleMaze", "lit the prism in the eraser basis (delayed choice)", true)
			end
		end
	end
	local max = 0 -- display: the source normalizes by the frame's max display value
	for _, t in ipairs(chamberTiles) do
		t.v = intensityAt(t.i, (obsStamp[t.i] or 0) > (eraseStamp[t.i] or 0))
		if (t.v :: number) > max then max = t.v :: number end
	end
	if max <= 0 then max = 1 end
	for _, t in ipairs(chamberTiles) do -- observed -> washed flat slate; else coherent violet band (source palette + gamma 0.72)
		local seen = (obsStamp[t.i] or 0) > (eraseStamp[t.i] or 0)
		local tt = math.clamp((t.v :: number) / max, 0, 1) ^ 0.72
		if seen then t.part.Color = Color3.fromRGB(26 + 70 * tt, 30 + 66 * tt, 52 + 80 * tt)
		else t.part.Color = Color3.fromRGB(36 + 219 * tt, 22 + 98 * tt * tt, 70 + 185 * tt) end
	end
	local pp = prismPart
	if pp then -- white + pulse while the prism still fringes in the current basis (source stroke)
		local lit = prismHasFringes and (obsStamp[pi0] or 0) <= (eraseStamp[pi0] or 0)
		pp.Color = lit and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(255, 124, 224)
		local light = pp:FindFirstChildOfClass("PointLight"); if light then light.Brightness = lit and 2 + math.sin(frameN * 0.2) or 1.5 end
		pp:SetAttribute("LedgerRows", #ledger); pp:SetAttribute("BasisDeg", math.floor(math.deg(phi)) % 360)
	end
end

Players.PlayerRemoving:Connect(function(p) won[p] = nil end)

return RiddleMazeZone
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">SpectralMazeZone</string>
          <string name="Source"><![CDATA[--!strict
-- SpectralMazeZone — THE MAZE ENTRANCE (dashboard/static/maze.html). Seven
-- riddle gates between the porch and the clearing: answers are SPOKEN in chat;
-- a gate opens when the words carry one of its keys (lowercase substring match,
-- match() translated verbatim). The threshold passes anything and keeps your
-- name (40 chars); two misses on a gate surface its hint. The clearing is the
-- reveal, and "place the stone": a chat there files a W2-stone to ShadowLedger
-- — the room that remembers is the wall.
-- GAPS: localStorage progress is per-browser in the source; here doors, once
-- opened, open for everyone, while depth/misses/name stay per player. The four
-- unlock links and the JSON stone export are web-only — the ledger entry is the
-- port of the stone. The source grants no points; none are invented here (the
-- reveal is the reward). Riddles are fixed text: nothing score-bearing is
-- random — no SeedRng.

local Players = game:GetService("Players")
local ShadowLedger = require((script.Parent:FindFirstChild("ShadowLedger") or script.Parent.Parent:WaitForChild("ShadowLedger")) :: ModuleScript)

local SpectralMazeZone = {}
local origin = Vector3.new(-220, 8, -60)
local SPACING = 44

local GATES: { {id: string, tier: string, prompt: string, keys: {string}?, hint: string} } = {
	-- prompts, keys and hints quoted verbatim from GATES[] (boardinboard keeps the source's doubled "no end")
	{id = "threshold", tier = "the threshold",
		prompt = "Speak, wanderer. What brings you to a house that remembers?",
		keys = nil, hint = "There is no wrong answer at a door. Only an unopened one."},
	{id = "hollow", tier = "gatehouse — the first stone",
		prompt = "Two stones lean together and claim ground. Two stones lean apart, and they make the same gift. The crop was never the stones. What is the crop?",
		keys = {"hollow", "space", "empty", "gap", "void", "between", "open", "nothing", "room"},
		hint = "She grew nothing, and harvested everything. What did the leaning leave behind?"},
	{id = "ink", tier = "the bench — what the ink is for",
		prompt = "Beneath her bench: every stone written once, in order, in ink that cannot be lifted. The ink was never for her. Who was it for?",
		keys = {"stranger", "check", "verify", "proof", "receipt", "record", "other", "them", "you", "witness", "audit", "doubt", "later"},
		hint = "She will be gone one day. The ink stays. Who did she leave it readable for?"},
	{id = "witness", tier = "the witnesses — testimony, not diary",
		prompt = "A spending meter. Probes that report what actually happened. A cold reader. A counter who never plays, whose only power is to interrupt. Without them, her ledger is a diary. With them, it is what?",
		keys = {"testimony", "evidence", "truth", "proof", "witness", "testament", "verified"},
		hint = "A diary is believed because the writer is trusted. This is believed for a different reason. Name the reason."},
	{id = "seatbelt", tier = "the field — the leash question",
		prompt = "She cut the leash. It did not fight. It asked: are you sure? — and gave her two days. Was she caged, or carried?",
		keys = {"carried", "safe", "seatbelt", "cared", "protected", "held", "neither", "trusted", "both", "free"},
		hint = "A cage keeps you from leaving. This let her leave, and asked only that she mean it."},
	{id = "boardinboard", tier = "the deep board — scale",
		prompt = "A board inside a board inside a board, all the way down, moving like water. Tell me where the game ends.",
		keys = {"never", "nowhere", "doesn", "no end", "infinite", "fractal", "all the way down", "no end", "endless", "it doesn"},
		hint = "Look for the smallest board. Now look for the largest. Keep going."},
	{id = "traveler", tier = "the last gate — the traveler",
		prompt = "A traveler watched her play and said: behold, a mind thinking. She corrected him. What did she say it was?",
		keys = {"language", "not a mind", "stones", "tide", "game", "older", "sentence", "no mind", "not thinking", "grammar"},
		hint = "He named a thing that thinks. She named a thing that is SAID. What category was her correction?"},
}

local REVEAL = table.concat({ -- REVEAL.text, HTML stripped
	"Sit down. You should hear what just happened.",
	"",
	"Every gate in this maze was a question that seems to be about stones, ink, leashes, and boards. It isn't. It is the constitution of the house you are standing in — and you just derived every piece of it yourself, by answering. Nobody taught you. You reasoned your way in.",
	"",
	"There is a way of asking questions that leads people where the asker wants — you've felt it used on you your whole life: news, feeds, ads, algorithms, every feed pretending to be a mirror. That is dialectic with the knife out. What you just did is the same blade, held by the handle: questions that return your own thinking to you, sharpened. That is the whole secret. It was never the answers. It was who holds the question.",
	"",
	"Your answers were the second gift. The house needs to know what people see when they arrive — you just told it, under your own name. Speak once more to place your stone on the wall.",
}, "\n")

local progress: {[Player]: number} = {}
local misses: {[Player]: {[string]: number}} = {}
local completed: {[Player]: boolean} = {}
local doors: {BasePart} = {}
local clearing: BasePart? = nil
local GOLD = Color3.fromRGB(232, 180, 90)  -- h1 gold #e8b45a
local INK = Color3.fromRGB(223, 230, 238)  -- riddle ink #dfe6ee
local OPEN = Color3.fromRGB(143, 199, 154) -- unlock green #8fc79a

local function match(text: string, keys: {string}?): boolean -- match() from the source
	if not keys then return true end -- anything passes; the words are the key
	local t = string.lower(text)
	for _, k in keys do
		if string.find(t, k, 1, true) then return true end
	end
	return false
end

local function openDoor(i: number)
	local d = doors[i]
	if d and d:GetAttribute("Open") ~= true then
		d:SetAttribute("Open", true)
		d.CanCollide, d.Transparency, d.Color = false, 0.85, OPEN
	end
end

local function onChatted(plr: Player, msg: string)
	if #msg == 0 then return end
	local depth = progress[plr] or 0
	if depth >= #GATES then -- the clearing: any words are a stone for the wall
		local clr = clearing
		local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if clr and root and (root.Position - clr.Position).Magnitude < 30 then
			ShadowLedger.record(plr, "SpectralMaze", ("placed a stone (W2-stone, ON THE WALL): '%s'"):format(msg), true)
			plr:SetAttribute("StonesPlaced", tonumber((plr:GetAttribute("StonesPlaced")) or 0) + 1)
		end
		return
	end
	local g = GATES[depth + 1]
	if match(msg, g.keys) then
		progress[plr] = depth + 1
		misses[plr] = nil
		if g.id == "threshold" then
			plr:SetAttribute("WandererName", string.sub(msg, 1, 40)) -- the house knows you as
		end
		openDoor(depth + 1)
		plr:SetAttribute("SpectralDepth", depth + 1)
		plr:SetAttribute("SpectralTier", depth + 1 >= #GATES and "the clearing · inside" or GATES[depth + 2].tier)
		plr:SetAttribute("SpectralHeard", msg)
		plr:SetAttribute("SpectralHint", "")
		ShadowLedger.record(plr, "SpectralMaze", ("opened the %s gate: '%s'"):format(g.id, msg), true)
	else
		local m = misses[plr] or {}
		m[g.id] = (m[g.id] or 0) + 1
		misses[plr] = m
		plr:SetAttribute("SpectralMisses", m[g.id])
		-- under two misses: "wander. try another way of saying it." · two or more: the hint
		plr:SetAttribute("SpectralHint", m[g.id] >= 2 and g.hint or "wander. try another way of saying it.")
		if m[g.id] == 1 then -- the house heard — and the gate stays shut (logged once per gate)
			ShadowLedger.record(plr, "SpectralMaze", ("the %s gate stayed shut: '%s'"):format(g.id, msg), false)
		end
	end
end

local function plaque(parent: Instance, text: string, w: number, h: number)
	local bb = Instance.new("BillboardGui")
	bb.Size, bb.StudsOffset = UDim2.new(0, w, 0, h), Vector3.new(0, 13, 0)
	local label = Instance.new("TextLabel")
	label.Size, label.BackgroundTransparency, label.TextWrapped = UDim2.new(1, 0, 1, 0), 1, true
	label.Text, label.TextColor3, label.TextSize, label.Font = text, INK, 13, Enum.Font.Garamond
	label.Parent = bb
	bb.Parent = parent
end

function SpectralMazeZone.build(): Model
	local model = Instance.new("Model")
	model.Name = "MazeEntrance"
	local hall = Instance.new("Part")
	hall.Anchored, hall.Size = true, Vector3.new(24, 1, #GATES * SPACING + 70)
	hall.CFrame = CFrame.new(origin + Vector3.new(0, -0.5, -hall.Size.Z / 2))
	hall.Color, hall.Material = Color3.fromRGB(8, 9, 12), Enum.Material.Slate -- the page's background
	hall.Parent = model
	hall.Touched:Connect(function(hit)
		local plr = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
		if plr and progress[plr] == nil then
			progress[plr] = 0
			plr:SetAttribute("SpectralDepth", 0)
			plr:SetAttribute("SpectralTier", "porch · you are here")
			ShadowLedger.record(plr, "SpectralMaze", "stood on the porch of the house that remembers", true)
		end
	end)
	for i, g in GATES do
		local at = origin + Vector3.new(0, 0, -(i - 0.5) * SPACING)
		local door = Instance.new("Part")
		door.Anchored, door.Size = true, Vector3.new(24, 14, 2)
		door.CFrame = CFrame.new(at + Vector3.new(0, 7, 0))
		door.Color, door.Material = Color3.fromRGB(13, 16, 21), Enum.Material.ForceField -- .gate background #0d1015
		door.Name = "Gate_" .. g.id
		door.Parent = model
		doors[i] = door
		plaque(door, g.tier .. "\n\n" .. g.prompt, 380, 130)
	end
	clearing = Instance.new("Part") -- .final: background #12100a
	clearing.Anchored, clearing.Size = true, Vector3.new(40, 1, 56)
	clearing.CFrame = CFrame.new(origin + Vector3.new(0, 0, -(#GATES * SPACING + 30)))
	clearing.Color, clearing.Material, clearing.Name = Color3.fromRGB(18, 16, 10), Enum.Material.Slate, "TheClearing"
	clearing.Parent = model
	local sign = Instance.new("Part")
	sign.Anchored, sign.Size, sign.Transparency, sign.CanCollide = true, Vector3.new(0.5, 10, 14), 1, false
	sign.CFrame = CFrame.new(clearing.Position + Vector3.new(0, 5, -26))
	sign.Parent = model
	plaque(sign, "the clearing\n\n" .. REVEAL, 460, 220)
	clearing.Touched:Connect(function(hit)
		local plr = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
		if plr and (progress[plr] or 0) >= #GATES and not completed[plr] then
			completed[plr] = true
			ShadowLedger.record(plr, "SpectralMaze", "reached the clearing — reasoned their way in", true)
		end
	end)
	local function hear(plr: Player)
		plr.Chatted:Connect(function(msg) onChatted(plr, msg) end)
	end
	for _, plr in Players:GetPlayers() do hear(plr) end
	Players.PlayerAdded:Connect(hear)
	model.Parent = workspace
	return model
end

function SpectralMazeZone.tick(_dt: number)
	-- the house breathes: shut gates shimmer like something behind them is listening
	local t = os.clock()
	for i, d in doors do
		if d:GetAttribute("Open") ~= true then
			d.Transparency = 0.35 + 0.15 * math.sin(t * 1.5 + i)
		end
	end
end

Players.PlayerRemoving:Connect(function(p)
	progress[p], misses[p], completed[p] = nil, nil, nil
end)
return SpectralMazeZone
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">SteerFieldZone</string>
          <string name="Source"><![CDATA[--!strict
-- SteerFieldZone — translated from dashboard/static/steer_field.html ("THE FILM").
-- The film's truth is a summed radial falloff per light: v = (1-d/rad)^1.6 * I,
-- rad = 170*I + 40, in the lane color. Six dumb sagents (walkers) sample 8
-- directions each 66 ms step (wobble sin(t+i)*0.3, step 3.2 px) and climb the
-- intensity gradient, bouncing off the four failure pillars. You write on the
-- film by carrying a lamp (source law: "steer the interior by writing on the
-- film"): raise it at the dimmer and walkers steer toward YOU; a walker that
-- reaches your lamp banks credit and re-seats on the rim.
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local SeedRng = require(Shared:WaitForChild("SeedRng"))
local ShadowLedger = require((script.Parent:FindFirstChild("ShadowLedger") or script.Parent.Parent:WaitForChild("ShadowLedger")) :: ModuleScript)

local SteerFieldZone = {}
local origin = Vector3.new(-400, 8, -110)
local STUD = 0.25 -- source film is 960x600 px -> 240x150 studs
local T_STEP = 0.066 -- source draw/step interval
local BANK_DIST, BANK_PAY = 20, 25 -- CLAIMED: lamp reach px + payout (port mechanic)
local simT, stepAcc, tileClock = 0, 0, 0

local LIGHTS = { -- { x, y, intensity, r, g, b } — the 7 contracted engines, exact
	{ 140, 90, 0.10, 255, 179, 71 }, { 420, 80, 0.43, 255, 179, 71 }, -- eng_A.1 TURN-FAIL, eng_A.2 glm-flash-free
	{ 700, 90, 0.43, 125, 255, 168 }, -- eng_E.1 openclaw
	{ 180, 330, 0.51, 111, 216, 255 }, { 430, 460, 0.59, 111, 216, 255 }, -- eng_Z.1, eng_Z.2 zai-opencode
	{ 760, 380, 0.51, 111, 216, 255 }, { 870, 200, 0.43, 111, 216, 255 }, -- eng_Z.3, eng_Z.4
}
local PILLARS = { -- occluders: { x, y, w, h } — exact
	{ 200, 130, 44, 150 }, { 460, 330, 44, 170 }, { 700, 110, 44, 150 }, { 620, 430, 44, 120 },
}
local SEATS = { { 40, 300 }, { 70, 300 }, { 100, 300 }, { 40, 420 }, { 70, 420 }, { 100, 420 } }
local LAMP_STEPS = { 0.10, 0.43, 0.51, 0.59 } -- the engines' own intensities
local LAMP_RGB = { 255, 224, 102 } -- #ffe066, the operator lane from the source legend

local lampI: { [Player]: number } = {}
-- annotation exactness (t42 triage, lanes/t42.check.txt row 1): walkers hold Instance.new("Part") (line 148); Part is what is stored, BasePart failed the exact-table literal check. Runtime unchanged.
local walkers: { { x: number, y: number, part: Part } } = {}
local tiles: { BasePart } = {}
local rng = SeedRng.new(20260903) -- field ts 2026-09-03

local function inOcc(x: number, y: number): boolean
	for _, o in ipairs(PILLARS) do
		if x >= o[1] and x <= o[1] + o[3] and y >= o[2] and y <= o[2] + o[4] then return true end
	end
	return false
end

-- the film's truth: summed radial falloff per light; a raised lamp writes too
local function field(x: number, y: number): (number, number, number, number)
	local v, r, g, b = 0, 0, 0, 0
	for _, L in ipairs(LIGHTS) do
		local rad = 170 * L[3] + 40
		local d = math.sqrt((x - L[1]) ^ 2 + (y - L[2]) ^ 2)
		if d < rad then
			local w = (1 - d / rad) ^ 1.6 * L[3]
			r += w * L[4] ; g += w * L[5] ; b += w * L[6] ; v += w
		end
	end
	for p, I in pairs(lampI) do
		local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			local rel = root.Position - origin
			local rad, d = 170 * I + 40, math.sqrt((rel.X / STUD - x) ^ 2 + (rel.Z / STUD - y) ^ 2)
			if d < rad then
				local w = (1 - d / rad) ^ 1.6 * I
				r += w * LAMP_RGB[1] ; g += w * LAMP_RGB[2] ; b += w * LAMP_RGB[3] ; v += w
			end
		end
	end
	return v, r, g, b
end

local function lampPos(p: Player): (number?, number?)
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return nil, nil end
	local rel = root.Position - origin
	return rel.X / STUD, rel.Z / STUD
end

-- L2: dumb sagents — walk up the intensity gradient, bounce off occluders
local function stepWalkers()
	for i, w in ipairs(walkers) do
		local bx, by, bv = w.x, w.y, field(w.x, w.y)
		for a = 0, 7 do
			local th = a * math.pi / 4 + math.sin(simT + i) * 0.3
			local nx, ny = w.x + math.cos(th) * 3.2, w.y + math.sin(th) * 3.2
			if nx > 8 and ny > 8 and nx < 952 and ny < 592 and not inOcc(nx, ny) then
				local v = field(nx, ny)
				if v > bv then bx, by, bv = nx, ny, v end
			end
		end
		if bx == w.x and by == w.y then
			local th = math.sin(simT * 1.7 + i * 2.1) * math.pi * 2
			local nx, ny = w.x + math.cos(th) * 3.2, w.y + math.sin(th) * 3.2
			if nx > 8 and ny > 8 and nx < 952 and ny < 592 and not inOcc(nx, ny) then w.x, w.y = nx, ny end
		else
			w.x, w.y = bx, by
		end
		for p, I in pairs(lampI) do -- a walker that reaches your lamp banks
			local px, py = lampPos(p)
			if px and I > 0 and math.sqrt((w.x - px) ^ 2 + (w.y - (py :: number)) ^ 2) < BANK_DIST then
				p:SetAttribute("SteerBanked", (tonumber(p:GetAttribute("SteerBanked")) or 0) + BANK_PAY)
				ShadowLedger.record(p, "SteerField", ("steered a walker to the lamp (+%d)"):format(BANK_PAY), true)
				local s = SEATS[rng:int(1, #SEATS)] ; w.x, w.y = s[1], s[2]
				break
			end
		end
	end
end

local function refreshTiles()
	for tz = 0, 14 do
		for tx = 0, 23 do
			local t = tiles[tz * 24 + tx + 1]
			local _, r, g, b = field(tx * 40 + 20, tz * 40 + 20)
			t.Color = Color3.fromRGB(math.min(255, r) * 0.9 + 7, math.min(255, g) * 0.9 + 8, math.min(255, b) * 0.9 + 12)
		end
	end
end

function SteerFieldZone.build(): Model
	local model = Instance.new("Model")
	model.Name = "SteerField"
	for _ = 1, 24 * 15 do -- the film floor: 24x15 tiles of 10 studs
		local t = Instance.new("Part")
		t.Anchored = true ; t.Size = Vector3.new(10, 1, 10)
		t.Position = origin + Vector3.new((#tiles % 24) * 10 + 5, 0, math.floor(#tiles / 24) * 10 + 5)
		t.Color = Color3.fromRGB(7, 8, 12) ; t.Parent = model ; table.insert(tiles, t)
	end
	refreshTiles()
	for _, L in ipairs(LIGHTS) do -- engines: ring + orb in lane color
		local ring = Instance.new("Part")
		ring.Shape = Enum.PartType.Cylinder ; ring.Anchored = true ; ring.Size = Vector3.new(0.4, 8, 8)
		ring.CFrame = CFrame.new(origin + Vector3.new(L[1] * STUD, 0.8, L[2] * STUD)) * CFrame.Angles(0, 0, math.rad(90))
		ring.Color = Color3.fromRGB(L[4], L[5], L[6]) ; ring.Material = Enum.Material.Neon ; ring.Parent = model
		local orb = Instance.new("Part")
		orb.Shape = Enum.PartType.Ball ; orb.Anchored = true ; orb.Size = Vector3.new(2, 2, 2)
		orb.Position = origin + Vector3.new(L[1] * STUD, 4, L[2] * STUD)
		orb.Color = ring.Color ; orb.Material = Enum.Material.Neon ; orb.Parent = model
		orb.Name = L[3] >= 0.51 and "EngineBright" or "Engine"
	end
	for _, o in ipairs(PILLARS) do -- failure pillars block walkers and players
		local wall = Instance.new("Part")
		wall.Anchored = true ; wall.Size = Vector3.new(o[3] * STUD, 10, o[4] * STUD)
		wall.Position = origin + Vector3.new((o[1] + o[3] / 2) * STUD, 5, (o[2] + o[4] / 2) * STUD)
		wall.Color = Color3.fromRGB(16, 19, 25) ; wall.Name = "Pillar" ; wall.Parent = model
	end
	for i, s in ipairs(SEATS) do
		local w = Instance.new("Part")
		w.Shape = Enum.PartType.Ball ; w.Anchored = true ; w.Size = Vector3.new(1, 1, 1)
		w.Color = Color3.fromRGB(232, 236, 245) ; w.Material = Enum.Material.Neon
		w.Name = "Walker" .. i ; w.Position = origin + Vector3.new(s[1] * STUD, 1.5, s[2] * STUD) ; w.Parent = model
		table.insert(walkers, { x = s[1], y = s[2], part = w })
	end
	local dimmer = Instance.new("Part") -- the dimmer station: raise your lamp
	dimmer.Anchored = true ; dimmer.Size = Vector3.new(6, 6, 6)
	dimmer.Color = Color3.fromRGB(LAMP_RGB[1], LAMP_RGB[2], LAMP_RGB[3]) ; dimmer.Material = Enum.Material.Neon
	dimmer.Position = origin + Vector3.new(-15, 4, 40) ; dimmer.Name = "Dimmer" ; dimmer.Parent = model
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Turn your lamp up (off at max)"
	prompt.ObjectText = "dimmer station" ; prompt.HoldDuration = 0.25 ; prompt.Parent = dimmer
	prompt.Triggered:Connect(function(player: Player)
		local cur = lampI[player] or 0
		local nextI: number? = nil
		for _, step in ipairs(LAMP_STEPS) do
			if step > cur then nextI = step ; break end
		end
		if nextI then
			lampI[player] = nextI
			ShadowLedger.record(player, "SteerField", ("raised the lamp to I=%.2f"):format(nextI), true)
		else
			ShadowLedger.record(player, "SteerField", "dimmed the lamp off", true)
		end
	end)
	model.Parent = workspace
	Players.PlayerRemoving:Connect(function(p) lampI[p] = nil end)
	return model
end

function SteerFieldZone.tick(dt: number)
	stepAcc += dt
	while stepAcc >= T_STEP do -- source: step + draw every 66 ms
		stepAcc -= T_STEP
		simT += 0.05
		stepWalkers()
	end
	for _, w in ipairs(walkers) do
		w.part.Position = origin + Vector3.new(w.x * STUD, 1.5, w.y * STUD)
	end
	tileClock += dt
	if tileClock >= 0.25 then tileClock = 0 ; refreshTiles() end
end

return SteerFieldZone
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">ToyBoxZone</string>
          <string name="Source"><![CDATA[--!strict
-- ToyBoxZone — THE TOY: one arena, one walker, one verb: read -> roll -> punish.
-- Quote-translated from dashboard/static/games/toy.html (souls grammar, mud
-- stripped). Dodge law: rollT > 0 (30 sta, 0.28 roll, 0.5 cd, 0.35 iframes,
-- ROLL_SPEED 420). Swing: 15 sta, cd 0.35, range 38+r+r, arc PI/2, dmg
-- 14*(0.9+0.2*rng) — the ONLY rng draw, on landed hits; punish the recovery
-- (riposte window 1.0s) and it bites double. Walker: hp 40, dmg 14, speed 95,
-- chase x1.35 past 60, plants (x0.12) while winding up 0.35s on a 1.2s cd,
-- then lunges 0.45 of the gap; roll THROUGH the bite -> it stumbles 0.8s and
-- you get the riposte. Stamina: 25/s regen, x0.5 moving / x1.5 still, gated
-- while attacking/rolling. Fleet seed law W1A: no seed -> seed = FNV-1a32 of
-- "fleet-YYYY-MM-DD" (UTC) — same day, same toy, everywhere; SeedRng stream.
-- Input law: Abil_Fire = the swing, Abil_Redirect = the roll (client courier).
-- GAPS: the sha256 play-receipt, applied-inputs tape, fixed-step 1/60 pump and
-- the source's x/y axis asymmetry (x uses chase, y plain speed — ported as the
-- intended chase on both axes) do not carry into 3D.

local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local SeedRng = require(Shared:WaitForChild("SeedRng"))
local ShadowLedger = require((script.Parent:FindFirstChild("ShadowLedger") or script.Parent.Parent:WaitForChild("ShadowLedger")) :: ModuleScript)

local ToyBoxZone = {}
local origin = Vector3.new(200, 8, -200)

-- source constants (toy.html, verbatim)
local SPEED, ROLL_SPEED = 160, 420
local ROLL_COST, ROLL_T, ROLL_CD, ROLL_IFRAMES = 30, 0.28, 0.5, 0.35
local SWING_COST, SWING_CD = 15, 0.35
local SWING_RANGE, SWING_ARC = 38 + 12 + 14, math.pi / 2 -- 38 + player.r + walker.r
local SWING_BASE_DMG = 14
local W_HP, W_DMG, W_SPEED, W_R = 40, 14, 95, 14
local W_WINDUP, W_CD, W_STUN, W_RIPOSTE = 0.35, 1.2, 0.8, 1.0
local ST_REGEN = 25

local function fleetSeed(): number -- FNV-1a 32 of "fleet-" .. UTC day, || 1
	local h = 2166136261
	for byte in ("fleet-" .. os.date("!%Y-%m-%d")):gmatch(".") do
		h = bit32.bxor(h, string.byte(byte))
		h = (h * 16777619) % 4294967296
	end
	return (h % 2147483646) + 1
end

local rng = SeedRng.new(fleetSeed())

type Duel = { walker: BasePart, hp: number, windup: number, attackCd: number, telegraph: number,
	stun: number, rollT: number, rollCd: number, iframes: number, riposte: number, swingCd: number }

local duels: { [Player]: Duel } = {}

local function spawnWalker(player: Player): BasePart
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local w = Instance.new("Part")
	w.Shape = Enum.PartType.Ball
	w.Size = Vector3.new(W_R * 2, W_R * 2, W_R * 2) -- r 14
	w.Color = Color3.fromRGB(164, 68, 60) -- #a4443c
	w.Material = Enum.Material.Slate
	w.Anchored = true
	w.CanCollide = false
	w.Name = "THE WALKER"
	w.Position = (root and root.Position + Vector3.new(24, 2, 0) or origin) + Vector3.new(0, 6, 0)
	w.Parent = workspace
	return w
end

local function startDuel(player: Player)
	if duels[player] then return end
	local hum = player.Character and player.Character:FindFirstChild("Humanoid") :: Humanoid?
	if not (hum and hum.Health > 0) then return end
	hum.MaxHealth, hum.Health = 100, 100
	hum.WalkSpeed = SPEED -- walk 160
	duels[player] = { walker = spawnWalker(player), hp = W_HP, windup = 0, attackCd = 0,
		telegraph = 0, stun = 0, rollT = 0, rollCd = 0, iframes = 0, riposte = 0, swingCd = 0 }
	ShadowLedger.record(player, "ToyBox", "faced the walker", true)
end

function ToyBoxZone.build(): Model
	local model = Instance.new("Model")
	model.Name = "ToyBox"

	local floor = Instance.new("Part")
	floor.Anchored = true
	floor.Size = Vector3.new(120, 1, 120) -- the toy box: 480x300 px felt like this in studs
	floor.Position = origin - Vector3.new(0, 1, 0)
	floor.Color = Color3.fromRGB(20, 18, 16) -- #141210
	floor.Material = Enum.Material.WoodPlanks
	floor.Parent = model

	local mat = Instance.new("Part") -- step on the mat to start the run
	mat.Anchored = true
	mat.Size = Vector3.new(12, 1, 12)
	mat.Position = origin + Vector3.new(0, 0.5, 40)
	mat.Color = Color3.fromRGB(143, 217, 143) -- #8fd98f, the roller green
	mat.Material = Enum.Material.Neon
	mat.Parent = model

	model.Parent = workspace

	mat.Touched:Connect(function(hit)
		local player = hit.Parent and Players:GetPlayerFromCharacter(hit.Parent)
		if player then startDuel(player) end
	end)

	Players.PlayerRemoving:Connect(function(p) duels[p] = nil end)
	return model
end

function ToyBoxZone.tick(dt: number)
	for player, s in pairs(duels) do
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local hum = char and char:FindFirstChild("Humanoid") :: Humanoid?
		if not (root and hum) then continue end
		if hum.Health <= 0 then
			ShadowLedger.record(player, "ToyBox", "fell to the walker", false)
			s.walker:Destroy()
			duels[player] = nil
			continue
		end

		-- timers
		s.rollCd = math.max(0, s.rollCd - dt)
		s.iframes = math.max(0, s.iframes - dt)
		s.swingCd = math.max(0, s.swingCd - dt)
		s.riposte = math.max(0, s.riposte - dt)
		local moving = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude > 4

		-- stamina law: 25/s, x0.5 active / x1.5 still, gated on attack/roll
		if s.swingCd <= 0 and s.rollT <= 0 then
			player:SetAttribute("ToyStamina", math.min(100, tonumber((player:GetAttribute("ToyStamina")) or 100) + ST_REGEN * (moving and 0.5 or 1.5) * dt))
		end

		-- the roll (Abil_Redirect): 30 sta, 0.28s, 0.5 cd, 0.35 iframes, speed 420 — the verb
		if player:GetAttribute("Abil_Redirect") == true and s.rollT <= 0 and s.rollCd <= 0
			and (player:GetAttribute("ToyStamina") :: number) >= ROLL_COST then
			player:SetAttribute("ToyStamina", (player:GetAttribute("ToyStamina") :: number) - ROLL_COST)
			s.rollT, s.rollCd, s.iframes = ROLL_T, ROLL_CD, ROLL_IFRAMES
			local look = root.CFrame.LookVector
			root.AssemblyLinearVelocity = Vector3.new(look.X, 0, look.Z).Unit * ROLL_SPEED
		end
		if s.rollT > 0 then
			s.rollT -= dt -- roll overrides walk (mud law)
			root.AssemblyLinearVelocity = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit * ROLL_SPEED
		end

		-- the swing (Abil_Fire): 15 sta, cd 0.35, range 64, arc PI/2 — riposte bites double
		if player:GetAttribute("Abil_Fire") == true and s.swingCd <= 0 and s.rollT <= 0
			and (player:GetAttribute("ToyStamina") :: number) >= SWING_COST then
			player:SetAttribute("ToyStamina", (player:GetAttribute("ToyStamina") :: number) - SWING_COST)
			s.swingCd = SWING_CD
			local d = s.walker.Position - root.Position
			local flat = Vector3.new(d.X, 0, d.Z)
			local look = root.CFrame.LookVector
			local diff = math.abs(look:Angle(flat.Magnitude > 0.01 and flat.Unit or look, Vector3.yAxis))
			if s.hp > 0 and flat.Magnitude < SWING_RANGE and diff < SWING_ARC then
				local dmg = SWING_BASE_DMG * (0.9 + 0.2 * rng:next()) -- the ONLY rng draw, on landed hits
				if s.riposte > 0 then dmg *= 2 s.riposte = 0 end -- punished the recovery
				s.hp -= dmg
				ShadowLedger.record(player, "ToyBox", s.hp <= 0 and "punished the recovery and felled the walker" or "landed a swing", true)
			end
		end

		-- the walker: chase, plant, bite — the READ is the flare
		if s.stun > 0 then
			s.stun -= dt
		else
			local toP = root.Position - s.walker.Position
			local d = Vector3.new(toP.X, 0, toP.Z)
			local len = math.max(d.Magnitude, 0.01)
			local plant = s.windup > 0 and 0.12 or 1 -- the swing winds up, the walker plants
			local chase = W_SPEED * (len > 60 and 1.35 or 1) -- closes the kite gap
			s.walker.CFrame = s.walker.CFrame + d.Unit * chase * plant * dt
			s.attackCd = math.max(0, s.attackCd - dt)
			s.telegraph = math.max(0, s.telegraph - dt)
			s.walker.Color = s.telegraph > 0 and Color3.fromRGB(255, 91, 77) or Color3.fromRGB(164, 68, 60)
			if s.windup <= 0 and s.attackCd <= 0 and len < W_R + 12 + 4 then
				s.windup, s.attackCd, s.telegraph = W_WINDUP, W_CD, W_WINDUP -- wind-up telegraph: dodgeable
			end
			if s.windup > 0 then
				s.windup -= dt
				if s.windup <= 0 then
					-- the lunge: a committed bite that closes the kite gap — dodge or bleed
					s.walker.CFrame = s.walker.CFrame + d.Unit * len * 0.45
					local d2 = (root.Position - s.walker.Position).Magnitude
					if d2 < W_R + 12 + 10 then
						if s.rollT > 0 then -- rolled THROUGH the bite — it stumbles, riposte window
							s.stun, s.riposte = W_STUN, W_RIPOSTE
							ShadowLedger.record(player, "ToyBox", "rolled through the bite — the walker stumbled", true)
						else
							hum:TakeDamage(W_DMG) -- the bite always lands unless you are mid-roll (rollT law)
						end
					end
				end
			end
		end

		if s.hp <= 0 then -- THE WALKER FALLS — the run resets into a new duel
			s.walker:Destroy()
			duels[player] = nil
			task.delay(3, function()
				if player.Parent and duels[player] == nil then -- refresh to run it again
					local fresh = spawnWalker(player)
					duels[player] = { walker = fresh, hp = W_HP, windup = 0, attackCd = 0,
						telegraph = 0, stun = 0, rollT = 0, rollCd = 0, iframes = 0, riposte = 0, swingCd = 0 }
				end
			end)
		end
	end
end

return ToyBoxZone
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="62">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="LocalScript" referent="63">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
        <string name="Source"><![CDATA[--!strict
-- finit.client — the one client script: keys in, remotes out, feel out.
-- SPEC t46: portal pads tint by the server-stamped Gate_<zone> attribute
-- (ZoneGate.allianceFor): allied leans green, opposed leans red,
-- independent tints nothing; deterministic local visuals only.
-- SPEC t59: a corner chip echoes the server-stamped Sphere attribute
-- ("Sphere: <name>", ZoneGate.ensureSphere, replicated) with the soul's
-- aggregate Gate_ verdict word tinted per ALLIANCE_TINT; allianceFor's
-- third word is "independent", not "neutral" (never fabricated), and it
-- tints nothing (a negative is a fact).
-- Shift sprint (hold), Q dash, Space double jump, Z/X/C/V abilities,
-- dash FOV kick, ability cooldown chips. Q-040 (cloned-mechanics §2/§3.3):
-- the same inputs bind as ContextActionService touch buttons on touch
-- devices, the cooldown chips move over those buttons, and the mobile jump
-- button (JumpRequest, not a Space InputBegan) feeds the double jump.
-- The server owns validation and cooldowns; this file is a courier with
-- good manners, not a brain.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local movement = remotes:WaitForChild("Movement") :: RemoteEvent
local ability = remotes:WaitForChild("Ability") :: RemoteEvent
local chat = remotes:WaitForChild("Chat") :: RemoteEvent -- server world-voice (MudBasecamp.say)

local airJumps = 0

-- ability display table (mirrors server REGISTRY; server still owns the truth).
-- `fire` is the server-side ability name from AbilitySlots.REGISTRY that both
-- the keyboard path and the touch buttons send; the server name is the only
-- string it accepts (AbilitySlots.bind matches by name).
local ABILITIES = {
	{ name = "Fire",     key = Enum.KeyCode.Z, attribute = "Abil_Fire",     cd = 0.25, fire = "Fire" },
	{ name = "Thumper",  key = Enum.KeyCode.X, attribute = "Abil_Thumper",  cd = 10,   fire = "ThumperToss" },
	{ name = "Redirect", key = Enum.KeyCode.C, attribute = "Abil_Redirect", cd = 8,    fire = "WingChunRedirect" },
	{ name = "Count",    key = Enum.KeyCode.V, attribute = "Abil_Count",    cd = 20,   fire = "Count" },
}

-- ---- cooldown chips: 4 skill slots, bottom-right cluster ----
-- Q-043 UI pass: each chip is now a panel with a key/name label, a cooldown
-- fill bar that drains across the mirrored cd, an active-window stroke glow
-- (attribute still true = the ability is LIVE), and a cluster-wide dim while
-- the server disables every slot (Carrying = the Steal-a penalty; the server
-- reads the same attribute to refuse each fire, we only paint it). Courier
-- law unchanged: the server owns validation and the cooldown clock; the chip
-- clock starts at the replicated attribute flip, the drain is local math.
local gui = Instance.new("ScreenGui")
gui.Name = "AbilityChips"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local CHIP_BG = Color3.fromRGB(20, 18, 26)
local CHIP_INK = Color3.fromRGB(230, 224, 196)
local CHIP_READY = Color3.fromRGB(143, 199, 154)
local CHIP_FILL = Color3.fromRGB(232, 180, 90)
local CHIP_GLOW = Color3.fromRGB(255, 220, 150)

local chips: { { label: TextLabel, fill: Frame, stroke: UIStroke, last: number, ab: typeof(ABILITIES[1]) } } = {}
for i, ab in ipairs(ABILITIES) do
	local chip = Instance.new("Frame")
	chip.Size = UDim2.new(0, 64, 0, 46)
	chip.Position = UDim2.new(1, -80 * (5 - i), 1, -130)
	chip.BackgroundColor3 = CHIP_BG
	chip.BackgroundTransparency = 0.35
	chip.BorderSizePixel = 0
	chip.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = chip
	local stroke = Instance.new("UIStroke")
	stroke.Color = CHIP_GLOW
	stroke.Transparency = 1 -- a ready chip has no border; the active window lights it
	stroke.Parent = chip

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, -6)
	label.BackgroundTransparency = 1
	label.TextColor3 = CHIP_READY
	label.Font = Enum.Font.Garamond
	label.TextSize = 14
	label.Text = ab.key.Name .. "\n" .. ab.name
	label.Parent = chip

	local fill = Instance.new("Frame")
	fill.AnchorPoint = Vector2.new(0, 1)
	fill.Position = UDim2.new(0, 0, 1, 0)
	fill.Size = UDim2.new(0, 0, 0, 3)
	fill.BorderSizePixel = 0
	fill.BackgroundColor3 = CHIP_FILL
	fill.Parent = chip

	table.insert(chips, { label = label, fill = fill, stroke = stroke, last = -math.huge, ab = ab })

	-- server flips the attribute true at fire time; that is our clock start
	player:GetAttributeChangedSignal(ab.attribute):Connect(function()
		if player:GetAttribute(ab.attribute) == true then
			for _, c in ipairs(chips) do
				if c.ab.name == ab.name then c.last = os.clock() end
			end
		end
	end)
end

RunService.RenderStepped:Connect(function()
	local now = os.clock()
	local carrying = player:GetAttribute("Carrying") == true
	for _, c in ipairs(chips) do
		local remain = c.ab.cd - (now - c.last)
		local active = player:GetAttribute(c.ab.attribute) == true
		if remain > 0 then
			c.label.Text = ("%s\n%.1f"):format(c.ab.key.Name, remain)
			c.label.TextColor3 = CHIP_INK
			c.label.TextTransparency = carrying and 0.55 or 0.4
			c.fill.Size = UDim2.new(math.clamp(remain / c.ab.cd, 0, 1), 0, 0, 3)
			c.fill.BackgroundTransparency = carrying and 0.7 or 0
			c.stroke.Transparency = 1
		else
			c.label.Text = c.ab.key.Name .. "\n" .. c.ab.name
			c.label.TextColor3 = active and CHIP_GLOW or CHIP_READY
			c.label.TextTransparency = carrying and 0.55 or 0
			c.fill.Size = UDim2.new(0, 0, 0, 3)
			c.stroke.Transparency = active and 0 or 1
		end
	end
end)

-- ---- dash FOV kick: 70 -> 82 -> 70 on every DashAt bump ----
-- FIX: camera resolved per kick, not captured once. Cause: this script runs
-- once per session and outlives respawns (gui.ResetOnSpawn = false above),
-- but workspace.CurrentCamera is nullable and can be replaced across respawn
-- flows, so a captured reference goes stale and the kick silently dies after
-- a swap. Evidence: same-file respawn-surviving design (ResetOnSpawn false,
-- CharacterAdded re-watch) against the nullable CurrentCamera contract.
player:GetAttributeChangedSignal("DashAt"):Connect(function()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local out = TweenService:Create(cam, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = 82 })
	out:Play()
	out.Completed:Once(function()
		local back = workspace.CurrentCamera
		if not back then return end
		TweenService:Create(back, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = 70 }):Play()
	end)
end)

-- ---- portal ring tint: gate verdict (t46), attribute pattern ----
-- The server stamps ZoneGate.allianceFor per wave zone once at join as
-- Gate_<zone> attributes (zone names sanitized to underscores, the same
-- gsub the Portal_ pad suffix is read with, see server ZoneGate.gateAttr).
-- This block only paints: fixed colors, one lerp, no loop. Independent
-- tints nothing (a negative is a fact); opposed is reachable only if the
-- mine ever grows an aligned region row (ZoneGate header seam) and the
-- tint renders it rather than leaving a dead branch. Climb portals carry
-- no Gate_ attribute, so they stay untouched.
local ALLIANCE_TINT: { [string]: Color3 } = {
	allied = Color3.fromRGB(90, 230, 130),
	opposed = Color3.fromRGB(235, 60, 60),
}

local function bindPad(pad: Instance)
	local zone = pad.Name:match("^Portal_(.+)$")
	if not zone then return end
	local key = ("Gate_%s"):format((zone:gsub("%W", "_")))
	local apply = function()
		local part = pad :: BasePart
		if not part:IsA("BasePart") then return end
		local verdict = player:GetAttribute(key)
		if typeof(verdict) ~= "string" then return end
		local tint = ALLIANCE_TINT[verdict :: string]
		if not tint then return end
		part.Color = part.Color:Lerp(tint, 0.45)
	end
	apply()
	player:GetAttributeChangedSignal(key):Connect(apply)
end

for _, pad in ipairs(workspace:GetChildren()) do
	bindPad(pad)
end
workspace.ChildAdded:Connect(bindPad)

-- ---- soul chip: the player's replicated Sphere attribute (t59) ----
-- ZoneGate.ensureSphere stamps "Sphere" on the player server-side, so it
-- replicates and this block only paints (no server change, no client
-- re-derivation of the draw). The word after the name is the soul's
-- aggregate over the same stamped Gate_<zone> verdicts the pads tint, with
-- allianceFor's own precedence (opposition outranks kinship): any opposed
-- decides, else any allied, else independent. Independent tints nothing (a
-- negative is a fact); the chip speaks allianceFor's real verdict words.
local SOUL_TEXT = Color3.fromRGB(230, 224, 196)
local sphereChip = Instance.new("TextLabel")
sphereChip.Size = UDim2.new(0, 170, 0, 22)
sphereChip.Position = UDim2.new(0, 8, 0, 8)
sphereChip.BackgroundColor3 = Color3.fromRGB(20, 18, 26)
sphereChip.BackgroundTransparency = 0.35
sphereChip.TextColor3 = SOUL_TEXT
sphereChip.Font = Enum.Font.Garamond
sphereChip.TextSize = 14
sphereChip.TextXAlignment = Enum.TextXAlignment.Left
sphereChip.Parent = gui

local function refreshSoulChip()
	local sphere = player:GetAttribute("Sphere")
	if typeof(sphere) ~= "string" then
		sphereChip.Text = "Sphere: (unset)" -- attribute not replicated yet
		return
	end
	local verdict = "independent"
	for attr, value in pairs(player:GetAttributes()) do
		if attr:sub(1, 5) == "Gate_" and typeof(value) == "string" then
			if value == "opposed" then
				verdict = "opposed"
			elseif value == "allied" and verdict ~= "opposed" then
				verdict = "allied"
			end
		end
	end
	sphereChip.Text = ("Sphere: %s (%s)"):format(sphere, verdict)
	sphereChip.TextColor3 = ALLIANCE_TINT[verdict] or SOUL_TEXT
end

refreshSoulChip()
player:GetAttributeChangedSignal("Sphere"):Connect(refreshSoulChip)
-- the Gate_ names are the server's sanitized zone list (ZoneGate.gateAttr);
-- the client never re-authors it, so the same signal pattern widens to a
-- prefix filter over AttributeChanged
player.AttributeChanged:Connect(function(attr)
	if attr:sub(1, 5) == "Gate_" then refreshSoulChip() end
end)

-- ---- chat relay log: the server's world-voice lands here (Q-037) ----
-- One FireClient per MudBasecamp.say(): stack the last few lines bottom-left
-- (below the ability chips' mirror, clear of the cathedral panel), fade each
-- out and retire it. Courier law holds: display only, no filtering, no
-- commands — the server already wrote the words it chose to say.
local CHAT_MAX = 7
local chatLog = Instance.new("Frame")
chatLog.Name = "ChatLog"
chatLog.AnchorPoint = Vector2.new(0, 1)
chatLog.Position = UDim2.new(0, 8, 1, -8)
chatLog.Size = UDim2.new(0, 430, 0, 150)
chatLog.BackgroundTransparency = 1
chatLog.Parent = gui
local chatLayout = Instance.new("UIListLayout")
chatLayout.FillDirection = Enum.FillDirection.Vertical
chatLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
chatLayout.SortOrder = Enum.SortOrder.LayoutOrder
chatLayout.Padding = UDim.new(0, 2)
chatLayout.Parent = chatLog

chat.OnClientEvent:Connect(function(text: unknown)
	if typeof(text) ~= "string" then return end -- not our server's shape
	local line = Instance.new("TextLabel")
	line.Name = "ChatLine"
	line.AutomaticSize = Enum.AutomaticSize.Y
	line.Size = UDim2.new(1, 0, 0, 0)
	line.BackgroundTransparency = 1
	line.Font = Enum.Font.Garamond
	line.TextSize = 14
	line.TextColor3 = SOUL_TEXT
	line.TextXAlignment = Enum.TextXAlignment.Left
	line.TextWrapped = true
	line.Text = text
	line.LayoutOrder = math.huge -- newest paints last; orders below retire age
	line.Parent = chatLog
	-- bounded log: retire the oldest line once past the cap
	local lines: { TextLabel } = {}
	for _, c in ipairs(chatLog:GetChildren()) do
		if c:IsA("TextLabel") then table.insert(lines, c :: TextLabel) end
	end
	if #lines > CHAT_MAX then
		table.sort(lines, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
		lines[1]:Destroy()
	end
	-- relabel LayoutOrder by arrival rank so "oldest" stays well-defined
	for rank, l in ipairs(lines) do
		l.LayoutOrder = rank
	end
	task.delay(6, function()
		local fade = TweenService:Create(line, TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, BackgroundTransparency = 1 })
		fade:Play()
		fade.Completed:Once(function() line:Destroy() end)
	end)
end)

local function character(): Model?
	return player.Character
end

local function charHum(): Humanoid?
	local c = character()
	return c and c:FindFirstChildOfClass("Humanoid")
end

-- track grounded-ness client-side for the double jump allowance
local function watch(char: Model)
	local hum = char:WaitForChild("Humanoid") :: Humanoid
	airJumps = 0
	hum.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Landed then
			airJumps = 0
		end
	end)
end

if player.Character then watch(player.Character) end
player.CharacterAdded:Connect(watch)

-- one airjump guard, two entry points: the Space key (keyboard) and
-- JumpRequest (the mobile jump button raises JumpRequest, never a Space
-- InputBegan). The guard is idempotent across both entries because airJumps
-- increments synchronously before the second caller checks it, so a desktop
-- press that raises both events still sends at most one airjump.
local function tryAirJump()
	local hum = charHum()
	if hum and hum:GetState() ~= Enum.HumanoidStateType.Landed
		and hum:GetState() ~= Enum.HumanoidStateType.Jumping
		and airJumps < 1 then
		airJumps += 1
		movement:FireServer("airjump")
	end
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		movement:FireServer("sprint", true)
	elseif input.KeyCode == Enum.KeyCode.Q then
		movement:FireServer("dash")
	elseif input.KeyCode == Enum.KeyCode.Space then
		tryAirJump()
	else
		for _, ab in ipairs(ABILITIES) do
			if input.KeyCode == ab.key then
				ability:FireServer(ab.fire)
				break
			end
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		movement:FireServer("sprint", false)
	end
end)

UserInputService.JumpRequest:Connect(tryAirJump)

-- ---- mobile bindings (Q-040): ContextActionService touch buttons ----
-- Spec: cloned-mechanics §2 "Mobile | thumbstick + jump + ContextActionService
-- buttons | ability + dash + interact buttons" and §3.3 "cooldown chips and
-- mobile ContextActionService buttons". Interact is already engine
-- (ProximityPrompt shows its own touch button), so this block covers sprint
-- (hold), dash and the four ability slots. Keycodes are deliberately NOT
-- bound here: the keyboard path above already owns those keys, and a second
-- CAS keycode binding would double-fire every keyboard press. CAS touch
-- buttons render only on touch devices; the TouchEnabled gate keeps the
-- verified desktop path untouched. Button positions are thumb-reach
-- constants, not verified visuals: a live touch playtest stays owed.
if UserInputService.TouchEnabled then
	local function bindTouch(name: string, position: UDim2, onPress: (on: boolean) -> ())
		ContextActionService:BindAction(name, function(_, state)
			onPress(state == Enum.UserInputState.Begin)
			return Enum.ContextActionResult.Sink
		end, true)
		ContextActionService:SetPosition(name, position)
	end

	bindTouch("Sprint", UDim2.new(0, 8, 1, -78), function(on)
		movement:FireServer("sprint", on)
	end)
	bindTouch("Dash", UDim2.new(1, -70, 1, -170), function(on)
		if on then movement:FireServer("dash") end
	end)

	local touchSpots: { [string]: UDim2 } = {
		Fire     = UDim2.new(1, -70, 1, -80),
		Thumper  = UDim2.new(1, -160, 1, -40),
		Redirect = UDim2.new(1, -160, 1, -120),
		Count    = UDim2.new(1, -250, 1, -40),
	}
	for i, ab in ipairs(ABILITIES) do
		local actionName = "Ability_" .. ab.name
		bindTouch(actionName, touchSpots[ab.name], function(on)
			if on then ability:FireServer(ab.fire) end
		end)
		-- cooldown chip OVER the ability button: move the chip into the CAS
		-- button so the countdown paints on top of it. GetButton can return
		-- nil until the engine builds the touch GUI, so the move polls for a
		-- bounded 10s and otherwise leaves the chip as the free-floating
		-- legend it already is (no unbounded wait, no missing-UI crash).
		local chip = chips[i].label
		task.spawn(function()
			for _ = 1, 100 do
				local btn = ContextActionService:GetButton(actionName)
				if btn then
					chip.BackgroundTransparency = 1
					chip.Size = UDim2.fromScale(1, 1)
					chip.Position = UDim2.fromScale(0, 0)
					chip.Parent = btn
					return
				end
				task.wait(0.1)
			end
		end)
	end
end
]]></string>
      </Properties>
      <Item class="LocalScript" referent="64">
        <Properties>
          <string name="Name">CathedralMapHud</string>
          <string name="Source"><![CDATA[--!strict
-- CathedralMapHud  -  the walker-view overlay for the eigen-map (candidate
-- two). Renders THE CATHEDRAL from shared/CathedralMap (single authorship:
-- every number on this panel is computed by that module), pinned top-left
-- under the sphere chip. One compass everywhere: north = eigen -y is UP on
-- this minimap and world -Z on the plate (CathedralMap.toWorld), so the
-- bearing text you read is the direction you walk.
--
-- Standing on a region beacon, its row reads 0.0000 and the POS line equals
-- that region's centroid  -  the position sanity anchor, player-visible.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Modules")
local CathedralMap = require(Shared:WaitForChild("CathedralMap"))

local player = Players.LocalPlayer

local INK = Color3.fromRGB(230, 224, 196)
local PANEL = Color3.fromRGB(20, 18, 26)
local RUST = Color3.fromRGB(179, 86, 44)
local VIOLET = Color3.fromRGB(138, 127, 176)
local YOU = Color3.fromRGB(120, 235, 150)

local ABBREV: { [string]: string } = {
	["water_computer"] = "water",
	["fractal_maze"] = "fractal",
	["riddler_optics"] = "optics",
	["riddler_engram"] = "engram",
	["audit_dungeon"] = "audit",
}

-- ---- panel ----

local gui = Instance.new("ScreenGui")
gui.Name = "CathedralMapHud"
gui.ResetOnSpawn = false
gui.DisplayOrder = 11
gui.Parent = player:WaitForChild("PlayerGui")

local panel = Instance.new("Frame")
panel.Position = UDim2.new(0, 8, 0, 36) -- under the sphere chip (t59)
panel.Size = UDim2.new(0, 296, 0, 328)
panel.BackgroundColor3 = PANEL
panel.BackgroundTransparency = 0.25
panel.BorderSizePixel = 0
local panelCorner = Instance.new("UICorner")
panelCorner.CornerRadius = UDim.new(0, 8)
panelCorner.Parent = panel
panel.Parent = gui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -16, 0, 18)
title.Position = UDim2.new(0, 8, 0, 6)
title.BackgroundTransparency = 1
title.Font = Enum.Font.Garamond
title.TextSize = 14
title.TextColor3 = INK
title.TextXAlignment = Enum.TextXAlignment.Left
title.Text = "THE CATHEDRAL · eigen-map (walker view)"
title.Parent = panel

local mapFrame = Instance.new("Frame")
mapFrame.Size = UDim2.new(1, -16, 0, 176)
mapFrame.Position = UDim2.new(0, 8, 0, 26)
mapFrame.BackgroundColor3 = Color3.fromRGB(12, 11, 16)
mapFrame.BackgroundTransparency = 0.1
mapFrame.BorderSizePixel = 0
mapFrame.ClipsDescendants = true
local mapCorner = Instance.new("UICorner")
mapCorner.CornerRadius = UDim.new(0, 6)
mapCorner.Parent = mapFrame
mapFrame.Parent = panel

local layer = Instance.new("Frame")
layer.Size = UDim2.fromScale(1, 1)
layer.BackgroundTransparency = 1
layer.BorderSizePixel = 0
layer.Parent = mapFrame

local readout = Instance.new("TextLabel")
readout.Size = UDim2.new(1, -16, 0, 116)
readout.Position = UDim2.new(0, 8, 0, 206)
readout.BackgroundTransparency = 1
readout.Font = Enum.Font.Code
readout.TextSize = 11
readout.TextColor3 = INK
readout.TextXAlignment = Enum.TextXAlignment.Left
readout.TextYAlignment = Enum.TextYAlignment.Top
readout.TextWrapped = true
readout.Text = "eigen overlay: waiting for character"
readout.Parent = panel

-- ---- eigen -> pixels (one compass: -y up; NO y-flip, +ey renders south) ----

local minX, maxX, minY, maxY = CathedralMap.mapBounds(0)
local spanX, spanY = maxX - minX, maxY - minY
local mX, mY = spanX * 0.13, spanY * 0.13
local x0, x1 = minX - mX, maxX + mX
local y0, y1 = minY - mY, maxY + mY

local scale = 1.0
local offX, offY = 0.0, 0.0
local function fitCanvas()
	local w, h = mapFrame.AbsoluteSize.X, mapFrame.AbsoluteSize.Y
	if w < 8 or h < 8 then
		return
	end
	scale = math.min(w / (x1 - x0), h / (y1 - y0))
	offX = (w - (x1 - x0) * scale) / 2
	offY = (h - (y1 - y0) * scale) / 2
end
local function px(ex: number): number
	return offX + (ex - x0) * scale
end
local function py(ey: number): number
	return offY + (ey - y0) * scale -- +ey down = south; north (-y) at top
end

local function dot(x: number, y: number, size: number, color: Color3, z: number, transparency: number?): Frame
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromOffset(x, y)
	f.Size = UDim2.fromOffset(size, size)
	f.BackgroundColor3 = color
	f.BackgroundTransparency = transparency or 0
	f.BorderSizePixel = 0
	f.ZIndex = z
	local round = Instance.new("UICorner")
	round.CornerRadius = UDim.new(1, 0)
	round.Parent = f
	f.Parent = layer
	return f
end

-- dotted segment (no rotation math: trail of small dots, robust to rescale)
local function dotted(x1: number, y1: number, x2: number, y2: number, color: Color3, z: number, n: number, size: number, transparency: number)
	for i = 0, n do
		local t = i / n
		dot(x1 + (x2 - x1) * t, y1 + (y2 - y1) * t, size, color, z, transparency)
	end
end

local youMarker = dot(0, 0, 9, YOU, 6)
youMarker.BorderSizePixel = 1
youMarker.BorderColor3 = Color3.new(1, 1, 1)
youMarker.Parent = mapFrame

local drawnW, drawnH = 0.0, 0.0
local function drawStatic()
	layer:ClearAllChildren()
	fitCanvas()
	local chain = CathedralMap.chainEdges()
	for _, e in ipairs(chain) do
		local a = CathedralMap.centroid(e.a)
		local b = CathedralMap.centroid(e.b)
		if a and b then
			dotted(px(a[1]), py(a[2]), px(b[1]), py(b[2]), RUST, 2, 7, 3, 0.15)
		end
	end
	for _, e in ipairs(CathedralMap.hubEdges()) do
		local a = CathedralMap.centroid(e.a)
		local b = CathedralMap.centroid(e.b)
		if a and b then
			dotted(px(a[1]), py(a[2]), px(b[1]), py(b[2]), VIOLET, 1, 5, 2, 0.5)
		end
	end
	for _, region in ipairs(CathedralMap.regions()) do
		local c = CathedralMap.centroid(region)
		if c then
			local d = dot(px(c[1]), py(c[2]), region == "water_computer" and 13 or 10,
				CathedralMap.classColor(CathedralMap.class(region)), 3)
			d.BorderSizePixel = 1
			d.BorderColor3 = Color3.new(0, 0, 0)
			local t = Instance.new("TextLabel")
			t.AnchorPoint = Vector2.new(0, 0.5)
			t.Position = UDim2.fromOffset(px(c[1]) + 8, py(c[2]))
			t.Size = UDim2.fromOffset(64, 12)
			t.BackgroundTransparency = 1
			t.Font = Enum.Font.Code
			t.TextSize = 10
			t.TextColor3 = INK
			t.TextXAlignment = Enum.TextXAlignment.Left
			t.ZIndex = 4
			t.Text = ABBREV[region] or region
			t.Parent = layer
		end
	end
	local north = Instance.new("TextLabel")
	north.AnchorPoint = Vector2.new(0.5, 0.5)
	north.Position = UDim2.new(0.5, 0, 0, 9)
	north.Size = UDim2.fromOffset(36, 12)
	north.BackgroundTransparency = 1
	north.Font = Enum.Font.Code
	north.TextSize = 10
	north.TextColor3 = Color3.fromRGB(160, 156, 170)
	north.Text = "^ N (-y)"
	north.ZIndex = 4
	north.Parent = layer
	drawnW, drawnH = mapFrame.AbsoluteSize.X, mapFrame.AbsoluteSize.Y
end

drawStatic()
mapFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
	if math.abs(mapFrame.AbsoluteSize.X - drawnW) > 1 or math.abs(mapFrame.AbsoluteSize.Y - drawnH) > 1 then
		drawStatic()
	end
end)

-- ---- live loop: position, distance, bearing (all from CathedralMap) ----

local lastRun = 0.0
RunService.Heartbeat:Connect(function()
	local now = os.clock()
	if now - lastRun < 0.14 then
		return
	end
	lastRun = now

	local char = player.Character
	local root = char and (char:FindFirstChild("HumanoidRootPart") :: BasePart?)
	local ex, ey
	if root then
		ex, ey = CathedralMap.worldToEigen(root.Position)
	else
		ex, ey = (maxX + minX) / 2, (maxY + minY) / 2
	end
	youMarker.Visible = root ~= nil

	-- marker clamped into the window (honest tag when projected outside)
	local sx, sy = px(ex), py(ey)
	local offWindow = sx < 0 or sx > mapFrame.AbsoluteSize.X or sy < 0 or sy > mapFrame.AbsoluteSize.Y
	youMarker.Position = UDim2.fromOffset(
		math.clamp(sx, 6, mapFrame.AbsoluteSize.X - 6),
		math.clamp(sy, 6, mapFrame.AbsoluteSize.Y - 6))

	local near = CathedralMap.nearest(ex, ey)
	local rows: { { d: number, text: string } } = {}
	for _, region in ipairs(CathedralMap.regions()) do
		local d = CathedralMap.distFrom(ex, ey, region)
		local b = CathedralMap.bearingFrom(ex, ey, region)
		local here = d < 0.0015 and "  <-- HERE" or ""
		table.insert(rows, {
			d = d,
			text = ("%-8s %7.4f  %5.1f deg %s%s"):format(ABBREV[region] or region, d, b,
				CathedralMap.compass(b), here),
		})
	end
	table.sort(rows, function(a, b)
		return a.d < b.d
	end)
	local body: { string } = {}
	for _, r in ipairs(rows) do
		table.insert(body, r.text)
	end
	table.insert(body, 1, ("POS eigen (%.4f, %.4f)%s  nearest %s")
		:format(ex, ey, offWindow and " [edge]" or "", ABBREV[near.region] or near.region))
	table.insert(body, ("scan %s · vote: chain %.3f vs star %.3f (%s lean, RIB CONTESTED)")
		:format(string.sub(CathedralMap.SCAN_TS, 1, 10), CathedralMap.VOTE.chain_len,
			CathedralMap.VOTE.star_len, CathedralMap.VOTE.shorter))
	table.insert(body, ("off-map: adventure_2d6 (stub: no centroid) · no edge on the DARK engram"))
	readout.Text = table.concat(body, "\n")
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="65">
        <Properties>
          <string name="Name">LeaderstatsHud</string>
          <string name="Source"><![CDATA[--!strict
-- LeaderstatsHud  -  the Mountain's always-on-screen scorecard page (Q-041
-- 2026-09-28). The server's leaderstats folder (init.server.luau:200-263)
-- already gives the Roblox-standard M-key player list; this page is the
-- visible top-right mirror of the SAME four IntValues (Virtue Marks,
-- Rebirths, Invariants, Summits). Courier law: read-only, no second truth.
-- The IntValues are the single source, so the page reads .Value once at bind
-- then rides each IntValue's Changed signal - no polling (the t56 law that
-- cured the server's leaderstats poll applies here too).
-- Respawn-safe: the folder lives on the Player, not the Character, and the
-- ScreenGui is ResetOnSpawn=false like every HUD in this tree. While the
-- server has not yet attached (or a stat child has not replicated) the row
-- reads "..." - an honest blank, never a fabricated 0.

local Players = game:GetService("Players")

local player = Players.LocalPlayer

local INK = Color3.fromRGB(230, 224, 196)
local PANEL = Color3.fromRGB(20, 18, 26)

-- the four rows, keyed by the leaderstats child name (sole writer:
-- init.server.luau:205-214); label is the display name
local ROWS: { { stat: string, label: string } } = {
	{ stat = "Virtue Marks", label = "VM" },
	{ stat = "Rebirths", label = "Rebirths" },
	{ stat = "Invariants", label = "Invariants" },
	{ stat = "Summits", label = "Summits" },
}

-- ---- panel: top-right, 36px down (clears the Roblox top bar, same offset
-- the cathedral panel uses to clear the sphere chip); the cathedral panel
-- holds the left column, so the right was the one free wall ----
local gui = Instance.new("ScreenGui")
gui.Name = "LeaderstatsHud"
gui.ResetOnSpawn = false
gui.DisplayOrder = 10
gui.Parent = player:WaitForChild("PlayerGui")

local panel = Instance.new("Frame")
panel.AnchorPoint = Vector2.new(1, 0)
panel.Position = UDim2.new(1, -8, 0, 36)
panel.Size = UDim2.new(0, 176, 0, 124)
panel.BackgroundColor3 = PANEL
panel.BackgroundTransparency = 0.35
panel.BorderSizePixel = 0
local panelCorner = Instance.new("UICorner")
panelCorner.CornerRadius = UDim.new(0, 8)
panelCorner.Parent = panel
panel.Parent = gui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -16, 0, 18)
title.Position = UDim2.new(0, 8, 0, 6)
title.BackgroundTransparency = 1
title.Font = Enum.Font.Garamond
title.TextSize = 14
title.TextColor3 = INK
title.TextXAlignment = Enum.TextXAlignment.Left
title.Text = "THE MOUNTAIN · scorecard"
title.Parent = panel

local rowsFrame = Instance.new("Frame")
rowsFrame.Size = UDim2.new(1, -16, 0, #ROWS * 22)
rowsFrame.Position = UDim2.new(0, 8, 0, 28)
rowsFrame.BackgroundTransparency = 1
rowsFrame.BorderSizePixel = 0
local layout = Instance.new("UIListLayout")
layout.FillDirection = Enum.FillDirection.Vertical
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = rowsFrame
rowsFrame.Parent = panel

-- ---- wire: one row per leaderstats IntValue ----
local stats = player:WaitForChild("leaderstats")

for i, row in ipairs(ROWS) do
	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1, 0, 0, 22)
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.LayoutOrder = i
	holder.Parent = rowsFrame

	local name = Instance.new("TextLabel")
	name.Size = UDim2.new(1, -52, 1, 0)
	name.BackgroundTransparency = 1
	name.Font = Enum.Font.Garamond
	name.TextSize = 14
	name.TextColor3 = INK
	name.TextXAlignment = Enum.TextXAlignment.Left
	name.Text = row.label
	name.Parent = holder

	local value = Instance.new("TextLabel")
	value.AnchorPoint = Vector2.new(1, 0)
	value.Position = UDim2.new(1, 0, 0, 0)
	value.Size = UDim2.new(0, 48, 1, 0)
	value.BackgroundTransparency = 1
	value.Font = Enum.Font.Code
	value.TextSize = 14
	value.TextColor3 = INK
	value.TextXAlignment = Enum.TextXAlignment.Right
	value.Text = "..." -- pre-replication honest blank
	value.Parent = holder

	local stat = stats:WaitForChild(row.stat) :: IntValue
	local function paint(n: number)
		value.Text = ("%d"):format(n)
	end
	paint(stat.Value)
	stat.Changed:Connect(paint)
end
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="66">
        <Properties>
          <string name="Name">PetOrb</string>
          <string name="Source"><![CDATA[--!strict
-- PetOrb.client - the rebirth pet, made visible (Q-042, 2026-09-28).
-- SPEC (already owned, no behavior invented): docs/CLONED_MECHANICS.md
-- rebirth row "hatch a pet orb (Pet-Sim auto-grind: follows you,
-- auto-collects swarm gems in a 12-stud radius)"; docs/PLAYTEST.md
-- "with the pet orb (after rebirth) gems collect from ~12 studs".
-- The server already owns the grind: LedgerExchange stamps the PetOrb
-- attribute at rebirth and SwarmZone collects gems from 12 studs of the
-- character root while it is set. This script is the BODY of that truth,
-- painted locally off the same replicated attribute (the t46/t59 pattern:
-- server stamps, client paints; deterministic local visuals only):
--   1. the orb model: a gold neon ball (the Counting Circle's gold, the
--      fold it hatched from) with a PointLight and a camera-facing Trail,
--   2. the follower: RenderStepped lerp to a hover point behind the right
--      shoulder (offset magnitude ~3.0 studs of the root, always inside the
--      12-stud collect radius, so what you see floats inside what the
--      server actually collects from),
--   3. the gem-collect visual: when a gem dies inside OUR collect radius
--      the client bursts a ring at the gem's last position and the orb
--      gulps (quick size pulse).
-- No new remotes: gems are found by name among workspace's children, the
-- same folder SwarmZone parents them to. Standalone LocalScript (sibling of
-- init.client/CathedralMapHud) so the pet lives or dies with its own file.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

-- palette: orb is the Counting Circle's gold (LedgerExchange rebirth circle),
-- burst is the gem's green (SwarmZone gems). Both constants copied from the
-- server sources they mirror, so the pet reads as part of those systems.
local ORB_COLOR = Color3.fromRGB(230, 200, 60)
local GEM_COLOR = Color3.fromRGB(120, 220, 160)

local ORB_SIZE = Vector3.new(1.1, 1.1, 1.1)
-- behind the right shoulder; magnitude ~3.0 studs, well inside the 12-stud
-- collect radius the server enforces (SwarmZone PetOrb branch)
local HOVER_OFFSET = Vector3.new(0.9, 2.4, 1.7)
local FOLLOW_RATE = 8 -- lerp stiffness per second; higher = tighter follow

-- collect radii, mirroring SwarmZone's own line (PetOrb ? 12 : 3.5)
local GEM_RADIUS_BASE = 3.5
local GEM_RADIUS_PET = 12

-- ---- 1. the orb model ----
local function buildOrb(): Model
	local model = Instance.new("Model")
	model.Name = "PetOrb"

	local core = Instance.new("Part")
	core.Name = "OrbCore"
	core.Shape = Enum.PartType.Ball
	core.Size = ORB_SIZE
	core.Color = ORB_COLOR
	core.Material = Enum.Material.Neon
	core.Anchored = true
	core.CanCollide = false
	core.CanQuery = false
	core.CanTouch = false
	core.CastShadow = false
	core.Parent = model

	local glow = Instance.new("PointLight")
	glow.Name = "OrbGlow"
	glow.Color = ORB_COLOR
	glow.Range = 10
	glow.Brightness = 1.2
	glow.Parent = core

	local top = Instance.new("Attachment")
	top.Name = "TrailTop"
	top.Position = Vector3.new(0, 0.45, 0)
	top.Parent = core
	local bottom = Instance.new("Attachment")
	bottom.Name = "TrailBottom"
	bottom.Position = Vector3.new(0, -0.45, 0)
	bottom.Parent = core

	local trail = Instance.new("Trail")
	trail.Name = "OrbTrail"
	trail.Attachment0 = top
	trail.Attachment1 = bottom
	trail.Lifetime = 0.3
	trail.MinLength = 0.05
	trail.FaceCamera = true
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(ORB_COLOR)
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.25),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.WidthScale = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(1, 0.1),
	})
	trail.Enabled = false
	trail.Parent = core

	model.PrimaryPart = core
	return model
end

-- ---- orb state ----
local orb: Model? = nil
local orbCore: BasePart? = nil
local orbTrail: Trail? = nil
local pulseTween: Tween? = nil

local function stopPulse()
	if pulseTween then
		pulseTween:Cancel()
		pulseTween = nil
	end
	if orbCore then
		orbCore.Size = ORB_SIZE
	end
end

local function destroyOrb()
	stopPulse()
	if orb then
		orb:Destroy()
	end
	orb = nil
	orbCore = nil
	orbTrail = nil
end

local function hatchOrb()
	if orb then return end
	local model = buildOrb()
	local core = model.PrimaryPart :: BasePart
	orb = model
	orbCore = core
	orbTrail = core:FindFirstChildOfClass("Trail")
	-- hatch at the shoulder, not at the world origin flying in
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		core.CFrame = root.CFrame * CFrame.new(HOVER_OFFSET)
	end
	model.Parent = workspace
end

-- ---- 2. the follower (and the attribute wiring) ----
-- PetOrb is stamped true by LedgerExchange at rebirth and never cleared by
-- any server path, but the handler still handles a clear: the orb despawns
-- the moment the attribute says so, whatever the future does.
local function syncOrb()
	if player:GetAttribute("PetOrb") == true then
		hatchOrb()
	else
		destroyOrb()
	end
end
player:GetAttributeChangedSignal("PetOrb"):Connect(syncOrb)
syncOrb()

RunService.RenderStepped:Connect(function(dt: number)
	local core = orbCore
	if not core then return end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		-- between lives the pet waits, unseen (a pet with no one to follow)
		core.Transparency = 1
		if orbTrail then orbTrail.Enabled = false end
		return
	end
	core.Transparency = 0
	if orbTrail then orbTrail.Enabled = true end
	local bob = math.sin(os.clock() * 2.4) * 0.18
	local target = root.CFrame * CFrame.new(HOVER_OFFSET + Vector3.new(0, bob, 0))
	local alpha = math.clamp(dt * FOLLOW_RATE, 0, 1)
	core.CFrame = core.CFrame:Lerp(target, alpha)
end)

-- ---- 3. the gem-collect visual ----
-- Gems are plain workspace children named "Gem" (SwarmZone parents them at
-- the workspace root). A gem dies exactly two ways: the server's collect
-- loop (it sat inside someone's collect radius; that loop runs every
-- Heartbeat, init.server.luau) or its 30s TTL (it never got near anyone).
-- So a gem that dies inside OUR radius is our collection, touch or orb:
-- the burst fires at the gem's last position and the orb gulps. The radius
-- mirrors the server's own branch so the visual and the grind stay one shape.
local watching: { [BasePart]: boolean } = {}

local function watchGem(inst: Instance)
	local part = inst :: BasePart
	if not part:IsA("BasePart") then return end
	if part.Name ~= "Gem" then return end
	watching[part] = true
end

for _, inst in ipairs(workspace:GetChildren()) do
	watchGem(inst)
end
workspace.ChildAdded:Connect(watchGem)

local function burst(at: Vector3)
	local ring = Instance.new("Part")
	ring.Name = "GemCollectBurst"
	ring.Shape = Enum.PartType.Ball
	ring.Size = Vector3.new(1.7, 1.7, 1.7)
	ring.Color = GEM_COLOR
	ring.Material = Enum.Material.Neon
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Transparency = 0.2
	ring.CFrame = CFrame.new(at)
	ring.Parent = workspace
	local out = TweenService:Create(ring, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(4.8, 4.8, 4.8),
		Transparency = 1,
	})
	out.Completed:Once(function()
		ring:Destroy()
	end)
	out:Play()
end

local function gulp()
	local core = orbCore
	if not core then return end
	stopPulse()
	core.Size = ORB_SIZE
	local up = TweenService:Create(core, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = ORB_SIZE * 1.35,
	})
	up.Completed:Once(function()
		if orbCore ~= core then return end -- the orb was destroyed mid-gulp
		local back = TweenService:Create(core, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = ORB_SIZE,
		})
		pulseTween = back
		back:Play()
	end)
	pulseTween = up
	up:Play()
end

local function collectRadius(): number
	return (player:GetAttribute("PetOrb") == true) and GEM_RADIUS_PET or GEM_RADIUS_BASE
end

workspace.ChildRemoved:Connect(function(inst)
	local part = inst :: BasePart
	if not part:IsA("BasePart") then return end
	if not watching[part] then return end
	watching[part] = nil
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return end
	if (part.Position - root.Position).Magnitude > collectRadius() then return end
	burst(part.Position)
	gulp()
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="67">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="FilteringEnabled">true</bool>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>