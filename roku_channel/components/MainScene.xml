<component name="MainScene" extends="Scene" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://devtools.web.roku.com/schema/RokuSceneGraph.xsd">
  <interface>
    <field id="beaconLoaded" type="boolean" alwaysNotify="true" />
  </interface>
  <children>
    <Rectangle
      id="bg"
      width="1280"
      height="720"
      color="0x0a0a14" />
    <Label
      id="title"
      text="THE DISTRIBUTED REPUBLIC"
      translation="[40, 24]"
      font="font:LargeBoldSystemFont"
      color="0xE8C874" />
    <Label
      id="subtitle"
      text="the beacon - live"
      translation="[40, 68]"
      font="font:SmallSystemFont"
      color="0x888899" />
    <Label
      id="body"
      text="connecting to the beacon..."
      translation="[40, 110]"
      width="1200"
      height="560"
      font="font:MediumSystemFont"
      color="0xDDDDE5"
      wrap="true" />
    <Timer
      id="refresh"
      repeat="true"
      duration="60" />
  </children>
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
</component>
