"""ghost_voice_ops - voice-accessible entry points wired onto existing Mag organs.

  board                      fortress board: spoken summary of mag.swarm_snapshot.collect()
  cage <seat>                what a seat DID, from its hermes job receipts (mag.cage_intake parser)
  designate "<goal>"         real job_floor designation (mag.job_floor.create_job); --dry-run previews
  steer <seat> "<line>"      mag.grok_steer patch gate; cache-hit escalation is a PAID DeepSeek call,
                             so it only fires with --allow-paid. --dry-run = gate only.
Output is plain speakable prose. No chain writes, no tape reads.
"""
from __future__ import annotations
import argparse, sys
from pathlib import Path
ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
try:
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
except Exception:
    pass


def _n(x: float) -> str:
    if x >= 1e9: return "%.1f billion" % (x / 1e9)
    if x >= 1e6: return "%.1f million" % (x / 1e6)
    if x >= 1e3: return "%.0f thousand" % (x / 1e3)
    return str(int(x))


def board(_a) -> int:
    from mag import swarm_snapshot as ss
    d = ss.collect()
    t = d["totals"]; days = d["days"]
    daily = [sum(m.get(k, 0) for m in d["burn_by_model"].values()) for k in days]
    out = ["Fortress board, last %d days." % len(days),
           "%s tokens burned across %d seats, %d errors, %d room events, %d chain knots, %d cards filed."
           % (_n(t["total_tokens_14d"]), t["agents_active"], t["errors_14d"], t["room_events_14d"],
              sum(d["chain_per_day"].values()), t["cards_14d"])]
    if d["burn_by_agent"]:
        top = sorted(d["burn_by_agent"].items(), key=lambda kv: -kv[1])[:3]
        out.append("Top burners: " + ", ".join("%s at %s" % (a, _n(v)) for a, v in top) + ".")
    if d["burn_by_model"]:
        m = max(d["burn_by_model"], key=lambda m: sum(d["burn_by_model"][m].values()))
        out.append("Heaviest model is %s." % m)
    # anomalies
    anom = []
    active = [v for v in daily if v]
    if active:
        avg = sum(active) / len(active)
        for k, v in zip(days, daily):
            if v > 2.5 * avg and v > 0: anom.append("burn spike on %s at %s tokens" % (k, _n(v)))
    errs = [d["errors_per_day"].get(k, 0) for k in days]
    if sum(errs):
        mx = max(errs); k = days[errs.index(mx)]
        if mx >= 3: anom.append("error burst on %s with %d errors" % (k, mx))
    quiet = [k for k, v in zip(days, daily) if v == 0]
    if quiet and len(quiet) < len(days): anom.append("%d silent day%s, last on %s" % (len(quiet), "s" if len(quiet) > 1 else "", quiet[-1]))
    if daily[-1] == 0: anom.append("nothing has burned today yet")
    if not sum(d["chain_per_day"].values()): anom.append("no chain knots sealed in the window")
    out.append(("Anomalies: " + "; ".join(anom) + ".") if anom else "No anomalies flagged.")
    print(" ".join(out)); return 0


def cage(a) -> int:
    from mag import cage_intake as ci
    seat = a.seat.strip().lower()
    src = ci.DEFAULT_SOURCE
    hits = []
    for p in sorted(src.glob("*.md")):
        try:
            parsed = ci.parse_job_card(p.read_text(encoding="utf-8", errors="replace"))
        except OSError:
            continue
        if parsed and ci.persona_of(parsed) == seat:
            hits.append((p, parsed))
    if not hits:
        print("I found no job receipts for %s in %s. Its self-report is uncorroborated; it has no behavior chain." % (seat, src.name))
        return 0
    ok = sum(1 for _, r in hits if r["exit"] == 0)
    bad = sum(1 for _, r in hits if r["exit"] not in (0, None))
    unk = len(hits) - ok - bad
    dur = sum(r["duration_s"] or 0 for _, r in hits)
    models = sorted({r.get("model") for _, r in hits if r.get("model")})
    out = ["Receipts for %s, not its self report." % seat,
           "%d job%s on file: %d exited clean, %d failed, %d with no exit recorded, about %d minutes of runtime total."
           % (len(hits), "" if len(hits) == 1 else "s", ok, bad, unk, round(dur / 60))]
    if models: out.append("Models used: %s." % ", ".join(models))
    out.append("Most recent:")
    for p, r in hits[-3:]:
        g = " ".join(str(r.get("goal") or "no goal recorded").split())[:140]
        ex = "exit %s" % r["exit"] if r["exit"] is not None else "no exit code"
        out.append("%s, %s, goal: %s." % (ci.filedate_of(p, r) or p.stem, ex, g))
    print(" ".join(out)); return 0


def designate(a) -> int:
    from mag import job_floor as jf
    goal = " ".join(a.goal.split())
    if len(goal) < 8:
        print("That goal is too vague to designate. Say what should change and where."); return 1
    if a.dry_run:
        print("Dry run. I would designate a job for seat %s with goal: %s. State would be designated, max %d seconds. Nothing written."
              % (a.seat, goal[:500], a.max_s)); return 0
    rec = jf.create_job(goal, seat=a.seat, max_s=a.max_s)
    print("Designated job %s for seat %s, state %s. Goal: %s. Written to %s."
          % (rec["id"], rec["seat"], rec["state"], rec["goal"], jf.JOBS_PATH.relative_to(ROOT)))
    return 0


def steer(a) -> int:
    from mag import grok_steer as gs
    line = " ".join(a.line.split())
    gate = gs._detect_patch(line)
    v = gate["verdict"].replace("_", " ")
    if not gate["patch"]:
        print("Steer gate for %s says %s. No steer needed, no model call, zero cost." % (a.seat, v)); return 0
    if a.dry_run or not a.allow_paid:
        why = "dry run" if a.dry_run else "the cache-hit escalation is a paid DeepSeek call, so rerun with allow paid to fire it"
        print("Steer gate for %s detected a patch move, %d pattern%s hit. Not escalating: %s."
              % (a.seat, len(gate["patch_hits"]), "" if len(gate["patch_hits"]) == 1 else "s", why)); return 0
    r = gs.decide_steer(line)
    if r.get("steer"):
        print("Steer for %s via %s: %s Note: grok_steer returns the steer; it does not deliver it into the session." % (a.seat, r.get("channel"), r["steer"]))
    else:
        print("Steer escalation failed: %s." % r.get("error")); return 1
    return 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="ghost_voice_ops")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("board").set_defaults(fn=board)
    p = sub.add_parser("cage"); p.add_argument("seat"); p.set_defaults(fn=cage)
    p = sub.add_parser("designate"); p.add_argument("goal"); p.add_argument("--seat", default="local")
    p.add_argument("--max-s", type=float, default=600.0); p.add_argument("--dry-run", action="store_true"); p.set_defaults(fn=designate)
    p = sub.add_parser("steer"); p.add_argument("seat"); p.add_argument("line")
    p.add_argument("--dry-run", action="store_true"); p.add_argument("--allow-paid", action="store_true"); p.set_defaults(fn=steer)
    a = ap.parse_args(argv)
    return a.fn(a)


if __name__ == "__main__":
    raise SystemExit(main())
