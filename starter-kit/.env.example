# Copy to .env and fill in. .env is gitignored from birth: never commit
# it, never paste a key into a chat or script. Rotate at the provider the
# same day if a key ever leaks. Names below are examples of the classes
# you will collect from free signups - keep only what you use.

# Your daily-driver agent (pick one door, comment the rest)
AGENT_CLI=

# Free-tier API keys (from the dedicated Gmail signups)
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Local model runtime (no key needed - Ollama runs local)
OLLAMA_HOST=http://127.0.0.1:11434
LOCAL_MODEL=mine-32k

# Voice room (murmur container from INSTALL.md step 5)
MURMUR_HOST=127.0.0.1
MURMUR_PORT=64738
