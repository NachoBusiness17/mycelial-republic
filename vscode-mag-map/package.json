{
  "name": "mag-framework-map",
  "displayName": "MAG Framework Map",
  "description": "Custom interface pane mapping every local_sovereign_agent command — search the framework, run from VS Code.",
  "version": "0.1.0",
  "publisher": "mag",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "mag",
    "framework",
    "map",
    "local_sovereign_agent"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "magMap",
          "title": "MAG Map",
          "icon": "media/mag.svg"
        },
        {
          "id": "magControlRoom",
          "title": "MAG Control Room",
          "icon": "media/mag.svg"
        }
      ]
    },
    "views": {
      "magMap": [
        {
          "id": "magMap.view",
          "name": "Framework Map",
          "type": "webview"
        }
      ],
      "magControlRoom": [
        {
          "id": "magControlRoom.thoughtSurface",
          "name": "Thought Surface",
          "type": "webview"
        },
        {
          "id": "magControlRoom.opsGraph",
          "name": "Ops Graph",
          "type": "webview"
        },
        {
          "id": "magControlRoom.drainerView",
          "name": "Drainer",
          "type": "webview"
        },
        {
          "id": "magControlRoom.ghostView",
          "name": "Ghost",
          "type": "webview"
        },
        {
          "id": "magControlRoom.handoffView",
          "name": "Handoff",
          "type": "webview"
        },
        {
          "id": "magControlRoom.surfaceHub",
          "name": "Surface Audit",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "magMap.thoughtSurface",
        "title": "MAG: Open Thought Surface (live agent streams)",
        "icon": "$(pulse)"
      },
      {
        "command": "magMap.opsGraphView",
        "title": "MAG: Open Ops Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "magMap.drainerView",
        "title": "MAG: Open Drainer",
        "icon": "$(graph-line)"
      },
      {
        "command": "magMap.ghostView",
        "title": "MAG: Open Ghost",
        "icon": "$(beaker)"
      },
      {
        "command": "magMap.open",
        "title": "MAG: Open Framework Map",
        "icon": "$(map)"
      },
      {
        "command": "magMap.refresh",
        "title": "MAG: Refresh Map",
        "icon": "$(refresh)"
      },
      {
        "command": "magMap.quickRun",
        "title": "MAG: Quick Run…",
        "icon": "$(play)"
      },
      {
        "command": "magMap.ghostSense",
        "title": "MAG Ghost: Sense System State",
        "icon": "$(eye)"
      },
      {
        "command": "magMap.ghostCatalog",
        "title": "MAG Ghost: Show Experiment Catalog",
        "icon": "$(beaker)"
      },
      {
        "command": "magMap.ghostDeploy",
        "title": "MAG Ghost: Deploy Test Vector…",
        "icon": "$(send)"
      },
      {
        "command": "magMap.janitorVerkle",
        "title": "MAG Janitor: Fix Verkle Tip",
        "icon": "$(debug-start)"
      },
      {
        "command": "magMap.janitorCycle",
        "title": "MAG Janitor: Run Full Cycle",
        "icon": "$(sync)"
      },
      {
        "command": "magMap.handoffRun",
        "title": "MAG: Run Pending Handoff Request…",
        "icon": "$(play)"
      },
      {
        "command": "magMap.handoffWatch",
        "title": "MAG: Handoff Watcher (status)",
        "icon": "$(eye)"
      },
      {
        "command": "magMap.liveOverseer",
        "title": "MAG Live: Overseer Feed",
        "icon": "$(eye)"
      },
      {
        "command": "magMap.liveGhost",
        "title": "MAG Live: Ghost Feed",
        "icon": "$(beaker)"
      },
      {
        "command": "magMap.liveDrainer",
        "title": "MAG Live: Drainer Feed",
        "icon": "$(sync)"
      },
      {
        "command": "magMap.drainerStats",
        "title": "MAG: Drainer Stats",
        "icon": "$(graph-line)"
      },
      {
        "command": "magMap.rgSearch",
        "title": "MAG: Ripgrep Code Search…",
        "icon": "$(search)"
      },
      {
        "command": "magMap.opsGraph",
        "title": "MAG: Ops Knowledge Graph (categorized telemetry)",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "magMap.surfaceAudit",
        "title": "MAG: Surface Audit (full surface hub)",
        "icon": "$(dashboard)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "magMap.refresh",
          "when": "view == magMap.view",
          "group": "navigation"
        },
        {
          "command": "magMap.ghostSense",
          "when": "view == magMap.view",
          "group": "navigation"
        },
        {
          "command": "magMap.ghostCatalog",
          "when": "view == magMap.view",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "magMap.open"
        },
        {
          "command": "magMap.refresh"
        },
        {
          "command": "magMap.quickRun"
        },
        {
          "command": "magMap.ghostSense"
        },
        {
          "command": "magMap.ghostCatalog"
        },
        {
          "command": "magMap.ghostDeploy"
        },
        {
          "command": "magMap.janitorVerkle"
        },
        {
          "command": "magMap.janitorCycle"
        },
        {
          "command": "magMap.opsGraph"
        },
        {
          "command": "magMap.thoughtSurface"
        },
        {
          "command": "magMap.opsGraphView"
        },
        {
          "command": "magMap.drainerView"
        },
        {
          "command": "magMap.ghostView"
        },
        {
          "command": "magMap.rgSearch"
        }
      ]
    },
    "configuration": {
      "title": "MAG Map",
      "properties": {
        "magMap.projectRoot": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the local_sovereign_agent project root. Empty = auto-detect from workspace."
        },
        "magMap.showOnlyRunnable": {
          "type": "boolean",
          "default": false,
          "description": "Only show items that have a run command (hide pure-info REST routes / providers)."
        },
        "magMap.refreshSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "description": "Auto-refresh interval (seconds) for the Framework Map. The map is served by the framework's own rule system (GET /api/v1/framework/map) and regenerated by the MAG_MAP_EVERY cadence loop, so it stays fresh without a manual rescan."
        }
      }
    }
  },
  "scripts": {
    "scan": "node scripts/scan.js --json"
  }
}
