-- Q-032 executable check: Flock - the swarm.html crop-physics boids port
-- (flee/tire/rest, the school, the pheromone trail), run under
-- tools/bin/luau/luau.exe.
--
-- The REAL module source is EMBEDDED below between the FLOCK-SOURCE markers:
-- this file is generated by Q_032_flock_check_gen.py straight from
-- roblox/src/shared/Flock.luau (the luau CLI sandbox has no `load`/`io`, and a
-- require'd module runs in a fresh env that cannot see this script's Vector3
-- stub, so embedding is the only way to execute the real source - the same
-- shape as the banked Q_043 check). Regenerate + rerun after any module edit:
--   python Q_032_flock_check_gen.py
--   tools/bin/luau/luau.exe Q_032_flock_check.luau
--
-- Vector3 stub (the module needs .new/.zero/.Magnitude/.Unit and +-*/ only;
-- the game's Vector3 is the Roblox runtime's):
local function v3new(x, y, z)
	local t = { X = x or 0, Y = y or 0, Z = z or 0 }
	t.Magnitude = math.sqrt(t.X * t.X + t.Y * t.Y + t.Z * t.Z)
	return setmetatable(t, {
		__add = function(a, b) return v3new(a.X + b.X, a.Y + b.Y, a.Z + b.Z) end,
		__sub = function(a, b) return v3new(a.X - b.X, a.Y - b.Y, a.Z - b.Z) end,
		__mul = function(a, b)
			if type(a) == "number" then return v3new(a * b.X, a * b.Y, a * b.Z) end
			return v3new(a.X * b, a.Y * b, a.Z * b)
		end,
		__div = function(a, b)
			if type(b) == "number" then return v3new(a.X / b, a.Y / b, a.Z / b) end
			error("v3 div by vec")
		end,
		__unm = function(a) return v3new(-a.X, -a.Y, -a.Z) end,
		__index = function(t, k)
			if k == "Unit" then
				local m = t.Magnitude
				if m < 1e-8 then return v3new(0, 0, 0) end
				return v3new(t.X / m, t.Y / m, t.Z / m)
			end
			return nil
		end,
	})
end
Vector3 = { new = v3new, zero = v3new(0, 0, 0) }

local Flock = (function()
--FLOCK-SOURCE-BEGIN
--!strict
-- Flock — the living-crop boids engine ported from dashboard/static/games/swarm.html
-- (Q-032). The source's own thesis: "the crop is ALIVE — XP is a spore fish, and it
-- flees ... the header catches the tired ones" (swarm.html:949-950). Three laws,
-- each carried from its exact source lines:
--
--   1. FLEE / TIRE / REST  (swarm.html:951-968) — an airborne fish flees the player
--      inside the flee radius, accelerating away at max(minSpeed, baseSpeed −
--      fatigue·slope), the same speed scalar pushed ×6 on the plane and ×4 on the
--      height axis; it accumulates `flee` fatigue, then when the player is out of
--      range it coasts (fleeT lingers 0.8s with drag but no gravity), then it TIRES:
--      fatigue decays by 0.4^dt and gravity pulls it down. Floor contact flips it
--      to rest. Drag 0.985 per source frame, frame-normalized as 0.985^(60·dt).
--      Arena walls bounce at half restitution (the source's x-walls at 8 / WW−8,
--      generalized to the port's two horizontal axes).
--   2. SCHOOL (swarm.html:970-981, the boids core) — a RESTING fish is steered by
--      direct position nudges only, never velocity: cohesion toward the centroid of
--      neighbors inside the school radius (rate 0.9 on the plane, 0.55 on height),
--      separation from neighbors inside the separation radius (rate 0.6 / 0.35),
--      plus the identity wiggle sin(t·7 + x·0.05)·amp·dt along world X, then the
--      floor clamp. The source's floor clamp `g.y > floor → g.y = floor` grows on a
--      down-positive canvas axis; here Y is up, so the clamp is `Y < floorY`.
--   3. PHEROMONE TRAIL (steering law swarm.html:842-851, drop law :1113-1121) — the
--      horde steers at the freshest trail point whose score life·(1 − manhattan/
--      radius) beats the floor 1.2, else straight at the player. Walking drops
--      points with life 2.5; the loud action (source: the harvest header; port: the
--      Fire pellet) drops life 5. Cap 140 points, drop interval 0.15s.
--
-- Scale law (the one port mapping, recorded in roblox/docs/CLONED_MECHANICS.md
-- §3.7): the source runs on a 2400-wide canvas with a 200-unit/s skater; this port
-- has a 90-stud arena and a 16 studs/s walk. Speeds scale ×0.08 (the player ratio;
-- gravity and the toss inherit it). Lengths are tuned inside that envelope to stay
-- playable: flee 95→14, catch 15→3.5 (the port's existing touch-collect radius),
-- school 155→20, separation 15→3, trail radius 300→38, wiggle amp 6→1.5. Rates,
-- thresholds, lives, the 1.2 score floor, the drag, and the 0.4^dt fatigue decay
-- carry over verbatim. NOT cloned here: the harvest-header row, the county-line
-- survey, and THE FISH boss duel (45 stays a population cap, not a spawn trigger) —
-- separate mechanics, open moves.
--
-- Pure module: no Instances, no services. A host with only a Vector3 stub (`.new`,
-- `+ - * /`, `Magnitude`, `Unit`) can execute every function, which is what the
-- banked check script does.

local Flock = {}

-- scale factors (see header)
local SPEED_SCALE = 0.08 -- the source skater 200 u/s -> the port walk 16 studs/s

-- flee / tire / rest (swarm.html:951-968; orig values in comments)
local FLEE_RADIUS = 14 -- orig 95
local FLEE_RADIUS_RAIN = 10 -- orig 68 (braver in rain); keeps the 68/95 ratio
local FLEE_SPEED = 26 -- orig 320 x SPEED_SCALE
local FLEE_SPEED_MIN = 11 -- orig 140 x SPEED_SCALE
local FLEE_FATIGUE_SLOPE = 160 * SPEED_SCALE -- orig 160
local FLEE_PLANE_PUSH = 6 -- verbatim: horizontal share of the speed scalar
local FLEE_HEIGHT_PUSH = 4 -- verbatim: vertical share
local FLEE_COAST = 0.8 -- verbatim: fleeT linger before the tire branch
local FATIGUE_DECAY = 0.4 -- verbatim: fatigue *= 0.4^dt while tiring
local GRAVITY = 140 * SPEED_SCALE -- orig 140 (tire branch only)
local DRAG = 0.985 -- verbatim, per 1/60s source frame
local WALL_BOUNCE = 0.5 -- verbatim

-- school (swarm.html:970-981)
local SCHOOL_RADIUS = 20 -- orig 155 (24025 = 155^2)
local COHESION_PLANE = 0.9 -- verbatim
local COHESION_HEIGHT = 0.55 -- verbatim
local SEPARATION_RADIUS = 3 -- orig 15 (225 = 15^2)
local SEPARATION_PLANE = 0.6 -- verbatim
local SEPARATION_HEIGHT = 0.35 -- verbatim
local WIGGLE_FREQ = 7 -- verbatim
local WIGGLE_SPACE = 0.05 -- verbatim
local WIGGLE_AMP = 1.5 -- orig 6

-- pheromone trail (swarm.html:842-851 + :1113-1121)
local TRAIL_RADIUS = 38 -- orig 300 (manhattan)
local TRAIL_SCORE_FLOOR = 1.2 -- verbatim
local TRAIL_LIFE_WALK = 2.5 -- verbatim
local TRAIL_LIFE_LOUD = 5 -- verbatim (source: harvest; port: Fire pellet)
local TRAIL_DROP_INTERVAL = 0.15 -- verbatim
local TRAIL_CAP = 140 -- verbatim

-- crop loop (swarm.html:631 toss, :1074 stir warn, :1091 gem ceiling)
local TOSS_SPEED = 46 * SPEED_SCALE -- orig rnd(-46, 46) horizontal
local TOSS_UP_MIN = 10 * SPEED_SCALE -- orig rnd(-90, -10) upward
local TOSS_UP_MAX = 90 * SPEED_SCALE
local STIR_AT = 30 -- verbatim warn threshold
local POP_CAP = 45 -- orig 200 ceiling; here the pre-boss population law
local CATCH_RADIUS = 3.5 -- orig 15 -> the port's existing touch-collect radius

export type Fish = {
	pos: Vector3,
	vel: Vector3,
	rest: boolean,
	flee: number,
	fleeT: number,
}

export type Bounds = {
	minX: number,
	maxX: number,
	minZ: number,
	maxZ: number,
	floorY: number,
}

export type TrailPoint = {
	pos: Vector3,
	life: number,
}

export type Trail = {
	points: { TrailPoint },
	cap: number,
}

function Flock.newFish(pos: Vector3, toss: Vector3?): Fish
	if toss then
		return { pos = pos, vel = toss, rest = false, flee = 0, fleeT = 0 }
	end
	return { pos = pos, vel = Vector3.zero, rest = true, flee = 0, fleeT = 0 }
end

-- the kill-drop toss (swarm.html:631 `vx:rnd(-46,46), vy:rnd(-90,-10)`), scaled;
-- the source tosses on one horizontal axis, the port across the full plane
function Flock.toss(rng: (() -> number)?): Vector3
	-- branch instead of `rng or math.random`: calling a union of function
	-- types is a TypeError under the strict analyzer
	local function draw(): number
		if rng then
			return rng()
		end
		return math.random()
	end
	local ang = draw() * math.pi * 2
	local mag = draw() * TOSS_SPEED
	local up = TOSS_UP_MIN + draw() * (TOSS_UP_MAX - TOSS_UP_MIN)
	return Vector3.new(math.cos(ang) * mag, up, math.sin(ang) * mag)
end

-- flee / tire / rest for one airborne fish (swarm.html:951-968). Mutates `f`.
-- `raining` keeps the source's braver-in-rain radius (the port passes false;
-- the zone has no weather yet — the parameter keeps the law in the module).
function Flock.fleeStep(f: Fish, playerPos: Vector3, dt: number, raining: boolean, bounds: Bounds)
	local delta = f.pos - playerPos
	local d = delta.Magnitude
	local fleeR = if raining then FLEE_RADIUS_RAIN else FLEE_RADIUS
	if d < fleeR and d > 0.01 then
		-- the fish darts (braver in rain)
		f.flee += dt
		f.fleeT = FLEE_COAST
		local sp = math.max(FLEE_SPEED_MIN, FLEE_SPEED - f.flee * FLEE_FATIGUE_SLOPE)
		local away = delta / d
		f.vel += Vector3.new(
			away.X * sp * FLEE_PLANE_PUSH * dt,
			away.Y * sp * FLEE_HEIGHT_PUSH * dt,
			away.Z * sp * FLEE_PLANE_PUSH * dt
		)
	elseif f.fleeT > 0 then
		f.fleeT -= dt
	else
		-- it tires
		f.flee *= FATIGUE_DECAY ^ dt
		f.vel -= Vector3.new(0, GRAVITY * dt, 0)
	end
	-- drag (source 0.985/frame; frame-normalized), integrate
	local drag = DRAG ^ (dt * 60)
	f.vel *= drag
	f.pos += f.vel * dt
	-- arena walls bounce at half restitution (source x-walls generalized to Z)
	if f.pos.X < bounds.minX then
		f.pos = Vector3.new(bounds.minX, f.pos.Y, f.pos.Z)
		f.vel = Vector3.new(math.abs(f.vel.X) * WALL_BOUNCE, f.vel.Y, f.vel.Z)
	elseif f.pos.X > bounds.maxX then
		f.pos = Vector3.new(bounds.maxX, f.pos.Y, f.pos.Z)
		f.vel = Vector3.new(-math.abs(f.vel.X) * WALL_BOUNCE, f.vel.Y, f.vel.Z)
	end
	if f.pos.Z < bounds.minZ then
		f.pos = Vector3.new(f.pos.X, f.pos.Y, bounds.minZ)
		f.vel = Vector3.new(f.vel.X, f.vel.Y, math.abs(f.vel.Z) * WALL_BOUNCE)
	elseif f.pos.Z > bounds.maxZ then
		f.pos = Vector3.new(f.pos.X, f.pos.Y, bounds.maxZ)
		f.vel = Vector3.new(f.vel.X, f.vel.Y, -math.abs(f.vel.Z) * WALL_BOUNCE)
	end
	-- floor contact -> rest (source: vx *= 0.6 damp, vy = 0, rest)
	if f.pos.Y <= bounds.floorY then
		f.pos = Vector3.new(f.pos.X, bounds.floorY, f.pos.Z)
		f.vel = Vector3.new(f.vel.X * 0.6, 0, f.vel.Z * 0.6)
		f.rest = true
	end
end

-- the boids school for one RESTED fish (swarm.html:970-981). Position nudges only;
-- neighbors include airborne fish, exactly like the source's global gems loop.
-- `t` is zone time (source T), `floorY` the rest height (source gyAt(x) − 6).
function Flock.schoolStep(f: Fish, school: { Fish }, t: number, dt: number, floorY: number)
	local cx, cy, cz, cn = 0, 0, 0, 0
	for _, o in school do
		if o == f then
			continue
		end
		local delta = o.pos - f.pos
		local d2 = delta.X * delta.X + delta.Y * delta.Y + delta.Z * delta.Z
		if d2 < SCHOOL_RADIUS * SCHOOL_RADIUS then
			cx += o.pos.X
			cy += o.pos.Y
			cz += o.pos.Z
			cn += 1
			if d2 < SEPARATION_RADIUS * SEPARATION_RADIUS then
				f.pos -= Vector3.new(
					delta.X * SEPARATION_PLANE * dt,
					delta.Y * SEPARATION_HEIGHT * dt,
					delta.Z * SEPARATION_PLANE * dt
				)
			end
		end
	end
	if cn > 0 then
		f.pos += Vector3.new(
			(cx / cn - f.pos.X) * COHESION_PLANE * dt,
			(cy / cn - f.pos.Y) * COHESION_HEIGHT * dt,
			(cz / cn - f.pos.Z) * COHESION_PLANE * dt
		)
	end
	-- the identity wiggle, along world X like the source's only horizontal axis
	f.pos += Vector3.new(math.sin(t * WIGGLE_FREQ + f.pos.X * WIGGLE_SPACE) * WIGGLE_AMP * dt, 0, 0)
	-- floor clamp (canvas-y down in the source, Y up here: the comparison flips)
	if f.pos.Y < floorY then
		f.pos = Vector3.new(f.pos.X, floorY, f.pos.Z)
	end
end

-- the source's catch law for airborne fish (swarm.html:968 `if(d0<15)`); the zone
-- applies its own collect radii on top (touch 3.5, pet orb 12)
function Flock.caught(f: Fish, playerPos: Vector3): boolean
	return (f.pos - playerPos).Magnitude < CATCH_RADIUS
end

function Flock.loudTrailLife(loud: boolean): number
	return if loud then TRAIL_LIFE_LOUD else TRAIL_LIFE_WALK
end

Flock.TRAIL_DROP_INTERVAL = TRAIL_DROP_INTERVAL
Flock.TRAIL_CAP = TRAIL_CAP
Flock.STIR_AT = STIR_AT
Flock.POP_CAP = POP_CAP

-- ---- the pheromone trail (plain-table state + free functions: strict-clean
-- without metatable typing, and executable against a bare Vector3 stub) ----

function Flock.trailNew(cap: number?): Trail
	return { points = {}, cap = cap or TRAIL_CAP }
end

-- drop one point (source: push + shift past the cap, swarm.html:1115-1118)
function Flock.trailDrop(trail: Trail, pos: Vector3, life: number)
	table.insert(trail.points, { pos = pos, life = life })
	while #trail.points > trail.cap do
		table.remove(trail.points, 1)
	end
end

-- age the trail (source: life -= dt, filter at 0, swarm.html:1120-1121)
function Flock.trailStep(trail: Trail, dt: number)
	local alive: { TrailPoint } = {}
	for _, p in trail.points do
		p.life -= dt
		if p.life > 0 then
			table.insert(alive, p)
		end
	end
	trail.points = alive
end

-- best fresh score at a position (swarm.html:845-850: manhattan radius, score
-- life·(1 − d/radius)); returns the score and the point, or nil
function Flock.trailBest(trail: Trail, pos: Vector3): (number, TrailPoint?)
	local bestScore, bestPoint = 0, nil :: TrailPoint?
	for _, p in trail.points do
		local d = math.abs(p.pos.X - pos.X) + math.abs(p.pos.Y - pos.Y) + math.abs(p.pos.Z - pos.Z)
		if d < TRAIL_RADIUS then
			local s = p.life * (1 - d / TRAIL_RADIUS)
			if s > bestScore then
				bestScore = s
				bestPoint = p
			end
		end
	end
	return bestScore, bestPoint
end

-- the steering law (swarm.html:842-851): the trail pulls when it is fresher than
-- the score floor, else the horde walks straight at the player. Returns a unit
-- direction, or the zero vector when both targets coincide with the asker.
function Flock.trailSteer(trail: Trail, pos: Vector3, playerPos: Vector3): Vector3
	local score, point = Flock.trailBest(trail, pos)
	local target = if score > TRAIL_SCORE_FLOOR and point then point.pos else playerPos
	local delta = target - pos
	if delta.Magnitude < 1e-4 then
		return Vector3.zero
	end
	return delta.Unit
end

return Flock
--FLOCK-SOURCE-END
end)()

local pass, fail = 0, 0
local function CHECK(name, cond)
	if cond then
		pass += 1
	else
		fail += 1
		print("FAIL: " .. name)
	end
end
local function approx(a, b, eps)
	return math.abs(a - b) <= (eps or 1e-9)
end

local DT = 1 / 60
local FLOOR = 0.8
local BOUNDS = { minX = -44, maxX = 44, minZ = -44, maxZ = 44, floorY = FLOOR }
local DRAG = 0.985 -- 0.985^(dt*60) == 0.985 at dt = 1/60

-- 1. exported crop-loop laws
CHECK("exports (STIR_AT 30 / POP_CAP 45 / TRAIL_CAP 140 / drop 0.15)",
	Flock.STIR_AT == 30 and Flock.POP_CAP == 45 and Flock.TRAIL_CAP == 140
		and approx(Flock.TRAIL_DROP_INTERVAL, 0.15))

-- 2. newFish: resting vs tossed
local r = Flock.newFish(v3new(1, 2, 3))
CHECK("newFish resting (rest, zero vel, pos kept)",
	r.rest == true and r.vel.X == 0 and r.vel.Y == 0 and r.vel.Z == 0
		and r.pos.X == 1 and r.pos.Y == 2 and r.pos.Z == 3 and r.flee == 0 and r.fleeT == 0)
local to = Flock.newFish(v3new(0, 0, 0), v3new(1, 2, 3))
CHECK("newFish tossed (airborne, vel kept)", to.rest == false and to.vel.X == 1 and to.vel.Y == 2 and to.vel.Z == 3)

-- 3. toss law (swarm.html:631 scaled): rng pinned to 0 / 1 gives the envelope ends
local t0 = Flock.toss(function() return 0 end)
CHECK("toss at rng=0 (up floor 0.8, zero horizontal)",
	approx(t0.X, 0) and approx(t0.Y, 0.8, 1e-6) and approx(t0.Z, 0, 1e-6))
local t1 = Flock.toss(function() return 1 end)
CHECK("toss at rng=1 (up ceil 7.2, horizontal ceil 3.68)",
	approx(t1.X, 3.68, 1e-6) and approx(t1.Y, 7.2, 1e-6) and approx(t1.Z, 0, 1e-6))

-- 4. flee dart: accelerates AWAY, plane share x6, fatigue accumulates, coast timer set
local f = Flock.newFish(v3new(5, 3, 0))
Flock.fleeStep(f, v3new(0, 3, 0), DT, false, BOUNDS)
CHECK("flee dart pushes away on the plane (x6 share, drag applied)",
	approx(f.vel.X, (26 - 12.8 * DT) * 6 * DT * DRAG)
		and approx(f.vel.Y, 0) and approx(f.vel.Z, 0))
CHECK("flee dart books fatigue and the 0.8 coast timer", approx(f.flee, DT) and f.fleeT == 0.8)
local fh = Flock.newFish(v3new(0, 8, 0))
Flock.fleeStep(fh, v3new(0, 3, 0), DT, false, BOUNDS)
CHECK("flee dart height share x4 (fish above player is pushed up)",
	approx(fh.vel.Y, (26 - 12.8 * DT) * 4 * DT * DRAG) and approx(fh.vel.X, 0))

-- 5. coast: player out of range while fleeT > 0 -> drag only, NO gravity
local fc = Flock.newFish(v3new(13, 3, 0))
Flock.fleeStep(fc, v3new(0, 3, 0), DT, false, BOUNDS)
local coastVX = fc.vel.X
Flock.fleeStep(fc, v3new(1000, 3, 0), DT, false, BOUNDS)
CHECK("coast: velocity decays by drag, no gravity while fleeT > 0",
	approx(fc.vel.X, coastVX * DRAG) and fc.vel.Y == 0)
-- coast until gravity first bites, then the tire branch is exact
local preTireY = 0
for _ = 1, 200 do
	preTireY = fc.vel.Y
	Flock.fleeStep(fc, v3new(1000, 3, 0), DT, false, BOUNDS)
	if fc.vel.Y < -1e-9 then break end
end
CHECK("tire: after the 0.8s coast gravity pulls down (140 x 0.08)",
	approx(fc.vel.Y, (preTireY - 11.2 * DT) * DRAG, 1e-6))

-- 6. fatigue decays by 0.4^dt in the tire branch (swarm.html:960 verbatim shape),
-- and holds untouched through the coast ticks
local ff = Flock.newFish(v3new(13, 3, 0))
Flock.fleeStep(ff, v3new(0, 3, 0), DT, false, BOUNDS)
local fleeAfterDart = ff.flee
local tireFlee = nil :: number?
for _ = 1, 200 do
	local before = ff.flee
	Flock.fleeStep(ff, v3new(1000, 3, 0), DT, false, BOUNDS)
	if ff.vel.Y < -1e-9 then
		tireFlee = before
		break
	end
end
CHECK("tire: fatigue decays by 0.4^dt on the first tire tick",
	tireFlee ~= nil and approx(ff.flee, tireFlee * (0.4 ^ DT)))
CHECK("tire: fatigue held through the coast ticks", approx(tireFlee :: number, fleeAfterDart))

-- 7. the full law integrates: a spooked fish flees, coasts, tires, RESTS on the floor
local fs = Flock.newFish(v3new(5, 3, 0))
local stayedIn = true
for _ = 1, 1200 do
	Flock.fleeStep(fs, v3new(0, 3, 0), DT, false, BOUNDS)
	if fs.pos.X < BOUNDS.minX - 1e-6 or fs.pos.X > BOUNDS.maxX + 1e-6
		or fs.pos.Z < BOUNDS.minZ - 1e-6 or fs.pos.Z > BOUNDS.maxZ + 1e-6
		or fs.pos.Y < FLOOR - 1e-6 then
		stayedIn = false
	end
end
CHECK("integration: spooked fish ends RESTED on the floor",
	fs.rest == true and approx(fs.pos.Y, FLOOR, 1e-9) and fs.vel.Y == 0)
CHECK("integration: never left the arena or sank through the floor", stayedIn)

-- 8. arena wall bounce at half restitution (source x-walls, generalized to Z)
local fw = Flock.newFish(v3new(43.5, 3, 0))
local bounced = false
for _ = 1, 30 do
	Flock.fleeStep(fw, v3new(40, 3, 0), DT, false, BOUNDS)
	if fw.vel.X < 0 then bounced = true end
end
CHECK("wall: fish driven past maxX re-enters with half restitution", bounced and fw.pos.X <= 44 + 1e-6)

-- 9. rain shrinks the flee radius 14 -> 10 (swarm.html:954, the 68/95 ratio kept)
local fn = Flock.newFish(v3new(12, 3, 0))
Flock.fleeStep(fn, v3new(0, 3, 0), DT, false, BOUNDS)
CHECK("dry: a fish at 12 studs flees (radius 14)", approx(fn.flee, DT) and fn.fleeT == 0.8)
local fr = Flock.newFish(v3new(12, 3, 0))
Flock.fleeStep(fr, v3new(0, 3, 0), DT, true, BOUNDS)
CHECK("rain: the same fish does NOT flee (radius 10), it just tires",
	fr.flee == 0 and fr.fleeT == 0 and fr.vel.Y < 0)

-- 10. the catch law (swarm.html:968 d0<15, scaled to the port's touch radius)
local fc3 = Flock.newFish(v3new(3, 0, 0))
local fc4 = Flock.newFish(v3new(4, 0, 0))
CHECK("caught: 3 studs yes, 4 studs no", Flock.caught(fc3, v3new(0, 0, 0)) and not Flock.caught(fc4, v3new(0, 0, 0)))

-- 11. school cohesion: pulls TOWARD the centroid at the verbatim 0.9 plane rate.
-- Expected values replicate the module's (and the source's) composition order:
-- separation reads the live pos inside the neighbor loop, cohesion after it, and
-- the wiggle reads the post-cohesion x -- so a clean rate extraction uses axes the
-- wiggle never touches (Z for the plane rate, Y for the height rate).
local a = Flock.newFish(v3new(0, FLOOR, 0))
local b = Flock.newFish(v3new(10, FLOOR, 0))
Flock.schoolStep(a, { a, b }, 0, DT, FLOOR)
local cohX = 10 * 0.9 * DT
CHECK("school cohesion: x = gap x 0.9 x dt + the identity wiggle on the moved x",
	approx(a.pos.X, cohX + math.sin(cohX * 0.05) * 1.5 * DT)
		and approx(a.pos.Y, FLOOR) and approx(a.pos.Z, 0))
local aZ = Flock.newFish(v3new(0, FLOOR, 0))
local bZ = Flock.newFish(v3new(0, FLOOR, 10))
Flock.schoolStep(aZ, { aZ, bZ }, 0, DT, FLOOR)
CHECK("school cohesion rate extracts to 0.9 from the wiggle-free Z axis",
	approx(aZ.pos.Z / DT / 10, 0.9))
local aY = Flock.newFish(v3new(0, FLOOR, 0))
local bY = Flock.newFish(v3new(0, FLOOR + 10, 0))
Flock.schoolStep(aY, { aY, bY }, 0, DT, FLOOR)
CHECK("school cohesion height rate extracts to 0.55",
	approx((aY.pos.Y - FLOOR) / DT / 10, 0.55))

-- 12. height anisotropy: separation 0.35 down, cohesion 0.55 up (vs 0.6 / 0.9 on
-- the plane), composed in the source's order (separation first, cohesion reads
-- the live pos)
local h = Flock.newFish(v3new(0, FLOOR, 0))
local hb = Flock.newFish(v3new(0, FLOOR + 2, 0))
Flock.schoolStep(h, { h, hb }, 0, DT, FLOOR)
local h1 = FLOOR - 2 * 0.35 * DT
local h2 = h1 + (FLOOR + 2 - h1) * 0.55 * DT
CHECK("school anisotropy: composed y matches 0.35-sep then 0.55-coh, x untouched",
	approx(h.pos.Y, h2) and h.pos.X == 0)

-- 13. close-range pair (gap 1 < separation 3): separation pushes A away from the
-- left neighbor at 0.6, cohesion pulls toward it at 0.9 -- the source's own numbers
-- net TOWARD each other at close range (its comment calls it "wiggle closer")
local sp = Flock.newFish(v3new(0, FLOOR, 0))
local spb = Flock.newFish(v3new(-1, FLOOR, 0))
Flock.schoolStep(sp, { sp, spb }, 0, DT, FLOOR)
local s1 = 0 - (-1) * 0.6 * DT
local s2 = s1 + (-1 - s1) * 0.9 * DT
local s3 = s2 + math.sin(s2 * 0.05) * 1.5 * DT
CHECK("school close pair: cohesion 0.9 out-runs separation 0.6 (net toward the neighbor)",
	approx(sp.pos.X, s3, 1e-12) and sp.pos.X < 0)

-- 14. far neighbors are ignored; airborne neighbors still count (source parity:
-- the source school loop iterates the GLOBAL gems array, rest state not filtered)
local far = Flock.newFish(v3new(0, FLOOR, 0))
local farb = Flock.newFish(v3new(25, FLOOR, 0))
Flock.schoolStep(far, { far, farb }, 0, DT, FLOOR)
CHECK("school: neighbor beyond the 20-stud radius is ignored",
	far.pos.X == 0 and far.pos.Y == FLOOR and far.pos.Z == 0)
local air = Flock.newFish(v3new(10, 5, 0), v3new(1, 1, 0))
local anchored = Flock.newFish(v3new(0, FLOOR, 0))
Flock.schoolStep(anchored, { anchored, air }, 0, DT, FLOOR)
CHECK("school: an AIRBORNE neighbor still pulls the school (source parity)",
	anchored.pos.Y > FLOOR + 1e-4)

-- 15. the school is position-only: velocity never touched; floor clamp holds
local pinned = Flock.newFish(v3new(0, 0.5, 0))
Flock.schoolStep(pinned, { pinned }, 0, DT, FLOOR)
CHECK("school: velocity untouched, below-floor fish clamped to the rest height",
	pinned.vel.X == 0 and pinned.vel.Y == 0 and pinned.vel.Z == 0 and approx(pinned.pos.Y, FLOOR))

-- 16. wiggle identity: the lone-school drift along X is sin(t*7 + x*0.05)*1.5*dt
local wg = Flock.newFish(v3new(3, FLOOR, 0))
Flock.schoolStep(wg, { wg }, 1.5, DT, FLOOR)
CHECK("wiggle: sin(t*7 + x*0.05)*1.5*dt along X only",
	approx(wg.pos.X, 3 + math.sin(1.5 * 7 + 3 * 0.05) * 1.5 * DT)
		and approx(wg.pos.Y, FLOOR) and wg.pos.Z == 0)

-- 17. trail: cap evicts the OLDEST, step kills the dead (free-function API)
local tr = Flock.trailNew()
for i = 1, 150 do
	Flock.trailDrop(tr, v3new(i, 0, 0), 10)
end
CHECK("trail cap 140 evicts the oldest (150 dropped -> 1..10 gone, 11 first)",
	#tr.points == 140 and tr.points[1].pos.X == 11 and tr.points[140].pos.X == 150)
local tr2 = Flock.trailNew()
Flock.trailDrop(tr2, v3new(0, 0, 0), 1)
Flock.trailDrop(tr2, v3new(5, 0, 0), 0.05)
Flock.trailStep(tr2, 0.1)
CHECK("trail step: dead points filtered, survivor aged",
	#tr2.points == 1 and approx(tr2.points[1].life, 0.9) and tr2.points[1].pos.X == 0)

-- 18. the steering law (swarm.html:842-851): fresh trail beats the player,
-- stale/far trail does not
local tFresh = Flock.trailNew()
Flock.trailDrop(tFresh, v3new(-10, 0, 0), 5)
local sFresh = Flock.trailSteer(tFresh, v3new(0, 0, 0), v3new(30, 0, 0))
CHECK("steer: fresh point (score 5*(1-10/38) > 1.2) pulls LEFT against the player",
	sFresh.X < -0.99 and approx(sFresh.Magnitude, 1))
local tStale = Flock.trailNew()
Flock.trailDrop(tStale, v3new(-10, 0, 0), 0.2)
CHECK("steer: stale point (score < 1.2) loses to the player",
	Flock.trailSteer(tStale, v3new(0, 0, 0), v3new(30, 0, 0)).X > 0.99)
local tFar = Flock.trailNew()
Flock.trailDrop(tFar, v3new(-50, 0, 0), 5)
CHECK("steer: a point beyond the 38-stud manhattan radius is ignored",
	Flock.trailSteer(tFar, v3new(0, 0, 0), v3new(30, 0, 0)).X > 0.99)
local tMan = Flock.trailNew()
Flock.trailDrop(tMan, v3new(25, 25, 0), 5)
CHECK("steer: the radius is MANHATTAN (|25|+|25|=50 out; euclid 35.4 would count)",
	Flock.trailSteer(tMan, v3new(0, 0, 0), v3new(-30, 0, 0)).X < -0.99)
-- fresher wins at equal distance (life weighting inside the score)
local tW1 = Flock.trailNew()
Flock.trailDrop(tW1, v3new(-10, 0, 0), 5)
Flock.trailDrop(tW1, v3new(10, 0, 0), 2.5)
CHECK("steer: fresher wins at equal distance (5-life left vs 2.5-life right)",
	Flock.trailSteer(tW1, v3new(0, 0, 0), v3new(0, 0, 0)).X < -0.99)
local tW2 = Flock.trailNew()
Flock.trailDrop(tW2, v3new(-10, 0, 0), 2.5)
Flock.trailDrop(tW2, v3new(10, 0, 0), 5)
CHECK("steer: and the bias flips with the lives",
	Flock.trailSteer(tW2, v3new(0, 0, 0), v3new(0, 0, 0)).X > 0.99)

-- 19. zero-vector guard: horde standing on the player with no trail
local tZ = Flock.trailNew()
CHECK("steer: coincident targets give the zero vector",
	Flock.trailSteer(tZ, v3new(0, 0, 0), v3new(0, 0, 0)).Magnitude == 0)

-- 20. the loud-action trail life (source harvest 5 / walk 2.5)
CHECK("loudTrailLife: loud 5, walk 2.5",
	Flock.loudTrailLife(true) == 5 and Flock.loudTrailLife(false) == 2.5)

