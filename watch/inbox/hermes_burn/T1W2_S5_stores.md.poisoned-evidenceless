def test_xproc_increment_no_loss(tmp_path):
    p = tmp_path / "ctr.txt"; p.write_text("0")
    N, W = 200, 4
    procs = [Process(target=incr_loop, args=(p, N)) for _ in range(W)]
    procs.append(Process(target=reader_loop, args=(p, 5.0)))  # holds file open
    for x in procs: x.start()
    for x in procs: x.join()
    assert all(x.exitcode == 0 for x in procs)
    assert int(p.read_text()) == N * W
```

Here, `incr_loop` performs a read, a +1, and `atomic_write_text`, all inside `exclusive(p)`.

