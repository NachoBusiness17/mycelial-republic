-- ---- constants (the only hand-set numbers in the file) ----

-- 20000 studs per eigen unit: the whole centroid cloud (span ~0.0157 x
-- ~0.0081 in the 0926/0927 scans) lands as a ~314 x ~162 stud plaza, the
-- size of the wave-zone plots, walkable in under a minute at walk speed.
EigenMap.STUDS_PER_UNIT = 20000
-- plaza center, east of every existing zone (prior max worldX = 300, see
-- init.server.luau WAVE table; basecamp rooms stay within radius 174)
EigenMap.PLAZA_X = 600
EigenMap.PLAZA_Z = -100
EigenMap.FLOOR_Y = 8

-- ---- derived from the generated block, never hand-set ----

local BY_NAME: { [string]: RegionRow } = {}
for _, r in ipairs(REGIONS) do
	BY_NAME[r.name] = r
end

local function bounds(): (number, number, number, number)
	local x0, x1, y0, y1 = math.huge, -math.huge, math.huge, -math.huge
	for _, r in ipairs(REGIONS) do
		if r.ex < x0 then x0 = r.ex end
		if r.ex > x1 then x1 = r.ex end
		if r.ey < y0 then y0 = r.ey end
		if r.ey > y1 then y1 = r.ey end
	end
	return x0, x1, y0, y1
end

local EX0, EX1, EY0, EY1 = bounds()
local CENTER_EX = (EX0 + EX1) / 2
local CENTER_EY = (EY0 + EY1) / 2

local function row(name: string): RegionRow
	local r = BY_NAME[name]
	if not r then
		error(("EigenMap: unknown region %s (not in the scan's eigen_centroids)"):format(name), 2)
	end
	return r
end

-- bearing over the eigen plane: 0 = north (eigen -ey), clockwise, degrees.
-- Same law as the HTML map (tools/cathedral_eigen_map.py bearing()).
local function bearingXY(dx: number, dy: number): number
	return (math.deg(math.atan2(dx, -dy)) + 360) % 360
end

-- ---- pure-number API (Luau CLI runnable, no Roblox globals) ----

function EigenMap.regions(): { RegionRow }
	return REGIONS
end

function EigenMap.region(name: string): RegionRow?
	return BY_NAME[name]
end

-- eigen bounding box of the mapped regions
function EigenMap.span(): (number, number, number, number)
	return EX0, EX1, EY0, EY1
end

function EigenMap.center(): (number, number)
	return CENTER_EX, CENTER_EY
end

function EigenMap.worldFromEigen(ex: number, ey: number): (number, number)
	return EigenMap.PLAZA_X + (ex - CENTER_EX) * EigenMap.STUDS_PER_UNIT,
		EigenMap.PLAZA_Z + (ey - CENTER_EY) * EigenMap.STUDS_PER_UNIT
end

function EigenMap.eigenFromWorld(wx: number, wz: number): (number, number)
	return CENTER_EX + (wx - EigenMap.PLAZA_X) / EigenMap.STUDS_PER_UNIT,
		CENTER_EY + (wz - EigenMap.PLAZA_Z) / EigenMap.STUDS_PER_UNIT
end

-- distance between two mapped regions, in raw eigen units
function EigenMap.distEigen(a: string, b: string): number
	local ra, rb = row(a), row(b)
	local dx, dy = rb.ex - ra.ex, rb.ey - ra.ey
	return math.sqrt(dx * dx + dy * dy)
end

-- bearing from region a to region b, degrees 0..360, 0 = N, clockwise
function EigenMap.bearingEigen(a: string, b: string): number
	local ra, rb = row(a), row(b)
	return bearingXY(rb.ex - ra.ex, rb.ey - ra.ey)
end

-- distance from an arbitrary eigen point (e.g. the walker's projected
-- position) to a mapped region, in raw eigen units
function EigenMap.distFromEigen(name: string, ex: number, ey: number): number
	local r = row(name)
	local dx, dy = r.ex - ex, r.ey - ey
	return math.sqrt(dx * dx + dy * dy)
end

function EigenMap.bearingFromEigen(name: string, ex: number, ey: number): number
	local r = row(name)
	return bearingXY(r.ex - ex, r.ey - ey)
end

-- nearest mapped region to an eigen point (the receiver read)
function EigenMap.nearestEigen(ex: number, ey: number): (string, number)
	local bestName, bestSq = "", math.huge
	for _, r in ipairs(REGIONS) do
		local dx, dy = r.ex - ex, r.ey - ey
		local sq = dx * dx + dy * dy
		if sq < bestSq then
			bestName, bestSq = r.name, sq
		end
	end
	return bestName, math.sqrt(bestSq)
end

-- the water_first chain over mapped regions (operative lean), each segment
-- stamped by the wired graph: "wired" = cross-region exit exists, "missing"
-- = the descent demands an edge that does not (build debt), "via" =
-- reachable through wired hops (carries the intermediate region list)
function EigenMap.chain(): { ChainSeg }
	return CHAIN
end

-- regions of the cathedral world with no eigen centroid (a negative is a
-- fact; they are recorded, not silently dropped)
function EigenMap.offMap(): { string }
	return OFF_MAP
end

-- beta0 of the wired world vs the intended graph (the scan's 3-islands
-- finding until the river-ford loop is hand-wired)
function EigenMap.beta0(): (number, number)
	return BETA0_WIRED, BETA0_INTENDED
end

function EigenMap.scanStamp(): (string, string)
	return SCAN_TS, SCAN_SHA256
end

-- studs per milli-eigen (1 milli-eigen = 0.001 eigen units)
function EigenMap.studsPerMilli(): number
	return EigenMap.STUDS_PER_UNIT / 1000
end

-- ---- Roblox adapters (Vector3 / Color3 live only below this line) ----

function EigenMap.worldPos(name: string): Vector3
	local r = row(name)
	local wx, wz = EigenMap.worldFromEigen(r.ex, r.ey)
	return Vector3.new(wx, EigenMap.FLOOR_Y, wz)
end

function EigenMap.distFrom(name: string, pos: Vector3): number
	local ex, ey = EigenMap.eigenFromWorld(pos.X, pos.Z)
	return EigenMap.distFromEigen(name, ex, ey)
end

function EigenMap.bearingFrom(name: string, pos: Vector3): number
	local ex, ey = EigenMap.eigenFromWorld(pos.X, pos.Z)
	return EigenMap.bearingFromEigen(name, ex, ey)
end

function EigenMap.nearest(pos: Vector3): (string, number)
	local ex, ey = EigenMap.eigenFromWorld(pos.X, pos.Z)
	return EigenMap.nearestEigen(ex, ey)
end

-- class palette = the HTML map's law (tools/cathedral_eigen_map.py
-- CLASS_COLOR): SADDLE amber, DARK violet, HILL green
function EigenMap.classColor(cls: string): Color3
	if cls == "SADDLE" then
		return Color3.fromRGB(217, 164, 65)
	elseif cls == "DARK" then
		return Color3.fromRGB(91, 75, 138)
	elseif cls == "HILL" then
		return Color3.fromRGB(76, 154, 106)
	end
	return Color3.fromRGB(136, 136, 136)
end

return EigenMap
