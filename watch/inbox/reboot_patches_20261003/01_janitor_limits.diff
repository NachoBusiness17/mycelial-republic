diff --git a/mag/janitor_governor.py b/mag/janitor_governor.py
new file mode 100644
index 000000000..f621e2a40
--- /dev/null
+++ b/mag/janitor_governor.py
@@ -0,0 +1,296 @@
+"""janitor_governor - limits on the ghost autonomous janitor (reboot patch 01, 2026-10-03).
+
+Why (watch/inbox/ractor_engine/2026-10-03-grokbot-estate/SYNTHESIS.md step 1,
+watch/inbox/JANITOR_FIX_PLAN_20261003.md items b and c): the janitor loop
+(mag/ghost.py autonomous_task_loop) has no off switch, no failure memory and
+no spend cap. Every orchestrator child crashed at import since 2026-09-26
+(373+ failed janitor tasks); un-damming that crash without a governor turns
+free crashes into metered deepseek calls.
+
+Limits, all checked before a quest is spawned:
+  1. Off switch: state/janitor.off (stop file) or MAG_JANITOR_DISABLED=1.
+  2. STUCK after N consecutive failures per signature (default 3). A stuck
+     signature never spawns again until an operator clears it
+     (python -m mag.janitor_governor clear <sig>).
+  3. Re-arm only on fresh recurrence: after a failed attempt, a signature is
+     retried only when its occurrence count rose since that attempt.
+  4. Daily spawn cap (default 12 per UTC day, MAG_JANITOR_MAX_PER_DAY).
+  5. Paid-provider gate: quests routed to a paid provider are downgraded to
+     the local tier unless MAG_JANITOR_ALLOW_PAID=1.
+
+Outcomes: spawned tasks are tracked as pending and reconciled against the
+orchestrator task record when they reach a terminal status. done counts as
+success only when the quest output file exists and is non-empty; anything
+else is a failure. reconcile() accepts an on_success callback so the caller
+can do the success-only side effects (patch 03 folds the Verkle knot there).
+
+State: memory/runs/ghost/janitor_governor.json (one small JSON document).
+CLI:   python -m mag.janitor_governor status|disable|enable|clear <sig>|clear-all
+"""
+from __future__ import annotations
+
+import json
+import os
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Callable
+
+ROOT = Path(__file__).resolve().parent.parent
+STATE_PATH = ROOT / "memory" / "runs" / "ghost" / "janitor_governor.json"
+STOP_FILE = ROOT / "state" / "janitor.off"
+
+STUCK_AFTER = 3
+DEFAULT_MAX_PER_DAY = 12
+PAID_PROVIDERS = frozenset({"deepseek", "openai", "anthropic", "xai", "grok", "openrouter", "gemini", "google"})
+LOCAL_PROVIDER = "ollama"
+LOCAL_MODEL = "qwen2.5-coder:7b"
+# Must cover every terminal status mag/orchestrator.py can write (its TERMINAL:
+# done, failed, timeout, stalled, killed, died). Ractor 2026-10-04: "died" and
+# "stalled" were missing, so such a task sat pending for PENDING_MAX_AGE_S and
+# blocked its signature ("attempt still pending") for 6 h before settling.
+TERMINAL = frozenset({"done", "failed", "timeout", "stalled", "killed", "died", "error", "cancelled"})
+PENDING_MAX_AGE_S = 6 * 3600  # a pending task with no terminal record after this is a failure
+
+
+def _now() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+def _iso(d: datetime | None = None) -> str:
+    return (d or _now()).isoformat()
+
+
+def _empty() -> dict[str, Any]:
+    return {"schema": "janitor_governor.v1", "sigs": {}, "pending": {}, "day": "", "spawned_today": 0}
+
+
+def load_state(path: Path | None = None) -> dict[str, Any]:
+    p = path or STATE_PATH
+    try:
+        data = json.loads(p.read_text(encoding="utf-8"))
+        if isinstance(data, dict):
+            base = _empty()
+            base.update(data)
+            return base
+    except (OSError, ValueError):
+        pass
+    return _empty()
+
+
+def save_state(state: dict[str, Any], path: Path | None = None) -> None:
+    p = path or STATE_PATH
+    p.parent.mkdir(parents=True, exist_ok=True)
+    tmp = p.with_suffix(".json.tmp")
+    tmp.write_text(json.dumps(state, indent=1, sort_keys=True, default=str), encoding="utf-8")
+    os.replace(tmp, p)
+
+
+def max_per_day() -> int:
+    try:
+        return max(0, int(os.environ.get("MAG_JANITOR_MAX_PER_DAY", DEFAULT_MAX_PER_DAY)))
+    except ValueError:
+        return DEFAULT_MAX_PER_DAY
+
+
+def is_enabled(stop_file: Path | None = None) -> tuple[bool, str]:
+    if os.environ.get("MAG_JANITOR_DISABLED", "").strip() in ("1", "true", "yes"):
+        return False, "disabled by MAG_JANITOR_DISABLED"
+    if (stop_file or STOP_FILE).exists():
+        return False, f"disabled by stop file {(stop_file or STOP_FILE).name}"
+    return True, "enabled"
+
+
+def _roll_day(state: dict[str, Any]) -> None:
+    today = _now().strftime("%Y-%m-%d")
+    if state.get("day") != today:
+        state["day"] = today
+        state["spawned_today"] = 0
+
+
+def allow(state: dict[str, Any], sig: str, count: int | None = None) -> tuple[bool, str]:
+    """May a quest for `sig` spawn now? Pure check on the loaded state."""
+    _roll_day(state)
+    if int(state.get("spawned_today", 0)) >= max_per_day():
+        return False, f"daily cap reached ({max_per_day()})"
+    for meta in (state.get("pending") or {}).values():
+        if meta.get("sig") == sig:
+            return False, "attempt still pending"
+    row = (state.get("sigs") or {}).get(sig) or {}
+    if row.get("stuck"):
+        return False, f"STUCK after {row.get('fail_count', 0)} consecutive failures (operator clear required)"
+    if row.get("fail_count", 0) > 0 and count is not None and row.get("last_count") is not None:
+        if int(count) <= int(row["last_count"]):
+            return False, "no fresh recurrence since last failed attempt"
+    return True, "ok"
+
+
+def apply_provider_gate(quest: dict[str, Any]) -> dict[str, Any]:
+    """Downgrade a paid-provider quest to the local tier unless paid is allowed."""
+    if os.environ.get("MAG_JANITOR_ALLOW_PAID", "").strip() in ("1", "true", "yes"):
+        return quest
+    if str(quest.get("provider", "")).lower() in PAID_PROVIDERS:
+        quest = dict(quest)
+        quest["paid_downgraded_from"] = f"{quest.get('provider')}/{quest.get('model')}"
+        quest["provider"] = LOCAL_PROVIDER
+        quest["model"] = LOCAL_MODEL
+    return quest
+
+
+def record_spawn(state: dict[str, Any], quest: dict[str, Any], result: dict[str, Any],
+                 count: int | None = None) -> None:
+    _roll_day(state)
+    sig = str(quest.get("sig", "?"))
+    state["spawned_today"] = int(state.get("spawned_today", 0)) + 1
+    row = state.setdefault("sigs", {}).setdefault(sig, {"fail_count": 0, "stuck": False})
+    row["last_attempt"] = _iso()
+    if count is not None:
+        row["last_count"] = int(count)
+    task_id = str(result.get("task_id") or "")
+    if result.get("outcome") == "spawned" and task_id and task_id != "?":
+        state.setdefault("pending", {})[task_id] = {
+            "sig": sig,
+            "quest_id": quest.get("id", "?"),
+            "output": quest.get("output", ""),
+            "ts": _iso(),
+        }
+    else:
+        record_outcome(state, sig, ok=False, reason=f"spawn outcome {result.get('outcome')}")
+
+
+def record_outcome(state: dict[str, Any], sig: str, *, ok: bool, reason: str = "") -> dict[str, Any]:
+    row = state.setdefault("sigs", {}).setdefault(sig, {"fail_count": 0, "stuck": False})
+    row["last_outcome"] = "ok" if ok else "fail"
+    row["last_reason"] = reason[:200]
+    row["last_outcome_ts"] = _iso()
+    if ok:
+        row["fail_count"] = 0
+        row["stuck"] = False
+    else:
+        row["fail_count"] = int(row.get("fail_count", 0)) + 1
+        if row["fail_count"] >= STUCK_AFTER:
+            row["stuck"] = True
+    return row
+
+
+def output_ok(rel_path: str) -> bool:
+    if not rel_path:
+        return False
+    p = ROOT / rel_path
+    try:
+        return p.is_file() and p.stat().st_size > 0
+    except OSError:
+        return False
+
+
+def _default_status(task_id: str) -> dict[str, Any] | None:
+    from mag.orchestrator import task_status
+    return task_status(task_id)
+
+
+def reconcile(state: dict[str, Any], *,
+              status_fn: Callable[[str], dict[str, Any] | None] | None = None,
+              on_success: Callable[[str, dict[str, Any]], None] | None = None,
+              on_failure: Callable[[str, dict[str, Any], str], None] | None = None) -> list[dict[str, Any]]:
+    """Settle pending janitor tasks that reached a terminal status.
+
+    Success = status done AND the quest output file exists and is non-empty.
+    Returns the list of settled rows (for the caller's trail)."""
+    status_fn = status_fn or _default_status
+    settled: list[dict[str, Any]] = []
+    pending = state.setdefault("pending", {})
+    for task_id in list(pending):
+        meta = pending[task_id]
+        try:
+            t = status_fn(task_id) or {}
+        except Exception as e:  # noqa: BLE001 - a status read never crashes the loop
+            t = {"status": "?", "error": str(e)[:120]}
+        status = str(t.get("status") or "")
+        age_s = 0.0
+        try:
+            age_s = (_now() - datetime.fromisoformat(str(meta.get("ts")))).total_seconds()
+        except (TypeError, ValueError):
+            pass
+        if status not in TERMINAL and age_s < PENDING_MAX_AGE_S:
+            continue
+        ok = status == "done" and output_ok(str(meta.get("output", "")))
+        if ok:
+            reason = "done with non-empty output"
+        elif status == "done":
+            reason = "done but output file missing or empty"
+        elif status in TERMINAL:
+            reason = f"status {status}"
+        else:
+            reason = f"no terminal status after {int(age_s)}s"
+        row = record_outcome(state, str(meta.get("sig", "?")), ok=ok, reason=reason)
+        del pending[task_id]
+        rec = {"task_id": task_id, **meta, "status": status or "?", "ok": ok, "reason": reason,
+               "stuck": bool(row.get("stuck"))}
+        settled.append(rec)
+        try:
+            if ok and on_success:
+                on_success(task_id, rec)
+            elif not ok and on_failure:
+                on_failure(task_id, rec, reason)
+        except Exception:  # noqa: BLE001 - callbacks are best-effort
+            pass
+    return settled
+
+
+def clear(state: dict[str, Any], sig: str | None = None) -> int:
+    sigs = state.setdefault("sigs", {})
+    if sig is None:
+        n = len(sigs)
+        sigs.clear()
+        return n
+    return 1 if sigs.pop(sig, None) is not None else 0
+
+
+def status_report(state: dict[str, Any] | None = None) -> dict[str, Any]:
+    st = state if state is not None else load_state()
+    en, why = is_enabled()
+    return {
+        "enabled": en,
+        "why": why,
+        "day": st.get("day"),
+        "spawned_today": st.get("spawned_today", 0),
+        "max_per_day": max_per_day(),
+        "stuck": sorted(s for s, r in (st.get("sigs") or {}).items() if r.get("stuck")),
+        "pending": len(st.get("pending") or {}),
+        "sigs": st.get("sigs") or {},
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = list(sys.argv[1:] if argv is None else argv)
+    verb = args[0] if args else "status"
+    st = load_state()
+    if verb == "status":
+        print(json.dumps(status_report(st), indent=2, sort_keys=True))
+        return 0
+    if verb == "disable":
+        STOP_FILE.parent.mkdir(parents=True, exist_ok=True)
+        STOP_FILE.write_text(f"disabled {_iso()}\n", encoding="utf-8")
+        print(f"janitor disabled ({STOP_FILE})")
+        return 0
+    if verb == "enable":
+        if STOP_FILE.exists():
+            STOP_FILE.unlink()
+        print("janitor stop file removed")
+        return 0
+    if verb == "clear" and len(args) > 1:
+        n = clear(st, args[1])
+        save_state(st)
+        print(f"cleared {n}")
+        return 0
+    if verb == "clear-all":
+        n = clear(st, None)
+        save_state(st)
+        print(f"cleared {n}")
+        return 0
+    print("usage: python -m mag.janitor_governor status|disable|enable|clear <sig>|clear-all")
+    return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
