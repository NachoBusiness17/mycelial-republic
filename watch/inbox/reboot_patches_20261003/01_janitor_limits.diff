+def test_reconcile_success_needs_done_and_nonempty_output(gov):
+    st = jg.load_state()
+    (gov / "out_ok.md").write_text("diagnosis", encoding="utf-8")
+    (gov / "out_empty.md").write_text("", encoding="utf-8")
+    for tid, out in (("a", "out_ok.md"), ("b", "out_empty.md"), ("c", "out_ok.md")):
+        jg.record_spawn(st, {"sig": f"sig-{tid}", "id": tid, "output": out},
+                        {"outcome": "spawned", "task_id": tid})
+    statuses = {"a": "done", "b": "done", "c": "failed"}
+    wins: list[str] = []
+    settled = jg.reconcile(st, status_fn=lambda t: {"status": statuses[t]},
+                           on_success=lambda t, rec: wins.append(t))
+    assert {r["task_id"]: r["ok"] for r in settled} == {"a": True, "b": False, "c": False}
+    assert wins == ["a"]
+    assert st["pending"] == {}
+
