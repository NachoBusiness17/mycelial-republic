+def test_stuck_after_three_failures_spawns_nothing(gov, monkeypatch, tmp_path):
+    st = jg.load_state()
+    for _ in range(3):
+        jg.record_outcome(st, "fkb:zz_test:abc123", ok=False, reason="status failed")
+    jg.save_state(st)
+    ok, reason = jg.allow(jg.load_state(), "fkb:zz_test:abc123", 99)
+    assert not ok and "STUCK" in reason
+    spawned, _f, _e, rows = _run_one_cycle(monkeypatch, tmp_path, FKB)
+    assert spawned == []
+    assert any("STUCK" in r.get("note", "") for r in rows)
+    st = jg.load_state()
+    assert jg.clear(st, "fkb:zz_test:abc123") == 1
+    assert jg.allow(st, "fkb:zz_test:abc123", 99)[0]
