+def test_terminal_covers_every_orchestrator_terminal_status(gov):
+    """Ractor 2026-10-04: a died/stalled task must settle now, not after 6 h."""
+    from mag import orchestrator
+    assert set(orchestrator.TERMINAL) <= set(jg.TERMINAL)
+    st = jg.load_state()
+    for tid in ("d1", "s1"):
+        jg.record_spawn(st, {"sig": f"sig-{tid}", "id": tid, "output": "o"},
+                        {"outcome": "spawned", "task_id": tid})
+    statuses = {"d1": "died", "s1": "stalled"}
+    settled = jg.reconcile(st, status_fn=lambda t: {"status": statuses[t]})
+    assert {r["task_id"]: (r["ok"], r["reason"]) for r in settled} == {
+        "d1": (False, "status died"), "s1": (False, "status stalled")}
+    assert st["pending"] == {}
