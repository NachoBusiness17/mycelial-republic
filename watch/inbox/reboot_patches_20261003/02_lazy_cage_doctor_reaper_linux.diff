+def _linux_project_python_procs() -> list[dict[str, Any]]:
+    """Linux path (reboot patch 02, 2026-10-03): read /proc, no powershell.
+
+    In the mag-sovereign cage the Windows enumerator logged
+    reaper-enumerate-error on every call (1,056 rows on 2026-10-03), so the
+    reaper was blind there. A process counts as ours when argv[0] is a python
+    and its command line names the project/venv OR its cwd is the project root
+    (cage children run `python main.py ...` from /app)."""
+    out: list[dict[str, Any]] = []
+    project = str(ROOT)
+    # Never list the container init (pid 1: mag_launch.py) or this process and
+    # its parent; the Windows-era classifier would bucket them as leaks.
+    skip = {1, os.getpid(), os.getppid()}
+    try:
+        entries = [p for p in _PROC_ROOT.iterdir() if p.name.isdigit() and int(p.name) not in skip]
+    except OSError as e:
+        _log("reaper-enumerate-error", error=f"proc unreadable: {e}"[:160])
+        return out
+    for p in entries:
+        try:
+            raw = (p / "cmdline").read_bytes()
+        except OSError:
+            continue  # exited between listdir and read
+        if not raw:
+            continue  # kernel thread or zombie
+        argv = [a.decode("utf-8", "replace") for a in raw.rstrip(b"\0").split(b"\0")]
+        if not os.path.basename(argv[0]).lower().startswith("python"):
+            continue
+        cl = " ".join(argv).strip()
+        cwd = _proc_cwd(p)
+        ours = ("local_sovereign_agent" in cl or ".venv" in cl
+                or cwd == project or cwd.startswith(project.rstrip("/") + "/"))
+        if not ours:
+            continue
+        out.append({"pid": int(p.name), "cmdline": cl[:400]})
+    return out
+
