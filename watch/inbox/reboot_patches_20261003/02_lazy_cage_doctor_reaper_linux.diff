diff --git a/tests/test_health_lazy_import.py b/tests/test_health_lazy_import.py
new file mode 100644
index 000000000..173f78f6e
--- /dev/null
+++ b/tests/test_health_lazy_import.py
@@ -0,0 +1,99 @@
+"""Reboot patch 02: mag.health imports where powershell does not exist; reaper sees Linux procs."""
+from __future__ import annotations
+
+import subprocess
+import sys
+import textwrap
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+# Simulate the Linux cage: no powershell on PATH, no System32 candidates,
+# sys.platform reports linux. Before patch 02 this raised FileNotFoundError
+# at `import mag.health` (health.py:25-27).
+_SIM = textwrap.dedent("""
+    import shutil, sys
+    shutil.which = lambda *a, **k: None
+    import mag.win_powershell as w
+    w._CANDIDATES = ("/nonexistent/WindowsPowerShell/powershell.exe",)
+    w.powershell_exe.cache_clear()
+    sys.platform = "linux"
+    import mag.health as h
+    assert h.CAGE_DOCTOR.startswith("powershell -NoProfile"), h.CAGE_DOCTOR
+    assert h.reconnect_plan()["cage_cli"].endswith("mag_exec.ps1 doctor")
+    from mag.health import sanity, in_mag_cage, catch_up  # the context_pack / guard imports
+    import mag.lifecycle, mag.window_audit  # call-time resolution only
+    print("IMPORT_OK")
+""")
+
+
+def test_import_mag_health_without_powershell() -> None:
+    r = subprocess.run([sys.executable, "-c", _SIM], cwd=str(ROOT), capture_output=True,
+                       text=True, timeout=120)
+    assert r.returncode == 0, r.stderr[-2000:]
+    assert "IMPORT_OK" in r.stdout
+
+
+def test_cage_doctor_still_absolute_when_resolvable(monkeypatch) -> None:
+    import mag.health as h
+    monkeypatch.setattr(h, "powershell_exe", lambda: r"C:\\PS\\powershell.exe")
+    assert h.CAGE_DOCTOR.startswith(r"C:\\PS\\powershell.exe -NoProfile")
+    assert h.reconnect_plan()["cage_cli"] == h.CAGE_DOCTOR
+
+
+def test_no_import_time_powershell_calls() -> None:
+    """Static guard: powershell_exe() is never called at module level."""
+    import ast
+    for rel in ("mag/health.py", "mag/lifecycle.py", "mag/window_audit.py", "mag/guard.py"):
+        tree = ast.parse((ROOT / rel).read_text(encoding="utf-8"))
+        for node in tree.body:
+            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
+                continue
+            for sub in ast.walk(node):
+                if isinstance(sub, ast.Call) and getattr(sub.func, "id", "") == "powershell_exe":
+                    raise AssertionError(f"{rel}:{sub.lineno} calls powershell_exe() at import time")
+
+
+def test_reaper_linux_path_reads_proc(tmp_path, monkeypatch) -> None:
+    import mag.process_reaper as pr
+
+    def mk(pid: int, argv: list[str]) -> None:
+        d = tmp_path / str(pid)
+        d.mkdir()
+        (d / "cmdline").write_bytes(b"\0".join(a.encode() for a in argv) + b"\0")
+
+    mk(10, ["python", "main.py", "agent", "--query", "x"])        # cwd = project root
+    mk(11, ["/usr/bin/python3", "/opt/other/tool.py"])            # foreign python
+    mk(12, ["bash", "-c", "sleep 1"])                             # not python
+    mk(13, [])                                                    # kernel thread
+    (tmp_path / "self").mkdir()
+    cwds = {"10": str(pr.ROOT), "11": "/opt/other"}
+    monkeypatch.setattr(pr, "_PROC_ROOT", tmp_path)
+    monkeypatch.setattr(pr, "_proc_cwd", lambda p: cwds.get(p.name, ""))
+    monkeypatch.setattr(sys, "platform", "linux")
+    got = pr._project_python_procs()
+    assert [g["pid"] for g in got] == [10]
+    assert got[0]["cmdline"].startswith("python main.py agent")
+
+
+def test_reaper_linux_skips_init_and_refuses_live_by_default(tmp_path, monkeypatch) -> None:
+    import mag.process_reaper as pr
+
+    for pid in (1, 20):
+        d = tmp_path / str(pid)
+        d.mkdir()
+        (d / "cmdline").write_bytes(b"python\0mag_launch.py\0" if pid == 1 else b"python\0stray.py\0")
+    monkeypatch.setattr(pr, "_PROC_ROOT", tmp_path)
+    monkeypatch.setattr(pr, "_proc_cwd", lambda p: str(pr.ROOT))
+    monkeypatch.setattr(sys, "platform", "linux")
+    monkeypatch.delenv("MAG_REAPER_LINUX_LIVE", raising=False)
+    logged: list[str] = []
+    monkeypatch.setattr(pr, "_log", lambda ev, **m: logged.append(ev))
+    monkeypatch.setattr(pr, "_supervised_pids", lambda: set())
+    monkeypatch.setattr(pr, "_task_pids", lambda: set())
+    kills: list[int] = []
+    monkeypatch.setattr(pr.os, "kill", lambda pid, sig: kills.append(pid))
+    res = pr.run(live=True, grace_s=0)
+    assert [l["pid"] for l in res["leaks"]] == [20]  # pid 1 never listed
+    assert res["live"] is False and kills == []
+    assert "reaper-live-refused" in logged
