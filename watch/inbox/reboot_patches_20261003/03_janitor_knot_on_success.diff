+def _fold_janitor_knot(task_id: str, rec: dict[str, Any]) -> None:
+    """Fold a SUCCESSFUL janitor task into the Verkle chain (reboot patch 03).
+
+    Called by janitor_governor.reconcile only when the orchestrator task is
+    done AND the quest output file exists and is non-empty. The old fold ran
+    at spawn time (mag/ghost.py:1472/1506 before this patch), so every failed
+    task became a knot (the canonical tip became a failed-task knot) and a
+    false "autonomous_task_completed" event went out. tension_index now carries
+    the full signature, not an 8-char prefix (JANITOR_FIX_PLAN item e)."""
+    from mag.verkle_knot import append_verkle_knot
+    sig = str(rec.get("sig", "?"))
+    dossier = {
+        "session_id": f"autonomous-{rec.get('quest_id', '?')}",
+        "time": {
+            "created_at": {"iso_minute": str(rec.get("ts") or _now()), "unix_minute": None, "date": None},
+            "updated_at": {"iso_minute": _now(), "unix_minute": None, "date": None},
+        },
+        "scalar_knot": {
+            "duration_minutes": 0.1,
+            "tension_index": sig,
+            "residual_weight": 1.0,
+            "theme_vector": {
+                "dominant": "autonomous_janitor",
+                "basis": ["mag_hands", "harness", "biography", "constitution"],
+                "raw": [1.0, 0.5, 0.3, 0.0],
+                "normalized": [1.0, 0.5, 0.3, 0.0],
+            },
+        },
+        "content_commit": {"hex": str(task_id)[:8]},
+    }
+    try:
+        fold_result = append_verkle_knot(dossier)
+        if fold_result is None or (isinstance(fold_result, dict) and fold_result.get("ok") is False):
+            print(f"[verkle] WARNING: janitor fold refused for task {task_id}: "
+                  f"{(fold_result or {}).get('error', 'returned None')}", flush=True)
+            return
+    except Exception as _ve:
+        print(f"[verkle] FOLD-SWALLOW GUARD: append_verkle_knot failed: {_ve}", flush=True)
+        return
+    try:
+        from mag.verkle_bus import publish as bus_publish, CH_TASK
+        asyncio.ensure_future(bus_publish(CH_TASK, {
+            "type": "autonomous_task_completed",
+            "quest_id": rec.get("quest_id", "?"),
+            "sig": sig,
+            "task_id": task_id,
+            "outcome": "done",
+            "output": rec.get("output", ""),
+            "ts": _now(),
+        }))
+    except Exception:
+        pass
+
