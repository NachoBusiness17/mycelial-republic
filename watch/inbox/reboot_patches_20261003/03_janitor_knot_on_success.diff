@@ -0,0 +1,123 @@
+"""Reboot patch 03: the janitor Verkle knot is folded at task completion, only on success."""
+from __future__ import annotations
+
+import asyncio
+import json
+import sys
+import types
+from pathlib import Path
+
+import pytest
+
+from mag import ghost
+from mag import janitor_governor as jg
+
+
+@pytest.fixture()
+def gov(tmp_path, monkeypatch):
+    monkeypatch.setattr(jg, "STATE_PATH", tmp_path / "gov.json")
+    monkeypatch.setattr(jg, "STOP_FILE", tmp_path / "janitor.off")
+    monkeypatch.setattr(jg, "ROOT", tmp_path)
+    monkeypatch.delenv("MAG_JANITOR_DISABLED", raising=False)
+    monkeypatch.delenv("MAG_JANITOR_ALLOW_PAID", raising=False)
+    monkeypatch.delenv("MAG_JANITOR_MAX_PER_DAY", raising=False)
+    return tmp_path
+
+
+def _run_one_cycle(monkeypatch, tmp_path, state, *, task_status=None):
+    """Drive autonomous_task_loop through exactly one cycle with every side effect faked."""
+    spawned: list[dict] = []
+    folds: list[dict] = []
+    events: list[tuple] = []
+    trail = tmp_path / "auto_trail.jsonl"
+    monkeypatch.setattr(ghost, "AUTO_TRAIL", trail)
+    monkeypatch.setattr(ghost, "_GOV_NOTES", {})
+    monkeypatch.setattr(ghost, "sense", lambda: state)
+    monkeypatch.setattr(ghost, "stall_sweep", lambda **k: {})
+    monkeypatch.setattr(ghost, "leak_detect", lambda **k: (_ for _ in ()).throw(RuntimeError("off")))
+
+    def fake_exec(quest, dry=False):
+        spawned.append(quest)
+        return {"outcome": "spawned", "task_id": f"t{len(spawned):03d}"}
+
+    monkeypatch.setattr(ghost, "exec_copilot", fake_exec)
+    import mag.verkle_knot as vk
+    monkeypatch.setattr(vk, "append_verkle_knot", lambda d: folds.append(d) or {"ok": True})
+    import mag.process_reaper as pr
+    monkeypatch.setattr(pr, "classify", lambda: {"leaks": []})
+    bus = types.ModuleType("mag.verkle_bus")
+
+    async def publish(ch, payload):
+        events.append((ch, payload))
+
+    bus.publish, bus.CH_TASK, bus.CH_VERKLE, bus.CH_COPILOT = publish, "task", "verkle", "copilot"
+    monkeypatch.setitem(sys.modules, "mag.verkle_bus", bus)
+    if task_status is not None:
+        monkeypatch.setattr(jg, "_default_status", task_status)
+
+    calls = {"n": 0}
+
+    async def fake_sleep(_s):
+        calls["n"] += 1
+        if calls["n"] > 1:
+            raise asyncio.CancelledError
+        return None
+
+    monkeypatch.setattr(ghost.asyncio, "sleep", fake_sleep)
+    app = types.SimpleNamespace(state=types.SimpleNamespace(_auto_cycle_count=0))
+
+    async def drive():
+        await ghost.autonomous_task_loop(app, interval_s=0)
+        await asyncio.gather(*[t for t in asyncio.all_tasks() if t is not asyncio.current_task()],
+                             return_exceptions=True)
+
+    asyncio.run(drive())
+    rows = [json.loads(l) for l in trail.read_text(encoding="utf-8").splitlines()] if trail.is_file() else []
+    return spawned, folds, events, rows
+
+
+FKB = {"context": {}, "fkb_signals": [{"sig": "zz_test:abc123", "count": 6}]}
+QUIET = {"context": {}, "fkb_signals": []}
+
+
+def _completed(events):
+    return [p for _ch, p in events if p.get("type") == "autonomous_task_completed"]
+
+
+def test_spawn_folds_nothing_and_emits_no_completed_event(gov, monkeypatch, tmp_path):
+    spawned, folds, events, _rows = _run_one_cycle(monkeypatch, tmp_path, FKB)
+    assert len(spawned) == 1
+    assert folds == []
+    assert _completed(events) == []
+
+
+def test_failed_task_adds_no_knot(gov, monkeypatch, tmp_path):
+    _run_one_cycle(monkeypatch, tmp_path, FKB)
+    spawned, folds, events, rows = _run_one_cycle(
+        monkeypatch, tmp_path, QUIET, task_status=lambda t: {"status": "failed"})
+    assert spawned == [] and folds == [] and _completed(events) == []
+    settled = [r for r in rows if r.get("event") == "janitor_settled"]
+    assert settled and settled[-1]["ok"] is False and settled[-1]["status"] == "failed"
+    assert jg.load_state()["sigs"]["fkb:zz_test:abc123"]["fail_count"] == 1
+
+
+def test_done_without_output_adds_no_knot(gov, monkeypatch, tmp_path):
+    _run_one_cycle(monkeypatch, tmp_path, FKB)
+    _s, folds, events, _r = _run_one_cycle(
+        monkeypatch, tmp_path, QUIET, task_status=lambda t: {"status": "done"})
+    assert folds == [] and _completed(events) == []
+
+
+def test_done_with_output_folds_once_with_full_sig(gov, monkeypatch, tmp_path):
+    _run_one_cycle(monkeypatch, tmp_path, FKB)
+    out = gov / "memory" / "runs" / "ghost" / "autonomous_fixes" / "zz_test_abc123.md"
+    out.parent.mkdir(parents=True)
+    out.write_text("root cause: ...", encoding="utf-8")
+    _s, folds, events, _r = _run_one_cycle(
+        monkeypatch, tmp_path, QUIET, task_status=lambda t: {"status": "done"})
+    assert len(folds) == 1
+    assert folds[0]["scalar_knot"]["tension_index"] == "fkb:zz_test:abc123"
+    assert folds[0]["content_commit"]["hex"] == "t001"
+    done = _completed(events)
+    assert len(done) == 1 and done[0]["outcome"] == "done"
+    assert jg.load_state()["pending"] == {}
