@@ -0,0 +1,96 @@
+"""Reboot patch 04: knot_at_close never selects workflow_child/dwf- sessions and reads the real first user text."""
+from __future__ import annotations
+
+import json
+import sqlite3
+import time
+
+import pytest
+
+from mag import knot_at_close as kac
+
+# Subset of the real ZCode db schema (checked read-only 2026-10-03).
+SCHEMA = """
+CREATE TABLE session (id text primary key, title text not null, time_created integer not null,
+  time_updated integer not null, task_type text not null default 'interactive');
+CREATE TABLE message (id text primary key, session_id text not null, time_created integer not null,
+  time_updated integer not null, data text not null);
+CREATE TABLE part (id text primary key, message_id text not null, session_id text not null,
+  time_created integer not null, time_updated integer not null, data text not null);
+"""
+
+
+@pytest.fixture()
+def db(tmp_path, monkeypatch):
+    path = tmp_path / "db.sqlite"
+    c = sqlite3.connect(path)
+    c.executescript(SCHEMA)
+    t0 = int((time.time() - 3 * 86400) * 1000)
+
+    def sess(sid, task_type, user_text):
+        c.execute("INSERT INTO session VALUES (?,?,?,?,?)", (sid, f"title {sid}", t0, t0 + 60000, task_type))
+        c.execute("INSERT INTO message VALUES (?,?,?,?,?)",
+                  (f"{sid}-m0", sid, t0 + 1, t0 + 1, json.dumps({"role": "assistant"})))
+        c.execute("INSERT INTO part VALUES (?,?,?,?,?,?)",
+                  (f"{sid}-p0", f"{sid}-m0", sid, t0 + 1, t0 + 1, json.dumps({"type": "text", "text": "assistant first"})))
+        c.execute("INSERT INTO message VALUES (?,?,?,?,?)",
+                  (f"{sid}-m1", sid, t0 + 2, t0 + 2, json.dumps({"role": "user"})))
+        c.execute("INSERT INTO part VALUES (?,?,?,?,?,?)",
+                  (f"{sid}-p1", f"{sid}-m1", sid, t0 + 2, t0 + 2, json.dumps({"type": "file", "url": "x"})))
+        c.execute("INSERT INTO part VALUES (?,?,?,?,?,?)",
+                  (f"{sid}-p2", f"{sid}-m1", sid, t0 + 3, t0 + 3, json.dumps({"type": "text", "text": user_text})))
+
+    sess("sess_real01", "interactive", "fix the janitor key=abcdefghijklmnop please")
+    sess("sess_dwf-dwfrun-aa-actor_1_2", "workflow_child", "actor prompt")
+    sess("sess_wfchild02", "workflow_child", "workflow child without dwf prefix")
+    sess("sess_sub03", "subagent_child", "subagent prompt")
+    c.commit()
+    c.close()
+    chain = tmp_path / "verkle_chain.jsonl"
+    chain.write_text("", encoding="utf-8")
+    monkeypatch.setattr(kac, "DB", path)
+    monkeypatch.setattr(kac.vk, "CHAIN", chain)
+    return path
+
+
+def _rows(path, **kw):
+    conn = sqlite3.connect(f"file:{path.as_posix()}?mode=ro", uri=True)
+    try:
+        return kac._db_rows(conn, int(time.time() * 1000), **kw)
+    finally:
+        conn.close()
+
+
+def test_old_first_message_query_cannot_run_on_real_schema(db):
+    conn = sqlite3.connect(db)
+    with pytest.raises(sqlite3.OperationalError):
+        conn.execute("SELECT content FROM message WHERE session_id = ? AND is_sidechain = 0", ("x",))
+    conn.close()
+
+
+def test_workflow_children_dropped_by_default(db):
+    ids = {r["session_id"] for r in _rows(db)}
+    assert ids == {"real01", "sub03"}
+    ids_all = {r["session_id"] for r in _rows(db, include_workflow_children=True)}
+    assert {"dwf-dwfrun-aa-actor_1_2", "wfchild02"} <= ids_all
+
+
+def test_first_user_excerpt_is_real_text_and_redacted(db):
+    row = next(r for r in _rows(db) if r["session_id"] == "real01")
+    assert row["first_user_excerpt"].startswith("fix the janitor")
+    assert "abcdefghijklmnop" not in row["first_user_excerpt"]
+    assert "[redacted]" in row["first_user_excerpt"]
+    assert row["n_msgs"] == 2
+
+
+def test_report_lists_zero_dwf_candidates(db, capsys):
+    assert kac.main([]) == 0
+    out = capsys.readouterr().out
+    assert "dwfrun" not in out and "wfchild" not in out
+    assert "ended >2.0h with no chain row: 2" in out
+
+
+def test_backfill_with_nothing_to_knot_takes_no_backup(db, tmp_path, capsys):
+    assert kac.main(["--backfill", "--skip-subagents", "--min-messages", "5"]) == 0
+    assert "NOTHING TO KNOT" in capsys.readouterr().out
+    assert list(tmp_path.glob("*.bak-orphanlane-*")) == []
