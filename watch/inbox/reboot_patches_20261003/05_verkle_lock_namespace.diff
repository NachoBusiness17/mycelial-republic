+# NAMESPACE-AWARE OWNER CHECK (reboot patch 05, 2026-10-03). memory/ is
+# bind-mounted into mag-sovereign, so the host (Windows) and the cage (Linux
+# pid namespace) contend for this same lock file. A PID written by one side is
+# meaningless on the other: the old probe could call a live cage holder dead
+# (no host pid with that number) and break its lock mid-rewrite, or keep a
+# dead holder's lock. On Windows os.kill(pid, 0) is not a probe at all:
+# signal 0 == CTRL_C_EVENT, routed to GenerateConsoleCtrlEvent, which returned
+# success even for an already-dead pid (measured 2026-10-04, isolated console),
+# so a same-host dead holder was never detected. So the marker now records
+# "<pid> <iso-ts> <host>|<pid-namespace>", and the PID is probed only when the
+# marker was written in OUR namespace, with a probe that never signals. A
+# foreign or legacy (untagged) marker is broken only on mtime staleness.
+def _lock_identity() -> str:
+    host = (socket.gethostname() or "unknown-host").replace(" ", "_")
+    if sys.platform == "win32":
+        ns = "win"
+    else:
+        try:
+            ns = os.readlink("/proc/self/ns/pid")
+        except OSError:
+            ns = "posix"
+    return f"{host}|{ns}".replace(" ", "_")
+
+
+def _local_pid_alive(pid: int) -> bool | None:
+    """True alive, False gone, None unknown. Never signals the process."""
+    try:
+        import psutil  # type: ignore
+
+        return bool(psutil.pid_exists(pid))
+    except ImportError:
+        pass
+    except Exception:
+        return None
+    if sys.platform == "win32":
+        try:
+            import ctypes
+
+            k32 = ctypes.windll.kernel32
+            handle = k32.OpenProcess(0x1000, False, int(pid))  # PROCESS_QUERY_LIMITED_INFORMATION
+            if not handle:
+                err = k32.GetLastError()
+                return False if err == 87 else (True if err == 5 else None)
+            try:
+                code = ctypes.c_ulong()
+                if not k32.GetExitCodeProcess(handle, ctypes.byref(code)):
+                    return None
+                return code.value == 259  # STILL_ACTIVE
+            finally:
+                k32.CloseHandle(handle)
+        except Exception:
+            return None
+    try:
+        os.kill(pid, 0)
+        return True
+    except ProcessLookupError:
+        return False
+    except PermissionError:
+        return True
+    except OSError:
+        return None
+
+
+def _parse_lock(text: str) -> tuple[int, str | None]:
+    parts = text.split()
+    try:
+        owner = int(parts[0])
+    except (ValueError, IndexError):
+        owner = 0
+    ident = parts[2] if len(parts) >= 3 else None
+    return owner, ident
+
+
+def _lock_owner_dead(text: str) -> bool:
+    """True only when the marker is ours-namespace AND its pid is provably gone."""
+    owner, ident = _parse_lock(text)
+    if not owner or owner == os.getpid():
+        return False
+    if ident != _lock_identity():
+        return False  # foreign or legacy marker: pid means nothing here; mtime decides
+    return _local_pid_alive(owner) is False
+
+
