@@ -0,0 +1,97 @@
+"""Reboot patch 05: a lock written in another pid namespace is never judged by a local pid probe."""
+from __future__ import annotations
+
+import os
+import sys
+import time
+from datetime import datetime, timezone
+
+import pytest
+
+from mag import verkle_knot as vk
+
+
+@pytest.fixture()
+def lock(tmp_path, monkeypatch):
+    p = tmp_path / ".verkle.lock"
+    monkeypatch.setattr(vk, "LOCK", p)
+    monkeypatch.setattr(vk, "_LOCK_POLL_SECONDS", 0.01)
+    return p
+
+
+def _ts() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+def test_marker_carries_namespace_identity(lock):
+    seen = {}
+    with vk.verkle_lock(timeout=1):
+        seen["text"] = lock.read_text(encoding="utf-8")
+    owner, ident = vk._parse_lock(seen["text"])
+    assert owner == os.getpid()
+    assert ident == vk._lock_identity() and "|" in ident
+
+
+def test_foreign_namespace_lock_is_not_broken_by_pid_probe(lock, monkeypatch):
+    # A cage writer (pid 57 in its own namespace) holds the lock; pid 57 means
+    # nothing on this side. The old probe would declare it dead and break it.
+    lock.write_text(f"57 {_ts()} 0a1b2c3d4e5f|pid:[4026532999]", encoding="utf-8")
+    monkeypatch.setattr(vk, "_local_pid_alive", lambda pid: pytest.fail("foreign pid must not be probed"))
+    with pytest.raises(TimeoutError):
+        with vk.verkle_lock(timeout=0.2):
+            pass
+    assert lock.exists()
+
+
+def test_legacy_untagged_lock_is_treated_as_foreign(lock, monkeypatch):
+    lock.write_text(f"99999999 {_ts()}", encoding="utf-8")
+    monkeypatch.setattr(vk, "_local_pid_alive", lambda pid: pytest.fail("legacy pid must not be probed"))
+    with pytest.raises(TimeoutError):
+        with vk.verkle_lock(timeout=0.2):
+            pass
+
+
+def test_foreign_lock_broken_on_mtime_staleness(lock):
+    lock.write_text(f"57 {_ts()} otherhost|pid:[1]", encoding="utf-8")
+    old = time.time() - vk._LOCK_STALE_SECONDS - 5
+    os.utime(lock, (old, old))
+    with vk.verkle_lock(timeout=1):
+        assert vk._parse_lock(lock.read_text(encoding="utf-8"))[0] == os.getpid()
+    assert not lock.exists()
+
+
+def test_same_namespace_live_owner_is_kept(lock, monkeypatch):
+    lock.write_text(f"4242 {_ts()} {vk._lock_identity()}", encoding="utf-8")
+    monkeypatch.setattr(vk, "_local_pid_alive", lambda pid: True)
+    with pytest.raises(TimeoutError):
+        with vk.verkle_lock(timeout=0.2):
+            pass
+
+
+def test_probe_never_signals_the_process(monkeypatch):
+    # os.kill(pid, 0) on Windows is CTRL_C_EVENT and reports dead pids as alive.
+    monkeypatch.setattr(os, "kill", lambda *a: pytest.fail("os.kill used as a liveness probe"))
+    if sys.platform != "win32":
+        pytest.skip("Windows-specific guard (POSIX os.kill(pid, 0) is a real probe)")
+    assert vk._local_pid_alive(os.getpid()) is True
+    assert vk._local_pid_alive(99999999) is False
+
+
+def test_breaker_does_not_unlink_a_lock_retaken_after_judgement(lock, monkeypatch):
+    """Ractor 2026-10-04: two waiters judge the same dead marker; the first breaks
+    it and takes the lock. The second must re-read and leave the NEW lock alone."""
+    dead = f"99999999 {_ts()} {vk._lock_identity()}"
+    lock.write_text(dead, encoding="utf-8")
+    fresh = f"4242 {_ts()} {vk._lock_identity()}"
+
+    def judge_then_lose_race(marker):
+        if marker == dead:
+            lock.write_text(fresh, encoding="utf-8")  # the other waiter won meanwhile
+            return True
+        return False  # the new holder is alive
+
+    monkeypatch.setattr(vk, "_lock_owner_dead", judge_then_lose_race)
+    with pytest.raises(TimeoutError):
+        with vk.verkle_lock(timeout=0.2):
+            pass
+    assert lock.read_text(encoding="utf-8") == fresh
