# W1 draft runner — prompts stealth/union-alpha with the W1 module contract (blueprint M0).
# Wave laws honored: repo key via mag.flight_recorder.load_env, never printed; only the
# openrouter.ai endpoint; the editor seat integrates and verifies (U3: self-checks lie).
import json
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(r"C:\Users\foste\Documents\projects\local_sovereign_agent")
sys.path.insert(0, str(ROOT))

from mag.flight_recorder import load_env  # noqa: E402

HERE = ROOT / "watch" / "inbox" / "wave_20260916" / "drafts"
CONTRACT = HERE / "W1_contract.md"
DRAFT = HERE / "W1_union_alpha_draft.py"
META = HERE / "W1_union_alpha_meta.json"

URL = "https://openrouter.ai/api/v1/chat/completions"
MODEL = "stealth/union-alpha"

env = load_env(str(ROOT))
KEY = env.get("OPENROUTER_API_KEY", "")
if not KEY:
    print("FATAL: OPENROUTER_API_KEY not present in .env")
    sys.exit(1)

messages = [
    {"role": "system", "content":
        "You are union-alpha, the drafting pen of the Mag harness. You output exactly one "
        "complete Python module in one ```python code block. No prose before or after the block."},
    {"role": "user", "content": CONTRACT.read_text(encoding="utf-8")},
]
body = json.dumps({
    "model": MODEL,
    "messages": messages,
    "max_tokens": 16000,
    "temperature": 0.0,
}).encode("utf-8")
t0 = time.perf_counter()
rec = {"model": MODEL, "ok": False, "attempts": []}
BACKOFF = [80, 80, 80, 80, 80, 80]
for attempt in range(1, len(BACKOFF) + 2):
    att = {"n": attempt}
    req = urllib.request.Request(URL, data=body, headers={
        "Authorization": f"Bearer {KEY}",
        "Content-Type": "application/json",
        "User-Agent": "mag-w1-world/1.0",
    }, method="POST")
    ta = time.perf_counter()
    try:
        with urllib.request.urlopen(req, timeout=420) as r:
            dt = time.perf_counter() - ta
            data = json.loads(r.read().decode("utf-8"))
            ch = (data.get("choices") or [{}])[0]
            msg = ch.get("message", {})
            text = msg.get("content") or ""
            usage = data.get("usage", {})
            att.update(ok=r.status == 200 and bool(text.strip()),
                       status=r.status, latency_s=round(dt, 2),
                       model_reported=data.get("model"), finish=ch.get("finish_reason"),
                       usage={k: usage.get(k) for k in
                              ("prompt_tokens", "completion_tokens", "total_tokens", "cost")},
                       content_chars=len(text),
                       reason_head=(msg.get("reasoning") or "")[:120])
            if att["ok"]:
                rec["ok"] = True
                rec.update(latency_s=round(time.perf_counter() - t0, 2),
                           model_reported=data.get("model"), finish=ch.get("finish_reason"),
                           usage=att["usage"], content_chars=len(text))
                DRAFT.write_text(text, encoding="utf-8")
                rec["attempts"].append(att)
                break
            if not text and msg.get("reasoning"):
                att["note"] = "reasoning-only response"
    except urllib.error.HTTPError as e:
        dt = time.perf_counter() - ta
        err = e.read().decode("utf-8", "replace")
        att.update(ok=False, status=e.code, latency_s=round(dt, 2), error_head=err[:300])
    except Exception as e:  # noqa: BLE001
        att.update(ok=False, error=repr(e)[:300])
    rec["attempts"].append(att)
    if attempt <= len(BACKOFF):
        time.sleep(BACKOFF[attempt - 1])

if not rec["ok"]:
    rec["latency_s"] = round(time.perf_counter() - t0, 2)

META.write_text(json.dumps(rec, ensure_ascii=False, indent=2), encoding="utf-8")
print(json.dumps({"ok": rec["ok"], "attempts": len(rec["attempts"]),
                  "finish": rec.get("finish"), "usage": rec.get("usage"),
                  "draft_chars": rec.get("content_chars")}, ensure_ascii=False))
sys.exit(0 if rec["ok"] else 2)
